# Response headers for Cloudflare, which reads this file at deploy time and
# never serves it. Astro copies it from public/ into the build unchanged.

# Keep search engines from listing the site until it launches: the
# workers.dev address is public. Remove this rule at launch (the roadmap's
# launch checklist).
/*
  X-Robots-Tag: noindex

# Everything Astro builds into /_astro/ (photos, fonts, scripts, styles) has
# a fingerprint of its contents in its file name, so a changed file always
# gets a new name. Browsers can keep these for a year without asking again.
# Cloudflare's default (max-age=0, must-revalidate) makes them check with
# the server before every use, a wasted round trip on every page view.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
