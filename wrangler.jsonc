// How Cloudflare deploys the site. Workers Builds runs `npm run build`, then
// `npx wrangler deploy` for main (the live site) or `npx wrangler preview`
// for any other branch, and both read this file. Build commands and build
// variables live in the Cloudflare dashboard, not here: see
// docs/architecture/tech-stack.md, "Hosting".
{
  // Must match the Worker's name in the dashboard, or a deploy creates a
  // second Worker instead of updating this one.
  "name": "bacchus-astro",

  // Which version of the Workers runtime to behave like. Bump it deliberately,
  // never automatically.
  "compatibility_date": "2026-10-07",

  // The Worker that runs the on-demand routes (the API) and the daily jobs.
  // Every page is still static: Cloudflare serves a matching file first,
  // with the rules in public/_headers applied, and only hands the Worker what
  // no file answers. Our own entry point wraps Astro's (src/worker.ts) to add
  // the daily run. The build writes the final config (dist/server/
  // wrangler.json) from this one, and `wrangler deploy` picks that up.
  "main": "./src/worker.ts",

  // When Cloudflare runs the Worker's `scheduled` (src/worker.ts): every day
  // at 07:00 UTC, which is 8 or 9 in the morning in Malta.
  "triggers": { "crons": ["0 7 * * *"] },

  // Lets the Worker read process.env and Node's built-ins, which
  // @sanity/client relies on.
  "compatibility_flags": ["nodejs_compat"],

  // Cloudflare's headless Chrome (Browser Rendering), which prints each quote
  // as a PDF when it's sent (src/lib/quotes/pdf/print.ts). `npm run dev`
  // launches a Chrome on this machine for it instead.
  "browser": { "binding": "BROWSER", "remote": true },

  // Required by `wrangler preview`, even when empty. Branch previews need no
  // settings of their own yet; their build variables (INCLUDE_DRAFTS) are set
  // under Builds, "Previews Base", in the dashboard.
  "previews": {},
}
