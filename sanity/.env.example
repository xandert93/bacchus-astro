# Copy to .env.local and fill in. Sanity's CLI loads .env.local automatically;
# it is gitignored, so the real values never reach the repository.
#
# Both come from the project you create at sanity.io/manage. Keep the
# dataset private: it will hold enquiries, and a public dataset lets anyone
# read every published document without a token.

SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
