{
  "name": "bacchus-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --port 3000",
    "dev:host": "astro dev --port 3000 --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . --cache && stylelint \"src/**/*.{css,astro}\"",
    "lint:fix": "eslint . --cache --fix && stylelint \"src/**/*.{css,astro}\" --fix",
    "test:e2e": "playwright test",
    "sanity:migrate": "node scripts/sanity-migrate.mjs",
    "sanity:install": "npm --prefix sanity install",
    "sanity:dev": "npm --prefix sanity run dev",
    "sanity:check": "npm --prefix sanity run check",
    "sanity:build": "npm --prefix sanity run build",
    "sanity:deploy": "npm --prefix sanity run deploy",
    "sanity:import": "npm --prefix sanity run import --",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "globals": "^17.13.0",
    "postcss": "^8.5.29",
    "postcss-custom-media": "^12.0.3",
    "postcss-html": "^2.0.0",
    "postcss-selector-parser": "^7.1.6",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "stylelint": "^17.16.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
