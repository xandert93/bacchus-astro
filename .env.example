# Copy this file to .env (which git ignores) and fill in the values.
# This file is committed, so never put a real value in it.

# Reads the private Sanity dataset while the site builds and in `npm run dev`.
# sanity.io/manage -> API -> Tokens, permissions "Viewer". On the live site
# it's a build variable AND a Worker secret: the availability endpoint reads
# Sanity when a visitor opens the calendar.
SANITY_API_READ_TOKEN=

# Lets the enquiry endpoint store new enquiries. Permissions "Editor".
# On the live site it's a Worker secret in Cloudflare, not a build variable.
SANITY_API_WRITE_TOKEN=

# Leave unset to use production. "development" points `npm run dev` (and its
# test enquiries) at the development dataset.
SANITY_DATASET=development

# Sends emails (the enquiry confirmation and others) through Resend.
# resend.com -> API Keys -> Create, permission "Sending access".
RESEND_API_KEY=

# Every email goes here instead of its real recipient: keep it set locally so
# testing never emails a real person. Use your Resend account's address: until
# Bacchus's domain is verified, Resend only delivers to that one.
EMAIL_TEST_RECIPIENT=

# The Studio, with its workspace, for the "Open in the Studio" button in the
# staff alert email.
STUDIO_URL=http://localhost:3333/development

# Proves a webhook call really came from Sanity (src/lib/webhooks/sanity.ts).
# Locally, any long random string: `npm run dev:webhooks` signs with it. On
# the live site, the secret set on each Sanity webhook, as a Worker secret.
SANITY_WEBHOOK_SECRET=

# Card deposits through Stripe. Dashboard -> Developers -> API keys, in test
# mode: the secret key (sk_test_...). Without it, cards use the pretend checkout.
STRIPE_SECRET_KEY=

# Proves a payment event came from Stripe. Locally, the whsec_... that
# `stripe listen --forward-to localhost:3000/api/payments/stripe-events` prints.
STRIPE_WEBHOOK_SECRET=

# Open banking through Enable Banking, being tried for "Pay by bank". From its
# Control Panel -> API applications: the application's id, and its private
# key (the downloaded .pem file's body, on one line). Leave both empty to use
# Stripe's Pay by Bank instead.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
