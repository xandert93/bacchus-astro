.eslintcache

# Sanity Studio's local runtime cache
/sanity/.sanity/

# Exports made by `npm run sanity:copy-production` on the way to the
# development dataset: a full copy of the client's content, never committed.
/sanity/exports/

# Cloudflare: local Worker secrets and wrangler's working files.
.dev.vars
.dev.vars.*
.wrangler/

# Client documents dropped in the repo root for reference (a real quote,
# say) name real people, so they never go into git.
/*.pdf
