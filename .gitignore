# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production
# Sanity's CLI loads .env.local; .env.example is committed as the template
.env.local
.env.*.local

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# playwright
test-results/
playwright-report/

# personal Claude Code instructions
CLAUDE.local.md

# local-only copy of the prototype's sandboxes (design comparisons), served by
# the dev server at /prototype/sandboxes/; never committed
/public/prototype/

# ESLint cache
.eslintcache

# Generated by scripts/sanity-migrate.mjs, regenerated deterministically from
# src/data/. Committing it would be a second copy of the content, free to
# drift from the first.
/sanity/import/

# Sanity Studio's local runtime cache
/sanity/.sanity/
