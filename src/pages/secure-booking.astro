---
// /secure-booking: the deposit page. A couple reaches it from the private link
// in their quote email (?token=…), so it's never linked from the site and
// stays out of search results. The page itself is static; _secure-booking.js
// asks /api/deposits/view for the quote behind the link and fills it in,
// which keeps the photos going through the build's image pipeline.
// docs/planning/sanity-rollout.md, step 7.
import BaseLayout from "@layouts/BaseLayout.astro"
import SecureCheckoutBadge from "@components/secure-booking/SecureCheckoutBadge.astro"
import SecureBookingHero from "@components/secure-booking/SecureBookingHero.astro"
import DepositStatus from "@components/secure-booking/DepositStatus.astro"
import BookingSummary from "@components/secure-booking/BookingSummary.astro"
import DepositPaymentOptions from "@components/secure-booking/DepositPaymentOptions.astro"
import DeclineQuote from "@components/secure-booking/DeclineQuote.astro"
import PaymentSupport from "@components/secure-booking/PaymentSupport.astro"
import PaymentFaq from "@components/secure-booking/PaymentFaq.astro"
import PaymentHelpButton from "@components/secure-booking/PaymentHelpButton.astro"
import BookingAssurances from "@components/secure-booking/BookingAssurances.astro"
import "./_secure-booking.css"
---

<BaseLayout
  title="Secure Your Booking — Bacchus, Mdina"
  description="Secure your booking at Bacchus by paying the deposit."
  checkout
  noIndex
  showVisitSection={false}
>
  <SecureCheckoutBadge slot="header" />

  <div id="depositPage" data-deposit-state="loading">
    <SecureBookingHero />
    <DepositStatus />
    <BookingSummary />
    <DepositPaymentOptions />
    <DeclineQuote />
    <PaymentSupport />
    <PaymentFaq />
    <PaymentHelpButton />
    <BookingAssurances />
  </div>
</BaseLayout>

<script>
  import "./_secure-booking.js"
</script>
