---
// /gallery. Filtering is pure CSS (:has() keyed off which radio is
// :checked — see global.css); gallery-filter.js keeps ?filter= in the URL in
// step as the visitor clicks between categories.
import BaseLayout from "../layouts/BaseLayout.astro"
import PageHero from "../components/PageHero.astro"
import GalleryTile from "../components/GalleryTile.astro"
import "../styles/gallery-grid.css"
import Lightbox from "../components/Lightbox.astro"
import EnquirySection from "../components/EnquirySection.astro"
import WaitlistPopover from "../components/WaitlistPopover.astro"
import { GALLERY_FILTERS, GALLERY_PHOTOS } from "../data/gallery"
---

<BaseLayout
  title="Gallery — Bacchus, Mdina"
  menuBackgroundImage="venue/hall-chandeliers-banquet"
>
  <PageHero
    crumb="Gallery"
    image={{
      src: "venue/hall-chandeliers-banquet",
      alt: "The banquet room dressed with chair sashes and long tables",
    }}
  >
    Every photograph is <em>real</em> Bacchus
    <Fragment slot="sub">
      No stock photography, no renders — every frame here was taken at Bacchus, across the
      restaurant and the estate's event spaces.
    </Fragment>
  </PageHero>

  <section class="section-padding-small">
    <div class="wrap">
      {/* Radio + label, not buttons: the selected filter is real, native
           single-select state that the CSS :has() filter can read, and
           radios get arrow-key navigation for free. The input is visually
           hidden; the label is the visible pill. */}
      <div class="gallery-filter" id="gfilter" data-reveal>
        {GALLERY_FILTERS.map((filter) => (
          <>
            <input
              type="radio"
              name="gfilter"
              id={`gf-${filter.id}`}
              class="gallery-filter-input"
              checked={filter.id === "all"}
            />
            <label for={`gf-${filter.id}`} class="gallery-filter-label">
              {filter.label}
            </label>
          </>
        ))}
      </div>

      {/* is:inline tells Astro to leave this script EXACTLY here, as written:
           not bundled, not turned into a deferred module, not moved. Every
           other <script> on the site is processed, which makes it deferred —
           and that is precisely wrong here (prototype bug #25). The mini
           galleries link in with ?filter=weddings etc.; if the radio were set
           any later than this point, the browser would already have painted
           the whole unfiltered grid below and the visitor would see every
           photo flash before it snapped to their category. Running here,
           parser-blocking and before #ggrid exists, the CSS filter is right
           at first paint. Keep it to this one job. */}
      <script is:inline>
        ;(function () {
          var requested = new URLSearchParams(location.search).get("filter")
          var radio = requested && document.getElementById("gf-" + requested)
          if (radio) radio.checked = true
        })()
      </script>
      <div class="gallery-grid" id="ggrid">
        {GALLERY_PHOTOS.map((photo, i) => (
          <GalleryTile
            class:list={{ "gallery-item-span-two": photo.wide }}
            data-cat={photo.category}
            data-title={photo.title}
            data-tag={photo.tag}
            data-reveal="img"
            style={i === 0 ? undefined : `--d: ${photo.revealDelay}ms`}
            tag={photo.badge ?? photo.tag}
            photo={{
              src: photo.src,
              alt: photo.alt,
              // The first two load eagerly: they're in view on arrival.
              loading: i < 2 ? undefined : "lazy",
              sizes: photo.wide
                ? "(max-width: 620px) 100vw, (max-width: 980px) 66vw, 50vw"
                : "(max-width: 620px) 50vw, (max-width: 980px) 33vw, 25vw",
              maxWidth: photo.wide ? 1920 : 1280,
            }}
          />
        ))}
      </div>
    </div>
  </section>

  <Lightbox />

  <EnquirySection
    eventType="Wedding"
    eyebrow="Liked what you saw?"
    railPhoto={{
      src: "venue/mdina-bastion-view",
      alt: "View over Mdina's bastion walls at dusk",
      caption: "Mdina's bastion walls, just beyond the estate.",
    }}
  >
    <Fragment slot="heading">
      Let's plan your <em>own</em> evening
    </Fragment>
    <Fragment slot="lead">
      Whichever room caught your eye, tell us the occasion and we'll come back with dates,
      pricing and a proposal — before we ever get on the phone.
    </Fragment>
  </EnquirySection>

  <WaitlistPopover slot="after-footer" />
  <script>
    import "../scripts/gallery-filter.js"
  </script>
</BaseLayout>

<style>
  /* Scoped to this page (moved from global.css by
     scripts/scope-styles.mjs). See FaqSection.astro for how scoping works. */
  /* ---------- View Gallery grid + lightbox ---------- */
  .gallery-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: clamp(30px, 4vw, 44px);
  }
  /* Standard visually-hidden-but-focusable pattern — not display:none, which
     would drop these out of tab order and break the label-click/keyboard
     arrow-key selection that's the actual point of using real radios here. */
  .gallery-filter-input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  /* Same chip style as the enquiry form's .chip (event type, contact
     preference) — same filter/choice pattern, so it reads as one shared
     component — except border-radius and padding, kept as this page's own
     (a fully round pill with room for longer labels like "Venue & Dining",
     vs .chip's tighter card radius sized for its own fixed-width layout). */
  .gallery-filter-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(var(--muted-ink-rgb), 0.16);
    background: var(--paper);
    cursor: pointer;
    font-size: 10.5px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.2;
    text-align: center;
    color: var(--ink);
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease),
      color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  @media (hover: hover) {
    .gallery-filter-label:hover {
      background-color: var(--limestone);
    }
  }
  .gallery-filter-input:checked + .gallery-filter-label {
    background: var(--ink);
    color: var(--limestone);
    border-color: var(--ink);
    box-shadow: 0 3px 12px rgba(var(--ink-rgb), 0.12);
    /* Selection is the one transition on this chip that must not be slow,
       on ANY input type. The 0.3s above is tuned for the hover crossfade
       (paper to limestone, a few percent of lightness) — but hovering
       previews the HOVER state, not this one, so a click still runs an
       unpreviewed 300ms ease from near-white to near-black, and that fade
       IS the "did my click register?" gap. It also lands on top of the
       filter change's own main-thread cost (23 tiles toggling display,
       newly-in-view images decoding), so the two stack. Same reasoning as
       the touch override below, which only ever covered touch because the
       hover preview was assumed to do this job on a pointer; it doesn't.
       Scoped to the checked rule rather than the base so LEAVING the
       selected state keeps the slower crossfade and only the chip the
       visitor is waiting on snaps. Duration-only, so the property list
       above stays the single source of truth for WHICH properties animate
       (bug #2). Note this rule is (0,2,0) and so outranks the base-level
       (0,1,0) duration override in the @media (hover: none) block below —
       deliberately the same 0.1s, so touch is unchanged either way rather
       than silently governed by whichever rule wins. */
    transition-duration: 0.1s;
  }
  @media (hover: hover) {
    .gallery-filter-input:checked + .gallery-filter-label:hover {
      background: var(--ink-2);
      border-color: var(--ink-2);
    }
  }
  /* Touch has no hover state at all, so unlike a pointer there is nothing
       the 0.3s crossfade is there to serve — it only ever shows up as the
       "did my tap register?" gap described on the checked rule above. So the
       whole chip goes fast here, both directions, not just the entering one.
       Duration-only override rather than a fresh `transition` shorthand, so
       the property list above stays the single source of truth for WHICH
       properties animate (bug #2). */
  @media (hover: none) {
    .gallery-filter-label {
      transition-duration: 0.1s;
    }
  }
  @media (hover: none) {
    .gallery-filter-label:active {
      background-color: var(--limestone);
    }
  }
  @media (hover: none) {
    .gallery-filter-input:checked + .gallery-filter-label:active {
      background: var(--ink-2);
      border-color: var(--ink-2);
    }
  }
  /* The input itself is visually hidden, so its own default focus ring would
     never be seen — forwarded onto the label it's paired with instead. */
  .gallery-filter-input:focus-visible + .gallery-filter-label {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  :global(.gallery-item.gallery-item-span-two) {
    grid-column: span 2;
  }
  @media (max-width: 980.98px) {
    :global(.gallery-item.gallery-item-span-two) {
      grid-column: span 2;
    }
  }
  @media (max-width: 620.98px) {
    :global(.gallery-item.gallery-item-span-two) {
      grid-column: span 1;
    }
  }
  /* Filtering itself, in place of the old JS click handler that toggled a
     .hide class on non-matching .gallery-item elements: #gfilter and #ggrid
     are plain siblings under one .wrap (same shape the mega-menu scrim
     already relies on :has() for), so :has() on that shared ancestor, keyed
     off which radio is :checked, can reach across to filter the grid with no
     JS at all. #gf-all has no matching rule below — with nothing checked
     matching, no .gallery-item ever gets hidden, which is exactly "show
     everything." */
  .wrap:has(#gf-weddings:checked)
    :global(#ggrid)
    :global(.gallery-item:not([data-cat="weddings"])),
  .wrap:has(#gf-corporate:checked)
    :global(#ggrid)
    :global(.gallery-item:not([data-cat="corporate"])),
  .wrap:has(#gf-celebrations:checked)
    :global(#ggrid)
    :global(.gallery-item:not([data-cat="celebrations"])),
  .wrap:has(#gf-venue:checked)
    :global(#ggrid)
    :global(.gallery-item:not([data-cat="venue"])) {
    display: none;
  }
</style>
