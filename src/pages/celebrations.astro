---
// /celebrations. No process steps and no testimonials, as in the prototype:
// none of the four real testimonials is celebration-specific.
import BaseLayout from "../layouts/BaseLayout.astro"
import PageHero from "../components/PageHero.astro"
import ArrowIcon from "../components/ArrowIcon.astro"
import CheckList from "../components/CheckList.astro"
import OccasionCards from "../components/OccasionCards.astro"
import GalleryPreview from "../components/GalleryPreview.astro"
import Lightbox from "../components/Lightbox.astro"
import FaqSection from "../components/FaqSection.astro"
import EnquirySection from "../components/EnquirySection.astro"
import WaitlistPopover from "../components/WaitlistPopover.astro"
import Photo from "../components/Photo.astro"
---

<BaseLayout
  title="Celebrations — Bacchus, Mdina"
  menuBackgroundImage="celebrations/friends"
>
  <PageHero
    crumb="Celebrations"
    image={{
      src: "celebrations/friends",
      alt: "Friends embracing at a long outdoor table during a celebration",
    }}
  >
    Birthdays, anniversaries and <em>everything</em> worth marking
    <Fragment slot="sub">
      From an intimate family dinner to a full holy-day banquet, the Secret Garden and
      Terrace flex to fit the night — canapés and wine, or a complete sit-down menu.
    </Fragment>
    <Fragment slot="ctas">
      <a href="#enquire" class="button button-gradient button-shimmer">
        <span>Tell us the date</span>
        <ArrowIcon />
      </a>
      <a href="/gallery" class="button button-ghost">
        <span>See the room</span>
      </a>
    </Fragment>
  </PageHero>

  <section class="section-padding">
    <div class="wrap split">
      <div>
        <div class="eyebrow" data-reveal>
          The Terrace, and the Secret Garden beyond it
        </div>
        <h2 data-reveal style="--d: 80ms">
          Smaller parties, the same historic <em>estate</em>
        </h2>
        <p
          data-reveal
          style="--d: 160ms; color: var(--muted-ink); margin-top: 22px; max-width: 52ch"
        >
          We cater for celebrations of all sorts — intimate family gatherings and
          banquets, holy celebrations, graduations, birthdays and more — hosted across the
          Terrace and Secret Garden, part of the same 17th-century estate as the
          restaurant.
        </p>
        <CheckList
          items={[
            "Flexible group sizes, from a family table to a full banquet",
            "Canapé and sharing menus, or a complete sit-down service",
            "Flexible timing, including late sittings",
            "Garden terrace open for warmer-month evenings",
          ]}
        />
      </div>
      <div class="ph-wrap" data-reveal="img">
        <Photo
          src="venue/terrace-marquee-tables"
          sizes="(max-width: 980px) 100vw, 50vw"
          alt="Round tables dressed in white under a marquee on the Terrace, set for an outdoor celebration"
        />
      </div>
    </div>
  </section>

  <OccasionCards
    eyebrow="Occasions we host"
    cards={[
      {
        title: "Birthdays & anniversaries",
        body: "A private table or a full Terrace takeover, either way.",
        iconPaths: ["M12 2v4M8 6h8l1 4H7l1-4ZM6 10h12l1 11H5l1-11Z"],
      },
      {
        title: "Graduations & holy celebrations",
        body: "Family banquets that scale from a dozen to a full hall.",
        iconPaths: ["M12 3 4 8v3h16V8zM6 11v8m4-8v8m4-8v8m4-8v8M4 21h16"],
      },
      {
        title: "Family banquets & high teas",
        body: "A relaxed, tiered-stand format for daytime gatherings.",
        iconPaths: ["M4 21h16M6 21V8a2 2 0 0 1 2-2h5l5 5v10"],
      },
      {
        title: "Intimate parties & gatherings",
        body: "Smaller tables with the same attention as our largest nights.",
        iconPaths: [
          "M12 21s-7-4.35-9.5-8.5C.6 8.9 2.4 5 6 5c2 0 3.3 1 4 2.2C10.7 6 12 5 14 5c3.6 0 5.4 3.9 3.5 7.5C19 16.65 12 21 12 21Z",
        ],
      },
    ]}
  >
    Every reason to <em>gather</em>
  </OccasionCards>

  <GalleryPreview
    id="celebrationsGalleryPreview"
    eyebrow="From past celebrations"
    lead="Birthdays, anniversaries and long lunches — real celebrations across the Secret Garden and Terrace."
    category="celebrations"
    photos={[
      {
        src: "celebrations/guest-laughing",
        alt: "A guest laughing at a celebration",
        title: "Shared Laughter",
      },
      {
        src: "celebrations/canape-tray",
        alt: "A canapé tray at a garden celebration",
        title: "The Canapé Tray",
      },
      {
        src: "celebrations/friends",
        alt: "Friends embracing at a long outdoor table",
        title: "Old Friends, Long Table",
      },
      {
        src: "celebrations/tea-pour",
        alt: "A guest pouring tea in the garden",
        title: "An Afternoon in the Garden",
      },
    ]}
  >
    Old friends, <em>long</em> table
  </GalleryPreview>

  <Lightbox />

  <FaqSection
    items={[
      {
        question: "What's the smallest group you'll host?",
        answer:
          "We host intimate family tables as well as full Terrace takeovers — tell us your group size and we'll suggest the right setup.",
      },
      {
        question: "Is the garden terrace available year-round?",
        answer:
          "The Terrace is at its best in the warmer months; outside of that we move the same service into the Secret Garden or indoors as needed.",
      },
      {
        question: "Can we bring our own cake or decorations?",
        answer:
          "Yes — let your event manager know in advance so we can plan the table and timing around it.",
      },
    ]}
  >
    Celebrations <em>FAQ</em>
  </FaqSection>

  <EnquirySection
    eventType="Celebration"
    railPhoto={{
      src: "celebrations/guest-laughing",
      alt: "A guest laughing during a celebration at Bacchus",
      caption: "A celebration among friends, into the evening.",
    }}
  >
    <Fragment slot="heading">
      Tell us about your <em>celebration</em>
    </Fragment>
    <Fragment slot="lead">
      Four short steps. We come back with dates, pricing and a proposal shaped to your
      event — before we ever get on the phone.
    </Fragment>
  </EnquirySection>

  <WaitlistPopover slot="after-footer" />
</BaseLayout>
