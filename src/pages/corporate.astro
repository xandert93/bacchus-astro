---
// /corporate.
import BaseLayout from "@layouts/BaseLayout.astro"
import IntroSplit from "@components/sections/IntroSplit.astro"
import PageHero from "@components/sections/PageHero.astro"
import OccasionCards from "@components/sections/OccasionCards.astro"
import GalleryPreview from "@components/sections/GalleryPreview.astro"
import Lightbox from "@components/ui/Lightbox.astro"
import ProcessSteps from "@components/sections/ProcessSteps.astro"
import FaqSection from "@components/sections/FaqSection.astro"
import EnquirySection from "@components/enquiry/EnquirySection.astro"
import WaitlistPopover from "@components/enquiry/WaitlistPopover.astro"
import Button from "@components/ui/Button.astro"
---

<BaseLayout
  title="Corporate Events — Bacchus, Mdina"
  menuBackgroundImage="corporate/champagne-service"
>
  <PageHero
    crumb="Corporate"
    image={{
      src: "corporate/guests-chatting",
      alt: "Colleagues chatting at a corporate event with laptops on the table",
    }}
  >
    A boardroom with <em>better</em> acoustics
    <Fragment slot="sub">
      Lunches, dinners, high teas, presentations and staff parties — Bacchus adapts from
      theatre-style meetings to a full seated gala, inside a 17th-century estate within
      Mdina's walls.
    </Fragment>
    <Fragment slot="ctas">
      <Button href="#enquire" variant="gradient" shimmer arrow>
        <span>Request a proposal</span>
      </Button>
      <Button href="/gallery" variant="ghost">
        <span>See the room</span>
      </Button>
    </Fragment>
  </PageHero>

  <IntroSplit
    eyebrow="Full facility, one dedicated manager"
    included={[
      "AV, staging and lighting included as standard",
      "Private bar and a dedicated event manager on the day",
      "Daytime and evening hire, theatre-style or seated dinner layout",
      "Part of a 4500m² historic estate within Mdina's walls",
    ]}
    photo={{
      src: "corporate/champagne-service",
      alt: "A waiter serving champagne to a guest in business attire",
    }}
  >
    <Fragment slot="heading">
      Built for business, inside a 17th-century <em>estate</em>
    </Fragment>
    <p
      data-reveal
      style="--d: 160ms; color: var(--muted-ink); margin-top: 22px; max-width: 52ch"
    >
      Whether it's a quarterly review or a year-end gala, the function room reconfigures
      around the shape of your event — and unlike a hotel conference floor, nobody else is
      booked in beside you.
    </p>
  </IntroSplit>

  <OccasionCards
    eyebrow="What we cater for"
    cards={[
      {
        title: "Lunches & dinners",
        body: "Working lunches through to a full seated evening for the whole team.",
        iconPaths: ["M4 21V9l8-6 8 6v12M9 21v-6h6v6"],
      },
      {
        title: "High teas",
        body: "A lighter, daytime format for smaller meetings or client visits.",
        iconPaths: ["M4 21h16M6 21V8a2 2 0 0 1 2-2h5l5 5v10"],
      },
      {
        title: "Presentations & meetings",
        body: "AV and theatre-style seating for launches, briefings and board sessions.",
        iconPaths: ["M4 5h16M4 12h16M4 19h10"],
      },
      {
        title: "Staff parties & galas",
        body: "Year-end and milestone celebrations, with a private bar through the night.",
        iconPaths: ["M8 3h8l-1 9a3 3 0 0 1-6 0z", "M12 15v6M9 21h6"],
      },
    ]}
  >
    Every kind of working <em>gathering</em>
  </OccasionCards>

  <GalleryPreview
    id="corpGalleryPreview"
    eyebrow="Inside a corporate evening"
    lead="From theatre-style briefings to a seated dinner, in the same room."
    category="corporate"
    photos={[
      {
        src: "corporate/cocktail-tray",
        alt: "A cocktail tray at a corporate reception",
        title: "The Cocktail Tray",
      },
      {
        src: "corporate/canape-roulade",
        alt: "Canapé roulades served at a corporate event",
        title: "Canapé Roulades",
      },
      {
        src: "corporate/champagne-service",
        alt: "A waiter serving champagne",
        title: "Champagne on Arrival",
      },
      {
        src: "corporate/guests-chatting",
        alt: "Colleagues chatting at a corporate event",
        title: "Business, Unhurried",
      },
    ]}
  >
    Business, <em>unhurried</em>
  </GalleryPreview>

  <Lightbox />

  <ProcessSteps
    steps={[
      {
        title: "Enquire",
        body: "Tell us the format, date and headcount — we'll check availability the same day.",
      },
      {
        title: "Site visit",
        body: "Walk the room with our event manager and confirm layout, AV and catering.",
      },
      {
        title: "Proposal",
        body: "A written proposal covering room hire, menu and any add-ons, ready to approve.",
      },
      {
        title: "Event day",
        body: "Your dedicated manager runs the room end to end, so your team doesn't have to.",
      },
    ]}
  >
    From brief to <em>event day</em>
  </ProcessSteps>

  <FaqSection
    items={[
      {
        question: "Can you handle presentations and AV?",
        answer:
          "Yes — screen, sound and lighting are included, and our team can run a technical walkthrough before your event.",
      },
      {
        question: "Do you offer daytime-only hire?",
        answer:
          "Yes, both daytime and evening hire are available, priced separately from our evening dining and wedding calendar.",
      },
      {
        question: "Can you cater for dietary requirements?",
        answer:
          "Yes — let us know when you enquire and we'll build dietary and allergen needs into the menu from the start.",
      },
    ]}
  >
    Corporate <em>FAQ</em>
  </FaqSection>

  <EnquirySection
    eventType="Corporate"
    railPhoto={{
      src: "corporate/guests-chatting",
      alt: "Colleagues networking over drinks at a Bacchus corporate event",
      caption: "Networking drinks ahead of a corporate dinner.",
    }}
  >
    <Fragment slot="heading">
      Tell us about your <em>event</em>
    </Fragment>
    <Fragment slot="lead">
      Four short steps. We come back with dates, pricing and a proposal shaped to your
      event — before we ever get on the phone.
    </Fragment>
  </EnquirySection>

  <WaitlistPopover slot="after-footer" />
</BaseLayout>
