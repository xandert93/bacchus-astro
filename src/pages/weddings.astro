---
// /weddings: the page composes its sections; the weddings-only ones live
// in src/components/weddings/.
import BaseLayout from "@layouts/BaseLayout.astro"
import WeddingsIntro from "@components/weddings/WeddingsIntro.astro"
import WeddingsPackages from "@components/weddings/WeddingsPackages.astro"
import WeddingsAvailability from "@components/weddings/WeddingsAvailability.astro"
import AvailabilityModal from "@components/enquiry/AvailabilityModal.astro"
import EnquirySection from "@components/enquiry/EnquirySection.astro"
import WaitlistPopover from "@components/enquiry/WaitlistPopover.astro"
import ArrowIcon from "@components/ui/ArrowIcon.astro"
import FaqSection from "@components/sections/FaqSection.astro"
import GalleryPreview from "@components/sections/GalleryPreview.astro"
import Lightbox from "@components/ui/Lightbox.astro"
import PageHero from "@components/sections/PageHero.astro"
import ProcessSteps from "@components/sections/ProcessSteps.astro"
import Testimonials from "@components/sections/Testimonials.astro"
---

<BaseLayout
  title="Weddings — Bacchus, Mdina"
  menuBackgroundImage="weddings/cake-chandelier"
>
  <PageHero
    crumb="Weddings"
    image={{
      src: "weddings/toast",
      alt: "A bride and groom clinking champagne glasses",
    }}
  >
    Married in the
    <br />
    <em>Prince De Redin</em> Hall
    <Fragment slot="sub">
      From large-scale celebrations to intimate ceremonies, Bacchus hosts weddings across
      the Secret Garden, the Prince De Redin Hall and the Terrace — part of the same
      17th-century estate as the restaurant, held exclusively for one wedding a day.
    </Fragment>
    <Fragment slot="ctas">
      <a href="#availability" class="button button-gradient button-shimmer">
        <span>Find Your Date</span>
        <ArrowIcon />
      </a>
      <a
        href="/docs/bacchus-wedding-catalogue.pdf"
        target="_blank"
        rel="noopener"
        class="button button-ghost"
      >
        <span>View the catalogue</span>
      </a>
    </Fragment>
  </PageHero>

  <WeddingsIntro />

  <WeddingsPackages />

  <GalleryPreview
    id="weddingsGalleryPreview"
    eyebrow="From real weddings"
    lead="The Hall dressed for dinner, the Terrace at dusk, the Secret Garden for vows — real weddings, not staged shots."
    category="weddings"
    photos={[
      {
        src: "weddings/cake-detail",
        alt: "Detail of a wedding cake",
        title: "Cake Detail",
      },
      {
        src: "weddings/oysters",
        alt: "A tray of oysters served to guests",
        title: "Oysters, On Ice",
      },
      {
        src: "weddings/guest-portrait",
        alt: "A guest portrait at a wedding",
        title: "A Guest, In the Garden",
      },
      {
        src: "venue/hall-chandeliers-banquet",
        alt: "The banquet room dressed for a wedding",
        title: "The Banquet Room",
      },
    ]}
  >
    A few frames from <em>the day</em>
  </GalleryPreview>

  <Lightbox />

  <ProcessSteps
    steps={[
      {
        title: "Enquire",
        body: "Send your date and guest count — we'll come back with availability within two working days.",
      },
      {
        title: "Viewing & tasting",
        body: "Walk the Hall, Terrace and Secret Garden, and taste the set menu options with our team.",
      },
      {
        title: "Confirm your date",
        body: "A 30% non-refundable deposit secures the venue exclusively for your day.",
      },
      {
        title: "The big day",
        body: "The remaining balance is due 14 days before — then it's just you, your guests, and 360 years of stone.",
      },
    ]}
  >
    From enquiry to <em>the aisle</em>
  </ProcessSteps>

  <FaqSection
    items={[
      {
        question: "Is Bacchus exclusively ours for the day?",
        answer:
          "Yes — we host one wedding a day. The Prince De Redin Hall, Terrace and Secret Garden are yours from arrival to last dance.",
      },
      {
        question: "How do we secure our date?",
        answer:
          "A 30% deposit is non-refundable and confirms your booking. The remaining 70% is due 14 days before the event.",
      },
      {
        question: "What happens if it rains?",
        answer:
          "The Prince De Redin Hall gives us a covered indoor option for the ceremony and reception, so a wet forecast never puts the day at risk.",
      },
      {
        question: "How many guests can Bacchus hold?",
        answer:
          "Capacity depends on layout and season — the figures on this prototype are placeholders, which we'll confirm with Bacchus before we go into production.",
      },
    ]}
  >
    Wedding <em>FAQ</em>
    <Fragment slot="lead">
      A few of the questions couples ask most before they enquire — if yours isn't here,
      just ask when you get in touch.
    </Fragment>
  </FaqSection>

  <Testimonials backgroundImage="weddings/cake-chandelier" />

  <WeddingsAvailability />

  <AvailabilityModal />

  <WaitlistPopover />

  <EnquirySection
    eventType="Wedding"
    datePicker="modal"
    railPhoto={{
      src: "venue/hall-chandeliers-banquet",
      alt: "The Prince De Redin Hall, dressed for a wedding breakfast with chandeliers overhead",
      caption: "The Prince De Redin Hall, dressed for a wedding breakfast.",
    }}
  >
    <Fragment slot="heading">
      Tell us about your <em>wedding</em>
    </Fragment>
    <Fragment slot="lead">
      Four short steps. We come back with dates, pricing and a proposal shaped to your day
      — before we ever get on the phone.
    </Fragment>
  </EnquirySection>
  <script>
    import "@scripts/availability.js"
    import "@scripts/weddings.js"
  </script>
</BaseLayout>
