                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span
                >Illustrative only — the dates shown are placeholder data. We'll connect
                this to real availability with Bacchus before we go live. Weddings need
                at least 3 months' notice.</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
