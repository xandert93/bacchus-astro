---
// The homepage. Everything shared with other pages (nav, drawer, Visit
// section, footer, script) comes from BaseLayout; this file holds only what
// is unique to the homepage.
import BaseLayout from "../layouts/BaseLayout.astro"
import HeroFrame from "../components/HeroFrame.astro"
import HeroImage from "../components/HeroImage.astro"
import EnquirySection from "../components/EnquirySection.astro"
import Testimonials from "../components/Testimonials.astro"
import WaitlistPopover from "../components/WaitlistPopover.astro"
import Photo from "../components/Photo.astro"
import PhotoCarousel from "../components/PhotoCarousel.astro"
import "../styles/tabs.css"

// "Across the estate": the photo strip.
const carouselSlides = [
  {
    src: "venue/hall-chandeliers-banquet",
    alt: "The banquet room dressed with chair sashes and long tables",
    caption: "The Banquet Room",
  },
  {
    src: "venue/ballroom-night",
    alt: "The function room lit for an evening reception",
    caption: "Reception, After Dark",
  },
  {
    src: "weddings/toast",
    alt: "A bride and groom clinking champagne glasses",
    caption: "The First Toast",
  },
  {
    src: "weddings/oysters",
    alt: "A tray of oysters served to guests at a wedding",
    caption: "Oysters, On Ice",
  },
  {
    src: "weddings/cake-chandelier",
    alt: "A tiered wedding cake beneath a crystal chandelier",
    caption: "The Cake, Under Crystal",
  },
  {
    src: "celebrations/tea-pour",
    alt: "A guest pouring tea at an outdoor garden celebration",
    caption: "An Afternoon in the Garden",
  },
  {
    src: "celebrations/friends",
    alt: "Friends embracing at a long outdoor table",
    caption: "Old Friends, Long Table",
  },
  {
    src: "corporate/guests-chatting",
    alt: "Colleagues chatting at a corporate event",
    caption: "Business, Unhurried",
  },
  {
    src: "corporate/champagne-service",
    alt: "A waiter serving champagne to a guest in business attire",
    caption: "Champagne on Arrival",
  },
  {
    src: "food-and-drink/canapes-tray",
    alt: "A tray of canapés",
    caption: "The Reception Tray",
  },
]
---

<BaseLayout title="Bacchus — Events in Mdina, Malta" showEnquireLink>
  <HeroFrame id="top">
    <HeroImage
      slot="media"
      id="heroImg"
      src="venue/ballroom-night"
      alt="The Bacchus function room lit for an evening reception, with chandeliers and candlelight"
      heroHeightVh={100}
    />
    <div slot="overlay" class="portcullis">
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
    </div>
    <h1>
      <span class="hero-text-mask">
        <span style="transition-delay: 1.55s">The Silent City</span>
      </span>
      <span class="hero-text-mask">
        <span style="transition-delay: 1.72s">
          keeps <em>one</em> table
        </span>
      </span>
    </h1>
    <p class="sub fade-up" style="transition-delay: 1.95s">
      Two vaulted 17th-century chambers hold our restaurant table, while weddings and
      private events unfold separately across the Hall, Terrace and Secret Garden.
    </p>
    <div class="kicker fade-up" style="transition-delay: 2.15s">
      Mdina, Malta — within the walls since 1660
    </div>
    <div class="hero-ctas fade-up" style="transition-delay: 2.32s">
      <a href="#enquire" class="button button-gradient button-shimmer">
        <span>Plan your event</span>
        <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
          <path
            d="M1 5h11M8.5 1.5 12 5 8.5 8.5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
      <a href="/gallery" class="button button-ghost">
        <span>See the rooms</span>
      </a>
    </div>
    <div slot="after" class="scroll-cue">
      Scroll<i></i>
    </div>
  </HeroFrame>
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track" id="mtrack">
      <span>Weddings</span>
      <span>Corporate dinners</span>
      <span>Private celebrations</span> <span>Garden receptions</span>
      <span>Maltese wine list</span>
      <span>Bastion views</span>
    </div>
  </div>
  <section class="section-padding story" id="story">
    <div class="wrap grid">
      <div>
        <div class="eyebrow" data-reveal>
          A chamber built for gunpowder, kept for the table
        </div>
        <h2 data-reveal style="--d: 80ms">
          Built in 1657, still standing <em>guard</em> over dinner
        </h2>
        <p data-reveal style="--d: 180ms; margin-top: 28px">
          Grand Master Fra Martino de Redin raised these chambers between 1657 and 1660 as
          a magazine for Mdina's bastion walls. Where the city once stored its defence,
          Bacchus now keeps its cellar, its kitchen, and its longest tables.
        </p>
        <p data-reveal style="--d: 250ms">
          Guests still enter through the original iron portcullis before the stone opens
          into two vaulted rooms and a garden beyond — unchanged in shape for over 360
          years.
        </p>
        <div class="facts" id="facts">
          <div data-reveal style="--d: 320ms">
            <span class="fact-number" data-count="1657" data-plain="1">
              0
            </span>
            <span class="label">Chambers built</span>
          </div>
          <div data-reveal style="--d: 400ms">
            <span class="fact-number" data-count="2">
              0
            </span>
            <span class="label">Vaulted rooms</span>
          </div>
          <div data-reveal style="--d: 480ms">
            <span class="fact-number" data-count="35" data-suffix="+">
              0
            </span>
            <span class="label">Years serving Mdina</span>
          </div>
        </div>
        <div class="cta-row" data-reveal style="--d: 560ms; margin-top: 40px">
          <a href="#events" class="button button-dark">
            <span>Explore the spaces</span>
            <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
              <path
                d="M1 5h11M8.5 1.5 12 5 8.5 8.5"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
      </div>
      <div class="story-visual">
        <div class="arch" data-reveal="img">
          <Photo
            src="venue/mdina-bastion-view"
            sizes="(max-width: 980px) 100vw, 50vw"
            alt="A view along Mdina's bastion walls, looking out over the Maltese countryside"
          />
        </div>
        <div class="badge" data-reveal="scale" style="--d: 400ms">
          <div class="badge-number">
            360<span style="font-size: 0.55em">yrs</span>
          </div>
          <div class="badge-caption">Of the same stone, the same arches</div>
        </div>
      </div>
    </div>
  </section>
  <section class="section-padding on-dark" id="events">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow" data-reveal>
          Weddings · Corporate · Celebrations
        </div>
        <h2 data-reveal style="--d: 80ms">
          One venue, three ways to <em>gather</em>
        </h2>
        <p class="lead" data-reveal style="--d: 170ms; margin-top: 22px">
          Each occasion gets its own room and its own plan — not a shared form. Choose
          below to see how we'd shape your event, or open the full page for each.
        </p>
      </div>

      <div class="tab-bar tabs-bar" role="tablist" data-reveal style="--d: 220ms">
        <span class="pill" id="pill"></span>
        <button class="active" data-tab="weddings" role="tab" aria-selected="true">
          Weddings
        </button>
        <button data-tab="corporate" role="tab" aria-selected="false">
          Corporate
        </button>
        <button data-tab="celebrations" role="tab" aria-selected="false">
          Celebrations
        </button>
      </div>

      <div class="panels" data-reveal style="--d: 300ms">
        <div class="tab-panel active" data-panel="weddings">
          <div>
            <div class="capacity">Up to 120 seated* · Secret Garden included</div>
            <h3>Married in the Prince De Redin Hall</h3>
            <p>
              The banquet hall hosts your wedding breakfast, with the Secret Garden held
              for the ceremony, drinks and photographs — part of the same 17th-century
              estate as the restaurant next door.
            </p>
            <ul>
              <li>Private hire of the Hall, Terrace and Secret Garden</li>
              <li>Set or bespoke menus, tasted in advance</li>
              <li>In-house wine list, sourced from Maltese producers</li>
              <li>
                One wedding a day — a dedicated Events Manager from your first visit
              </li>
            </ul>
            <div class="actions">
              <a href="/weddings" class="button button-gradient">
                <span>Explore weddings</span>
                <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
                  <path
                    d="M1 5h11M8.5 1.5 12 5 8.5 8.5"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </div>
          <div class="arch arch-tab">
            <Photo
              src="weddings/toast"
              sizes="(max-width: 980px) 100vw, 50vw"
              alt="A bride and groom clinking champagne glasses"
            />
          </div>
        </div>

        <div class="tab-panel" data-panel="corporate">
          <div>
            <div class="capacity">Capacity on request*</div>
            <h3>A boardroom with better acoustics</h3>
            <p>
              For product launches, dinners and year-end gatherings, our function room
              adapts to theatre-style or a seated dinner layout.
            </p>
            <ul>
              <li>AV, staging and lighting included</li>
              <li>Private bar and a dedicated event manager</li>
              <li>Daytime and evening hire available</li>
              <li>Set within a 4500m² estate inside Mdina's walls</li>
            </ul>
            <div class="actions">
              <a href="/corporate" class="button button-gradient">
                <span>Explore corporate</span>
                <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
                  <path
                    d="M1 5h11M8.5 1.5 12 5 8.5 8.5"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </div>
          <div class="arch arch-tab">
            <Photo
              src="corporate/guests-chatting"
              sizes="(max-width: 980px) 100vw, 50vw"
              alt="Colleagues chatting at a corporate event with laptops on the table"
            />
          </div>
        </div>

        <div class="tab-panel" data-panel="celebrations">
          <div>
            <div class="capacity">
              Small and large groups* · Terrace &amp; Secret Garden
            </div>
            <h3>Birthdays, anniversaries, and everything worth marking</h3>
            <p>
              Smaller private parties are hosted across the Terrace and Secret Garden,
              with a shared canapé and wine service or a full sit-down menu, depending on
              the night.
            </p>
            <ul>
              <li>Flexible group sizes</li>
              <li>Canapé and sharing menus available</li>
              <li>Flexible timing, including late sittings</li>
              <li>Secret Garden open for warmer months</li>
            </ul>
            <div class="actions">
              <a href="/celebrations" class="button button-gradient">
                <span>Explore celebrations</span>
                <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
                  <path
                    d="M1 5h11M8.5 1.5 12 5 8.5 8.5"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </div>
          <div class="arch arch-tab">
            <Photo
              src="celebrations/tea-pour"
              sizes="(max-width: 980px) 100vw, 50vw"
              alt="A guest pouring tea at an outdoor garden celebration"
            />
          </div>
        </div>
      </div>
      <p style="font-size: 11px; color: rgba(239, 231, 212, 0.4); margin-top: 20px">
        *Capacity figures are placeholders — they will be confirmed with Bacchus before we
        go live.
      </p>
    </div>
  </section>

  <section class="section-padding gallery" id="gallery">
    <div class="wrap">
      <div class="head-row">
        <div>
          <div class="eyebrow" data-reveal>
            Across the estate
          </div>
          <h2 data-reveal style="--d: 80ms">
            An evening, in <em>ten</em> frames
          </h2>
        </div>
        <p
          class="lead"
          data-reveal
          style="--d: 160ms; max-width: 34ch; padding-bottom: 8px"
        >
          Drag, swipe or use the arrows — or see every photograph in the{" "}
          <a href="/gallery" class="link-underline-inline">
            gallery
          </a>
          .
        </p>
      </div>
    </div>
    <PhotoCarousel slides={carouselSlides} />
  </section>
  <section class="section-padding on-dark" id="menu">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow" data-reveal>
          From the kitchen
        </div>
        <h2 data-reveal style="--d: 80ms">
          A taste of <em>the table</em>
        </h2>
        <p class="lead" data-reveal style="--d: 160ms; margin-top: 22px">
          Mediterranean cooking built around what's landed and what's in season, plated
          the way it's always been at Bacchus.
        </p>
      </div>
      <div class="dishes">
        <article class="dish" data-reveal style="--d: 0ms">
          <div class="arch arch-dish">
            <span class="course-number">I</span>
            <Photo
              src="food-and-drink/seabass"
              sizes="(max-width: 980px) 100vw, 33vw"
              alt="Pan-seared fish with vegetables, plated"
            />
          </div>
          <h4>Seared catch of the day</h4>
          <p>Spring vegetables, light pea purée, salsa verde.</p>
        </article>
        <article class="dish" data-reveal style="--d: 130ms">
          <div class="arch arch-dish">
            <span class="course-number">II</span>
            <Photo
              src="food-and-drink/lamb"
              sizes="(max-width: 980px) 100vw, 33vw"
              alt="Slow-cooked lamb with beetroot and citrus"
            />
          </div>
          <h4>Slow-cooked lamb</h4>
          <p>Pistachio crust, beetroot and orange.</p>
        </article>
        <article class="dish" data-reveal style="--d: 260ms">
          <div class="arch arch-dish">
            <span class="course-number">III</span>
            <Photo
              src="food-and-drink/canapes-tray"
              sizes="(max-width: 980px) 100vw, 33vw"
              alt="A tray of canapés being served"
            />
          </div>
          <h4>Canapés, passed and shared</h4>
          <p>Built for standing receptions and drinks.</p>
        </article>
      </div>
      <div
        class="cta-row"
        data-reveal
        style="--d: 340ms; margin-top: clamp(38px, 5vw, 58px)"
      >
        <a href="#enquire" class="button button-light">
          <span>Request the full menus</span>
          <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
            <path
              d="M1 5h11M8.5 1.5 12 5 8.5 8.5"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </div>
  </section>
  <Testimonials backgroundImage="venue/ballroom-night" />
  <EnquirySection
    eventType="Wedding"
    railPhoto={{
      src: "venue/terrace-celebration-reception",
      alt: "Guests gathered on the Terrace at Bacchus during a reception",
      caption: "The Terrace, set for an evening reception.",
    }}
  >
    <Fragment slot="heading">
      Tell us about your <em>event</em>
    </Fragment>
    <Fragment slot="lead">
      Four short steps. We come back with dates, pricing and a proposal shaped to your
      event — before we ever get on the phone.
    </Fragment>
  </EnquirySection>
  <WaitlistPopover slot="after-footer" />
  <script>
    import "../scripts/tabs.js"
    import "../scripts/home.js"
  </script>
</BaseLayout>

<style>
  /* Scoped to this page (moved from global.css by
     scripts/scope-styles.mjs). See FaqSection.astro for how scoping works. */
  .story p {
    font-family: "Newsreader", Georgia, serif;
  }
  .button-light {
    /* Filled (not outline) at rest, at reduced opacity — hover intensifies to
       full solid rather than dropping to transparent. --bd matches --bg so
       the border reads as part of the fill, not a separate outline. Used for
       non-hero secondary CTAs on dark backgrounds (the hero's own secondary
       CTA uses the real .button-ghost below instead). */
    --bg: rgba(var(--limestone-rgb), 0.88);
    --fg: var(--ink);
    --bd: rgba(var(--limestone-rgb), 0.88);
    --bg-h: var(--limestone);
    --fg-h: var(--ink);
  }
  .portcullis {
    position: absolute;
    inset: 0;
    z-index: 25;
    display: flex;
    pointer-events: none;
  }
  .portcullis .bar {
    flex: 1;
    background: linear-gradient(180deg, #2c2820 0%, #14120d 100%);
    border-left: 1px solid rgba(0, 0, 0, 0.4);
    border-right: 1px solid rgba(var(--bronze-rgb), 0.2);
    transform: translateY(0%);
    animation: rise 1.05s cubic-bezier(0.7, 0, 0.2, 1) forwards;
  }
  .portcullis .bar:nth-child(1) {
    animation-delay: 0.1s;
  }
  .portcullis .bar:nth-child(2) {
    animation-delay: 0.18s;
  }
  .portcullis .bar:nth-child(3) {
    animation-delay: 0.26s;
  }
  .portcullis .bar:nth-child(4) {
    animation-delay: 0.34s;
  }
  .portcullis .bar:nth-child(5) {
    animation-delay: 0.42s;
  }
  .portcullis .bar:nth-child(6) {
    animation-delay: 0.5s;
  }
  .portcullis .bar:nth-child(7) {
    animation-delay: 0.58s;
  }
  .portcullis .bar:nth-child(8) {
    animation-delay: 0.66s;
  }
  @media (prefers-reduced-motion: reduce) {
    .portcullis .bar {
      animation: none;
      transform: translateY(-115%);
    }
  }
  :global(.hero) .kicker {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--gold-2);
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin-top: 24px;
    margin-bottom: 24px;
  }
  .hero-text-mask {
    display: block;
    overflow: hidden;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .scroll-cue {
    position: absolute;
    right: clamp(20px, 5vw, 44px);
    bottom: clamp(58px, 9vh, 104px);
    z-index: 4;
    writing-mode: vertical-rl;
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .scroll-cue i {
    display: block;
    width: 1px;
    height: 64px;
    background: linear-gradient(180deg, var(--gold), transparent);
    animation: cue 2.2s var(--ease-io) infinite;
  }
  .marquee {
    background: var(--ink);
    color: var(--limestone);
    padding: 16px 0;
    overflow: hidden;
    border-top: 1px solid rgba(var(--gold-rgb), 0.2);
    border-bottom: 1px solid rgba(var(--gold-rgb), 0.2);
  }
  .marquee-track {
    display: flex;
    gap: 0;
    width: max-content;
    animation: slide 38s linear infinite;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  .story {
    background: linear-gradient(180deg, var(--paper), #f3eddf);
  }
  .story p {
    color: var(--muted-ink);
    margin-bottom: 18px;
    max-width: 52ch;
  }
  @media (max-width: 900px) {
    .story p {
      max-width: none;
    }
  }
  /* Below ~900px, .section-head's own max-width (760px, or #events's/.story's
     column width once narrower than that) is already doing the narrowing —
     the extra 52ch cap on top of it just makes the paragraph noticeably
     narrower than the heading above it instead of matching it. Placed after
     the base rule above, not before (CLAUDE.md bug #2: same selector, same
     specificity — source order decides). */
  .facts {
    display: flex;
    gap: clamp(20px, 4vw, 48px);
    margin-top: 38px;
    flex-wrap: wrap;
  }
  .facts .fact-number {
    font-family: "Fraunces", serif;
    font-size: clamp(30px, 4.4vw, 50px);
    color: var(--ink);
    display: block;
    line-height: 1;
  }
  .facts .label {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bronze);
    margin-top: 10px;
    display: block;
  }
  :global(.on-dark) .facts .fact-number {
    color: var(--limestone-2);
  }
  .story-visual {
    position: relative;
  }
  .story-visual .badge {
    position: absolute;
    bottom: -26px;
    left: -26px;
    background: var(--ink);
    color: var(--limestone);
    padding: clamp(16px, 3.5vw, 22px) clamp(18px, 4.5vw, 26px);
    border-radius: 3px;
    border: 1px solid rgba(var(--gold-rgb), 0.3);
    max-width: clamp(150px, 34vw, 230px);
    box-shadow: 0 26px 60px -24px rgba(var(--muted-ink-rgb), 0.6);
  }
  /* Scales with the badge's own padding/max-width above (clamp, not fixed
     34px) — needed now that .story-visual goes full-width at 760px and below
     instead of staying capped at 440px, so the badge itself must shrink to
     match a much smaller image instead of overwhelming it. */
  .story-visual .badge .badge-number {
    font-family: "Fraunces", serif;
    font-size: clamp(24px, 6vw, 34px);
    color: var(--gold-2);
    line-height: 1;
  }
  .story-visual .badge .badge-caption {
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 8px;
  }
  @media (max-width: 760.98px) {
    .story-visual {
      order: -1;
    }
  }
  /* Previously overhung past the image's own edge (right:-6px;
       bottom:-20px) — fine while .story-visual was capped at 440px, well
       clear of the wrap's own edge, but now that the image is full-width
       here, that same overhang tracks the image's edge straight out to the
       wrap padding, landing within a few px of the actual screen edge on a
       narrow phone. Inset instead, so it sits inside the image regardless of
       how much wrap padding there is. */
  @media (max-width: 760.98px) {
    .story-visual .badge {
      left: auto;
      right: 20px;
      bottom: 20px;
    }
  }
  /* Fully-rounds a .tab-bar (bar, buttons, active pill) instead of the
     plain 3px-radius default — actually brings it in line with the design
     system's own pill-shaped-buttons rule better than that default did.
     Originally built for the Reception Menus sandbox
     (sandboxes/reception-package.html, née reception-menus.html before it was
