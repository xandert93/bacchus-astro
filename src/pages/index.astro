                    <b>Candlelit &amp; ceremonial</b
                    ><span>Long tables, warm light and a slow evening.</span>
                  </button>
                  <button
                    type="button"
                    class="option-card"
                    data-v="Garden &amp; golden hour"
                  >
                    <b>Garden &amp; golden hour</b
                    ><span>Open air, relaxed drinks and sunset portraits.</span>
                  </button>
                  <button
                    type="button"
                    class="option-card"
                    data-v="Formal &amp; refined"
                  >
                    <b>Formal &amp; refined</b
                    ><span>A seated service with considered timing.</span>
                  </button>
