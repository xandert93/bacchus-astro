---
// The homepage. Everything shared with other pages (nav, drawer, Visit
// section, footer, script) comes from BaseLayout; this file holds only what
// is unique to the homepage.
import BaseLayout from "../layouts/BaseLayout.astro";
import EnquirySection from "../components/EnquirySection.astro";
import Testimonials from "../components/Testimonials.astro";
import WaitlistPopover from "../components/WaitlistPopover.astro";
---

<BaseLayout title="Bacchus — Events in Mdina, Malta" showEnquireLink>
  <section class="hero" id="top">
    <div class="hero-media">
      <img
        id="heroImg"
        src="/images/shared/ballroom-night.webp"
        alt="The Bacchus function room lit for an evening reception, with chandeliers and candlelight"
      />
    </div>
    <div class="hero-scrim"></div>
    <div class="particles" id="particles"></div>
    <div class="portcullis">
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
      <div class="bar"></div>
    </div>
    <div class="hero-content">
      <div class="wrap">
        <h1>
          <span class="hero-text-mask">
            <span style="transition-delay: 1.55s">The Silent City</span>
          </span>
          <span class="hero-text-mask">
            <span style="transition-delay: 1.72s">
              keeps <em>one</em> table
            </span>
          </span>
        </h1>
        <p class="sub fade-up" style="transition-delay: 1.95s">
          Two vaulted 17th-century chambers hold our restaurant table, while weddings and
          private events unfold separately across the Hall, Terrace and Secret Garden.
        </p>
        <div class="kicker fade-up" style="transition-delay: 2.15s">
          Mdina, Malta — within the walls since 1660
        </div>
        <div class="hero-ctas fade-up" style="transition-delay: 2.32s">
          <a href="#enquire" class="button button-gradient button-shimmer">
            <span>Plan your event</span>
            <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
              <path
                d="M1 5h11M8.5 1.5 12 5 8.5 8.5"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
          <a href="/gallery" class="button button-ghost">
            <span>See the rooms</span>
          </a>
        </div>
      </div>
    </div>
    <div class="scroll-cue">
      Scroll<i></i>
    </div>
  </section>
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track" id="mtrack">
      <span>Weddings</span>
      <span>Corporate dinners</span>
      <span>Private celebrations</span> <span>Garden receptions</span>
      <span>Maltese wine list</span>
      <span>Bastion views</span>
    </div>
  </div>
  <section class="section-padding story" id="story">
    <div class="wrap grid">
      <div>
        <div class="eyebrow" data-reveal>
          A chamber built for gunpowder, kept for the table
        </div>
        <h2 data-reveal style="--d: 80ms">
          Built in 1657, still standing <em>guard</em> over dinner
        </h2>
        <p data-reveal style="--d: 180ms; margin-top: 28px">
          Grand Master Fra Martino de Redin raised these chambers between 1657 and 1660 as
          a magazine for Mdina's bastion walls. Where the city once stored its defence,
          Bacchus now keeps its cellar, its kitchen, and its longest tables.
        </p>
        <p data-reveal style="--d: 250ms">
          Guests still enter through the original iron portcullis before the stone opens
          into two vaulted rooms and a garden beyond — unchanged in shape for over 360
          years.
        </p>
        <div class="facts" id="facts">
          <div data-reveal style="--d: 320ms">
            <span class="fact-number" data-count="1657" data-plain="1">
              0
            </span>
            <span class="label">Chambers built</span>
          </div>
          <div data-reveal style="--d: 400ms">
            <span class="fact-number" data-count="2">
              0
            </span>
            <span class="label">Vaulted rooms</span>
          </div>
          <div data-reveal style="--d: 480ms">
            <span class="fact-number" data-count="35" data-suffix="+">
              0
            </span>
            <span class="label">Years serving Mdina</span>
          </div>
        </div>
        <div class="cta-row" data-reveal style="--d: 560ms; margin-top: 40px">
          <a href="#events" class="button button-dark">
            <span>Explore the spaces</span>
            <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
              <path
                d="M1 5h11M8.5 1.5 12 5 8.5 8.5"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
      </div>
      <div class="story-visual">
        <div class="arch" data-reveal="img">
          <img
            src="/images/shared/mdina-bastion-view.webp"
            alt="A view along Mdina's bastion walls, looking out over the Maltese countryside"
          />
        </div>
        <div class="badge" data-reveal="scale" style="--d: 400ms">
          <div class="badge-number">
            360<span style="font-size: 0.55em">yrs</span>
          </div>
          <div class="badge-caption">Of the same stone, the same arches</div>
        </div>
      </div>
    </div>
  </section>
  <section class="section-padding on-dark" id="events">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow" data-reveal>
          Weddings · Corporate · Celebrations
        </div>
        <h2 data-reveal style="--d: 80ms">
          One venue, three ways to <em>gather</em>
        </h2>
        <p class="lead" data-reveal style="--d: 170ms; margin-top: 22px">
          Each occasion gets its own room and its own plan — not a shared form. Choose
          below to see how we'd shape your event, or open the full page for each.
        </p>
      </div>

      <div class="tab-bar tabs-bar" role="tablist" data-reveal style="--d: 220ms">
        <span class="pill" id="pill"></span>
        <button class="active" data-tab="weddings" role="tab" aria-selected="true">
          Weddings
        </button>
        <button data-tab="corporate" role="tab" aria-selected="false">
          Corporate
        </button>
        <button data-tab="celebrations" role="tab" aria-selected="false">
          Celebrations
        </button>
      </div>

      <div class="panels" data-reveal style="--d: 300ms">
        <div class="tab-panel active" data-panel="weddings">
          <div>
            <div class="capacity">Up to 120 seated* · Secret Garden included</div>
            <h3>Married in the Prince De Redin Hall</h3>
            <p>
              The banquet hall hosts your wedding breakfast, with the Secret Garden held
              for the ceremony, drinks and photographs — part of the same 17th-century
              estate as the restaurant next door.
            </p>
            <ul>
              <li>Private hire of the Hall, Terrace and Secret Garden</li>
              <li>Set or bespoke menus, tasted in advance</li>
              <li>In-house wine list, sourced from Maltese producers</li>
              <li>
                One wedding a day — a dedicated Events Manager from your first visit
              </li>
            </ul>
            <div class="actions">
              <a href="/weddings" class="button button-gradient">
                <span>Explore weddings</span>
                <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
                  <path
                    d="M1 5h11M8.5 1.5 12 5 8.5 8.5"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </div>
          <div class="arch arch-tab">
            <img
              src="/images/weddings/toast.webp"
              alt="A bride and groom clinking champagne glasses"
            />
          </div>
        </div>

        <div class="tab-panel" data-panel="corporate">
          <div>
            <div class="capacity">Capacity on request*</div>
            <h3>A boardroom with better acoustics</h3>
            <p>
              For product launches, dinners and year-end gatherings, our function room
              adapts to theatre-style or a seated dinner layout.
            </p>
            <ul>
              <li>AV, staging and lighting included</li>
              <li>Private bar and a dedicated event manager</li>
              <li>Daytime and evening hire available</li>
              <li>Set within a 4500m² estate inside Mdina's walls</li>
            </ul>
            <div class="actions">
              <a href="/corporate" class="button button-gradient">
                <span>Explore corporate</span>
                <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
                  <path
                    d="M1 5h11M8.5 1.5 12 5 8.5 8.5"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </div>
          <div class="arch arch-tab">
            <img
              src="/images/corporate/guests-chatting.webp"
              alt="Colleagues chatting at a corporate event with laptops on the table"
            />
          </div>
        </div>

        <div class="tab-panel" data-panel="celebrations">
          <div>
            <div class="capacity">
              Small and large groups* · Terrace &amp; Secret Garden
            </div>
            <h3>Birthdays, anniversaries, and everything worth marking</h3>
            <p>
              Smaller private parties are hosted across the Terrace and Secret Garden,
              with a shared canapé and wine service or a full sit-down menu, depending on
              the night.
            </p>
            <ul>
              <li>Flexible group sizes</li>
              <li>Canapé and sharing menus available</li>
              <li>Flexible timing, including late sittings</li>
              <li>Secret Garden open for warmer months</li>
            </ul>
            <div class="actions">
              <a href="/celebrations" class="button button-gradient">
                <span>Explore celebrations</span>
                <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
                  <path
                    d="M1 5h11M8.5 1.5 12 5 8.5 8.5"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </div>
          <div class="arch arch-tab">
            <img
              src="/images/celebrations/tea-pour.webp"
              alt="A guest pouring tea at an outdoor garden celebration"
            />
          </div>
        </div>
      </div>
      <p style="font-size: 11px; color: rgba(239, 231, 212, 0.4); margin-top: 20px">
        *Capacity figures are placeholders — they will be confirmed with Bacchus before we
        go live.
      </p>
    </div>
  </section>

  <section class="section-padding gallery" id="gallery">
    <div class="wrap">
      <div class="head-row">
        <div>
          <div class="eyebrow" data-reveal>
            Across the estate
          </div>
          <h2 data-reveal style="--d: 80ms">
            An evening, in <em>ten</em> frames
          </h2>
        </div>
        <p
          class="lead"
          data-reveal
          style="--d: 160ms; max-width: 34ch; padding-bottom: 8px"
        >
          Drag, swipe or use the arrows — or see every photograph in the
          <a href="/gallery" class="link-underline-inline">
            view gallery
          </a>
          .
        </p>
      </div>
    </div>
    <div class="wrap carousel-section">
      <div class="carousel-view" id="carView">
        <div class="carousel-track" id="carTrack">
          <figure class="slide">
            <div class="ph">
              <img
                src="/images/shared/hall-chandeliers-banquet.webp"
                alt="The banquet room dressed with chair sashes and long tables"
                decoding="async"
              />
            </div>
            <figcaption class="carousel-caption">
              <b>The Banquet Room</b>
              <i>1</i>
            </figcaption>
          </figure>
          <figure class="slide">
            <div class="ph">
              <img
                src="/images/shared/ballroom-night.webp"
                alt="The function room lit for an evening reception"
                decoding="async"
              />
            </div>
            <figcaption class="carousel-caption">
              <b>Reception, After Dark</b>
              <i>2</i>
            </figcaption>
          </figure>
          <figure class="slide">
            <div class="ph">
              <img
                src="/images/weddings/toast.webp"
                alt="A bride and groom clinking champagne glasses"
                decoding="async"
              />
            </div>
            <figcaption class="carousel-caption">
              <b>The First Toast</b>
              <i>3</i>
            </figcaption>
          </figure>
          <figure class="slide">
            <div class="ph">
              <img
                src="/images/weddings/oysters.webp"
                alt="A tray of oysters served to guests at a wedding"
                decoding="async"
              />
            </div>
            <figcaption class="carousel-caption">
              <b>Oysters, On Ice</b>
              <i>4</i>
            </figcaption>
          </figure>
          <figure class="slide">
            <div class="ph">
              <img
                src="/images/weddings/cake-chandelier.webp"
                alt="A tiered wedding cake beneath a crystal chandelier"
                decoding="async"
              />
            </div>
            <figcaption class="carousel-caption">
              <b>The Cake, Under Crystal</b>
              <i>5</i>
            </figcaption>
          </figure>
          <figure class="slide">
            <div class="ph">
              <img
                src="/images/celebrations/tea-pour.webp"
                alt="A guest pouring tea at an outdoor garden celebration"
                decoding="async"
              />
            </div>
            <figcaption class="carousel-caption">
              <b>An Afternoon in the Garden</b>
              <i>6</i>
            </figcaption>
          </figure>
          <figure class="slide">
            <div class="ph">
              <img
                src="/images/celebrations/friends.webp"
                alt="Friends embracing at a long outdoor table"
                decoding="async"
              />
            </div>
            <figcaption class="carousel-caption">
              <b>Old Friends, Long Table</b>
              <i>7</i>
            </figcaption>
          </figure>
          <figure class="slide">
            <div class="ph">
              <img
                src="/images/corporate/guests-chatting.webp"
                alt="Colleagues chatting at a corporate event"
                decoding="async"
              />
            </div>
            <figcaption class="carousel-caption">
              <b>Business, Unhurried</b>
              <i>8</i>
            </figcaption>
          </figure>
          <figure class="slide">
            <div class="ph">
              <img
                src="/images/corporate/champagne-service.webp"
                alt="A waiter serving champagne to a guest in business attire"
                decoding="async"
              />
            </div>
            <figcaption class="carousel-caption">
              <b>Champagne on Arrival</b>
              <i>9</i>
            </figcaption>
          </figure>
          <figure class="slide">
            <div class="ph">
              <img
                src="/images/shared/canapes-tray.webp"
                alt="A tray of canapés"
                decoding="async"
              />
            </div>
            <figcaption class="carousel-caption">
              <b>The Reception Tray</b>
              <i>10</i>
            </figcaption>
          </figure>
        </div>
      </div>
      <div class="carousel-controls">
        <button class="carousel-button" id="prev" aria-label="Previous">
          <svg width="16" height="12" viewBox="0 0 14 10" fill="none">
            <path
              d="M13 5H2m3.5-3.5L2 5l3.5 3.5"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
        <button class="carousel-button" id="next" aria-label="Next">
          <svg width="16" height="12" viewBox="0 0 14 10" fill="none">
            <path
              d="M1 5h11M8.5 1.5 12 5 8.5 8.5"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
        <div class="carousel-progress-bar">
          <i id="carBar"></i>
        </div>
        <div class="carousel-count">
          <span id="carNow">1</span> / <span id="carTotal">10</span>
        </div>
      </div>
    </div>
  </section>
  <section class="section-padding on-dark" id="menu">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow" data-reveal>
          From the kitchen
        </div>
        <h2 data-reveal style="--d: 80ms">
          A taste of <em>the table</em>
        </h2>
        <p class="lead" data-reveal style="--d: 160ms; margin-top: 22px">
          Mediterranean cooking built around what's landed and what's in season, plated
          the way it's always been at Bacchus.
        </p>
      </div>
      <div class="dishes">
        <article class="dish" data-reveal style="--d: 0ms">
          <div class="arch arch-dish">
            <span class="course-number">I</span>
            <img
              src="/images/shared/seabass.jpg"
              alt="Pan-seared fish with vegetables, plated"
            />
          </div>
          <h4>Seared catch of the day</h4>
          <p>Spring vegetables, light pea purée, salsa verde.</p>
        </article>
        <article class="dish" data-reveal style="--d: 130ms">
          <div class="arch arch-dish">
            <span class="course-number">II</span>
            <img
              src="/images/shared/lamb.jpg"
              alt="Slow-cooked lamb with beetroot and citrus"
            />
          </div>
          <h4>Slow-cooked lamb</h4>
          <p>Pistachio crust, beetroot and orange.</p>
        </article>
        <article class="dish" data-reveal style="--d: 260ms">
          <div class="arch arch-dish">
            <span class="course-number">III</span>
            <img
              src="/images/shared/canapes-tray.webp"
              alt="A tray of canapés being served"
            />
          </div>
          <h4>Canapés, passed and shared</h4>
          <p>Built for standing receptions and drinks.</p>
        </article>
      </div>
      <div
        class="cta-row"
        data-reveal
        style="--d: 340ms; margin-top: clamp(38px, 5vw, 58px)"
      >
        <a href="#enquire" class="button button-light">
          <span>Request the full menus</span>
          <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
            <path
              d="M1 5h11M8.5 1.5 12 5 8.5 8.5"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </div>
  </section>
  <Testimonials backgroundImage="/images/shared/ballroom-night.webp" />
  <EnquirySection
    eventType="Wedding"
    railPhoto={{
      src: "/images/shared/terrace-celebration-reception.webp",
      alt: "Guests gathered on the Terrace at Bacchus during a reception",
      caption: "The Terrace, set for an evening reception.",
    }}
  >
    <Fragment slot="heading">
      Tell us about your <em>event</em>
    </Fragment>
    <Fragment slot="lead">
      Four short steps. We come back with dates, pricing and a proposal shaped to your
      event — before we ever get on the phone.
    </Fragment>
  </EnquirySection>
  <WaitlistPopover slot="after-footer" />
</BaseLayout>
