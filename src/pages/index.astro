---
// The homepage. Everything shared with other pages (nav, drawer, Visit
// section, footer, script) comes from BaseLayout; this file holds only what
// is unique to the homepage.
import BaseLayout from "@layouts/BaseLayout.astro"
import HomeHero from "@components/home/HomeHero.astro"
import HomeMarquee from "@components/home/HomeMarquee.astro"
import HomeStory from "@components/home/HomeStory.astro"
import HomeEventsSection from "@components/home/HomeEventsSection.astro"
import HomeGallerySection from "@components/home/HomeGallerySection.astro"
import HomeKitchenSection from "@components/home/HomeKitchenSection.astro"
import Testimonials from "@components/sections/Testimonials.astro"
import EnquirySection from "@components/enquiry/EnquirySection.astro"
import WaitlistPopover from "@components/enquiry/WaitlistPopover.astro"
---

<BaseLayout
  title="Bacchus — Events in Mdina, Malta"
  description="Weddings, celebrations and corporate events on a 17th-century estate within Mdina's walls, with our restaurant in two vaulted stone chambers below."
  describesVenue
  showEnquireLink
>
  <HomeHero />
  <HomeMarquee />
  <HomeStory />
  <HomeEventsSection />
  <HomeGallerySection />
  <HomeKitchenSection />
  <Testimonials backgroundImage="venue/ballroom-night" />
  <EnquirySection
    eventType="Wedding"
    railPhoto={{
      src: "venue/terrace-celebration-reception",
      alt: "Guests gathered on the Terrace at Bacchus during a reception",
      caption: "The Terrace, set for an evening reception.",
    }}
  >
    <Fragment slot="heading">
      Tell us about your <em>event</em>
    </Fragment>
    <Fragment slot="lead">
      Four short steps. We come back with dates, pricing and a proposal shaped to your
      event — before we ever get on the phone.
    </Fragment>
  </EnquirySection>
  <WaitlistPopover slot="after-footer" />
</BaseLayout>
