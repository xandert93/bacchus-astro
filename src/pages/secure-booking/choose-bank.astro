---
// /secure-booking/choose-bank: where "Pay by bank" goes while Enable Banking
// takes it (src/lib/payments/checkout.ts). Laid out like Stripe's own: a
// country dropdown, then that country's banks as logo tiles. Choosing one
// starts the payment and sends the couple to their bank to approve it; their
// bank sends them back to the deposit page. Nothing but the loading ring
// shows until the banks have loaded, so no country appears and then vanishes.
//
// The bank tiles are selection controls, like the enquiry form's option
// cards, not action pills, so they're plain buttons rather than <Button>
// (the "every button is <Button>" rule is for actions).
import BaseLayout from "@layouts/BaseLayout.astro"
import Button from "@components/ui/Button.astro"
import CheckoutCard from "@components/secure-booking/CheckoutCard.astro"
import FormField from "@components/forms/FormField.astro"
import LoadingRing from "@components/ui/LoadingRing.astro"
import SecureCheckoutBadge from "@components/secure-booking/SecureCheckoutBadge.astro"
import "../_secure-booking.css"
---

<BaseLayout
  title="Choose Your Bank — Bacchus, Mdina"
  description="Choose the bank to pay your deposit from."
  checkout
  noIndex
  showVisitSection={false}
>
  <SecureCheckoutBadge slot="header" />

  <CheckoutCard id="chooseBank">
    <p class="secure-booking-eyebrow-plain">Pay by bank</p>
    <h2>Choose your bank</h2>
    <p>
      You'll approve the payment in your bank's own app or website. Bacchus never sees
      your banking details.
    </p>

    <div class="choose-bank-loading" id="chooseBankLoading">
      <LoadingRing label="Loading the banks" size={28} />
    </div>

    <div class="choose-bank-picker" id="chooseBankPicker" hidden>
      <FormField label="Country" for="chooseBankCountry">
        {/* Filled by the script with the countries that have banks. */}
        <select id="chooseBankCountry"></select>
      </FormField>

      <p class="choose-bank-label">Select your bank</p>
      <ul class="choose-bank-tiles" id="chooseBankTiles"></ul>
    </div>

    {/* Copied by the script for each bank. */}
    <template id="chooseBankTile">
      <li>
        <button type="button" class="choose-bank-tile">
          <img class="choose-bank-logo" alt="" loading="lazy" />
          <span data-bank-name></span>
        </button>
      </li>
    </template>

    <p class="secure-booking-pay-error" id="chooseBankError" role="alert" hidden></p>

    <div class="secure-booking-button-row">
      <Button variant="dark" id="chooseBankBack">
        <span>My bank isn't listed</span>
      </Button>
    </div>
  </CheckoutCard>
</BaseLayout>

<script>
  import "./_choose-bank.js"
</script>

<style>
  .choose-bank-loading {
    display: flex;
    justify-content: center;
    padding: 32px 0 8px;
  }

  .choose-bank-picker {
    margin-top: 28px;
  }

  .choose-bank-label {
    margin: 24px 0 10px;

    font-family: "Inter", sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
  }

  .choose-bank-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 140px), 1fr));
    gap: 10px;
    list-style: none;
  }

  /* Cloned from the template by the script, so without this file's scoping
     attribute: hence :global(). */
  .choose-bank-tiles :global(.choose-bank-tile) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 104px;
    padding: 16px 12px;
    border: 1px solid rgba(var(--ink-rgb), 0.12);
    border-radius: var(--radius-card);
    background: #fff;

    font-family: "Inter", sans-serif;
    font-size: 13px;
    line-height: 1.3;
    color: var(--ink);
    text-align: center;
    cursor: pointer;
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  @media (--hover) {
    .choose-bank-tiles :global(.choose-bank-tile:hover) {
      border-color: rgba(var(--gold-rgb), 0.6);
      box-shadow: 0 12px 30px -18px rgba(var(--ink-rgb), 0.35);
    }
  }

  .choose-bank-tiles :global(.choose-bank-tile:focus-visible) {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .choose-bank-tiles :global(.choose-bank-tile:disabled) {
    opacity: 0.5;
    cursor: progress;
  }

  .choose-bank-tiles :global(.choose-bank-logo) {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }
</style>
