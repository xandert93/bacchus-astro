---
// The Beverage package page - the fourth and last of the wedding package
// pages, and the only one that is NOT a meal format. Reception, Banquet and
// High Tea are three mutually exclusive ways to feed a wedding; Beverage is
// additive, chosen alongside whichever of those three a couple picks. The
// page says that outright in its hero and lead, because the whole packages
// section on weddings.html is built around that distinction.
//
// Structure differs from its three siblings for the same reason. It has FOUR
// categories (Local Wine / Foreign Wine / Bar Options / Themed Bars), not
// three ranked tiers, and they are not alternatives to each other - a wedding
// can take a wine package AND an open bar AND a themed bar. So:
// - the tier switcher is reused as-is, but the card grid is a 2x2 (four
// cards across one row would squeeze each description below a readable
// measure, and a 3+1 wrap reads as a mistake);
// - there is NO .package-sticky-switch. That control sizes its buttons
// flex:1 on mobile and was measured against three short tier names; four
// categories, the longest being "Themed Bars", leave roughly 80px each
// and would overflow (CLAUDE.md bug #13). The tab bar and the cards both
// already switch categories, so nothing is lost, and the switcher JS
// guards for its absence;
// - .package-menu-groups drops to two columns, because each wine carries a
// tasting note that a third of the wrap can't give a readable measure;
// - wines render as name / grape + producer / tasting note rather than a
// single line (.package-wine-*).
//
// Pricing: the catalogue carries NO prices at all. The figures shown come
// from the quote Bacchus shared - EUR 30 and 35 per person for the wine
// packages, EUR 23 and 12 for the full and reduced open bars - and a
// .package-menu-note-warning callout under the cards says so, plus notes that
// Bacchus generates pricing internally and varies it by season. The corkage
// figure from that quote is deliberately NOT published: the quote gives an
// amount without saying whether it is per bottle or per person, and guessing
// a unit on a chargeable fee is worse than omitting it. The callout says that
// too.
//
// NO placeholder dish tiles on this page, unlike banquet-package.html and
// high-tea-package.html. Those two carry three blacked-out
// .package-dish-placeholder tiles per tier standing in for dish photography;
// a drinks page has no equivalent - "signature dishes" is the wrong frame for
// a wine list, and there is no per-item photography to stand in for. The hero
// is blacked out the same way the siblings' are, and the carousel further
// down uses real generic Bacchus photography, labelled as such in its lead.
//
// Content comes from the rendered catalogue pages, not from extracted text -
// an automated text pull of that PDF silently drops accents and whole words
// ("Gavi Di Gavi" vanished from one wine name, "Gordon's Gin" from the spirit
// list). Do not rebuild these lists from a text extraction.
//
// House-style normalisations applied, same convention as the sibling pages,
// listed so the client can confirm or reverse them: "Rosmary" to "Rosemary",
// "Pina Colada" given its tilde, "Saint-Emilion" and
// "Chateau" given their accents, "Shiraz Rose" and "Sancerre Rose" given
// theirs, "characterized" to "characterised". Two catalogue oddities were
// left exactly as printed rather than corrected, since both could be
// deliberate: "Terre Antich" (probably Terre Antiche) and "Henessey"
// (probably Hennessy). Also left as printed: the Whiskey and Rum bars are
// captioned "service of five" but list six each, which reads naturally as
// choosing five from six - worth confirming, not worth silently editing.
//
// Deliberately omitted on request: the catalogue's "After Mass Reception"
// offering, which needs the client before it can be published.
//
import BaseLayout from "@layouts/BaseLayout.astro"
import { BEVERAGE_TIERS } from "@data/packages/beverage"
import PackageTierSection from "@components/packages/PackageTierSection.astro"
import PackageMenuNote from "@components/packages/PackageMenuNote.astro"
import PageHero from "@components/sections/PageHero.astro"
import EnquirySection from "@components/enquiry/EnquirySection.astro"
import WaitlistPopover from "@components/enquiry/WaitlistPopover.astro"
import ArrowIcon from "@components/ui/ArrowIcon.astro"
import PhotoCarousel from "@components/sections/PhotoCarousel.astro"
// After BaseLayout, so these load after global.css (see package-page.css).
import "@styles/package-page.css"
import "@styles/package-beverage.css"

// The "closer look" photo strip.
const carouselSlides = [
  {
    src: "weddings/toast",
    alt: "Guests raising glasses in a toast at a Bacchus wedding",
    caption: "A Toast, Raised",
  },
  {
    src: "venue/terrace-celebration-reception",
    alt: "Guests mingling at a Bacchus wedding reception on the Terrace",
    caption: "Guests, On the Terrace",
  },
  {
    src: "food-and-drink/champagne",
    alt: "A guest raising a glass of sparkling wine at a dressed table",
    caption: "A Toast, On Arrival",
  },
  {
    src: "venue/terrace-marquee-tables",
    alt: "Tables dressed under a marquee on the Terrace",
    caption: "The Terrace, Dressed",
  },
  {
    src: "venue/secret-garden-night",
    alt: "A long candlelit table in the Secret Garden at night",
    caption: "The Secret Garden, By Night",
  },
]
---

<BaseLayout
  title="Our Beverage Menus — Bacchus"
  menuBackgroundImage="weddings/cake-chandelier"
>
  <PageHero crumb="Beverage Menus" parent={{ href: "/weddings", label: "Weddings" }}>
    Our Beverage <em>Menus</em>
    <Fragment slot="sub">
      Wine, bar and themed-bar packages — chosen alongside whichever meal format your
      wedding takes, not instead of one.
    </Fragment>
    <Fragment slot="sub-secondary">
      Four categories, each explored in full below.
    </Fragment>
    <Fragment slot="ctas">
      <a href="#enquire" class="button button-gradient button-shimmer">
        <span>Book a tasting</span>
        <ArrowIcon />
      </a>
      <a
        href="/docs/bacchus-wedding-catalogue.pdf"
        target="_blank"
        rel="noopener"
        class="button button-ghost"
      >
        <span>View the catalogue</span>
      </a>
    </Fragment>
  </PageHero>

  <PackageTierSection tiers={BEVERAGE_TIERS} stickySwitch={false}>
    <Fragment slot="heading">
      The four <em>categories</em>
    </Fragment>
    <Fragment slot="lead">
      <p class="lead">
        Unlike the meal formats, these are not ranked alternatives. Wine, bar and themed
        bars are chosen together, in whatever combination suits the day.
      </p>
      <p class="lead">
        Switch between them below — every listing is taken straight from the printed
        catalogue.
      </p>
    </Fragment>
    <Fragment slot="after-cards">
      <PackageMenuNote variant="warning">
        <p>
          <b>Beverage pricing needs confirming before this page goes live.</b>
        </p>
        <p>
          The catalogue itself carries no prices. The figures above come from a quote
          Bacchus shared &mdash; &euro;30 and &euro;35 per person for the wine packages,
          and &euro;23 and &euro;12 per person for the full and reduced open bars. Bacchus
          has said pricing is generated internally and varies by season, so treat these as
          one data point rather than a rate card.
        </p>
        <p>
          A corkage fee also applies to wines and spirits brought in. We have not
          published a figure for it here, because the quote states an amount without
          stating whether it is charged per bottle or per person.
        </p>
      </PackageMenuNote>
    </Fragment>
    <Fragment slot="after-panels">
      <PackageMenuNote>
        <p>
          Menu items may contain or come into contact with allergens — please discuss
          requirements with the Bacchus sales team.
        </p>
        <p>
          BCL is certified Halal by The World Islamic Call Society (Malta Branch). Full
          terms are in the printed catalogue.
        </p>
      </PackageMenuNote>
      <div class="package-stations-note" data-reveal style="--d: 60ms">
        <p>
          Beverage pairs with any format — see all packages on the{" "}
          <a href="/weddings#packages" class="link-underline-inline">
            Weddings page
          </a>
          .
        </p>
      </div>
    </Fragment>
  </PackageTierSection>

  {/* No .package-sticky-switch on this page, unlike its three sibling
       package pages. That control sizes its buttons with flex:1 on mobile
       and was measured against three short tier names; four categories,
       the longest being "Themed Bars", leave roughly 80px per button and
       would overflow (CLAUDE.md bug #13, same failure mode as the homepage
       tab bar). The tab bar and the card grid above already both switch
       categories, so nothing is lost. The switcher JS guards for its
       absence (if (stickySwitch)), so no script change was needed. */}

  <section class="section-padding">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow" id="closerLookEyebrow" data-reveal>
          From the Bar
        </div>
        <h2 data-reveal style="--d: 80ms">
          A closer look, in <em>five</em> frames
        </h2>
        <p class="lead" data-reveal style="--d: 160ms; margin-top: 22px">
          Drag, swipe or use the arrows. Generic Bacchus photography for now — easily
          swapped for shots of the bar itself once available.
        </p>
      </div>
    </div>
    <PhotoCarousel slides={carouselSlides} />
  </section>

  <EnquirySection
    eventType="Wedding"
    railPhoto={{
      src: "food-and-drink/champagne",
      alt: "A guest raising a glass of sparkling wine at a dressed table",
      caption: "A glass raised at a dressed table.",
    }}
  >
    <Fragment slot="heading">
      Tell us about your <em>wedding</em>
    </Fragment>
    <Fragment slot="lead">
      Four short steps. We come back with dates, pricing and a proposal shaped to your day
      — before we ever get on the phone.
    </Fragment>
  </EnquirySection>

  <WaitlistPopover slot="after-footer" />

  <script>
    import "@scripts/package-tiers.js"
  </script>
</BaseLayout>
