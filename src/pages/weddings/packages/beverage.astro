          role="tablist"
          data-reveal
          style="--d: 160ms"
        >
          <span class="pill" id="pill"></span>
          <button class="active" data-tab="local-wine" role="tab" aria-selected="true">
            Local Wine
          </button>
          <button data-tab="foreign-wine" role="tab" aria-selected="false">
            Foreign Wine
          </button>
          <button data-tab="bar-options" role="tab" aria-selected="false">
            Bar Options
          </button>
          <button data-tab="themed-bars" role="tab" aria-selected="false">
            Themed Bars
          </button>
        </div>
        <div class="package-tabs-lead" data-reveal style="--d: 220ms">
          <p class="lead">
            Unlike the meal formats, these are not ranked alternatives. Wine, bar and
            themed bars are chosen together, in whatever combination suits the day.
          </p>
          <p class="lead">
            Switch between them below — every listing is taken straight from the printed
            catalogue.
          </p>
        </div>
      </div>

      <div class="package-tier-cards" data-reveal style="--d: 280ms">
        <button
