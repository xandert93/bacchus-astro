          <b class="package-tier-card-name">Local Wine</b>
          <span class="package-tier-card-price">
            €30<span class="package-tier-card-unit">per person</span>
          </span>
          <span class="package-tier-card-desc">
            Maltese and Gozitan wines, free flow, with beer, soft drinks and juices
            alongside.
          </span>
        </button>
        <button
          type="button"
          class="package-tier-card"
          data-tier-card="foreign-wine"
          aria-pressed="false"
        >
          <span class="package-tier-card-check" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path
                d="M4 9.5l3 3 7-7.5"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="package-tier-card-eyebrow">Beverage</span>
          <b class="package-tier-card-name">Foreign Wine</b>
          <span class="package-tier-card-price">
            €35<span class="package-tier-card-unit">per person</span>
          </span>
          <span class="package-tier-card-desc">
            Italian and French wines, free flow, with beer, soft drinks and juices
            alongside.
          </span>
        </button>
        <button
          type="button"
          class="package-tier-card"
          data-tier-card="bar-options"
          aria-pressed="false"
        >
          <span class="package-tier-card-check" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path
                d="M4 9.5l3 3 7-7.5"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="package-tier-card-eyebrow">Beverage</span>
          <b class="package-tier-card-name">Bar Options</b>
          <span class="package-tier-card-price">
            from €12<span class="package-tier-card-unit">per person</span>
          </span>
          <span class="package-tier-card-desc">
            A full open bar, a reduced one, or corkage on your own wines and spirits.
          </span>
        </button>
        <button
          type="button"
          class="package-tier-card"
          data-tier-card="themed-bars"
          aria-pressed="false"
        >
          <span class="package-tier-card-check" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path
                d="M4 9.5l3 3 7-7.5"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="package-tier-card-eyebrow">Beverage</span>
