---
// /weddings/packages/banquet — the Banquet package: a six-course seated
// dinner in three tiers. The content is src/data/packages/banquet.ts.
//
// PRICING IS SHOWN WITH A WARNING, not silently resolved: the client quote
// gives €65/€85/€95, while client correspondence says banqueting starts
// around €135 per person. The warning note under the tier cards states the
// conflict. Do not remove it while the conflict is open — it is the only
// thing telling a reader the numbers above it are contested.
//
// No photography yet: the hero and the signature dishes are deliberately
// black "photo to follow" frames rather than stand-in shots, which would
// read as finished choices. Pass PageHero an image, and give the dishes
// photos in the data file, once Bacchus supplies them.
import BaseLayout from "@layouts/BaseLayout.astro"
import { BANQUET_TIERS } from "@data/packages/banquet"
import PackageTierSection from "@components/packages/PackageTierSection.astro"
import PackageMenuNote from "@components/packages/PackageMenuNote.astro"
import PageHero from "@components/sections/PageHero.astro"
import EnquirySection from "@components/enquiry/EnquirySection.astro"
import WaitlistPopover from "@components/enquiry/WaitlistPopover.astro"
import ArrowIcon from "@components/ui/ArrowIcon.astro"
import PhotoCarousel from "@components/sections/PhotoCarousel.astro"

// The "closer look" photo strip.
const carouselSlides = [
  {
    src: "food-and-drink/canapes-service",
    alt: "A waiter serving canapés at a wedding reception",
    caption: "Canapés, Passed",
  },
  {
    src: "venue/terrace-celebration-reception",
    alt: "Guests mingling at a Bacchus wedding reception on the Terrace",
    caption: "Guests, On the Terrace",
  },
  {
    src: "food-and-drink/champagne",
    alt: "A guest raising a glass of sparkling wine at a dressed table",
    caption: "A Toast, On Arrival",
  },
  {
    src: "venue/ballroom-night",
    alt: "The De Redin ballroom lit for an evening banquet",
    caption: "The Ballroom, By Night",
  },
  {
    src: "venue/secret-garden-night",
    alt: "A long candlelit table in the Secret Garden at night",
    caption: "The Secret Garden, By Night",
  },
]
---

<BaseLayout
  title="Our Banquet Menus — Bacchus"
  menuBackgroundImage="weddings/cake-chandelier"
>
  <PageHero crumb="Banquet Menus" parent={{ href: "/weddings", label: "Weddings" }}>
    Our Banquet <em>Menus</em>
    <Fragment slot="sub">
      A seated dinner in the De Redin ballroom — six courses, from a welcome canapé to the
      cutting of the cake.
    </Fragment>
    <Fragment slot="sub-secondary">
      Three considered tiers, each explored in full below.
    </Fragment>
    <Fragment slot="ctas">
      <a href="#enquire" class="button button-gradient button-shimmer">
        <span>Book a tasting</span>
        <ArrowIcon />
      </a>
      <a
        href="/docs/bacchus-wedding-catalogue.pdf"
        target="_blank"
        rel="noopener"
        class="button button-ghost"
      >
        <span>View the catalogue</span>
      </a>
    </Fragment>
  </PageHero>

  <PackageTierSection tiers={BANQUET_TIERS}>
    <Fragment slot="heading">
      Compare the three <em>tiers</em>
    </Fragment>
    <Fragment slot="lead">
      <p class="lead">
        Orchid, Dahlia and Sunflower are three readings of the same six-course dinner,
        each more lavish than the last.
      </p>
      <p class="lead">
        Switch between them below — every course is taken straight from the printed
        catalogue.
      </p>
    </Fragment>
    <Fragment slot="after-cards">
      <PackageMenuNote variant="warning">
        <p>
          <b>Banquet pricing needs confirming before this page goes live.</b>
        </p>
        <p>
          The per-person figures above come from the quote Bacchus shared. Separate
          correspondence from Bacchus describes banqueting as starting at around &euro;135
          per person and requiring a dedicated meeting — a material difference from the
          tier prices shown here, on the same product.
        </p>
        <p>
          We have deliberately not chosen between the two. Both are reproduced as
          received, and we will publish a single set of figures once Bacchus confirms
          which governs.
        </p>
      </PackageMenuNote>
    </Fragment>
    <Fragment slot="after-panels">
      <PackageMenuNote>
        <p>
          <span class="package-veg-marker" aria-hidden="true">
            V
          </span>{" "}
          vegetarian.
        </p>
        <p>
          Menu items may contain or come into contact with allergens — please discuss
          requirements with the Bacchus sales team.
        </p>
        <p>
          BCL is certified Halal by The World Islamic Call Society (Malta Branch). Full
          terms are in the printed catalogue.
        </p>
      </PackageMenuNote>
      <div class="package-stations-note" data-reveal style="--d: 60ms">
        <p>
          Comparing formats? Also see our{" "}
          <a href="/weddings/packages/reception" class="link-underline-inline">
            Reception
          </a>{" "}
          and{" "}
          <a href="/weddings/packages/high-tea" class="link-underline-inline">
            High Tea
          </a>{" "}
          menus.
        </p>
      </div>
    </Fragment>
  </PackageTierSection>

  <section class="section-padding">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow" id="closerLookEyebrow" data-reveal>
          From the Banquet
        </div>
        <h2 data-reveal style="--d: 80ms">
          A closer look, in <em>five</em> frames
        </h2>
        <p class="lead" data-reveal style="--d: 160ms; margin-top: 22px">
          Drag, swipe or use the arrows. Generic Bacchus photography for now — easily
          swapped for shots of the Banquet itself once available.
        </p>
      </div>
    </div>
    <PhotoCarousel slides={carouselSlides} />
  </section>

  <EnquirySection
    eventType="Wedding"
    railPhoto={{
      src: "venue/hall-chandeliers-banquet",
      alt: "The banquet room dressed with chair sashes and long tables",
      caption: "The banquet room, dressed for a wedding breakfast.",
    }}
  >
    <Fragment slot="heading">
      Tell us about your <em>wedding</em>
    </Fragment>
    <Fragment slot="lead">
      Four short steps. We come back with dates, pricing and a proposal shaped to your day
      — before we ever get on the phone.
    </Fragment>
  </EnquirySection>

  <WaitlistPopover slot="after-footer" />
</BaseLayout>
