    class="package-sticky-switch"
    id="packageStickySwitch"
    role="tablist"
    aria-label="Switch tier"
    aria-hidden="true"
  >
    <span class="pill"></span>
    <button
      type="button"
      class="package-sticky-switch-btn active"
      data-tier-switch="orchid"
      role="tab"
      aria-selected="true"
      aria-label="Switch to Orchid, €65 per person"
    >
      <span class="package-sticky-switch-name">Orchid</span>
      <span class="package-sticky-switch-price">€65</span>
    </button>
    <button
      type="button"
      class="package-sticky-switch-btn"
      data-tier-switch="dahlia"
      role="tab"
      aria-selected="false"
      aria-label="Switch to Dahlia, €85 per person"
    >
      <span class="package-sticky-switch-name">Dahlia</span>
      <span class="package-sticky-switch-price">€85</span>
    </button>
    <button
      type="button"
      class="package-sticky-switch-btn"
      data-tier-switch="sunflower"
      role="tab"
      aria-selected="false"
      aria-label="Switch to Sunflower, €95 per person"
    >
      <span class="package-sticky-switch-name">Sunflower</span>
      <span class="package-sticky-switch-price">€95</span>
    </button>
  </div>

  <section class="section-padding">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow" id="closerLookEyebrow" data-reveal>
          From the Banquet
        </div>
        <h2 data-reveal style="--d: 80ms">
          A closer look, in <em>five</em> frames
        </h2>
        <p class="lead" data-reveal style="--d: 160ms; margin-top: 22px">
          Drag, swipe or use the arrows. Generic Bacchus photography for now — easily
          swapped for shots of the Banquet itself once available.
        </p>
      </div>
    </div>
    <PhotoCarousel slides={carouselSlides} />
  </section>

  <EnquirySection
    eventType="Wedding"
    railPhoto={{
      src: "venue/hall-chandeliers-banquet",
      alt: "The banquet room dressed with chair sashes and long tables",
      caption: "The banquet room, dressed for a wedding breakfast.",
    }}
  >
    <Fragment slot="heading">
      Tell us about your <em>wedding</em>
    </Fragment>
    <Fragment slot="lead">
      Four short steps. We come back with dates, pricing and a proposal shaped to your day
      — before we ever get on the phone.
    </Fragment>
  </EnquirySection>

  <WaitlistPopover slot="after-footer" />

  <script>
    import "../../../scripts/package-tiers.js"
  </script>
</BaseLayout>
