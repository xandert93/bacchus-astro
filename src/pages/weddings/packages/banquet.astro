                <div class="package-menu-group">
                  <h4>Starter Course</h4>
                  <ul>
                    <li>Prawn Crudo, Seasonal Fruit &amp; Prosciutto di San Daniele</li>
                    <li>Beef Tartare, Brown Butter Hollandaise &amp; Croutons</li>
                  </ul>
                </div>
                <div class="package-menu-group">
                  <h4>Intermediate Course</h4>
                  <ul>
                    <li>Home-Made Black Truffle Agnolotti</li>
                    <li>Home-Made Lobster Ravioli &amp; Prawn Bisque</li>
                  </ul>
                </div>
                <div class="package-menu-group">
                  <h4>Main Course</h4>
                  <ul>
