                </figure>
                <figure class="package-dish">
                  <div class="package-dish-placeholder" aria-hidden="true">
                    <span class="package-dish-placeholder-initials">LR</span>
                    <span class="package-dish-placeholder-note">Photo to follow</span>
                  </div>
                  <figcaption class="package-dish-name">Lobster Ravioli</figcaption>
                </figure>
                <figure class="package-dish">
                  <div class="package-dish-placeholder" aria-hidden="true">
                    <span class="package-dish-placeholder-initials">BF</span>
                    <span class="package-dish-placeholder-note">Photo to follow</span>
                  </div>
                  <figcaption class="package-dish-name">Beef Fillet</figcaption>
                </figure>
              </div>
              <div class="package-menu-groups" data-reveal-safe>
                <div class="package-menu-group">
                  <h4>Welcome Drink &amp; Canapés</h4>
                  <ul>
                    <li>
                      Brie &amp; Candied Walnuts{" "}
                      <span class="package-veg-marker-keep-with-word">
                        Leaves&nbsp;
                        <span
                          class="package-veg-marker"
                          role="img"
                          aria-label="Vegetarian"
