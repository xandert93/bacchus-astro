                d="M4 9.5l3 3 7-7.5"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="package-tier-card-eyebrow">High Tea</span>
          <b class="package-tier-card-name">Tulip</b>
          <span class="package-tier-card-price">
            €55<span class="package-tier-card-unit">per person</span>
          </span>
          <span class="package-tier-card-desc">
            The full table — seven savouries including quiches and open pies, three rolls,
            and every sweet on the list.
          </span>
        </button>
      </div>

      <div class="package-menu-note package-menu-note-warning" data-reveal>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
