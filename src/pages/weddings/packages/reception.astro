---
// /weddings/packages/reception — the Reception package: three tiers of
// canapés, flying buffet and desserts, then the sixteen stations that can be
// added to any of them. Reached from the Reception card on /weddings; not in
// the nav, by design.
//
// The content is data (src/data/packages/reception.ts and
// reception-stations.ts); this page only arranges the sections. The tier
// section and its behaviour are shared with the other three package pages
// (PackageTierSection, PackageTierSection.js); the stations are Reception-only
// (ReceptionStations, ReceptionStations.js). Every dish tile and station
// photo opens the shared lightbox, grouped so its arrows stay within the
// tier, or the stations browser, that was opened.
//
// The prototype's reception-package.html carries this page's full history:
// how the tiers and the stations were built in separate sandboxes and
// merged.
import BaseLayout from "@layouts/BaseLayout.astro"
import { RECEPTION_TIERS } from "@data/packages/reception"
import PackageTierSection from "@components/packages/PackageTierSection.astro"
import ReceptionStations from "@components/packages/ReceptionStations.astro"
import PackageMenuNote from "@components/packages/PackageMenuNote.astro"
import PageHero from "@components/sections/PageHero.astro"
import EnquirySection from "@components/enquiry/EnquirySection.astro"
import WaitlistPopover from "@components/enquiry/WaitlistPopover.astro"
import ArrowIcon from "@components/ui/ArrowIcon.astro"
import Lightbox from "@components/ui/Lightbox.astro"
import PhotoCarousel from "@components/sections/PhotoCarousel.astro"

// The "closer look" photo strip.
const carouselSlides = [
  {
    src: "food-and-drink/canapes-service",
    alt: "A waiter serving canapés at a wedding reception",
    caption: "Canapés, Passed",
  },
  {
    src: "venue/terrace-celebration-reception",
    alt: "Guests mingling at a Bacchus wedding reception on the Terrace",
    caption: "Reception, On the Terrace",
  },
  {
    src: "food-and-drink/champagne",
    alt: "A guest raising a glass of sparkling wine at a dressed table",
    caption: "A Toast, On Arrival",
  },
  {
    src: "venue/terrace-marquee-tables",
    alt: "Tables dressed under a marquee on the Terrace",
    caption: "The Terrace, Dressed",
  },
  {
    src: "venue/secret-garden-night",
    alt: "A long candlelit table in the Secret Garden at night",
    caption: "The Secret Garden, By Night",
  },
]
---

<BaseLayout
  title="Our Reception Menus — Package (concept) — Bacchus"
  menuBackgroundImage="weddings/cake-chandelier"
>
  <PageHero
    crumb="Reception Menus"
    parent={{ href: "/weddings", label: "Weddings" }}
    image={{
      src: "food-and-drink/canapes-tray",
      alt: "A tray of salmon canapés being served",
    }}
  >
    Our Reception <em>Menus</em>
    <Fragment slot="sub">
      Canapés passed by hand, a flying buffet, desserts and the wedding cake — taken
      standing, rather than at a seated breakfast.
    </Fragment>
    <Fragment slot="sub-secondary">
      Three considered tiers, each explored in full below — plus Stations to add on top.
    </Fragment>
    <Fragment slot="ctas">
      <a href="#enquire" class="button button-gradient button-shimmer">
        <span>Book a tasting</span>
        <ArrowIcon />
      </a>
      <a
        href="/docs/bacchus-wedding-catalogue.pdf"
        target="_blank"
        rel="noopener"
        class="button button-ghost"
      >
        <span>View the catalogue</span>
      </a>
    </Fragment>
  </PageHero>

  <PackageTierSection tiers={RECEPTION_TIERS} id="reception-tiers">
    <Fragment slot="heading">
      Compare the three <em>tiers</em>
    </Fragment>
    <Fragment slot="lead">
      <p class="lead">
        Daisy, Lavender and Rose are three interpretations of the same reception, each
        more abundant than the last.
      </p>
      <p class="lead">
        Switch between them below — every dish is taken straight from the printed
        catalogue.
      </p>
    </Fragment>
    <Fragment slot="after-panels">
      <PackageMenuNote>
        <p>
          <span class="package-veg-marker" aria-hidden="true">
            V
          </span>{" "}
          vegetarian.
        </p>
        <p>
          Menu items may contain or come into contact with allergens — please discuss
          requirements with the Bacchus sales team.
        </p>
        <p>
          BCL is certified Halal by The World Islamic Call Society (Malta Branch). Full
          terms are in the printed catalogue.
        </p>
      </PackageMenuNote>
      <div class="package-stations-note" data-reveal style="--d: 60ms">
        <p>
          Want to add more?{" "}
          <a href="#stations-hybrid" class="link-underline-inline">
            Explore the Stations add-on below
          </a>{" "}
          — sixteen tables and towers, priced per person.
        </p>
        <p>
          Comparing formats? Also see our{" "}
          <a href="/weddings/packages/banquet" class="link-underline-inline">
            Banquet
          </a>{" "}
          and{" "}
          <a href="/weddings/packages/high-tea" class="link-underline-inline">
            High Tea
          </a>{" "}
          menus.
        </p>
      </div>
    </Fragment>
  </PackageTierSection>

  <section class="section-padding">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow" id="closerLookEyebrow" data-reveal>
          From the Reception
        </div>
        <h2 data-reveal style="--d: 80ms">
          A closer look, in <em>five</em> frames
        </h2>
        <p class="lead" data-reveal style="--d: 160ms; margin-top: 22px">
          Drag, swipe or use the arrows. Generic Bacchus photography for now — easily
          swapped for shots of the Reception itself once available.
        </p>
      </div>
    </div>
    <PhotoCarousel slides={carouselSlides} />
  </section>

  <ReceptionStations />

  <Lightbox />

  <EnquirySection
    eventType="Wedding"
    railPhoto={{
      src: "food-and-drink/canapes-service",
      alt: "Canapés being served to guests",
      caption: "Canapés passed by hand at a reception.",
    }}
  >
    <Fragment slot="heading">
      Tell us about your <em>wedding</em>
    </Fragment>
    <Fragment slot="lead">
      Four short steps. We come back with dates, pricing and a proposal shaped to your day
      — before we ever get on the phone.
    </Fragment>
  </EnquirySection>

  <WaitlistPopover slot="after-footer" />
</BaseLayout>
