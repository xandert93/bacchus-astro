---
import Photo from "./Photo.astro"
// "From our guestbook" rotator. Empty shells here; the four testimonials
// themselves live in testimonials.js, which fills the quote, meta and picker cards.
interface Props {
  // The darkened photo behind the section — a key from src/lib/images.ts.
  backgroundImage: string
}
const { backgroundImage } = Astro.props
---

<section class="section-padding quote testimonials" id="testimonials">
  <Photo class="bgimg" src={backgroundImage} alt="" sizes="100vw" loading="lazy" />
  <div class="particles" id="particles2"></div>
  <div class="wrap">
    <div class="eyebrow" data-reveal>
      From our guestbook
    </div>
    <div class="stars" id="tStars" data-reveal style="--d: 60ms">
      <svg class="star" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
        <path d="m12 2 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z" />
      </svg>
      <svg class="star" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
        <path d="m12 2 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z" />
      </svg>
      <svg class="star" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
        <path d="m12 2 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z" />
      </svg>
      <svg class="star" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
        <path d="m12 2 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z" />
      </svg>
      <svg class="star" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
        <path d="m12 2 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z" />
      </svg>
    </div>
    <div class="testimonial-quote-box" id="tQuoteBox">
      <blockquote
        class="testimonial-quote"
        id="tQuote"
        data-reveal
        style="--d: 120ms"
      ></blockquote>
      <div class="who testimonial-meta" id="tMeta" data-reveal style="--d: 200ms"></div>
    </div>
    <div
      class="testimonial-cards"
      id="tCards"
      role="tablist"
      aria-label="Choose a testimonial"
      data-reveal
      style="--d: 240ms"
    ></div>
    <div class="testimonial-controls" data-reveal style="--d: 300ms">
      <button
        type="button"
        class="testimonial-arrow"
        id="tPrev"
        aria-label="Previous testimonial"
      >
        <svg width="16" height="12" viewBox="0 0 16 12" fill="none">
          <path
            d="M15 6H1M6 1 1 6l5 5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
      <div class="testimonial-dots" id="tDots" aria-hidden="true"></div>
      <button
        type="button"
        class="testimonial-arrow t-arrow-next"
        id="tNext"
        aria-label="Next testimonial"
      >
        <svg
          class="testimonial-ring"
          width="48"
          height="48"
          viewBox="0 0 48 48"
          aria-hidden="true"
        >
          <circle class="testimonial-ring-track" cx="24" cy="24" r="23" />
          <circle class="testimonial-ring-fill" id="tRingFill" cx="24" cy="24" r="23" />
        </svg>
        <svg width="16" height="12" viewBox="0 0 16 12" fill="none">
          <path
            d="M1 6h14M10 1l5 5-5 5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  import "../scripts/testimonials.js"
</script>

<style>
  /* Scoped to this component (moved from global.css by
     scripts/scope-styles.mjs). See FaqSection.astro for how scoping works. */
  .quote {
    background: var(--ink);
    position: relative;
    overflow: hidden;
  }
  .quote .bgimg {
    position: absolute;
    inset: 0;
    opacity: 0.14;
    object-fit: cover;
    width: 100%;
    height: 100%;
    filter: grayscale(0.4);
  }
  .quote blockquote {
    font-family: "Fraunces", serif;
    font-weight: 300;
    font-size: clamp(24px, 4.2vw, 50px);
    line-height: 1.22;
    color: var(--limestone-2);
    letter-spacing: -0.02em;
  }
  .quote .who {
    margin-top: 30px;
    font-size: 11px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .stars {
    display: flex;
    justify-content: center;
    gap: 7px;
    margin-bottom: 28px;
    color: var(--gold);
  }
  /* Per-star entrance, staggered by nth-child (fixed at 5 stars, so a static
     CSS stagger works without JS needing to manage per-element delays — unlike
     bug #13's mobile-drawer case, .star has no other transition for a shared
     transition-delay to bleed into). #tStars.is-in-view is toggled from tRender() in
     main.js on every testimonial change, not just once on page load, since the
     rating is per-review data and the whole point is to replay this each time
     a new review comes in — separate from the one-time [data-reveal] fade
     already on the outer #tStars container itself. */
  .stars .star {
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity 0.35s var(--ease),
      transform 0.35s var(--ease);
  }
  :global(#tStars.is-in-view) .star {
    opacity: 1;
    transform: scale(1);
  }
  /* Scoped to the entering direction only (#tStars.is-in-view), not the bare
     .stars .star base state — the delay must not also apply when leaving
     (is-in removed). tShow() only waits 250ms (220ms fade + 30ms) between
     removing and re-adding is-in, shorter than the 5th star's 280ms delay, so
     an unconditional delay left its leaving transition never even starting in
     that window — it just sat unchanged, with nothing to visibly animate back
     from on re-entry. Leaving now happens uniformly with no delay instead. */
  :global(#tStars.is-in-view) .star:nth-child(1) {
    transition-delay: 0ms;
  }
  :global(#tStars.is-in-view) .star:nth-child(2) {
    transition-delay: 70ms;
  }
  :global(#tStars.is-in-view) .star:nth-child(3) {
    transition-delay: 140ms;
  }
  :global(#tStars.is-in-view) .star:nth-child(4) {
    transition-delay: 210ms;
  }
  :global(#tStars.is-in-view) .star:nth-child(5) {
    transition-delay: 280ms;
  }
  .stars .star.is-empty {
    color: rgba(var(--limestone-rgb), 0.25);
  }
  /* Same specificity as the base .stars .star rule above and placed after it,
       so it wins outright regardless of whether #tStars.is-in-view (a higher-
       specificity ID selector) has been added yet — stars must never be stuck
       at their hidden opacity:0 base state for reduced-motion users waiting on
       a class toggle that's tied to a transition they won't otherwise see. */
  @media (prefers-reduced-motion: reduce) {
    .stars .star {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
  /* Selector matches `.quote blockquote`'s specificity (class+type) and beats
     it on source order, instead of losing to it — a plain `.testimonial-quote` class
     selector is less specific than `.quote blockquote` and silently lost the
     font-size override entirely (bug #2 pattern in CLAUDE.md: a losing
     override, not a dropped property, but the same root cause). Truncation
     past 5 lines is done in JS (see tRender in main.js) rather than
     `-webkit-line-clamp`, which doesn't reliably clamp centered text
     (`.quote .wrap` is `text-align: center`) across engines. */
  .quote blockquote.testimonial-quote {
    font-size: clamp(18px, 2.4vw, 36px);
  }
  .testimonial-quote,
  .testimonial-meta {
    transition:
      opacity 0.3s var(--ease),
      transform 0.3s var(--ease);
  }
  .testimonial-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    margin-top: 34px;
  }
  /* Resting state matches .lightbox-prev/.lightbox-next (gallery lightbox) — the
     site's one other "arrow button on a dark background" pattern: frosted dark
     chip, gold-2 icon, no border. Hover/press inverts to gold, which the
     lightbox doesn't (yet). */
  .testimonial-arrow {
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background-color: rgba(var(--ink-rgb), 0.65);
    backdrop-filter: blur(6px);
    color: var(--gold-2);
    cursor: pointer;
    display: grid;
    place-items: center;
    /* Named properties rather than "all", so nothing else on this element
       can pick up the timing by accident (bug #2). */
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
    flex: none;
  }
  @media (hover: hover) {
    .testimonial-arrow:hover {
      background-color: var(--gold);
      color: var(--ink);
    }
  }
  @media (hover: none) {
    .testimonial-arrow:active {
      background-color: var(--gold);
      color: var(--ink);
    }
  }
  .testimonial-dots {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .testimonial-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 34px;
    text-align: left;
  }
  @media (max-width: 980.98px) {
    .testimonial-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  /* An SVG ring (stroke-dashoffset animated from JS), not a conic-gradient
     redrawn via a JS-updated custom property every animation frame — that
     approach produced inconsistent fills and seam artifacts at the gold/grey
     boundary in testing. stroke-dashoffset is the standard, artifact-free
     technique for an animated circular progress indicator. Only the next
     button has this ring — giving the prev button a matching static track
     (an earlier attempt at equalizing their visual weight) made it read as if
     it had a timer too; both are the same 48x48px box regardless, so the
     ring isn't needed there for actual size parity. */
  .testimonial-ring {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
    pointer-events: none;
  }
  .testimonial-ring-track,
  .testimonial-ring-fill {
    fill: none;
    stroke-width: 1.5;
  }
  .testimonial-ring-track {
    stroke: rgba(var(--limestone-rgb), 0.28);
  }
  .testimonial-ring-fill {
    stroke: var(--gold);
    stroke-linecap: round;
  }
  .testimonial-arrow svg:last-child {
    position: relative;
    z-index: 1;
  }
</style>
