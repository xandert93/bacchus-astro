---
// "From our guestbook" rotator. Empty shells here; the four testimonials
// themselves live in main.js, which fills the quote, meta and picker cards.
interface Props {
  // The darkened photo behind the section.
  backgroundImage: string;
}
const { backgroundImage } = Astro.props;
---

<section class="section-padding quote testimonials" id="testimonials">
  <img class="bgimg" src={backgroundImage} alt="" />
  <div class="particles" id="particles2"></div>
  <div class="wrap">
    <div class="eyebrow" data-reveal>From our guestbook</div>
    <div class="stars" id="tStars" data-reveal style="--d: 60ms">
      <svg
        class="star"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path
          d="m12 2 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"
        />
      </svg>
      <svg
        class="star"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path
          d="m12 2 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"
        />
      </svg>
      <svg
        class="star"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path
          d="m12 2 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"
        />
      </svg>
      <svg
        class="star"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path
          d="m12 2 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"
        />
      </svg>
      <svg
        class="star"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path
          d="m12 2 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"
        />
      </svg>
    </div>
    <div class="testimonial-quote-box" id="tQuoteBox">
      <blockquote
        class="testimonial-quote"
        id="tQuote"
        data-reveal
        style="--d: 120ms"
      ></blockquote>
      <div
        class="who testimonial-meta"
        id="tMeta"
        data-reveal
        style="--d: 200ms"
      ></div>
    </div>
    <div
      class="testimonial-cards"
      id="tCards"
      role="tablist"
      aria-label="Choose a testimonial"
      data-reveal
      style="--d: 240ms"
    ></div>
    <div class="testimonial-controls" data-reveal style="--d: 300ms">
      <button
        type="button"
        class="testimonial-arrow"
        id="tPrev"
        aria-label="Previous testimonial"
      >
        <svg width="16" height="12" viewBox="0 0 16 12" fill="none">
          <path
            d="M15 6H1M6 1 1 6l5 5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
      <div class="testimonial-dots" id="tDots" aria-hidden="true"></div>
      <button
        type="button"
        class="testimonial-arrow t-arrow-next"
        id="tNext"
        aria-label="Next testimonial"
      >
        <svg
          class="testimonial-ring"
          width="48"
          height="48"
          viewBox="0 0 48 48"
          aria-hidden="true"
        >
          <circle class="testimonial-ring-track" cx="24" cy="24" r="23" />
          <circle
            class="testimonial-ring-fill"
            id="tRingFill"
            cx="24"
            cy="24"
            r="23"
          />
        </svg>
        <svg width="16" height="12" viewBox="0 0 16 12" fill="none">
          <path
            d="M1 6h14M10 1l5 5-5 5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </div>
  </div>
</section>
