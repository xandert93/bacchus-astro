---
// The short hero at the top of every subpage: crumb → h1 → paragraph(s) →
// optional CTAs, on the 24px rhythm described in the prototype's CLAUDE.md
// ("Hero structure"). The homepage's portcullis hero is a different
// component and stays in index.astro.
//
// Slots: default = the h1's content (rich text, so <em> works), "sub" = the
// paragraph, "sub-secondary" = an optional second paragraph (the package
// pages), "ctas" = the buttons. Optional slots only render their wrapper
// when the page actually passes something, via Astro.slots.has().
interface Props {
  // Omit for the black "photography to follow" placeholder the package
  // pages use while real imagery is sourced. Its styles live in
  // package-page.css, so only pages importing that should omit it.
  // src is a key from src/lib/images.ts.
  image?: { src: string; alt: string }
  // The page one level up. Home for top-level pages, Weddings for packages.
  parent?: { href: string; label: string }
  // The last crumb, i.e. this page's own name.
  crumb: string
}
import HeroImage from "./HeroImage.astro"

const { image, parent = { href: "/", label: "Home" }, crumb } = Astro.props
const hasSecondarySub = Astro.slots.has("sub-secondary")
const hasCtas = Astro.slots.has("ctas")
---

<section class="hero hero-sm">
  {image ? (
    <div class="hero-media">
      <HeroImage src={image.src} alt={image.alt} heroHeightVh={62} />
    </div>
  ) : (
    <div class="hero-media package-hero-placeholder" />
  )}
  <div class="hero-scrim"></div>
  {!image && (
    <span class="package-hero-placeholder-label">
      Image placeholder — real photography to follow
    </span>
  )}
  <div class="particles" id="particles"></div>
  <div class="hero-content">
    <div class="wrap">
      <div class="crumb fade-up" style="transition-delay: 0.1s">
        <a href={parent.href}>{parent.label}</a>
        <svg width="7" height="10" viewBox="0 0 7 10" fill="none">
          <path
            d="M1 1l5 4-5 4"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
        <span>{crumb}</span>
      </div>
      <h1 class="fade-up" style="transition-delay: 0.2s">
        <slot />
      </h1>
      <p class="sub fade-up" style="transition-delay: 0.32s">
        <slot name="sub" />
      </p>
      {hasSecondarySub && (
        <p class="sub fade-up" style="transition-delay: 0.38s">
          <slot name="sub-secondary" />
        </p>
      )}
      {hasCtas && (
        <div class="hero-ctas fade-up" style="transition-delay: 0.44s">
          <slot name="ctas" />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /* Scoped to this component (moved from global.css by
     scripts/scope-styles.mjs). See FaqSection.astro for how scoping works. */
  /* Compact sub-page hero (shorter than the homepage hero) */
  .hero-sm {
    min-height: 62vh;
    min-height: 62svh;
  }
  .hero-sm h1 {
    font-size: clamp(32px, 6vw, 74px);
  }
  .crumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(var(--limestone-rgb), 0.55);
    margin-bottom: 24px;
  }
  .crumb a {
    transition: color 0.3s;
  }
  .crumb a:hover {
    color: var(--gold-2);
  }
  .crumb svg {
    opacity: 0.6;
  }
</style>
