---
// A grid of choice cards, each a title and a line of description. enquiry.js
// handles selection (single or multiple, per group) and reads each card's
// data-v.
import type { EnquiryOption } from "@data/enquiry"

interface Props {
  id: string
  options: EnquiryOption[]
}

const { id, options } = Astro.props
---

<div class="option-grid" id={id}>
  {options.map((option) => (
    <button type="button" class="option-card" data-v={option.value}>
      <b>{option.title}</b>
      <span>{option.description}</span>
    </button>
  ))}
</div>

<style>
  /* Scoped to this file (moved from global.css by
     scripts/scope-styles.mjs). See FaqSection.astro for how scoping works. */
  /* ---------- Toggle-list (spaces / event style) ---------- */
  .option-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
    margin-top: 5px;
  }
  .option-card {
    text-align: left;
    border: 1px solid rgba(var(--muted-ink-rgb), 0.16);
    border-radius: var(--radius-card);
    background: var(--paper);
    padding: 13px 14px;
    cursor: pointer;
    transition: all 0.35s var(--ease);
  }
  @media (hover: hover) {
    .option-card:hover {
      border-color: rgba(var(--gold-rgb), 0.4);
    }
  }
  .option-card.is-selected {
    border-color: var(--gold);
    background: var(--limestone-2);
    box-shadow: inset 0 0 0 1px rgba(var(--gold-rgb), 0.5);
  }
  .option-card :global(b) {
    display: block;
    font-family: "Fraunces", Georgia, serif;
    font-weight: 400;
    font-size: 15.5px;
  }
  .option-card :global(span) {
    display: block;
    font-family: "Newsreader", Georgia, serif;
    font-size: 12.5px;
    color: var(--muted-ink);
    margin-top: 3px;
  }
</style>
