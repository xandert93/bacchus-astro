---
// A checkbox with its wording beside it, in the site's style: a rounded box
// that fills gold when ticked. The wording comes through the slot. Used for
// the enquiry's consent and the review's permission to publish.
//
// A script marks it unticked-but-required by adding .bad to the label
// (`wrapperId`), which reddens the box and shakes it.
interface Props {
  id: string
  wrapperId?: string
}

const { id, wrapperId } = Astro.props
---

<label class="checkbox-field" id={wrapperId}>
  <input type="checkbox" id={id} />
  <span class="checkbox-field-box" aria-hidden="true">
    <svg
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m5 12 5 5L19 7" />
    </svg>
  </span>
  <span>
    <slot />
  </span>
</label>

<style>
  .checkbox-field {
    flex: 1 1 100%;
    display: flex;
    gap: 12px;
    align-items: flex-start;
    cursor: pointer;
    font-family: "Newsreader", Georgia, serif;
    font-size: 12px;
    color: var(--muted-ink);
    line-height: 1.5;
  }

  .checkbox-field input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .checkbox-field-box {
    flex: none;
    width: 21px;
    height: 21px;
    margin-top: 2px;
    border-radius: 5px;
    border: 1px solid rgba(var(--muted-ink-rgb), 0.28);
    display: grid;
    place-items: center;
    transition: all 0.3s var(--ease);
  }

  .checkbox-field input:checked + .checkbox-field-box {
    background: var(--gold);
    border-color: var(--gold);

    /* Matches .button-gradient's --fg on the same --gold background (submit button
           included), rather than --paper, so the checkmark reads as the same "ink
           on gold" combination used everywhere else that pairs the two.
  */
    color: var(--ink);
  }

  /* The tick draws in when the box is ticked. */
  .checkbox-field-box svg {
    opacity: 0;
    transform: scale(0.6);
    transition: all 0.3s var(--ease);
  }

  .checkbox-field input:checked + .checkbox-field-box svg {
    opacity: 1;
    transform: none;
  }

  .checkbox-field input:focus-visible + .checkbox-field-box {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .checkbox-field:global(.bad) .checkbox-field-box {
    border-color: var(--oxblood);
    animation: shake 0.4s;
  }
</style>
