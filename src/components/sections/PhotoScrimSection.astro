---
// A section with a photograph filling it and a paper scrim (a translucent
// layer) over it, for a form or a block of text to sit on: the photo gives
// the section life without fighting the content. On a desktop the scrim is
// solid behind the content column, on the left, and fades to clear well past
// it, so the photograph shows fully on the right; on a phone and tablet it
// covers the whole photo, which just shows through. Used by the review page;
// the enquiry section, the waitlist page and the checkout pages are the next
// candidates (docs/design/decisions.md, "Photo with a scrim").
//
// The photo is a real image (Photo.astro), not a CSS background: it's sized
// for each screen, served in modern formats, loaded early when it's the
// first thing seen, and has alt text.
//
//   pageTop   the section starts the page, under the solid header (BaseLayout's
//             solidHeader), so it clears the bar and fills the screen
//
// The default slot is the content, in the left column on a desktop.
import { below } from "@lib/media-queries.js"
import Photo from "@components/ui/Photo.astro"

interface Props {
  // A key from src/lib/images.ts, and its description.
  photo: { src: string; alt: string }
  pageTop?: boolean
  class?: string
}

const { photo, pageTop = false, class: className } = Astro.props
---

<section class:list={["photo-scrim", { "photo-scrim-page-top": pageTop }, className]}>
  <div class="photo-scrim-photo">
    <Photo
      src={photo.src}
      alt={photo.alt}
      sizes={`${below.desktop} 100vw, 100vw`}
      loading={pageTop ? "eager" : "lazy"}
    />
  </div>

  <div class="photo-scrim-panel">
    <slot />
  </div>
</section>

<style>
  .photo-scrim {
    /* The content column on a desktop: in line with the site's other
       content (.wrap's left edge), and how wide it may grow. The scrim is
       solid to a little past its right edge, then fades out. */
    --photo-scrim-left: max(0px, calc((100vw - 1180px) / 2));
    --photo-scrim-width: min(620px, 42vw);
    --photo-scrim-solid-to: calc(
      var(--photo-scrim-left) + var(--photo-scrim-width) + 64px
    );

    position: relative;
    background: var(--paper);
  }

  .photo-scrim-page-top {
    min-height: 100vh;
    padding-top: var(--nav-h);
  }

  .photo-scrim-photo {
    position: absolute;
    inset: 0;
  }

  .photo-scrim-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-scrim::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(var(--paper-rgb), 0.9);
  }

  @media (--from-desktop) {
    .photo-scrim::before {
      background: linear-gradient(
        90deg,
        rgba(var(--paper-rgb), 0.95) 0,
        rgba(var(--paper-rgb), 0.95) var(--photo-scrim-solid-to),
        rgba(var(--paper-rgb), 0) calc(var(--photo-scrim-solid-to) + 180px)
      );
    }
  }

  .photo-scrim-panel {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(44px, 5vw, 60px) clamp(20px, 5vw, 44px) clamp(66px, 8vw, 90px);
  }

  .photo-scrim-page-top .photo-scrim-panel {
    min-height: calc(100vh - var(--nav-h));
  }

  @media (--from-desktop) {
    .photo-scrim-panel {
      max-width: var(--photo-scrim-width);
      margin: 0 0 0 var(--photo-scrim-left);
    }
  }
</style>
