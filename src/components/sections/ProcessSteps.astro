---
// "How it comes together" — four numbered steps on a dark band. The
// heading comes in through the default slot so it can carry an <em>.
interface Props {
  steps: { title: string; body: string }[]
}
const { steps } = Astro.props
---

<section class="section-padding on-dark">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow" data-reveal>
        How it comes together
      </div>
      <h2 data-reveal style="--d: 80ms">
        <slot />
      </h2>
    </div>
    <div class="process-steps">
      {steps.map((step, i) => (
        <div class="process-step" data-reveal style={`--d: ${i * 100}ms`}>
          <h4>{step.title}</h4>
          <p>{step.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Scoped to this component (moved from global.css by
       scripts/scope-styles.mjs). See FaqAccordion.astro for how scoping works.
  */
  /* ---------- FAQ accordion: styles live in FaqAccordion.astro ---------- */
  /* ---------- Process steps ---------- */
  .process-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(20px, 2.4vw, 30px);
    counter-reset: step;
  }

  .process-step {
    position: relative;
    padding-top: 22px;
    border-top: 1px solid rgba(var(--gold-rgb), 0.35);
  }

  .process-step::before {
    counter-increment: step;
    content: counter(step, decimal-leading-zero);
    font-family: "Fraunces", serif;
    font-size: 15px;
    color: var(--gold-2);
    display: block;
    margin-bottom: 16px;
  }

  .process-step h4 {
    font-size: 17px;
    font-weight: 400;
    margin-bottom: 8px;
  }

  .process-step p {
    font-size: 13.5px;
    color: var(--muted);
  }

  @media (--below-desktop) {
    .process-steps {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (--below-tablet) {
    .process-steps {
      grid-template-columns: 1fr;
    }
  }

  @media (--below-tablet) {
    .process-step:first-child {
      border-top: none;
    }
  }
</style>
