---
// The "Good to know" section: heading, optional lead, then the FAQ accordion.
// Questions come in as data and go straight to FaqAccordion, which owns the
// markup, styles and script. Default slot = heading, optional "lead" slot =
// the paragraph under it.
import FaqAccordion from "@components/ui/FaqAccordion.astro"

interface Props {
  items: { question: string; answer: string }[]
}
const { items } = Astro.props
const hasLead = Astro.slots.has("lead")
---

<section class="section-padding-small">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow" data-reveal>
        Good to know
      </div>
      <h2 data-reveal style="--d: 80ms">
        <slot />
      </h2>
      {hasLead && (
        <p class="lead" data-reveal style="--d: 160ms; margin-top: 22px">
          <slot name="lead" />
        </p>
      )}
    </div>
    {/* The list's reveal waits for the lead paragraph when there is one. */}
    <FaqAccordion items={items} data-reveal="" style={`--d: ${hasLead ? 220 : 120}ms`} />
  </div>
</section>
