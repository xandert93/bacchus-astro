---
// The /review page: where the link in the review request lands
// (src/lib/reviews/follow-ups.ts). The form sits on a photograph of a
// celebration on the terrace, under a paper scrim (PhotoScrimSection).
// ReviewForm.js loads who it's for, shows the form, and sends it; it then
// thanks them, or does straight away if they've already left their review,
// and offers Google.
//
// The stars are radio buttons, so the rating works from the keyboard (the
// arrow keys move between them) and is read out as "3 stars"; the script
// lights the stars up to the one chosen or hovered.
//
// Google comes after sending, to everyone, whatever their rating: asking
// only happy clients is "review gating", which Google forbids
// (docs/design/decisions.md, "Review gating"). Its link is a stand-in until
// Bacchus supplies their own, hence the Proposed badge.
import Breadcrumb from "@components/ui/Breadcrumb.astro"
import Button from "@components/ui/Button.astro"
import CharacterCount from "@components/forms/CharacterCount.astro"
import CheckboxField from "@components/forms/CheckboxField.astro"
import FormField from "@components/forms/FormField.astro"
import LoadingState from "@components/ui/LoadingState.astro"
import PhotoScrimSection from "@components/sections/PhotoScrimSection.astro"
import ProposedBadge from "@components/ui/ProposedBadge.astro"
import TextInput from "@components/forms/TextInput.astro"
import { GOOGLE_REVIEWS_URL, PUBLISH_WORDING, REVIEW_MAXIMUM_LENGTH } from "@data/reviews"

const STAR_VALUES = [1, 2, 3, 4, 5]
---

<PhotoScrimSection
  pageTop
  photo={{
    src: "venue/terrace-celebration-reception",
    alt: "Guests gathered on the terrace at sunset, drinks in hand, with a band playing under strings of lights",
  }}
>
  <div class="review-card is-loading" id="reviewCard">
    <LoadingState class="review-loading" text="Loading your review" onLight />

    <div class="review-content">
      <Breadcrumb current="Your review" tone="on-light" data-reveal />
      <h1 id="reviewTitle" data-reveal style="--d: 80ms"></h1>
      <p class="lead" id="reviewLead" data-reveal style="--d: 160ms"></p>

      <form
        class="review-form"
        id="reviewForm"
        novalidate
        hidden
        data-reveal
        style="--d: 240ms"
      >
        <fieldset class="review-rating" id="reviewRatingField">
          <legend>Your rating</legend>
          <div class="review-stars">
            {STAR_VALUES.map((value) => (
              <label class="review-star">
                <input
                  type="radio"
                  name="rating"
                  value={value}
                  aria-label={value === 1 ? "1 star" : `${value} stars`}
                />
                <svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m12 2 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z" />
                </svg>
              </label>
            ))}
          </div>
          <div class="error">Please choose a rating.</div>
        </fieldset>

        <FormField
          label="Your review"
          for="reviewText"
          full
          id="reviewTextField"
          error="Please tell us a little about it."
        >
          <TextInput
            id="reviewText"
            multiline
            maxlength={String(REVIEW_MAXIMUM_LENGTH)}
            placeholder="What made the day for you?"
          >
            <CharacterCount for="reviewText" limit={REVIEW_MAXIMUM_LENGTH} />
          </TextInput>
        </FormField>

        <FormField
          label="Name to show"
          for="reviewName"
          id="reviewNameField"
          error="Please add a name."
        >
          <TextInput id="reviewName" placeholder="e.g. Bertha & Alex" />
        </FormField>

        <FormField label="Where you're from" for="reviewLocation">
          <TextInput id="reviewLocation" placeholder="Optional, e.g. London" />
        </FormField>

        <CheckboxField id="reviewPublish">{PUBLISH_WORDING}</CheckboxField>

        <p class="review-error" id="reviewError" role="alert" hidden></p>

        <div class="review-buttons">
          <Button variant="gradient" type="submit" id="reviewSend">
            <span id="reviewSendLabel">Send my review</span>
          </Button>
        </div>
      </form>

      <div class="review-google" id="reviewGoogle" hidden data-reveal style="--d: 160ms">
        <div class="review-google-heading">
          <h2>Share it on Google too?</h2>
          <ProposedBadge tone="bronze" small />
        </div>
        <p>
          Couples choosing a venue read Google's reviews first.{" "}
          <span id="reviewGoogleNote">
            If you'd like to help them, copy your review here and paste it there.
          </span>
        </p>
        <div class="review-buttons">
          <Button variant="dark" id="reviewCopy">
            <svg
              class="review-copy-icon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="9" y="9" width="12" height="12" rx="2"></rect>
              <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path>
            </svg>
            <svg
              class="review-copied-icon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              style="display: none"
            >
              <path d="m5 12 5 5L19 7"></path>
            </svg>
            <span id="reviewCopyLabel">Copy my review</span>
          </Button>
          <Button
            href={GOOGLE_REVIEWS_URL}
            variant="gradient"
            target="_blank"
            rel="noopener"
            arrow
          >
            <span>Review us on Google</span>
          </Button>
        </div>
      </div>
    </div>
  </div>
</PhotoScrimSection>

<script>
  import "./ReviewForm.js"
</script>

<style>
  /* One gap between everything on the page, so its rhythm is even. Fills
     the section's panel, so the loading state can sit in its middle. */
  .review-card {
    --review-gap: clamp(22px, 2.6vw, 30px);

    display: flex;
    flex: 1;
    flex-direction: column;
  }

  /* While loading, only the ring and its line, in the middle of the panel. */
  .review-card :global(.review-loading) {
    display: none;
  }

  .is-loading :global(.review-loading) {
    display: flex;
    flex: 1;
    justify-content: center;
  }

  .is-loading .review-content {
    display: none;
  }

  .review-content {
    display: flex;
    flex-direction: column;
    gap: var(--review-gap);
  }

  .review-content h1 {
    margin: 0;

    font-size: clamp(30px, 4.5vw, 44px);
    line-height: 1.15;
  }

  .review-form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--review-gap) 12px;
  }

  /* A fieldset, so the legend names the five stars as one question; styled
     like the .field labels beside it. */
  .review-rating {
    flex: 1 1 100%;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .review-rating legend {
    margin-bottom: 9px;
    padding: 0;

    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bronze);
  }

  /* The same message as a FormField's, shown the same way (.field.bad). */
  .review-rating .error {
    height: 0;
    margin-top: 0;
    overflow: hidden;
    opacity: 0;

    font-family: "Newsreader", Georgia, serif;
    font-size: 11.5px;
    color: var(--oxblood);
    transition: all 0.3s var(--ease);
  }

  .review-rating:global(.bad) {
    animation: shake 0.4s;
  }

  .review-rating:global(.bad) .error {
    height: 18px;
    margin-top: 8px;
    opacity: 1;
  }

  .review-stars {
    display: flex;
    gap: 6px;
  }

  .review-star {
    position: relative;
    display: grid;
    place-items: center;
    padding: 4px;
    border-radius: 6px;

    color: rgba(var(--muted-ink-rgb), 0.25);
    cursor: pointer;
    transition:
      color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .review-star input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .review-star svg {
    fill: currentColor;
  }

  /* Lit by the script: every star up to the one chosen or hovered. */
  .review-star:global(.is-lit) {
    color: var(--gold);
  }

  .review-star:has(input:focus-visible) {
    outline: 2px solid var(--gold);
    outline-offset: 1px;
  }

  @media (--hover) {
    .review-star:hover {
      transform: scale(1.08);
    }
  }

  .review-error {
    flex: 1 1 100%;

    font-family: "Newsreader", Georgia, serif;
    font-size: 15px;
    color: var(--oxblood);
  }

  .review-buttons {
    display: flex;
    flex: 1 1 100%;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* On a phone the buttons stack in the middle, each as wide as the site's
     other phone buttons. */
  @media (--below-tablet) {
    .review-buttons {
      flex-direction: column;
      align-items: center;
    }

    .review-buttons :global(.button) {
      width: min(100%, 300px);
      justify-content: center;
    }
  }

  /* While sending: the button stays where it is, dimmed, and can't be
     pressed twice. */
  .review-buttons :global(button:disabled) {
    opacity: 0.6;
    cursor: progress;
  }

  /* After sending: Google, set off by a rule rather than boxed. */
  .review-google {
    display: flex;
    flex-direction: column;
    gap: calc(var(--review-gap) * 0.6);
    padding-top: var(--review-gap);
    border-top: 1px solid rgba(var(--muted-ink-rgb), 0.16);
  }

  .review-google-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .review-google h2 {
    font-size: clamp(24px, 3vw, 28px);
    line-height: 1.2;
  }

  .review-google p {
    font-family: "Newsreader", Georgia, serif;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted-ink);
  }

  .review-google .review-buttons {
    margin-top: calc(var(--review-gap) * 0.4);
  }
</style>
