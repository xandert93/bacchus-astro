---
// The three reassurances at the foot of the deposit page: what secures the
// date, someone is there to help, and the page is private.
import SecureBookingIcon from "./SecureBookingIcon.astro"
import type { SecureBookingIconName } from "./SecureBookingIcon.astro"

const ASSURANCES: { icon: SecureBookingIconName; title: string; body: string }[] = [
  {
    icon: "calendar",
    title: "Your date, secured",
    body: "Your date is yours the moment your deposit arrives. Until then it's still open to other couples.",
  },
  {
    icon: "phone",
    title: "Personal support",
    body: "Your dedicated Events Manager is available Mon–Fri for any questions.",
  },
  {
    icon: "shield-check",
    title: "Secure details",
    body: "This page is unique to your enquiry. Card and bank payments are processed securely.",
  },
]
---

<section class="secure-booking-trust-footer-section">
  <div class="secure-booking-container-large">
    <div class="secure-booking-trust-footer-grid">
      {ASSURANCES.map((assurance) => (
        <div class="secure-booking-trust-footer-item">
          <span class="secure-booking-icon-badge secure-booking-trust-footer-icon">
            <SecureBookingIcon name={assurance.icon} size={20} />
          </span>
          <h4>{assurance.title}</h4>
          <p>{assurance.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
