---
// The deposit page's hero: the compact HeroFrame, with the booking's own
// occasion, spaces and date in the copy, filled in by the page's script. Its
// words follow the page's state: while the booking loads, only the photo and
// the loading ring, so nothing claims what isn't known yet; then an
// invitation to pay while the deposit is due, a celebration once it's
// confirmed (the script adds a rise of gold through it), or something
// neutral for a closed quote or a broken link. No crumb and no buttons: the
// page is a checkout, reached from an emailed link.
import HeroFrame from "@components/sections/HeroFrame.astro"
import HeroImage from "@components/ui/HeroImage.astro"
import LoadingRing from "@components/ui/LoadingRing.astro"
---

<HeroFrame small>
  <HeroImage
    slot="media"
    src="weddings/toast"
    alt="A bride and groom clinking champagne glasses"
    heroHeightVh={62}
  />

  <div class="secure-booking-hero-loading" data-deposit-show="loading">
    <LoadingRing label="Loading your booking" size={36} />
    <p>Loading your booking</p>
  </div>

  <div data-deposit-show="pay transfer-sent" hidden>
    <div class="secure-booking-eyebrow">
      <span class="secure-booking-rule"></span>Your booking
    </div>
    <h1>
      Secure your date <br class="secure-booking-hide-mobile" />
      at <em>Bacchus</em>
    </h1>
    <div>
      <p class="sub">
        Congratulations, <span data-deposit="firstName"></span>: your{" "}
        <span data-deposit="occasion"></span> is approved!
      </p>
      <p class="sub">
        Review the details below and complete your deposit to confirm{" "}
        <span data-deposit="spaces"></span> for <span data-deposit="date"></span>.
      </p>
    </div>
  </div>

  <div data-deposit-show="confirmed" hidden>
    <div class="secure-booking-eyebrow">
      <span class="secure-booking-rule"></span>Booking confirmed
    </div>
    <h1>
      Your date is <br class="secure-booking-hide-mobile" />
      <em>confirmed</em>
    </h1>
    <p class="sub">
      Congratulations, <span data-deposit="firstName"></span>:{" "}
      <span data-deposit="spaces"></span> is yours on <span data-deposit="date"></span>.
    </p>
  </div>

  <div data-deposit-show="closed invalid" hidden>
    <div class="secure-booking-eyebrow">
      <span class="secure-booking-rule"></span>Your booking
    </div>
    <h1>
      Bacchus, <em>Mdina</em>
    </h1>
  </div>
</HeroFrame>
