---
// "Complete your deposit": the ways to pay, side by side from laptop width.
// Bank comes first and is the one we recommend: no card fee for Bacchus on a
// deposit of thousands. "Pay by bank" (open banking) sends the client to
// approve the payment in their own banking app, and confirms the booking as
// soon as they do. Folded away beneath it, for a bank that can't do that:
// the details to transfer it by hand, and an "I've sent it" button that
// tells the events team. Card goes to the card provider's checkout. Both
// online routes are pretend ones in test mode (src/lib/payments/checkout.ts),
// and everything is wired up in the page's script, src/pages/_secure-booking.js.
import Button from "@components/ui/Button.astro"
import BankDetailRow from "./BankDetailRow.astro"
import SecureBookingIcon from "./SecureBookingIcon.astro"
import SecureBookingIntro from "./SecureBookingIntro.astro"
---

<section class="secure-booking-pay-section" data-deposit-show="pay" hidden>
  <div class="secure-booking-container-large">
    <SecureBookingIntro eyebrow="Choose how to pay">
      Complete your <em>deposit</em>
      <Fragment slot="lead">
        Approve it in your banking app, or pay by card.{" "}
        <span data-deposit-row="validUntil" hidden>
          This quote is valid until <span data-deposit="validUntil"></span>.
        </span>
      </Fragment>
    </SecureBookingIntro>

    <div class="secure-booking-pay-grid">
      <div class="secure-booking-card secure-booking-pay-card">
        <div class="secure-booking-card-head">
          <span class="secure-booking-icon-badge secure-booking-pay-icon-cream">
            <SecureBookingIcon name="bank" size={24} />
          </span>
          <h3>Pay by bank</h3>
          <span class="secure-booking-recommended">Recommended</span>
        </div>
        <p>
          Approve the payment in your own banking app, with no card needed. Your booking
          is confirmed the moment you do.
        </p>
        <Button
          variant="gradient"
          arrow
          class="secure-booking-pay-button"
          data-checkout-method="pay-by-bank"
        >
          <span>
            Pay <span data-deposit="deposit.display"></span> by bank
          </span>
        </Button>
        <p class="secure-booking-pay-note">You'll choose your bank on the next screen.</p>

        <details class="secure-booking-manual-transfer">
          <summary>Or transfer it yourself</summary>
          <p>
            Use the reference below so we can match it. We'll confirm your booking once it
            arrives, usually within two working days.
          </p>

          <div class="secure-booking-bank-details">
            <BankDetailRow
              label="Account name"
              field="bank.accountName"
              copyLabel="Copy account name"
            />
            <BankDetailRow label="IBAN" field="bank.iban" copyLabel="Copy IBAN" />
            <BankDetailRow
              label="Amount to transfer"
              field="deposit.display"
              copyField="deposit.plain"
              copyLabel="Copy amount"
            />
            <BankDetailRow
              label="Reference"
              field="bank.reference"
              copyLabel="Copy reference"
            />
          </div>

          <div class="secure-booking-warning-box" data-deposit-row="exampleBank" hidden>
            <SecureBookingIcon name="warning" />
            <span>
              Example bank details, for testing only: please don't send funds to this
              account.
            </span>
          </div>

          <Button arrow class="secure-booking-pay-button" id="transferSentButton">
            <span>I've sent the transfer</span>
          </Button>
          <p class="secure-booking-pay-note">
            Press this once you've made the transfer, so we know to look for it.
          </p>
        </details>
      </div>

      <div class="secure-booking-card secure-booking-pay-card">
        <div class="secure-booking-card-head">
          <span class="secure-booking-icon-badge secure-booking-pay-icon-gold">
            <SecureBookingIcon name="credit-card" size={24} />
          </span>
          <h3>Pay by card</h3>
        </div>
        <p>Pay securely by card, and your booking is confirmed straight away.</p>
        <Button arrow class="secure-booking-pay-button" data-checkout-method="card">
          <span>
            Pay <span data-deposit="deposit.display"></span> by card
          </span>
        </Button>
      </div>
    </div>

    <p class="secure-booking-pay-error" id="depositActionError" role="alert" hidden></p>
  </div>
</section>
