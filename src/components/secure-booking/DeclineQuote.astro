---
// "Not going ahead?" under the payment options: a dark card, set apart from
// the white payment cards above so it reads as a different kind of choice,
// whose button opens a dialog to decline the quote, with an optional reason. It can't be
// undone from here, hence the dialog. The confirm button is wired in the
// page's script (src/pages/_secure-booking.js); opening and closing are the
// Dialog's own.
import Button from "@components/ui/Button.astro"
import Dialog from "@components/ui/Dialog.astro"
import FormField from "@components/forms/FormField.astro"
import TextInput from "@components/forms/TextInput.astro"
---

<section class="secure-booking-decline-section" data-deposit-show="pay" hidden>
  <div class="secure-booking-container-large">
    <div class="secure-booking-decline-card">
      <div>
        <p class="secure-booking-decline-eyebrow">Changed your plans?</p>
        <h3>
          Not going <em>ahead?</em>
        </h3>
        <p>
          Let us know and we'll close this quote. You're always welcome to enquire again.
        </p>
      </div>
      <Button variant="light" data-dialog-open="declineDialog">
        <span>Decline this quote</span>
      </Button>
    </div>
  </div>

  <Dialog id="declineDialog" labelledBy="declineTitle">
    <div class="secure-booking-decline-dialog">
      <p class="secure-booking-eyebrow-plain">Not going ahead</p>
      <h2 id="declineTitle">
        Decline this <em>quote?</em>
      </h2>
      <p>
        We'll close this quote and let the events team know. This can't be undone here,
        though you're always welcome to enquire again.
      </p>
      <FormField label="Would you tell us why? (optional)" for="declineReason">
        <TextInput id="declineReason" multiline maxlength="500" />
      </FormField>
      <p class="secure-booking-pay-error" id="declineError" role="alert" hidden></p>
      <div class="secure-booking-button-row">
        <Button variant="gradient" data-dialog-close>
          <span>Keep my quote</span>
        </Button>
        <Button variant="dark" id="declineConfirm">
          <span>Decline the quote</span>
        </Button>
      </div>
    </div>
  </Dialog>
</section>
