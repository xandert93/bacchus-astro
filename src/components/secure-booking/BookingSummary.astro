---
// The booking summary, laid out like the PDF quote (docs/design/quote-pdf/
// quote.pdf): who it's for and the quote reference, the event's facts in a
// panel, the price in groups with their subtotals, then the totals and the
// deposit due. Filled in by the page's script (src/pages/_secure-booking.js)
// from the quote its link points to: each `data-deposit` names the field it
// shows, and the facts and price groups are built from the templates below
// (src/lib/deposits/view.ts).
import SecureBookingIcon from "./SecureBookingIcon.astro"
import type { SecureBookingIconName } from "./SecureBookingIcon.astro"

// Each fact's icon, by its label (src/lib/quotes/quote-lines.ts, eventFacts).
const FACT_ICONS: Record<string, SecureBookingIconName> = {
  Date: "calendar",
  Time: "clock",
  Guests: "users",
  Spaces: "map-pin",
  Food: "utensils",
  Drinks: "wine",
}
---

<section
  class="secure-booking-summary-section"
  data-deposit-show="pay transfer-sent confirmed"
  hidden
>
  <div class="secure-booking-container-large">
    <div class="secure-booking-summary-card">
      <div class="secure-booking-summary-topbar">
        <div>
          <p class="secure-booking-eyebrow-plain">Booking summary for</p>
          <h2 data-deposit="couple"></h2>
        </div>
        <div class="secure-booking-quote-badge">
          <SecureBookingIcon name="tag" size={14} strokeWidth={1.4} />
          Quote Ref: <span data-deposit="reference"></span>
        </div>
      </div>

      <div class="secure-booking-summary-body">
        <div class="secure-booking-facts" id="depositFacts"></div>
        <template id="depositFactColumn">
          <dl class="secure-booking-facts-column"></dl>
        </template>
        <template id="depositFact">
          <div class="secure-booking-fact">
            <dt>
              <span class="secure-booking-fact-icon"></span>
              <span data-fact="label"></span>
            </dt>
            <dd></dd>
          </div>
        </template>
        {/* The icons, ready for the script to copy into each fact by its label. */}
        <template id="depositFactIcons">
          {Object.entries(FACT_ICONS).map(([label, icon]) => (
            <span data-fact-icon={label}>
              <SecureBookingIcon name={icon} />
            </span>
          ))}
        </template>

        <div class="secure-booking-price">
          {/* The column headings, once above every group, as on the PDF. */}
          <div class="secure-booking-price-head" aria-hidden="true">
            <span></span>
            <span>Item</span>
            <span>Qty</span>
            <span>Price</span>
            <span>Amount</span>
          </div>
          <div id="depositPriceGroups"></div>
        </div>
        <template id="depositPriceGroup">
          <div class="secure-booking-price-group">
            <p class="secure-booking-price-group-title">
              <span data-group="title"></span>
              <span
                class="secure-booking-price-group-subtotal"
                data-group="subtotal"
              ></span>
            </p>
            <ul class="secure-booking-price-lines"></ul>
          </div>
        </template>
        <template id="depositPriceLine">
          <li class="secure-booking-price-line">
            <span class="secure-booking-price-item" data-line="label"></span>
            {/* Two columns on a wide screen; "110 × €53" under the item on a phone. */}
            <span class="secure-booking-price-sum" data-line="sum">
              <span class="secure-booking-price-quantity" data-line="quantity"></span>
              <span class="secure-booking-price-times">{" × "}</span>
              <span class="secure-booking-price-unit" data-line="unitPrice"></span>
            </span>
            <span class="secure-booking-price-amount" data-line="amount"></span>
            <span class="secure-booking-price-details" data-line="details"></span>
          </li>
        </template>

        <div class="secure-booking-summary-foot">
          <div class="secure-booking-summary-money">
            <div class="secure-booking-totals">
              <div class="secure-booking-totals-row" data-deposit-row="discount" hidden>
                <span>Subtotal</span>
                <span data-deposit="subtotal"></span>
              </div>
              <div
                class="secure-booking-totals-row secure-booking-totals-discount"
                data-deposit-row="discount"
                hidden
              >
                <span>Discount</span>
                <span data-deposit="discount"></span>
              </div>
              <div class="secure-booking-totals-row secure-booking-totals-total">
                <span>Total</span>
                <span data-deposit="total"></span>
              </div>
              <div class="secure-booking-totals-row" data-deposit-row="vat" hidden>
                <span data-deposit="vat.label"></span>
                <span data-deposit="vat.amount"></span>
              </div>
              <div class="secure-booking-totals-row" data-deposit-row="perGuest" hidden>
                <span>Per guest</span>
                <span data-deposit="perGuest"></span>
              </div>
            </div>

            <div class="secure-booking-deposit-box">
              {/* What the deposit is now, as the page's state says. */}
              <p class="secure-booking-deposit-label">
                <span data-deposit-show="pay" hidden>
                  Deposit due now
                </span>
                <span data-deposit-show="transfer-sent" hidden>
                  Deposit on its way
                </span>
                <span data-deposit-show="confirmed" hidden>
                  Deposit paid
                </span>
              </p>
              <p class="secure-booking-deposit-amount" data-deposit="deposit.display"></p>
              <p class="secure-booking-deposit-note" data-deposit="deposit.note"></p>
            </div>
          </div>

          <div class="secure-booking-summary-from">
            {/* A paper panel, as the PDF sets its notes. */}
            <div class="secure-booking-notes" data-deposit-row="notes" hidden>
              <h3>Notes from Bacchus</h3>
              <p data-deposit="notes"></p>
            </div>
            {/* Signed, like a letter: whoever prepared it, by name. */}
            <div class="secure-booking-prepared" data-deposit-row="preparedBy" hidden>
              <p>This quote was prepared by</p>
              <p class="secure-booking-prepared-name" data-deposit="preparedBy"></p>
              <p data-deposit-row="preparedOn" hidden>
                on <span data-deposit="preparedOn"></span>
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="secure-booking-summary-footbar" data-deposit-row="testMode" hidden>
        <SecureBookingIcon name="warning" />
        <span>
          Test mode: payments here are pretend, and no money is taken. The bank details
          are examples: please don't send funds to them.
        </span>
      </div>
    </div>
  </div>
</section>
