---
// The booking summary: who it's for and the quote reference, the event's
// details beside the price breakdown, and the deposit due. Filled in by the
// page's script (src/pages/_secure-booking.js) from the quote its link points to: each
// `data-deposit` names the field it shows (src/lib/deposits/view.ts).
import SecureBookingIcon from "./SecureBookingIcon.astro"
import type { SecureBookingIconName } from "./SecureBookingIcon.astro"

// The event rows, in order. A row whose value doesn't come back (the time,
// when the quote has none) stays hidden.
const DETAILS: { icon: SecureBookingIconName; label: string }[] = [
  { icon: "calendar", label: "Date" },
  { icon: "clock", label: "Time" },
  { icon: "users", label: "Guests" },
  { icon: "map-pin", label: "Venue" },
]
---

<section
  class="secure-booking-summary-section"
  data-deposit-show="pay transfer-sent confirmed"
  hidden
>
  <div class="secure-booking-container-large">
    <div class="secure-booking-summary-card">
      <div class="secure-booking-summary-topbar">
        <div>
          <p class="secure-booking-eyebrow-plain">Booking summary for</p>
          <h2 data-deposit="couple"></h2>
        </div>
        <div class="secure-booking-quote-badge">
          <SecureBookingIcon name="tag" size={14} strokeWidth={1.4} />
          Quote Ref: <span data-deposit="reference"></span>
        </div>
      </div>

      <div class="secure-booking-summary-grid">
        <div class="secure-booking-summary-col">
          <h3>Your event</h3>
          <dl class="secure-booking-field-list">
            {DETAILS.map((detail) => (
              <div class="secure-booking-field" data-deposit-detail={detail.label} hidden>
                <span class="secure-booking-field-icon">
                  <SecureBookingIcon name={detail.icon} />
                </span>
                <div>
                  <dt>{detail.label}</dt>
                  <dd data-deposit-detail-value />
                </div>
              </div>
            ))}
          </dl>

          <div class="secure-booking-notes" data-deposit-row="notes" hidden>
            <h3>Notes from Bacchus</h3>
            <p data-deposit="notes"></p>
          </div>
          <p class="secure-booking-prepared" data-deposit-row="preparedBy" hidden>
            Prepared by <span data-deposit="preparedBy"></span>
          </p>
        </div>

        <div class="secure-booking-summary-col secure-booking-summary-col-right">
          <h3>Price breakdown</h3>
          <div class="secure-booking-items" id="depositLineItems"></div>
          <template id="depositLineItem">
            <div class="secure-booking-item">
              <span>
                <span data-line="label"></span>
                <span class="secure-booking-item-working" data-line="working"></span>
                <span class="secure-booking-item-working" data-line="details"></span>
              </span>
              <span class="secure-booking-item-amount" data-line="amount"></span>
            </div>
          </template>

          <div class="secure-booking-totals">
            <div class="secure-booking-totals-row">
              <span>Subtotal</span>
              <span data-deposit="subtotal"></span>
            </div>
            <div
              class="secure-booking-totals-row secure-booking-totals-discount"
              data-deposit-row="discount"
              hidden
            >
              <span>Discount</span>
              <span data-deposit="discount"></span>
            </div>
            <div class="secure-booking-totals-row secure-booking-totals-total">
              <span>Total</span>
              <span data-deposit="total"></span>
            </div>
            <p class="secure-booking-per-person" data-deposit="perPerson"></p>
            <div class="secure-booking-totals-row" data-deposit-row="vat" hidden>
              <span data-deposit="vat.label"></span>
              <span data-deposit="vat.amount"></span>
            </div>
          </div>

          <p class="secure-booking-deposit-terms" data-deposit="depositTerms"></p>

          <div class="secure-booking-deposit-box">
            {/* What the deposit is now, as the page's state says. */}
            <p class="secure-booking-deposit-label">
              <span data-deposit-show="pay" hidden>
                Deposit due now
              </span>
              <span data-deposit-show="transfer-sent" hidden>
                Deposit on its way
              </span>
              <span data-deposit-show="confirmed" hidden>
                Deposit paid
              </span>
            </p>
            <p class="secure-booking-deposit-amount" data-deposit="deposit.display"></p>
            <p class="secure-booking-deposit-note" data-deposit="balanceNote"></p>
          </div>
        </div>
      </div>

      <div class="secure-booking-summary-footbar" data-deposit-row="testMode" hidden>
        <SecureBookingIcon name="warning" />
        <span>
          Test mode: payments here are pretend, and no money is taken. The bank details
          are examples: please don't send funds to them.
        </span>
      </div>
    </div>
  </div>
</section>
