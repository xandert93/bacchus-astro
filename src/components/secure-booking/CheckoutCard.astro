---
// The single card that a payment step stands in, on a page of its own:
// the pretend provider (secure-booking/test-checkout.astro) and the bank
// picker for Enable Banking (secure-booking/choose-bank.astro). The step's
// content comes through the slot; its headings, paragraphs and a list of
// banks (`.checkout-card-banks`, each a `.checkout-card-bank` Button) are
// styled here, so both pages look the same. Above the card, a link back to
// the couple's deposit page, as on any checkout step (CheckoutCard.js fills
// in its address from this page's own ?token=).
interface Props {
  /** The card's id, for the page's script to find it. */
  id: string
}
---

<section class="secure-booking-status-section checkout-card-section">
  <div class="secure-booking-container-large">
    <a class="checkout-card-back" href="/secure-booking" data-checkout-back>
      <span aria-hidden="true">←</span> Back to your booking
    </a>
    <div class="secure-booking-card checkout-card" id={Astro.props.id}>
      <div>
        <slot />
      </div>
    </div>
  </div>
</section>

<script>
  import "./CheckoutCard.js"
</script>

<style>
  .checkout-card-section {
    padding: clamp(140px, 20vh, 220px) 0 clamp(80px, 11vw, 150px);
  }

  .checkout-card-back {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 640px;
    margin: 0 auto 16px;

    font-family: "Inter", sans-serif;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-ink);
    transition: color 0.3s var(--ease);
  }

  @media (--hover) {
    .checkout-card-back:hover {
      color: var(--ink);
    }
  }

  .checkout-card {
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(28px, 5vw, 48px);
  }

  /* The content arrives through the slot, carrying the page's scope, not
     this file's: hence :global(). */
  .checkout-card :global(h2) {
    margin: 10px 0 12px;

    font-size: clamp(26px, 3.5vw, 34px);
    line-height: 1.2;
  }

  .checkout-card :global(p:not([class])) {
    font-family: "Newsreader", Georgia, serif;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted-ink);
  }

  .checkout-card :global(.checkout-card-banks) {
    display: grid;
    gap: 10px;
    margin-top: 24px;
    list-style: none;
  }

  /* Full-width rows, the bank's name on the left and the arrow on the right. */
  .checkout-card :global(.checkout-card-bank) {
    width: 100%;
    justify-content: space-between;
  }
</style>
