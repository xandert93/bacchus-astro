---
// "From the kitchen": three dishes in arch frames, numbered like courses,
// then a call to request the menus. Restaurant-side content is kept to this
// teaser while the events side is the focus.
import Button from "@components/ui/Button.astro"
import DishGrid from "@components/sections/DishGrid.astro"
import type { Dish } from "@components/sections/DishGrid.astro"

const DISHES: Dish[] = [
  {
    course: "I",
    name: "Seared catch of the day",
    description: "Spring vegetables, light pea purée, salsa verde.",
    photo: {
      src: "food-and-drink/seabass",
      alt: "Pan-seared fish with vegetables, plated",
    },
  },
  {
    course: "II",
    name: "Slow-cooked lamb",
    description: "Pistachio crust, beetroot and orange.",
    photo: {
      src: "food-and-drink/lamb",
      alt: "Slow-cooked lamb with beetroot and citrus",
    },
  },
  {
    course: "III",
    name: "Canapés, passed and shared",
    description: "Built for standing receptions and drinks.",
    photo: { src: "food-and-drink/canapes-tray", alt: "A tray of canapés being served" },
  },
]
---

<section class="section-padding on-dark" id="menu">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow" data-reveal>
        From the kitchen
      </div>
      <h2 data-reveal style="--d: 80ms">
        A taste of <em>the table</em>
      </h2>
      <p class="lead" data-reveal style="--d: 160ms; margin-top: 22px">
        Mediterranean cooking built around what's landed and what's in season, plated the
        way it's always been at Bacchus.
      </p>
    </div>
    <DishGrid dishes={DISHES} revealEach />
    <div
      class="cta-row"
      data-reveal
      style="--d: 340ms; margin-top: clamp(38px, 5vw, 58px)"
    >
      <Button href="#enquire" variant="light" arrow>
        <span>Request the full menus</span>
      </Button>
    </div>
  </div>
</section>

<style>
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  @media (--below-tablet) {
    .cta-row {
      flex-direction: column;
      align-items: center;
    }
  }

  @media (--below-tablet) {
    .cta-row :global(.button) {
      width: 100%;
      max-width: 300px;
      justify-content: center;
    }
  }
</style>
