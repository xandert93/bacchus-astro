---
// Four icon cards on a dark band: "What we cater for" (corporate),
// "Occasions we host" (celebrations). Default slot = heading.
interface Props {
  eyebrow: string
  cards: {
    title: string
    body: string
    // One or more SVG path "d" strings, drawn in a 24x24 box.
    iconPaths: string[]
  }[]
}
const { eyebrow, cards } = Astro.props
---

<section class="section-padding on-dark">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow" data-reveal>
        {eyebrow}
      </div>
      <h2 data-reveal style="--d: 80ms">
        <slot />
      </h2>
    </div>
    <div class="package-grid">
      {cards.map((card, i) => (
        <div class="package-card" data-reveal style={`--d: ${i * 100}ms`}>
          <svg class="card-icon" viewBox="0 0 24 24" fill="none">
            {card.iconPaths.map((d) => (
              <path
                d={d}
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            ))}
          </svg>
          <h4>{card.title}</h4>
          <p>{card.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Scoped to this component (moved from global.css by
     scripts/scope-styles.mjs). See FaqSection.astro for how scoping works. */
  /* ---------- Package / info cards (Corporate, Celebrations) ---------- */
  .package-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(14px, 2vw, 22px);
  }
  .package-card {
    padding: clamp(24px, 2.6vw, 30px) clamp(20px, 2vw, 26px);
    border: 1px solid rgba(var(--muted-ink-rgb), 0.12);
    border-radius: var(--radius-card);
    background: #fff;
    color: var(--ink);
    transition:
      opacity 0.9s var(--ease),
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease),
      border-color 0.5s var(--ease);
  }
  .package-card:not(.is-revealed) {
    transition-delay: var(--d, 0ms);
  }
  .package-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 30px 60px -34px rgba(var(--muted-ink-rgb), 0.35);
    border-color: rgba(var(--gold-rgb), 0.4);
  }
  .package-card .card-icon {
    width: 38px;
    height: 38px;
    margin-bottom: 18px;
    color: var(--oxblood);
  }
  .package-card h4 {
    font-size: 19px;
    font-weight: 400;
    margin-bottom: 10px;
  }
  .package-card p {
    color: var(--muted-ink);
    font-size: 13.5px;
  }
  @media (max-width: 980.98px) {
    .package-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 620.98px) {
    .package-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
