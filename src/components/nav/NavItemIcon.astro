---
// The line icons beside the desktop dropdown items: 18px, 1.4 stroke, drawn
// in currentColor so the item's hover colour reaches them.
import type { NavIconName } from "@data/navigation"

interface Props {
  name: NavIconName
}

const ICONS: Record<NavIconName, string> = {
  "menu-card":
    '<rect x="5" y="3" width="14" height="18" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M9 8h6M9 12h6M9 16h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>',
  vaults:
    '<path d="M3 21V11a5 5 0 0 1 10 0v10M13 21V13a4 4 0 0 1 8 0v8" stroke="currentColor" stroke-width="1.4"/>',
  gift: '<rect x="3" y="8" width="18" height="12" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M3 12h18M12 8v12" stroke="currentColor" stroke-width="1.4"/><path d="M8.5 8a2.5 2.5 0 0 1 0-5c1.7 0 3.5 2.2 3.5 5M15.5 8a2.5 2.5 0 0 0 0-5c-1.7 0-3.5 2.2-3.5 5" stroke="currentColor" stroke-width="1.4"/>',
  rings:
    '<circle cx="9" cy="14" r="5.5" stroke="currentColor" stroke-width="1.4"/><circle cx="15" cy="14" r="5.5" stroke="currentColor" stroke-width="1.4"/>',
  building:
    '<rect x="4" y="4" width="16" height="16" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M8 9h3M8 13h3M13 9h3M13 13h3M10 20v-3h4v3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>',
  party:
    '<path d="M7 21l4-11 6 6-10 5zM13 3v3M19 7l-2 2M21 13h-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>',
  pin: '<path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.4"/>',
  camera:
    '<rect x="3" y="7" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M9 7l1.5-3h3L15 7" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="13.5" r="3.2" stroke="currentColor" stroke-width="1.4"/>',
  book: '<path d="M4 4.5h7a2 2 0 0 1 2 2V21a2 2 0 0 0-2-2H4zM20 4.5h-7a2 2 0 0 0-2 2V21a2 2 0 0 1 2-2h7z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>',
}
---

<svg
  width="18"
  height="18"
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  set:html={ICONS[Astro.props.name]}
/>
