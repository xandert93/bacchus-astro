---
// One of the desktop bar's dropdowns (Restaurant, Events). The label is a
// real link to the menu's landing page and the chevron beside it is its
// own button, so a click on the word navigates and only the chevron opens
// the panel — the only way the parent page stays reachable on touch.
//
// The panel: a heading row with the hub link, the items in a three-column
// grid, and a photo column that crossfades to an item's own photo while it
// is hovered or focused (pure CSS, :has() on the card). Opening, hover
// intent and keyboard handling are site-nav.js.
//
// The panel stays nested inside .nav-dd rather than being a sibling of the
// bar's .wrap: it is position: fixed, so it anchors to the viewport either
// way, and nesting keeps the natural .nav-dd:hover chain. A sibling was
// tried in the prototype and reverted.
import { hrefOf, unbuiltAttr, type NavMenu } from "@data/navigation"
import ProposedBadge from "@components/ui/ProposedBadge.astro"
import NavChevron from "./NavChevron.astro"
import NavItemIcon from "./NavItemIcon.astro"
import NavPanelPhoto from "./NavPanelPhoto.astro"

interface Props {
  menu: NavMenu
}

const { menu } = Astro.props
---

<li class="nav-dd nav-dd-split">
  <a href={hrefOf(menu)} {...unbuiltAttr(menu)}>
    {menu.label}
  </a>
  <button
    class="nav-dd-split-chevron-button"
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={`Open the ${menu.label} menu`}
  >
    <NavChevron />
  </button>
  <div class="nav-dd-panel">
    <div class="nav-dd-panel-card nav-dd-panel-card-dark">
      <div class="nav-dd-panel-main">
        <div class="nav-dd-panel-heading-row">
          <div class="nav-dd-panel-heading">{menu.heading}</div>
          <a class="nav-dd-hub-link" href={hrefOf(menu.hub)} {...unbuiltAttr(menu.hub)}>
            {menu.hub.label}
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M5 12h14m-7-7 7 7-7 7"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </a>
        </div>
        <div class="nav-dd-items">
          {menu.items.map((item) => (
            <a
              class="nav-dd-item"
              href={hrefOf(item)}
              {...unbuiltAttr(item)}
              data-target={item.photo}
            >
              <span class="nav-dd-icon">
                <NavItemIcon name={item.icon} />
              </span>
              <span class="nav-dd-text">
                <span class="nav-dd-label">
                  {item.label}
                  {item.unbuilt && <ProposedBadge tone="bronze" small />}
                </span>
                <span class="nav-dd-desc">{item.description}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
      {/* Decorative beside the text links, so aria-hidden and alt="".
           Only the default photo loads with the page; the rest carry
           data-src and load the first time the panel opens (see
           NavPanelPhoto), so a dropdown most visitors never open costs
           nothing on every page. 
*/}
      <div class="nav-dd-panel-media" aria-hidden="true">
        {menu.photos.map((photo) => (
          <NavPanelPhoto
            src={photo.src}
            state={photo.state}
            eager={photo.state === "default"}
          />
        ))}
        {menu.photos.map((photo) => (
          <p class="nav-dd-panel-caption" data-state={photo.state}>
            {photo.caption}
          </p>
        ))}
      </div>
    </div>
  </div>
</li>

<style>
  /* Scoped to this file (moved from global.css by
       scripts/scope-styles.mjs). See FaqSection.astro for how scoping works.
  */
  /* ---- split-trigger overrides, kept ADJACENT to what they override ----
         These two lived ~7,900 lines further down, in the whole-site nav section at
         the foot of this file, where they belong by topic. Moved here 2026-10-02
         because a reported "the override isn't applying" could not be reproduced
         from the file — the rule parsed, sat at brace depth 0, out-specified the
         base at (0,2,2) against (0,1,2), and the markup matched — yet devtools
         listed only the base rule as contributing. Proximity removes any dependency
         on the tail of a 350KB stylesheet being read, which was the one variable
         that could not be tested from the file alone. It is also simply better
         organisation: a rule whose entire job is to override the rule above it
         should not be eight thousand lines away from it.
  */
  :global(.nav-links) > li.nav-dd-split > a {
    /* The split trigger is a label plus a separate chevron <button>, so the
           pair has to read as ONE target — hence 6px here instead of the 16px
           above, closing the gap to the chevron's own 2px padding-left. Only the
           end variable changes; the start, and the underline, follow on their own.
  */
    --nav-link-padding-end: 6px;
  }

  /* Nav dropdown proposal (see navbar.html) — not yet adopted sitewide. Groups
         Weddings/Corporate/Celebrations under one "Events" trigger. Inert unless
         .nav-dd markup exists on the page, so safe to keep here even undecided.
         .nav-dd-panel is "position: fixed" (see the comment above it), which
         resolves against the viewport directly rather than the nearest positioned
         ancestor, so it can be centered and sized independently of this small
         trigger <li> while still living inside it in the DOM (kept there
         deliberately — see that same comment for why moving it out was tried and
         reverted).
         The real remaining gap, found by pinning :hover in devtools and
         confirming the panel itself works perfectly once truly hovered: .nav-dd's
         own box only wraps its button as tightly as the button's own size, not
         the full nav bar — .nav-links centers its items with room above and
         below, so the trigger's rendered bottom edge sits noticeably above the
         nav bar's actual bottom edge, where .nav-dd-panel starts. That gap
         belongs to neither element, so moving the mouse straight down from the
         button crosses dead space and drops :hover before ever reaching the
         panel — no transition delay can save a gap that's never actually
         entered. Explicit "height: var(--nav-h)" + flex centering on .nav-dd
         stretches its own box down to the nav bar's real bottom edge (this
         cascades: .nav-links, then <nav>, then .wrap all auto-size to their
         tallest item in a flex row, so this one explicit height on .nav-dd pulls
         all of them up to match .nav's own height too) — .nav-dd's hit-area now
         touches .nav-dd-panel's with nothing in between, the same principle as
         the pointer-events fix and the padding-top bridge above, just applied to
         the one remaining real gap instead of an assumed one.
  */
  .nav-dd {
    height: var(--nav-h);
    display: flex;
    align-items: center;
  }

  /* .nav-dd-panel: previously "position: absolute" against .wrap, whose own
         computed height (an auto-sized flex box centered inside .nav's 74px bar)
         isn't something to eyeball confidently — two rounds of guessing at it got
         the vertical gap wrong both times. Then tried moving the panel out to be
         a direct sibling of .nav so "top: var(--nav-h)" could anchor to .nav's
         own explicit height instead — that fixed the gap, but broke the hover
         chain a different way: once the panel was no longer a DOM descendant of
         .nav-dd, hovering the panel itself stopped counting as hovering .nav-dd,
         so leaving the trigger started the close transition regardless of the
         mouse now resting inside the panel — exactly the bug the pointer-events
         fix above was trying to solve, just moved one level up.
         "position: fixed" gets the same pixel-exact anchor as the sibling
         approach (fixed positioning resolves against the viewport itself, not
         the nearest positioned ancestor — and .nav starts at the viewport's own
         top edge, so "top: var(--nav-h)" means exactly the same thing either
         way) WITHOUT needing to move the panel out of .nav-dd — so it stays a
         real descendant, the built-in ".nav-dd:hover .nav-dd-panel" hover chain
         works again, and hovering the panel itself legitimately keeps .nav-dd
         "hovered" the whole time your cursor is inside it.
  */
  .nav-dd-panel {
    position: fixed;
    top: var(--nav-h);
    /* Centered on the viewport (left:50% + translateX(-50%) against a fixed
           element resolves against the viewport, same as .nav's own center since
           .wrap centers within it) — not left/right-anchored to an edge, since
           this panel is meant to be wider than .wrap's own 1180px content column
           (a mega-menu convention, not our normal reading-width container) and
           needs to extend symmetrically past both edges without one-sided
           clipping math.
  */
    left: 50%;
    transform: translateX(-50%);
    width: min(1376px, calc(100vw - 32px));
    padding-top: 24px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    /* pointer-events was missing from this list originally — with no
           transition entry it flips to "none" the instant the mouse leaves the
           trigger, before the 0.3s fade-out even starts. Kept as a second line of
           defense even with the dead zone gone above (e.g. covers a mouse that
           stops moving mid-transit for a beat).
  */
    transition:
      opacity 0.3s var(--ease),
      visibility 0s linear 0.3s,
      pointer-events 0s linear 0.3s;
  }

  .nav-dd-panel-card {
    display: flex;
    gap: 32px;
    padding: 28px;
    background: var(--limestone-2);
    border-radius: var(--radius-card);
    box-shadow: 0 30px 60px -24px rgba(var(--muted-ink-rgb), 0.5);
    transform: translateY(8px);
    transition: transform 0.3s var(--ease);
  }

  .nav-dd-panel-main {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* Fraunces stays reserved for the one genuine heading in here — lighter and
         larger than the old 20px/400 (matching the weight-300 editorial voice h2
         uses elsewhere) so it actually reads as a headline, not just a bolded
         label sitting at the same weight as the item names below it.
  */
  .nav-dd-panel-heading {
    font-family: "Fraunces", serif;
    font-size: 23px;
    font-weight: 300;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 20px;
  }

  /* Three columns, one row — at the panel's real width (up to 1376px) a
         two-column grid left each item too wide and the odd one out sitting alone
         on its own row; one row of three uses the space evenly for exactly the
         three items there are.
  */
  .nav-dd-items {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px 24px;
  }

  @media (--below-wide-tablet) {
    .nav-dd-items {
      grid-template-columns: 1fr;
    }
  }

  /* Never actually reached today — the burger takes over at 820px, well
           above this — but kept as a safety net rather than assuming that
           breakpoint never changes.
  */
  .nav-dd-panel-media {
    flex: 0 0 340px;
    border-radius: calc(var(--radius-card) - 2px);
    overflow: hidden;
  }

  @media (--below-desktop) {
    .nav-dd-panel-media {
      display: none;
    }
  }

  /* Matches the site's own existing tablet-ish cutover (e.g. the
           copy+image sections reordering at 980px) rather than a number invented
           for this one component. Below it, .wrap is narrow enough that a fixed
           340px image column would crowd the three-column item grid.
  */
  /* Plain descendant selectors again — .nav-dd-panel is back to being a real
         child of .nav-dd (see the comment above .nav-dd-panel), so it no longer
         needs :has() to reach it.
  */
  .nav-dd.is-open .nav-dd-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 0.3s var(--ease),
      visibility 0s linear 0s;
  }

  .nav-dd.is-open .nav-dd-panel-card {
    transform: translateY(0);
  }

  /* .is-hovering, not a bare ":hover" — see the long comment above .nav-dd.
         CSS :hover propagation depends entirely on the literal pixel path the
         cursor takes, and a narrow trigger next to a much wider, physically
         distant panel means any diagonal drift toward the panel's visual center
         can exit the trigger's hoverable box before ever touching the panel —
         confirmed directly (pinning :hover in devtools works perfectly; the
         failure is specifically in getting from trigger to panel by moving the
         mouse there normally). No amount of widening hit-areas or bridging gaps
         fixes that in general, because it's not really a size/position problem,
         it's that CSS has no notion of "still heading toward the target." JS
         mouseenter/mouseleave with a short close-delay (see the script at the
         bottom of navbar.html) does: it tolerates a brief moment of being
         "outside" while still moving, however the cursor got there, rather than
         trying to guess the exact geometry that keeps it "inside." :focus-within
         stays as plain CSS below — tabbing directly moves focus, no physical
         path involved, so it never had this problem.
  */
  .nav-dd.is-hovering .nav-dd-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 0.3s var(--ease),
      visibility 0s linear 0s;
  }

  .nav-dd.is-hovering .nav-dd-panel-card {
    transform: translateY(0);
  }

  /* Not gated behind (hover: hover) — that media query separates touch from
         mouse, which has nothing to do with keyboard focus. Gating this here
         would break keyboard access on any touch+keyboard hybrid device.
  */
  .nav-dd:focus-within .nav-dd-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 0.3s var(--ease),
      visibility 0s linear 0s;
  }

  .nav-dd:focus-within .nav-dd-panel-card {
    transform: translateY(0);
  }

  .nav-dd-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    /* 12px of left padding at EVERY state; the 2px border sits outside it and is
           always present, transparent until the row is hovered or current. Nothing
           reflows when it lands, which is the whole reason it is declared here
           rather than appearing on :hover. Ported from
           .package-stations-index-row on the Reception stations page, along with
           its asymmetric radius below.
  */
    padding: 11px 12px;
    border: 0;
    border-left: 2px solid transparent;
    /* Tight on the left where the marker sits, rounded on the right. A fully
           rounded left edge would leave the 2px bar as a floating curved sliver
           rather than a straight rule against the row.
  */
    border-radius: 3px calc(var(--radius-card) - 2px) calc(var(--radius-card) - 2px) 3px;
    text-decoration: none;
    /* 0.18s, not the 0.4s this was ported with. 0.4s suits
           .package-stations-index-row, which is a vertical index read slowly; a nav
           panel is swept across, and at 0.4s the row has not finished arriving
           before the pointer leaves — which reads as the hover being LATE rather
           than as a slow fade. Reported that way 2026-10-02. The label, description
           and icon transitions were shortened to match, or the row would arrive in
           two stages.
  */
    transition:
      background 0.18s var(--ease),
      border-color 0.18s var(--ease);
  }

  /* Ungated, unlike .nav-dd-trigger above — this is a real page link (like its
         .nav-links a siblings), so a lingering :hover on tap is moot (the sticky
         touch hover's documented exemption for controls that navigate away).
  */
  .nav-dd-item:hover {
    background: rgba(var(--gold-rgb), 0.12);
  }

  .nav-dd-item.active {
    background: rgba(var(--gold-rgb), 0.1);
  }

  .nav-dd-icon {
    flex: none;
    margin-top: 2px;
    color: var(--bronze);
  }

  /* Inter uppercase here, not Fraunces — per the design system, Fraunces is
         reserved for headings (the panel heading above already covers that role);
         this label is functionally the same thing as "WEDDINGS" in the plain nav
         bar, just relocated into a dropdown row, so it gets the same UI-chrome
         treatment every other nav label uses rather than borrowing the heading
         font a second time.
  */
  .nav-dd-label {
    display: block;
    font-family: "Inter", sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 5px;
  }

  .nav-dd-desc {
    display: block;
    font-family: "Newsreader", Georgia, serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.45;
    color: rgba(var(--ink-rgb), 0.62);
  }

  /* ============================================================================
         WHOLE-SITE NAV - dropdown panels, split triggers, drawer accordion
         ============================================================================
         Merged out of sandboxes/site-nav.html on 2026-10-02, live on index.html
         only for now. Every rule below was page-local in that sandbox; the sandbox
         keeps its own copy of the write-up styles and nothing else, so it still
         renders, but THIS is now the source of truth for the component.

         The sandbox's long-form reasoning comes with it deliberately - the
         measurements (why the burger moves to 980px, why the panel photo shrinks in
         the compact band), the specificity notes, and the two backdrop-filter bugs
         that come back if anyone re-adds the blur are all things that cost real time
         to find and are not re-derivable from the code.

         Two values that live in the ORIGINAL rules rather than here, so there is one
         source of truth per property: .nav .wrap's justify-content (now flex-start,
         which right-aligns the links) and .nav-links' gap (now 2px). Both are
         commented at their own definitions above.

         Inert on any page without .nav-dd markup, so the nine pages still carrying
         the old flat nav are unaffected.
         ============================================================================ */
  /* ============================================================
         Page-local only. The .nav-dd dropdown and .mobile-nav-group
         accordion components themselves live in styles.css (see the
         comment near .nav-dd there) — everything below is either this
         demo page's own layout, or one of the four additions listed in
         the comment at the top of this file.
         ============================================================ */
  /* RIGHT-ALIGNED NAV LINKS — part of the proposal, not a demo leftover.
         styles.css lays the real nav out as "justify-content: space-between",
         which puts the links in the middle of the bar; this groups them
         against the CTAs at the right edge instead, the treatment navbar.html
         has carried all along.
         Briefly removed on 2026-10-01 on the mistaken reading that it was a
         sandbox convenience rather than an intended design — it is intended,
         so it is restored and this comment exists so it does not get
         "cleaned up" a second time. Adopting this proposal means changing
         .nav .wrap in styles.css, which reaches every page's header; it is
         not a page-local tweak, and it is the one change here that alters the
         live nav's layout rather than only adding to it.
  */
  /* ---------- (a) .nav-dd-split: a trigger that both navigates and opens ----------
         navbar.html's .nav-dd-trigger is a single <button>, which is right
         for a pure grouping label but cannot navigate. This proposal wants
         Restaurant and Events to be real destinations (decision 2), so the
         label is a genuine <a> and the chevron is its own <button> beside
         it. Consequences handled below, in order:
           - The <a> is a DIRECT child of li.nav-dd, so it already inherits
             every ".nav-links > li > a" treatment for free, hover underline
             included. Nothing to restate.
           - The pair must read as ONE target, so the gap between them is
             closed by trimming the <a>'s right padding and the button's
             left padding rather than letting two 16px paddings sit back to
             back.
           - Keyboard order is label → chevron → panel rows, which is the
             reading order; :focus-within on .nav-dd (styles.css) opens the
             panel for either.
  */
  /* The two .nav-links > li.nav-dd-split > a rules that used to sit here (the
         padding that closes the gap to the chevron, and the underline inset that
         follows it) now live next to .nav-links > li > a near the top of this file,
         beside the rules they override. See the note there.
  */
  /* align-self: stretch, because .nav-dd is "align-items: center" on an
         explicit 74px height, so this button otherwise sits at its content
         height — 29 x 27px. That clears WCAG 2.5.8's 24px minimum but is well
         short of the comfortable 44px, and it matters more than it looks:
         between 980px and roughly 1100px there is no hover, so this chevron
         is the ONLY way a touch user can open a panel. Stretching takes it to
         29 x 74 at zero visual cost, since the button is already a centred
         flex container and the SVG stays optically where it was.
         The LABEL deliberately does not get the same treatment — it carries
         the gold underline-reveal at "bottom: 4px" of its own box, so
         stretching it would drop that underline to the bottom of the nav
         bar.
  */
  /* 6px (styles.css) down to 2px. The links already carry 16px of
         padding a side, so adjacent labels have 32px between them before the
         gap is counted at all — 6px was adding a seventh of that again for no
         structural reason. Reads tighter now that the links sit against the
         CTAs rather than centred: a compact link cluster is legible as ONE
         group distinct from the two buttons, where a loose one blurs into
         them. The compact band below takes it the rest of the way to 0.
         The hover underline is unaffected — .nav-links > li > a::after is
         inset 16px from the link's own edges, so the visible gap between two
         underlines is 32px + this, and 4px off that is imperceptible.
  */
  /* padding-left 4px -> 2px, so the chevron sits 2px nearer its word
         (the seam was the link's 6px padding-right plus this, 10px total;
         now 8px). Taken off THIS side rather than the link's padding-right
         because that value also sets where the underline stops — moving it
         would pull the gold bar in under the text. Cost worth stating: the
         button is now 27px wide rather than 29px. Still over WCAG 2.5.8's
         24px minimum, and the align-self below makes it 74px tall, so the
         target area is comfortably larger than it was before either change.
  */
  .nav-dd-split-chevron-button {
    display: flex;
    align-items: center;
    align-self: stretch;
    padding: 10px 14px 10px 2px;
    background: none;
    border: none;
    color: rgba(var(--limestone-rgb), 0.7);
    cursor: pointer;
    transition: color 0.35s;
  }

  @media (--hover) {
    .nav-dd-split-chevron-button:hover {
      color: #fff;
    }
  }

  @media (--no-hover) {
    .nav-dd-split-chevron-button:active {
      color: #fff;
    }
  }

  /* Same-page toggle, not a page link, so it needs the sticky touch hover's touch
         hover-gate: a tap would otherwise leave it looking permanently
         hovered instead of clearing on release. Identical reasoning to
         .nav-dd-trigger's own gate in styles.css.
  */
  /* Keeps the LABEL lit while the panel is open, so the pair reads as
         one lit control rather than a lit chevron next to a dim word.
         styles.css already does this for .nav-dd-trigger; the <a> needs
         its own line. At (0,2,0) this beats ".nav-links > li > a"'s (0,1,2)
         on class count, while ".nav-links > li > a.active" at (0,2,2) still
         beats THIS — so an active page stays gold rather than going white
         whenever its own dropdown is open.
  */
  .nav-dd.is-open > a,
  .nav-dd.is-hovering > a,
  .nav-dd:focus-within > a {
    color: #fff;
  }

  .nav-dd.is-open .nav-dd-split-chevron-button,
  .nav-dd.is-hovering .nav-dd-split-chevron-button,
  .nav-dd:focus-within .nav-dd-split-chevron-button {
    color: #fff;
  }

  /* ============================================================
         (e) DARK CARD — .nav-dd-panel-card-dark
         ============================================================
         The light card was the one thing about this treatment that did not
         match the plan: the nav is dark, so the dropdown was always meant to
         be too. Colour is a property of the CARD, not of the layout, so this
         keeps the three-column grid (which absorbs new links sideways —
         nine items is three clean rows) and takes the Events #2 panel's
         colour instead of its single-column shape.

         A modifier stacked on the base class rather than an edit to
         .nav-dd-panel-card itself, so the base keeps the light treatment that
         was compared against in the prototype.

         NO backdrop-filter HERE, and that is the whole point of this rule
         being three lines long. The Events #2 panel frosts its card the way
         .nav::after does, which is where this colour comes from — but the
         scrim behind an open panel is already rgba(--muted-ink, 0.5), and
         0.86 on top of that puts the card at roughly 93% opaque against the
         actual page. About 7% of a blur(14px) was reaching the eye, while
         paying for the one declaration measured as a dominant scroll
         cost on .package-sticky-switch. Measured against that, the blur was
         buying nothing. The flat alpha alone still carries the "extension of
         the nav bar" read, because what does that work is the colour matching
         .nav::after's, not the blur.

         DROPPING IT REMOVED TWO WORKAROUNDS RATHER THAN ONE, which is why
         this is a simplification and not just a deletion. Both are real bugs,
         both were solved once on the prototype's rejected single-column
         panel, and BOTH COME BACK THE
         MOMENT ANYONE RE-ADDS backdrop-filter HERE — so they are written down
         rather than quietly discarded:

         1. backdrop-filter AND border-radius on the SAME box produces a black
            hairline seam along the rounded edge in Chromium/WebKit, worst
            while the card is mid-transition. That forced the background onto
            a ::before with inset:-1px so its antialiased boundary fell
            outside the visible corner, with the card itself doing nothing but
            clip. With no blur, background and border-radius coexist happily
            on one box, so the ::before, its overflow:hidden, and the z-index
            rules that lifted both children above it are all gone.
         2. ANY transform on an ancestor of a backdrop-filter element isolates
            it into its own compositing layer, cutting the blur off from
            sampling the page behind it — the frost reads flatly opaque.
            .nav-dd-panel-card's open/close lift is
            "transform: translateY(8px) → translateY(0)", which made that
            lift unusable and forced a margin-top re-implementation plus an
            is-open override to match. With no blur, the base class's own
            transform lift just works, so both are gone too.

         What is left is one declaration.

         ALPHA RAISED 0.86 → 0.97, then settled at 0.91 on review — enough to
         stop the page reading through, with more of the frosted character
         than 0.97 kept. Over the 0.5 scrim that is about 95.5% opaque.
         (Original note follows.) Reported: too much of the page was reading
         through the panel). Note this is the RIGHT lever for that complaint
         and re-adding the blur is not: a blur softens what comes through, it
         does not reduce how much does — that is what alpha controls, and
         alpha is free where the blur was not. 0.97 over the 0.5 scrim puts
         the card at about 98.5% opaque, so nothing legible survives behind
         it, while the last whisper of transparency keeps it from reading as
         a flat sheet pasted over the page. Going fully solid is the next
         step if even that is too much.
         The trade is worth naming: a genuinely frosted panel REQUIRES low
         alpha, because frost is literally the page showing through blurred.
         Frost and an opaque panel are mutually exclusive, so this is a choice
         between them rather than a tuning problem.
  */
  /* THE HAIRLINE (added 2026-10-02). Over a light section the card's own
         darkness defines its edge; over a DARK one the card and the scrimmed ground
         behind it land close enough together that the panel stops reading as a card
         at all. A border is the standard answer to "this surface has no edge", and
         gold is not an invention here: .nav.stuck already defines the bar's own
         bottom edge with rgba(--gold-rgb, 0.22) once scrolled, and this exact
         1px/0.2 pairing is already used elsewhere in this file — so the panel
         hanging off the bar picks up a line the site already speaks rather than
         introducing a second vocabulary.
         0.2 rather than something heavier on purpose: this has to define an edge,
         not frame the panel in, which is the same judgement .tab-panel li makes
         about its own dividers.
         A GRADIENT border was considered and not taken for now — it needs either
         border-image or a masked ::before, and on a surface this large it starts
         reading as decoration rather than definition. The version worth revisiting
         if a flat line proves too quiet is a TOP-WEIGHTED gradient: strongest where
         the card meets the bar and fading down the sides, which is what an actual
         light source would do.
  */
  .nav-dd-panel-card-dark {
    background: rgba(var(--muted-ink-rgb), 0.91);
    /* 1.5px, up from the 1px this started at. A hairline defined the card's
           edge over a dark section but only just; half a pixel more gives it enough
           presence to read as a card without becoming a frame.
           Fractional borders antialias rather than landing on a device pixel, so on
           a 1x display this renders as a soft line rather than a crisp one. If that
           reads fuzzy, the alternative that avoids subpixels entirely is going back
           to 1px and raising the alpha to around 0.28 — same perceived weight, no
           antialiasing. Worth checking on an external monitor before settling.
           A TOP-WEIGHTED GRADIENT version of this border was built and removed on
           2026-10-02: brightest where the card met the bar and fading down the
           sides, via a masked ::before. It worked, but it was more machinery than
           the job needed and read as decoration on a surface this large. The flat
           line does the actual work, which is telling you where the card ends.
  */
    border: 1.5px solid rgba(var(--gold-rgb), 0.2);
  }

  /* ---------- Text recoloured for the dark card ----------
         Values taken from the prototype's rejected single-column panel, which
         was dark first, rather than invented. Each is scoped under
         .nav-dd-panel-card-dark so the base card's light treatment is
         untouched.
  */
  .nav-dd-panel-card-dark .nav-dd-panel-heading {
    color: var(--limestone-2);
  }

  /* Rows now REST DIM and the hovered one lights up, rather than every row
         sitting at full brightness with only the background moving. That is the
         half of the stations treatment worth having on its own: with the label
         already at --limestone-2 there was no headroom to brighten into, so hover
         could only add a wash. The comment on that page puts it best - the current
         row should be the LIT one, not the loud one, and most of that work is done
         by its neighbours resting lower.
  */
  .nav-dd-panel-card-dark .nav-dd-label {
    color: rgba(var(--limestone-rgb), 0.86);
    transition: color 0.18s var(--ease);
  }

  .nav-dd-panel-card-dark .nav-dd-desc {
    color: rgba(var(--limestone-rgb), 0.74);
    transition: color 0.18s var(--ease);
  }

  @media (--hover) {
    .nav-dd-panel-card-dark .nav-dd-item:hover {
      background: rgba(var(--limestone-rgb), 0.07);
      border-left-color: var(--gold);
    }
  }

  @media (--hover) {
    .nav-dd-panel-card-dark .nav-dd-item:hover .nav-dd-label {
      color: var(--limestone-2);
    }
  }

  @media (--hover) {
    .nav-dd-panel-card-dark .nav-dd-item:hover .nav-dd-desc {
      color: rgba(var(--limestone-rgb), 0.78);
    }
  }

  @media (--hover) {
    .nav-dd-panel-card-dark .nav-dd-item:hover .nav-dd-icon {
      color: var(--gold-2);
    }
  }

  /* (0,4,0) - one more class than the [data-unbuilt] label rule below at
           (0,3,0), so an unbuilt row brightens on hover too rather than staying
           pinned at its dimmer resting value.
  */
  /* (0,4,0), so it beats BOTH resting icon rules - the plain one at (0,2,0)
           and the [data-unbuilt] one at (0,3,0). Without that, unbuilt rows would
           be the only ones whose icon stayed dark on hover.
  */
  /* The wash is LIMESTONE, not gold, and the gold is spent entirely on the
         left border. This is the lesson the stations page already learned and
         recorded: a gold tint behind a gold border beside a gold badge is three
         golds at three strengths in one row, and the quietest of them stops
         registering. These rows carry a Proposed badge and a bronze icon, so they
         would have hit it immediately. One gold event per hover, and the surface
         says "this row" while the border says "gold".
         0.07 looks faint written down and is right rendered: it is doing far less
         work than the old 0.16 gold wash because the border and the label
         brightening now carry the state between them.
  */
  /* Current page. Not gated behind (hover: hover) - this is a persistent
         state, not feedback, and a touch visitor needs to see where they are as
         much as anyone.
         Until 2026-10-04 this was the hover treatment exactly, held — wash,
         border, label and icon — so on returning to a panel the current page's
         row read as a hover that never cleared. Now it keeps the gold border,
         brightened label and gold icon but NOT the limestone wash, which is left
         to mean "pointer is here", and adds a gold dot after the label as its own
         "you are here" mark.
         background is set explicitly, not just omitted: the light card's
         .nav-dd-item.active gold wash (0,2,0) would otherwise show through. That
         makes this (0,3,0) rule beat the (0,3,0) hover wash above on source
         order, so hovering the current row gets its own (0,4,0) rule below.
  */
  .nav-dd-panel-card-dark .nav-dd-item.active {
    background: transparent;
    border-left-color: var(--gold);
  }

  @media (--hover) {
    .nav-dd-panel-card-dark .nav-dd-item.active:hover {
      background: rgba(var(--limestone-rgb), 0.07);
    }
  }

  /* A flex item in the label's baseline-aligned row (see the .nav-dd-label
         override further down), so it centres itself rather than sitting on the
         baseline, which an empty box would otherwise do.
  */
  .nav-dd-panel-card-dark .nav-dd-item.active .nav-dd-label::after {
    content: "";
    flex: none;
    align-self: center;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold);
  }

  .nav-dd-panel-card-dark .nav-dd-item.active .nav-dd-label {
    color: var(--limestone-2);
  }

  .nav-dd-panel-card-dark .nav-dd-item.active .nav-dd-icon {
    color: var(--gold-2);
  }

  /* (0,3,0) with the attribute selector, beating the plain label rule
         above at (0,2,0) — the dim treatment for an unbuilt row has to win
         over the normal one.
  */
  .nav-dd-panel-card-dark .nav-dd-item[data-unbuilt] .nav-dd-label {
    color: rgba(var(--limestone-rgb), 0.74);
  }

  .nav-dd-panel-card-dark .nav-dd-item[data-unbuilt] .nav-dd-icon {
    color: rgba(var(--bronze-on-dark-rgb), 0.78);
  }

  /* The icon rests dim and lights with the label, rather than sitting at full
         strength while the text around it moves. Same reasoning as the labels: at
         full --bronze there was no headroom to brighten into, so the icon was the
         one part of a hovered row that did not respond.
         It brightens to --gold-2, not to full bronze, because bronze-to-bronze is
         too small a move to read at 18px. That does put a second gold in the row
         alongside the left border - which the stations page's own note warns
         about - but the case there was gold tint BEHIND a gold border beside a
         gold badge, three of them at three strengths with the background among
         them. Here the wash is limestone and the badge is bronze, so the only two
         gold things are the border and the icon, both of which appear together on
         the same event. One gold moment, two marks.
  */
  .nav-dd-panel-card-dark .nav-dd-icon {
    /* --bronze-on-dark at full strength, not --bronze at an alpha. See that
           token's note: the previous 0.72 then 0.85 passes were both trying to
           brighten a colour that is simply too dark for this surface, and alpha
           only ever moves it toward the background.
  */
    /* 0.85, not the 0.72 the labels rest at. Equal alpha is NOT equal
           brightness: --limestone is #f7f2e6, so 0.72 of it over a dark card is
           still clearly light, while --bronze is #8a7442 — already a dark colour —
           and 0.72 of that lands close to the card itself. Matching the numbers
           made the icon read as nearly off rather than as resting. The headroom for
           the hover is carried by the jump to --gold-2, which is a hue change as
           much as a brightness one, so it does not need the alpha gap the text
           does.
  */
    color: var(--bronze-on-dark);
    transition: color 0.18s var(--ease);
  }

  /* ---------- (b) Proposed-page markers ----------
         Several rows in these panels point at pages that do not exist yet.
         Rather than letting them look like working links in a pitch, each
         carries a ProposedBadge (bronze, small) and site-nav.js
         preventDefault()s it. The badge's own look lives in the component;
         only its placement beside the label is this file's.
  */
  /* The badge's 8px margin-left used to follow it onto the next line
         when the label wrapped, indenting it under nothing — reported on
         "Preferred suppliers", which is the one label long enough to wrap and
         push its badge down. The facetious version of the fix ("a media query
         for whether it wrapped") is actually the right instinct: CSS has no
         selector for that, so the answer is to stop using a margin and let a
         GAP do the spacing, since a flex gap applies between items on a line
         and never at the start of one.
         So the label becomes a flex container. Its own text stays a bare text
         node, which flex wraps in an anonymous item that still line-breaks
         internally exactly as it did; the badge is the second item, and
         flex-wrap drops it to its own flex line when it does not fit — flush
         left, no phantom indent. align-items: baseline keeps the badge
         sitting on the label's baseline rather than centred against a
         two-line block, which is what inline-block was giving for free and
         what a naive switch to flex would have quietly lost.
         Scoped to the dark card rather than edited into styles.css's
         .nav-dd-label, since navbar.html shares that class and has no badges
         to need it.
  */
  .nav-dd-panel-card-dark .nav-dd-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
  }

  /* ============================================================
         (f) THE HUB MOVED OUT OF THE GRID, into the heading row
         ============================================================
         The hub ("The restaurant" / "All events") is the dropdown's own
         parent page, and it has to be reachable by tap, since on touch there
         is no hover to separate "open the menu" from "go to the page". It was
         a row spanning all three columns, with a hairline under it. That is
         what made the Restaurant panel feel bloated, and the geometry says
         exactly why:

           RESTAURANT                        EVENTS
           ┌───────────────────────────┐     ┌───────────────────────────┐
           │ The restaurant      (hub) │     │ All events          (hub) │
           ├───────────────────────────┤     ├───────────────────────────┤
           │ Menus │ Chambers │ Vouch. │     │ Weddings │ Corp. │ Celebr.│
           └───────────────────────────┘     │ Spaces   │ Suppl.│ Guides │
                                             └───────────────────────────┘
             hub = 1 of 2 rows → 50% of        hub = 1 of 3 rows → 33% of
             the height for 1 of 4 links       the height for 1 of 6 links

         Same component, different proportion — which is why one panel read
         as mostly empty and the other read fine. On Restaurant the hub was
         half the panel's height for a quarter of its content, a short label
         and one line of description sprawled across the full 948px of the
         content column.
         Moving it onto the heading's own line costs no grid row at all, and
         it stays reachable two ways on touch (this link, plus the nav label
         itself, which is a real <a> — see .nav-dd-split). Measured result:
         Restaurant drops from roughly 260px to 180px, Events from 365px to
         270px.
         Note the knock-on that makes Events tidier too: with the hub out of
         the grid, adding Guides takes it to six items — two clean rows of
         three, which also closes the empty third cell its bottom row used
         to have.
  */
  .nav-dd-panel-heading-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    /* Takes over .nav-dd-panel-heading's own 20px bottom margin, zeroed
           below — a margin on a flex item inside this row would push the
           row's own height around instead of setting the gap beneath it.
  */
    margin-bottom: 20px;
  }

  .nav-dd-panel-heading-row .nav-dd-panel-heading {
    margin-bottom: 0;
  }

  /* Inter uppercase, matching every other piece of UI chrome rather than
         borrowing Fraunces a second time — the same reasoning as
         .nav-dd-label's own comment in styles.css.
  */
  /* Sized and lit as a PEER of the row labels below it, not as a caption.
         It was 10.5px at 0.62 alpha with 0.14em tracking — smaller, dimmer
         AND more letter-spaced than .nav-dd-label's 12.5px/0.07em, and wide
         tracking makes uppercase read smaller still, so all three pushed the
         same way and the panel's own parent page became the easiest link in
         it to miss. Now 12px at 0.8, tracking pulled back to 0.12em.
         Deliberately NOT gold at rest: that would compete with the Fraunces
         heading it shares a baseline with, and gold is what the hover and
         current-page states use.
  */
  .nav-dd-hub-link {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: "Inter", sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(var(--limestone-rgb), 0.9);
    text-decoration: none;
    transition: color 0.35s;
  }

  /* Ungated :hover — a real page link, so the sticky touch hover's touch exemption
         applies: tapping navigates away and a lingering hover is moot.
  */
  .nav-dd-hub-link:hover {
    color: var(--gold-2);
  }

  /* Gold rather than the rows' background wash: the rows are full-width
         blocks, and a wash behind a short inline label in a heading row
         would read as a stray chip. Without this the script's own .active
         class would be a silent no-op here, since nothing else styles it.
  */
  .nav-dd-hub-link.active {
    color: var(--gold-2);
  }

  /* ============================================================
         (g) THE PHOTOGRAPH NOW ANSWERS THE HOVERED ROW
         ============================================================
         The best thing about the Events #2 panel was that its photo column
         changed to match whichever row you were reading — for a venue, where
         the product IS the room, that beats one static decorative image. The
         mechanism is not specific to that panel's layout: it is :has()
         keyed off each row's data-target, entirely in CSS, no JS. So it
         ports onto this grid unchanged in principle.
         It was expensive before, because one <img> per state meant every
         photo downloading on page load. The deferred loading below (see
         primeDropdownMedia in the script) makes it close to free, which is
         what made this worth doing here at all.
  */
  .nav-dd-panel-media {
    position: relative;
  }

  /* Darkens only where the caption sits, so the photograph itself stays
         bright — a flat overall tint would dim the image to light the text.
  */
  .nav-dd-panel-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(var(--ink-rgb), 0) 40%,
      rgba(var(--ink-rgb), 0.8) 100%
    );
  }

  /* ::after is painted as the last child regardless of source order, so
         without an explicit z-index the gradient would paint over the
         caption and darken the text along with the photo.
  */
  .nav-dd-panel-caption {
    position: absolute;
    z-index: 1;
    left: 18px;
    right: 18px;
    bottom: 16px;
    margin: 0;
    font-family: "Newsreader", Georgia, serif;
    font-style: italic;
    font-weight: 350;
    font-size: 15px;
    line-height: 1.375;
    /* Matches .quote blockquote — the site's existing precedent for
           italic text over a photo — rather than plain white.
  */
    color: var(--limestone-2);
    /* Layered: a tight dark shadow for edge definition against bright
           patches, plus a softer one for separation from the image.
  */
    text-shadow:
      0 1px 3px rgba(0, 0, 0, 0.9),
      0 2px 10px rgba(0, 0, 0, 0.7);
    opacity: 0;
    transition: opacity 0.28s var(--ease);
  }

  .nav-dd-panel-caption[data-state="default"] {
    opacity: 1;
    transition: opacity 0.28s var(--ease) 0.15s;
  }

  @media (--reduced-motion) {
    .nav-dd-panel-card .nav-dd-panel-caption[data-state] {
      transition: none;
    }
  }

  .nav-dd-panel-card:has(.nav-dd-item[data-target]:is(:hover, :focus))
    .nav-dd-panel-caption[data-state="default"] {
    opacity: 0;
    /* The other half of the asymmetry above: no delay leaving, so landing
           on a row swaps the photo at once. Written as the full shorthand
           rather than a lone transition-delay — a bare delay here would have
           to win against a shorthand on the same element, which is the
           same-specificity collision's trap in miniature (the shorthand resets delay
           to 0, and whichever loads later takes the property wholesale).
  */
    transition: opacity 0.28s var(--ease) 0s;
  }

  .nav-dd-panel-card:has(.nav-dd-item[data-target="menus"]:is(:hover, :focus))
    .nav-dd-panel-caption[data-state="menus"] {
    opacity: 1;
  }

  .nav-dd-panel-card:has(.nav-dd-item[data-target="weddings"]:is(:hover, :focus))
    .nav-dd-panel-caption[data-state="weddings"] {
    opacity: 1;
  }

  .nav-dd-panel-card:has(.nav-dd-item[data-target="corporate"]:is(:hover, :focus))
    .nav-dd-panel-caption[data-state="corporate"] {
    opacity: 1;
  }

  .nav-dd-panel-card:has(.nav-dd-item[data-target="celebrations"]:is(:hover, :focus))
    .nav-dd-panel-caption[data-state="celebrations"] {
    opacity: 1;
  }

  .nav-dd-panel-card:has(.nav-dd-item[data-target="spaces"]:is(:hover, :focus))
    .nav-dd-panel-caption[data-state="spaces"] {
    opacity: 1;
  }

  @media (--from-desktop) and (--below-nav-full) {
    .nav-dd-split-chevron-button {
      padding-right: 8px;
    }
  }

  @media (--from-desktop) and (--below-nav-full) {
    :global(.nav-links) > li.nav-dd-split > a {
      --nav-link-padding-end: 4px;
    }
  }

  @media (--from-desktop) and (--below-nav-full) {
    .nav-dd-panel-media {
      flex-basis: 240px;
    }
  }

  @media (--from-desktop) and (--below-nav-full) {
    .nav-dd-items {
      column-gap: 16px;
    }
  }

  @media (--from-desktop) and (--below-nav-full) {
    .nav-dd-item {
      padding-left: 8px;
      padding-right: 8px;
      gap: 10px;
    }
  }

  .nav-dd.is-open :global(.nav-dd-chevron),
  .nav-dd.is-hovering :global(.nav-dd-chevron) {
    transform: rotate(180deg);
  }

  .nav-dd:focus-within :global(.nav-dd-chevron) {
    transform: rotate(180deg);
  }

  .nav-dd-panel-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nav-dd-hub-link :global(svg) {
    flex: none;
    transition: transform 0.35s var(--ease);
  }

  .nav-dd-hub-link:hover :global(svg) {
    transform: translateX(3px);
  }

  /* Stacked, all filling the same box — a real crossfade needs two
         images overlapping in opacity. Fading one <img> out before swapping
         its src shows the card's own background through the gap where
         neither photo is visible; this never opens that gap.
  */
  .nav-dd-panel-media :global(img) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.28s var(--ease);
  }

  /* --- The default pair fades back IN on a delay, but OUT instantly ---
         Reported: moving quickly between rows flashes the default photo
         between them. Correctly diagnosed as the gap — :has() only matches
         while a row is actually hovered, and the grid's 4px row gap and 24px
         column gap are real dead space where no row is, so the default pair
         starts fading back in and then straight back out again.
         Fixed by making that return asymmetric rather than by closing the
         gaps (which would have meant setting gap: 0 and letting the hover
         washes touch — a layout change to fix a timing problem). A 0.15s
         delay on the default's fade-IN is longer than any realistic transit
         across a 24px gap, so a row-to-row move never gives it time to
         start; the :has() rule below cancels the delay for the fade-OUT, so
         entering a row is still immediate. Dwelling in a gap for longer than
         0.15s does bring the default back, which is correct — at that point
         you genuinely aren't on a row.
         Specificity note, since this rule now carries `transition` and so
         can collide: (0,2,1) here beats the base .nav-dd-panel-media img at
         (0,1,1), which is what makes the delay stick.
  */
  .nav-dd-panel-media :global(img[data-state="default"]) {
    opacity: 1;
    transition: opacity 0.28s var(--ease) 0.15s;
  }

  @media (--reduced-motion) {
    .nav-dd-panel-card .nav-dd-panel-media :global(img[data-state]) {
      transition: none;
    }
  }

  @media (--reduced-motion) {
    .nav-dd-hub-link:hover :global(svg) {
      transform: none;
    }
  }

  /* Scoped through .nav-dd-panel-card to reach (0,3,1) and (0,3,0),
           which beat the [data-state="default"] rules above at (0,2,1) and
           (0,2,0). A bare ".nav-dd-panel-media img" would be (0,1,1) and
           would silently LOSE to them — so the crossfade, and now its delay,
           would have kept animating for anyone who asked it not to. Latent in
           this block from the moment the default pair got its own rule; worth
           re-checking any reduced-motion override that sits next to a
           state-attribute rule.
  */
  /* The crossfade trigger. Each row carries data-target naming one
         image/caption pair's data-state; :has() asks whether a row with that
         target is currently hovered or focused and, if so, opts that pair in
         while opting the default pair out. :is() folds hover and focus into
         one selector rather than writing every rule twice — focus matters,
         it is what makes the photo follow a keyboard user through the list.
         Rooted at .nav-dd-panel-card, not .nav-dd, so a state name can never
         match across from the other panel despite the shared ancestor.
         Rows with NO data-target deliberately leave the default photo up:
         there is no photograph of a page that does not exist, and — flagged
         to the client — none of the vaulted chambers either.
  */
  .nav-dd-panel-card:has(.nav-dd-item[data-target]:is(:hover, :focus))
    .nav-dd-panel-media
    :global(img[data-state="default"]) {
    opacity: 0;
    /* The other half of the asymmetry above: no delay leaving, so landing
           on a row swaps the photo at once. Written as the full shorthand
           rather than a lone transition-delay — a bare delay here would have
           to win against a shorthand on the same element, which is the
           same-specificity collision's trap in miniature (the shorthand resets delay
           to 0, and whichever loads later takes the property wholesale).
  */
    transition: opacity 0.28s var(--ease) 0s;
  }

  .nav-dd-panel-card:has(.nav-dd-item[data-target="menus"]:is(:hover, :focus))
    .nav-dd-panel-media
    :global(img[data-state="menus"]) {
    opacity: 1;
  }

