---
// The weddings page's opening: the three spaces and what's included, beside
// the Secret Garden at night, with a link down to the packages.
import CheckList from "@components/ui/CheckList.astro"
import Photo from "@components/ui/Photo.astro"
---

<section class="section-padding">
  <div class="wrap split">
    <div>
      <div class="eyebrow" data-reveal>
        Three spaces, one wedding a day
      </div>
      <h2 data-reveal style="--d: 80ms">
        The Secret Garden,
        <br />
        and the <em>Prince De Redin</em> Hall
      </h2>
      <p class="lead" data-reveal style="--d: 160ms; margin-top: 22px; max-width: 52ch">
        Bacchus is never shared on your day.
      </p>
      <p class="lead" data-reveal style="--d: 180ms; margin-top: 12px; max-width: 52ch">
        The Prince De Redin Hall seats the wedding breakfast, the Terrace holds the bar
        and late dancing, and the Secret Garden — home to Roman and Arab architectural
        remains dating back to the 1st century — is kept for the ceremony, drinks and
        photographs in between.
      </p>
      <CheckList
        items={[
          "Private hire of the Hall, Terrace and Secret Garden — one wedding a day, always",
          "Set or bespoke menus, tasted in advance with your dedicated Events Manager",
          "In-house wine list, sourced from Maltese producers",
          "Indoor ceremony option if the Mdina weather turns",
        ]}
      />
      <div data-reveal style="--d: 320ms; margin-top: 32px">
        <a href="#packages" class="link-underline">
          See the package categories <span class="arrow">↓</span>
        </a>
      </div>
    </div>
    <div class="ph-wrap" data-reveal="img">
      <Photo
        src="venue/secret-garden-night"
        sizes="(max-width: 980px) 100vw, 50vw"
        alt="The Secret Garden at Bacchus, candlelit tables strung with fairy lights at night"
      />
    </div>
  </div>
</section>

<style>
  /* Scoped to this file (moved from global.css by
     scripts/scope-styles.mjs). See FaqSection.astro for how scoping works. */
  /* Scoped to this page (moved from global.css by
       scripts/scope-styles.mjs). See FaqSection.astro for how scoping works. */
  /* a.link-underline (not just .link-underline) so this beats [data-reveal]'s
       own transition list on specificity — the "View Gallery" links also carry
       data-reveal, and two same-specificity rules both setting `transition` on
       one element means the later rule (here, [data-reveal] below) wins
       wholesale and silently drops color from the list otherwise. */
  a.link-underline {
    position: relative;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    padding-bottom: 6px;
    display: inline-flex;
    gap: 4px;
    align-items: center;
    color: var(--ink);
    border-bottom: 1px solid rgba(var(--muted-ink-rgb), 0.22);
    transition: color 0.35s var(--ease);
  }
  .link-underline::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 100%;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease);
  }
  .link-underline:hover {
    color: var(--gold);
  }
  .link-underline:hover::after {
    transform: scaleX(1);
  }
  .link-underline .arrow {
    display: inline-block;
    transition: transform 0.35s var(--ease);
  }
  .link-underline:hover .arrow {
    transform: translateX(4px);
  }
  @media (hover: none) {
    .link-underline:active {
      color: var(--gold);
    }
  }
  @media (hover: none) {
    .link-underline:active::after {
      transform: scaleX(1);
    }
  }
  @media (hover: none) {
    .link-underline:active .arrow {
      transform: translateX(4px);
    }
  }
</style>
