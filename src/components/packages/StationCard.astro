---
// One Reception station: photo with name and price (opens the lightbox,
// whose caption is built from data-detail), the category, what's on the
// table, a serving note, and the "Add to selection" toggle that
// ReceptionStations.js reveals and drives.
import type { Station } from "@data/packages/reception-stations"
import Photo from "@components/ui/Photo.astro"
import PackageMenuItem from "./PackageMenuItem.astro"
import Button from "@components/ui/Button.astro"

interface Props {
  station: Station
  categoryLabel: string
  // Each browser on the page is its own lightbox group, so the lightbox's
  // arrows only step through the copy that was opened.
  lightboxGroup: string
}

const { station, categoryLabel, lightboxGroup } = Astro.props
// The lightbox caption: serving note, then every item, with "(V)" in
// plain text where the card shows the marker.
const detail = `${station.servingNote} ${station.items
  .map((item) => (item.vegetarian ? `${item.name} (V)` : item.name))
  .join(" · ")}`
---

<li
  class="package-station-card"
  data-station={station.number}
  data-group={station.category}
>
  <figure
    class="package-station-card-figure"
    data-lb-group={lightboxGroup}
    data-title={station.name}
    data-tag={`${station.price} ${station.priceUnit}`}
    data-detail={detail}
  >
    <Photo
      src={station.photo.src}
      sizes="(max-width: 620px) 85vw, 420px"
      maxWidth={960}
      alt={station.photo.alt}
      loading="lazy"
      decoding="async"
    />
    <span class="package-station-card-expand-badge" aria-hidden="true">
      <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
        <path
          d="M1 5V1h4M9 1h4v4M13 9v4H9M5 13H1V9"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </span>
    <figcaption class="package-station-card-caption">
      <h3 class="package-station-card-name">{station.name}</h3>
      <p class="package-station-price">
        <span class="package-station-price-amount">{station.price}</span>
        <span class="package-station-price-unit">{station.priceUnit}</span>
      </p>
    </figcaption>
  </figure>
  <div class="package-station-card-body">
    <p class="eyebrow eyebrow-static">{categoryLabel}</p>
    <ul class="package-station-item-list">
      {station.items.map((item) => (
        <PackageMenuItem item={item} />
      ))}
    </ul>
    <p class="package-station-serving-note">{station.servingNote}</p>
    <Button
      variant="gradient"
      small
      class="package-station-add-button"
      data-station={station.number}
      aria-pressed="false"
      hidden
    >
      <svg
        class="package-station-add-button-icon"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 5v14M5 12h14"></path>
      </svg>
      <span class="package-station-add-button-label">Add to selection</span>
      <span class="package-stations-visually-hidden">— {station.name}</span>
    </Button>
  </div>
</li>
