---
// The gold-tick list used in the "split" intro sections (weddings,
// corporate, celebrations). Not the divided .tab-panel list — see the
// prototype's CLAUDE.md, "Divided lists", for why the two differ.
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<ul class="check" data-reveal style="--d: 240ms">
  {
    items.map((item) => (
      <li>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path
            d="M3 8.5 6.5 12 13 4"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        {item}
      </li>
    ))
  }
</ul>
