---
// Every pill button on the site. Renders an <a> when given `href`, a
// <button> otherwise (type="button" unless told it submits — a bare
// <button> inside a form would submit it, the implicit-submit bug), or, with
// as="span", a decorative pill inside a card whose whole surface is the
// real link.
//
// The look is a variant plus modifiers:
//   variant  gradient (the gold CTA) · ghost (hero secondary, on dark) ·
//            dark (on light) · light (on dark) · gold-outline (the nav's
//            Enquire, beside Book a table) · none (the plain ink outline)
//   small    the compact size
//   shimmer  a capped sweep across the face, for the one hero CTA
//   arrow    a trailing "proceed" arrow (ArrowIcon)
// Anything else — class, id, data-*, aria-*, disabled, hidden, target —
// lands on the element, so a parent can still add its own class and style
// it in context.
//
// The label and any icon come in through the slot, so they carry the
// caller's scoping attribute, not this file's — hence the :global() on
// span and svg below. Reception's stations script copies a hidden
// Button (see StationsBrowser) rather than building one, so it too
// carries this file's attribute.
import type { HTMLAttributes } from "astro/types"
import ArrowIcon from "./ArrowIcon.astro"

type Props = HTMLAttributes<"a"> &
  HTMLAttributes<"button"> & {
    href?: string
    as?: "span"
    type?: "button" | "submit"
    variant?: "gradient" | "ghost" | "dark" | "light" | "gold-outline"
    small?: boolean
    shimmer?: boolean
    arrow?: boolean
    class?: string
  }

const {
  href,
  as,
  type = "button",
  variant,
  small = false,
  shimmer = false,
  arrow = false,
  class: className,
  // A parent placing this into one of its named slots: Astro's business,
  // not an attribute for the element.
  slot: _slot,
  ...passedAttributes
} = Astro.props

// A bare attribute on a component (<Button data-reveal>) arrives as `true`,
// which would render as data-reveal="true"; render it bare, as written.
const rest = Object.fromEntries(
  Object.entries(passedAttributes).map(([name, value]) => [
    name,
    value === true && name.startsWith("data-") ? "" : value,
  ]),
)

const Tag = href !== undefined ? "a" : as === "span" ? "span" : "button"
const classes = [
  "button",
  variant && `button-${variant}`,
  { "button-small": small, "button-shimmer": shimmer },
  className,
]
---

{Tag === "a" ? (
  <a href={href} class:list={classes} {...rest}>
    <slot />
    {arrow && <ArrowIcon />}
  </a>
) : Tag === "span" ? (
  <span class:list={classes} {...rest}>
    <slot />
    {arrow && <ArrowIcon />}
  </span>
) : (
  <button type={type} class:list={classes} {...rest}>
    <slot />
    {arrow && <ArrowIcon />}
  </button>
)}

<style>
  .button {
    --bg: transparent;
    --fg: var(--ink);
    --bd: var(--ink);
    --bg-h: var(--ink);
    --fg-h: var(--limestone-2);
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 var(--button-padding-x);
    height: var(--button-height);
    border: 1px solid var(--bd);
    border-radius: var(--radius-pill);
    background: var(--bg);
    color: var(--fg);
    cursor: pointer;
    overflow: hidden;
    font-size: var(--button-font-size);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;

    /* As a flex item inside .wizard-nav (or any other flex row), a button can
         otherwise shrink below its label's natural width, wrapping the text
         internally onto two lines — invisible with single-word labels like
         "Continue", but real with two-word ones like "Review enquiry" on
         narrow phones. flex-shrink:0 plus the span's own nowrap (below) keep
         the whole button intact; .wizard-nav's flex-wrap then drops it to its
         own line if there's truly no room, instead of breaking the label.
  */
    flex-shrink: 0;
    transition:
      background-color 0.45s var(--ease),
      color 0.45s var(--ease),
      border-color 0.45s var(--ease),
      box-shadow 0.4s var(--ease),
      transform 0.3s var(--ease);
  }

  .button > :global(span),
  .button > :global(svg) {
    position: relative;
    z-index: 2;
    white-space: nowrap;
  }

  .button::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: -60%;
    width: 40%;
    background: linear-gradient(
      115deg,
      transparent,
      rgba(255, 255, 255, 0.35),
      transparent
    );
    transform: skewX(-18deg);
    transition: left 0.85s var(--ease);
    pointer-events: none;
    z-index: 1;
  }

  @media (--hover) {
    .button:hover {
      background-color: var(--bg-h);
      color: var(--fg-h);
      box-shadow: 0 14px 30px -16px rgba(var(--muted-ink-rgb), 0.4);
      transform: translateY(-1px);
    }
  }

  @media (--hover) {
    .button:hover::after {
      left: 130%;
    }
  }

  @media (--hover) {
    .button:hover :global(svg) {
      transform: translateX(4px);
    }
  }

  /* Gated to real hover-capable pointers — touch has no way to "leave" an
       element, so an unguarded :hover here would stick after tap on any button
       that doesn't navigate away (the wizard's Continue/Back/Submit, any
       same-page #enquire scroll CTA, etc. — same root cause as the photo
       carousel's arrows). Touch gets the equivalent feedback via :active below instead.
  */
  .button:active {
    transform: translateY(0) scale(0.98);
  }

  .button :global(svg) {
    transition: transform 0.45s var(--ease);
  }

  @media (--no-hover) {
    .button:active {
      background-color: var(--bg-h);
      color: var(--fg-h);
      box-shadow: 0 14px 30px -16px rgba(var(--muted-ink-rgb), 0.4);
    }
  }

  @media (--no-hover) {
    .button:active::after {
      left: 130%;
    }
  }

  @media (--no-hover) {
    .button:active :global(svg) {
      transform: translateX(4px);
    }
  }

  /* Touch devices never get a real :hover (or only a stuck/inconsistent one
       on first tap) — give tapping a button the same bg/color/shadow/arrow
       feedback via :active instead, so it doesn't read as unresponsive. The
       press-down scale in the unconditional .button:active above already covers
       the "tactile" part; this adds the part that was hover-only.
  */
  /* The sitewide solid CTA. Background is --gold-gradient (see :root) — the
       same two-tone gold fill as .tab-bar .pill, one shared value. Hover is
       done via `filter: brightness()` rather than swapping --bg-h to a second
       gradient: background-image (which a gradient is) doesn't interpolate on
       transition in any browser, so a --bg-h swap would cut instantly instead
       of fading. filter does transition smoothly, and — just as important —
       needs no extra pseudo-element, which leaves ::before free for
       .button-shimmer's sweep (below) and ::after free for .button's own hover
       sheen, so this composes cleanly with both rather than fighting over the
       same two pseudo-element slots (the specificity traps are what that
       fight looks like). Proved out in sandboxes/button-gradient.html before
       landing here; superseded that sandbox, which is now removed.
  */
  .button-gradient {
    --fg: var(--ink);
    --bd: var(--gold);
    --fg-h: var(--ink);
    background: var(--gold-gradient);
    transition:
      background-color 0.45s var(--ease),
      color 0.45s var(--ease),
      border-color 0.45s var(--ease),
      box-shadow 0.4s var(--ease),
      transform 0.3s var(--ease),
      filter 0.45s var(--ease);
  }

  @media (--hover) {
    .button-gradient:hover {
      filter: brightness(1.07);
    }
  }

  @media (--no-hover) {
    .button-gradient:active {
      filter: brightness(1.07);
    }
  }

  .button-shimmer::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: -60%;
    width: 40%;
    background: linear-gradient(
      115deg,
      transparent,
      rgba(255, 255, 255, 0.35),
      transparent
    );
    transform: skewX(-18deg);
    pointer-events: none;
    z-index: 1;
    animation-name: btn-shimmer-sweep;
    animation-duration: 5s;
    animation-timing-function: ease-out;
    animation-delay: 3.5s;
    animation-iteration-count: 3;
  }

  @media (--reduced-motion) {
    .button-shimmer::before {
      animation: none;
    }
  }

  .button-dark {
    /* A near-black filled button, for use on light backgrounds.
  */
    --bg: rgba(var(--ink-rgb), 0.88);
    --fg: var(--limestone-2);
    --bd: rgba(var(--ink-rgb), 0.88);
    --bg-h: var(--ink);
    --fg-h: var(--limestone-2);
  }

  .button-ghost {
    /* A genuine ghost/outline button — transparent at rest, fills solid on
         hover. Reserved for hero secondary CTAs.
  */
    --bg: transparent;
    --fg: var(--limestone);
    --bd: rgba(var(--limestone-rgb), 0.42);
    --bg-h: var(--limestone);
    --fg-h: var(--ink);
  }

  /* A .button-gradient that doubles as an aria-pressed toggle (added/
       selected/removed, etc.) takes .button-ghost's own values once pressed
       — reads as the sitewide secondary treatment instead of a new one, so
       "pressed" just means "already chosen," not "a different kind of
       button." First used by reception-stations-v2.html's "Add to
       selection" button (2026-09-30) — written here rather than page-scoped,
       since this is a general pattern: any future gradient-CTA toggle needs
       the exact same combo, hover/touch fix included, not something specific
       to that one page.

       background/filter are cleared explicitly here, unlike plain
       .button-ghost above (which never needs to): .button-gradient's own
       background is a gradient IMAGE and its :hover sets a filter, and
       recoloring custom properties alone doesn't turn either of those off.
  */
  .button-gradient[aria-pressed="true"] {
    --bg: transparent;
    --fg: var(--limestone);
    --bd: rgba(var(--limestone-rgb), 0.42);
    --bg-h: var(--limestone);
    --fg-h: var(--ink);
    background: transparent;
    filter: none;
  }

  @media (--hover) {
    .button-gradient[aria-pressed="true"]:hover {
      background-color: var(--bg-h);
    }
  }

  @media (--no-hover) {
    .button-gradient[aria-pressed]:active {
      background-color: var(--bg);
      color: var(--fg);
    }
  }

  @media (--no-hover) {
    .button-gradient[aria-pressed]:active::after {
      left: -60%;
      transition: none;
    }
  }

  /* REAL BUG, found 2026-09-30 (reported on reception-stations-v2.html's
       "Add to selection" button, the first user of the rule above): hovering
       — and, on touch, tapping — a PRESSED toggle showed invisible text,
       dark ink on a background that stayed transparent instead of switching
       to the intended light fill.

       Root cause: `background: transparent` above and .button:hover's
       `background-color: var(--bg-h)` are the same effective property at
       equal specificity (0,2,0 each — one class+attribute, one
       class+pseudo-class), one declared unconditionally and the other only
       under :hover, so whichever rule happens to load LATER in the
       stylesheet wins outright regardless of which one is actually meant to
       apply live (the specificity traps' exact mechanic — this is that
       mechanic biting a case neither trap anticipated: an unconditional
       rule and a conditional one, not two unconditional ones). `color` had
       no such collision (nothing else sets `color` for this state), so it
       switched to the intended dark ink on schedule while the background
       silently didn't follow — dark text on a permanently transparent (i.e.
       whatever's behind it, always dark here) background. Touch hits the
       identical collision one step later, against .button:active's own
       @media(hover:none) equivalent instead of :hover.

       Fixed by re-asserting the hover/active background explicitly, at
       higher specificity (attribute + pseudo-class beats attribute alone),
       so it wins by design rather than by accident of load order — reads
       var(--bg-h) rather than repeating a literal color, so retuning the
       toggle's hover fill above only ever needs the one edit.
  */
  /* The touch half of that same fix, reworked 2026-10-01 — REAL BUG, reported
       as "it flashes white before it says added" on reception-package.html's
       station cards.

       It used to mirror the :hover rule above, asserting
       `background-color: var(--bg-h)` on :active. That is right for the tap it
       was written for — tapping a button that is ALREADY pressed, to remove the
       item — but it also lands on the tap that CREATES the pressed state, and
       there it is wrong twice over. Touch browsers hold :active for a beat after
       touchend so a quick tap still registers visually, so it is still matching
       when the click handler flips aria-pressed. In that moment the button picks
       up the pressed vocabulary all at once: `background: transparent` strips the
       gold gradient that was covering background-color, --bg-h flips from
       var(--ink) to var(--limestone), and --fg-h means the label is dark. A
       near-white pill with dark text, held for the rest of the :active hold and
       then faded back out over background-color's own 0.45s. That is the flash.
       The .button::after sheen compounds it: a 0.85s sweep of
       rgba(255,255,255,0.35) that a short tap can only ever start and reverse,
       and that reads as far brighter once the gradient underneath it is gone.

       Fixed by giving a toggle NO press-fill on touch at all, rather than by
       timing the existing one around the state change. On a toggle the state
       change is itself the feedback — the button visibly becomes "Added" — so
       the fill is redundant on top of it, and .button:active's unconditional
       scale(0.98) still supplies the tactile part. background-color and color
       are pinned back to the button's own resting --bg/--fg rather than simply
       left out, because leaving them out would hand the element back to
       @media (hover: none) .button:active and reopen the invisible dark-on-
       transparent text this rule was created to fix. Replaces that rule rather
       than overriding it: the two would sit at equal specificity (0,3,0) and be
       settled by source order alone, which is the exact trap the specificity traps
       describes and which caused the original collision documented above.

       Deliberately scoped to [aria-pressed] (either value), not just ="true" —
       the gradient is stripped on the way INTO the pressed state, so the
       outgoing unpressed frame needs the sheen held off too. Desktop is
       untouched: the :hover rule above still stands, where a pointer genuinely
       does need hover feedback distinct from the pressed state.
  */
  .button-small {
    height: var(--button-compact-height);
    padding: 0 var(--button-compact-padding-x);
    font-size: var(--button-compact-font-size);
  }

  /* Scoped to this file (moved from global.css by
         scripts/scope-styles.mjs). See FaqAccordion.astro for how scoping works.
  */
  .button-light {
    /* Filled (not outline) at rest, at reduced opacity — hover intensifies to
             full solid rather than dropping to transparent. --bd matches --bg so
             the border reads as part of the fill, not a separate outline. Used for
             non-hero secondary CTAs on dark backgrounds (the hero's own secondary
             CTA uses the real .button-ghost below instead).
  */
    --bg: rgba(var(--limestone-rgb), 0.88);
    --fg: var(--ink);
    --bd: rgba(var(--limestone-rgb), 0.88);
    --bg-h: var(--limestone);
    --fg-h: var(--ink);
  }

  /* ============================================================
         (i) THE ENQUIRE BUTTON — .button-gold-outline
         ============================================================
         .button-ghost next to .button-gradient read as the disabled sibling
         rather than the secondary action, and three things were doing that at
         once: it was GREY where the other was gold, its border sat at 0.42
         alpha so the outline barely existed, and it had no icon so it carried
         noticeably less visual mass.

         Hue was the main one. Two buttons in the same colour, one filled and
         one outlined, read as a deliberate primary/secondary pair; a gold
         pill beside a grey pill reads as "one action and one thing that isn't
         available". So this keeps the outline — the hierarchy is still
         correct, Book a table should lead — and moves it into the same family
         by tinting the border and the label gold, then fills solid gold on
         hover, which is a more confident resolution than .button-ghost's fade
         to limestone.

         .button-ghost is DROPPED from the element rather than overridden.
         Overriding it would have meant silently redefining all five of its
         custom properties, leaving a class on the markup that no longer
         describes anything true about the button — and styles.css's own
         comment reserves it for hero secondary CTAs. Written as
         ".button.button-gold-outline" at (0,2,0) so it beats .button's own
         (0,1,0) defaults outright rather than on source order (the same-specificity
         collision).
  */
  .button.button-gold-outline {
    --bg: transparent;
    --fg: var(--gold-2);
    --bd: rgba(var(--gold-rgb), 0.55);
    --bg-h: var(--gold);
    --fg-h: var(--ink);

    /* 2px, up from .button's 1px (2026-10-04), so the outline carries
           visual mass closer to Book a table's solid fill beside it.
  */
    border-width: 2px;
  }

  /* The envelope is a LABEL, not a "proceed" chevron, so it must not
         inherit .button:hover svg's 4px forward nudge — that motion only
         reads correctly on a trailing arrow. Exactly the precedent
         #availChangeBtn's calendar icon already set in styles.css, and the
         reason the icon here is an envelope rather than a second copy of
         Book a table's arrow: "Enquire" is the vaguer of the two labels, so
         the icon is doing real work saying what the action is, instead of
         repeating what its neighbour already says.
  */
  .button-gold-outline :global(svg) {
    transition: none;
  }

  @media (--hover) {
    .button.button-gold-outline:hover :global(svg) {
      transform: none;
    }
  }

  @media (--no-hover) {
    .button.button-gold-outline:active :global(svg) {
      transform: none;
    }
  }

  /* A Button that is itself a scroll-reveal target (GalleryPreview's) keeps
       the reveal's transition. [data-reveal] in global.css sets it at the same
       specificity as .button's own list above, and this file loads after
       global.css, so .button's list would replace it wholesale (prototype bug
       #2) and the button would snap in instead of fading.
  */
  .button[data-reveal] {
    transition:
      opacity 0.9s var(--ease),
      transform 1s var(--ease);
    transition-delay: var(--d, 0ms);
  }

  /* Also used by ReceptionStations.css's stage shimmer.
  */
  @keyframes btn-shimmer-sweep {
    0%,
    60% {
      left: -60%;
    }

    85% {
      left: 130%;
    }

    100% {
      left: 130%;
    }
  }
</style>
