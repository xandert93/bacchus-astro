---
// Every non-hero photograph on the site. Takes a key from src/lib/images.ts
// ("venue/secret-garden-night"), or a photo stored in Sanity (RemotePhoto,
// fetched from its CDN at build time), and renders it through astro:assets,
// so each device downloads a copy sized for how big the photo is actually
// drawn.
//
//   • From an untouched ORIGINAL: a <picture> with AVIF (smaller at equal
//     quality) and a WebP fallback, each at its own quality — same recipe as
//     HeroImage. The <img> carries every attribute passed in (class,
//     loading, data-*), so selectors and scripts aimed at the img still hit.
//   • From a WEB COPY (no original yet — see WEB_COPY_ONLY): a plain <img>.
//     The copy itself is served untouched at its own size, and only smaller
//     variants are generated from it. Re-encoding an already-lossy file at
//     full size would compress it twice.
//
// `sizes` is required and must describe how wide the photo is drawn at each
// breakpoint — it's how the browser chooses a file before CSS has loaded.
// `maxWidth` caps the largest copy for photos that are only ever small.
//
// LAZY BY DEFAULT: the browser fetches the photo only as it nears the
// screen, so a visitor who never scrolls down never downloads it, and the
// photos they can see aren't sharing the connection with ones they can't. A
// photo in the first screenful passes loading="eager" (the header's logo).
import { getImage } from "astro:assets"
import type { HTMLAttributes } from "astro/types"
import type { ImageMetadata } from "astro"
import { image, isWebCopyOnly, type PhotoSource } from "@lib/images"

type ImgAttributes = Omit<
  HTMLAttributes<"img">,
  "src" | "srcset" | "sizes" | "width" | "height"
>

interface Props extends ImgAttributes {
  src: PhotoSource
  alt: string
  sizes: string
  maxWidth?: number
}

const {
  src: source,
  alt,
  sizes,
  maxWidth,
  decoding = "async",
  loading = "lazy",
  ...rest
} = Astro.props

const AVIF_QUALITY = 62
const WEBP_QUALITY = 82
// Scaled-down variants of an already-lossy web copy get a gentler setting,
// since they are being compressed for a second time.
const WEB_COPY_QUALITY = 88
// The largest copy made of any photo. The originals run to 5504px, and
// served whole the widest was a 1.4 MB download that only a 4K screen would
// pick, for a sharpness gain nobody would see. It's also the copy the
// lightbox shows (the img's src), which never needs more.
const LARGEST_WIDTH = 3200

// A local photo is handed to getImage() as the imported file. A Sanity one
// is its URL plus its size, since Astro can't measure a file it hasn't
// downloaded yet.
let original: { src: string; width: number; height: number }
let imageSource: { src: ImageMetadata } | { src: string; width: number; height: number }
let webCopy: boolean

if (typeof source === "string") {
  const file = image(source)
  original = file
  imageSource = { src: file }
  webCopy = isWebCopyOnly(source)
} else {
  original = { src: source.url, width: source.width, height: source.height }
  imageSource = original
  webCopy = source.isWebCopy
}

const cap = Math.min(original.width, maxWidth ?? LARGEST_WIDTH)
const widths = [320, 480, 640, 960, 1280, 1600, 1920, 2400]
  .filter((w) => w < cap)
  .concat(webCopy && cap === original.width ? [] : [cap])

let avifSrcset: string | null = null
let imgSrc: string
let imgSrcset: string

if (webCopy) {
  const scaled = widths.length
    ? await getImage({
        ...imageSource,
        widths,
        format: "webp",
        quality: WEB_COPY_QUALITY,
      })
    : null
  if (cap === original.width) {
    // The copy itself, untouched, as the largest candidate.
    imgSrc = original.src
    imgSrcset = [scaled?.srcSet.attribute, `${original.src} ${original.width}w`]
      .filter(Boolean)
      .join(", ")
  } else {
    imgSrc = scaled!.src
    imgSrcset = scaled!.srcSet.attribute
  }
} else {
  const [avif, webp] = await Promise.all([
    getImage({ ...imageSource, widths, format: "avif", quality: AVIF_QUALITY }),
    getImage({ ...imageSource, widths, format: "webp", quality: WEBP_QUALITY }),
  ])
  avifSrcset = avif.srcSet.attribute
  imgSrc = webp.src
  imgSrcset = webp.srcSet.attribute
}

// Intrinsic size at the largest candidate's width, so the browser reserves
// the right shape before the file arrives.
const width = cap
const height = Math.round((original.height / original.width) * cap)
---

{avifSrcset ? (
  <picture>
    <source type="image/avif" srcset={avifSrcset} sizes={sizes} />
    <img
      src={imgSrc}
      srcset={imgSrcset}
      sizes={sizes}
      width={width}
      height={height}
      alt={alt}
      loading={loading}
      decoding={decoding}
      {...rest}
    />
  </picture>
) : (
  <img
    src={imgSrc}
    srcset={imgSrcset}
    sizes={sizes}
    width={width}
    height={height}
    alt={alt}
    loading={loading}
    decoding={decoding}
    {...rest}
  />
)}
