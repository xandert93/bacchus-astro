---
// The gold-tick list used in the "split" intro sections (weddings,
// corporate, celebrations). Not the divided .tab-panel list — see
// docs/design/design-system.md, "Spacing details", for why the two differ.
interface Props {
  items: string[]
}
const { items } = Astro.props
---

<ul class="check" data-reveal style="--d: 240ms">
  {items.map((item) => (
    <li>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path
          d="M3 8.5 6.5 12 13 4"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      {item}
    </li>
  ))}
</ul>

<style>
  /* Scoped to this component (moved from global.css by
       scripts/scope-styles.mjs). See FaqAccordion.astro for how scoping works.
  */
  :global(.split) ul.check {
    list-style: none;
    margin-top: 24px;
    display: grid;
    gap: 12px;
  }

  :global(.split) ul.check li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 15px;
    font-family: "Newsreader", Georgia, serif;
  }

  :global(.split) ul.check li svg {
    flex: none;
    margin-top: 2px;
    color: var(--gold);
  }

  :global(.on-dark) :global(.split) ul.check li {
    color: var(--muted);
  }
</style>
