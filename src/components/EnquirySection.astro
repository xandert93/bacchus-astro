---
import AvailabilityCalendar from "./AvailabilityCalendar.astro"
import Photo from "./Photo.astro"
// The four-step enquiry wizard (#enquire). Same component on every events
// page; what differs per page comes in as props and slots. Behaviour lives
// in enquiry.js (.wizard-* classes).
//
// Initial visibility below (date picker, spaces/tone fields, guest hint,
// chip note) is rendered to match what enquiry.js sets on load for the chosen
// event type. The prototype hardcoded the Wedding state on every page and
// let its script correct it after load, so non-wedding pages flashed the wrong
// state first.
import { CHIP_NOTES, EVENT_TYPES, type EventType } from "../data/enquiry"

interface Props {
  eventType: EventType
  // "inline": the compact calendar sits in the form (most pages).
  // "modal": a summary row + "Pick a date" button opening the page's own
  // quick-pick modal (weddings, which already shows the full diary above).
  datePicker?: "inline" | "modal"
  eyebrow?: string
  // src is a key from src/lib/images.ts.
  railPhoto: { src: string; alt: string; caption: string }
}
const {
  eventType,
  datePicker = "inline",
  eyebrow = "Start planning",
  railPhoto,
} = Astro.props
const isWedding = eventType === "Wedding"
---

<section class="section-padding enquire" id="enquire">
  <div class="wrap">
    <div class="grid">
      {/* ============ Left rail: intent + persistent reassurance ============ */}
      <div class="enquiry-intro">
        <div class="eyebrow" data-reveal>
          {eyebrow}
        </div>
        <h2 data-reveal style="--d: 80ms">
          <slot name="heading" />
        </h2>
        <p class="lead" data-reveal style="--d: 160ms">
          <slot name="lead" />
        </p>

        <ul class="trust-rail" data-reveal style="--d: 240ms">
          <li>
            <span class="trust-item-icon" aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
              >
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3.5 2" />
              </svg>
            </span>
            <div>
              <b>A reply within two working days</b>
              <p>
                Written personally by Francois or Nicholas from our events team — Monday
                to Saturday, never an automated quote.
              </p>
            </div>
          </li>
          <li>
            <span class="trust-item-icon" aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="4" y="10" width="16" height="10" rx="2" />
                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
              </svg>
            </span>
            <div>
              <b>Private, and without obligation</b>
              <p>
                Your details stay with the events team at Bacchus. No mailing list, no
                third parties, no pressure to commit.
              </p>
            </div>
          </li>
          <li>
            <span class="trust-item-icon" aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 5h11l5 5v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" />
                <path d="m8.5 13 2.5 2.5 4.5-5" />
              </svg>
            </span>
            <div>
              <b>Nothing is sent until you review it</b>
              <p>
                Step four shows the enquiry exactly as we'll receive it. Edit any line
                from there — the send button waits for you.
              </p>
            </div>
          </li>
        </ul>

        <figure class="rail-photo" data-reveal="img" style="--d: 320ms">
          <Photo
            src={railPhoto.src}
            alt={railPhoto.alt}
            loading="lazy"
            sizes="(max-width: 980px) 100vw, 40vw"
            maxWidth={1600}
          />
          <figcaption>{railPhoto.caption}</figcaption>
        </figure>
      </div>

      {/* ============ The wizard ============ */}
      <div class="enquiry-form" data-reveal style="--d: 180ms">
        <form id="form" novalidate>
          <div class="wizard-progress" style="--wiz-tab-count: 4">
            <div class="wizard-progress-line">
              <i class="wizard-progress-segment"></i>
              <i class="wizard-progress-segment"></i>
              <i class="wizard-progress-segment"></i>
            </div>
            <div class="wizard-steps">
              <button type="button" class="wizard-step-tab active" data-goto="1">
                <span class="wizard-step-number">1</span>
                <span class="wizard-step-label">Occasion</span>
              </button>
              <button type="button" class="wizard-step-tab" data-goto="2" disabled>
                <span class="wizard-step-number">2</span>
                <span class="wizard-step-label">Specifics</span>
              </button>
              <button type="button" class="wizard-step-tab" data-goto="3" disabled>
                <span class="wizard-step-number">3</span>
                <span class="wizard-step-label">Your details</span>
              </button>
              <button type="button" class="wizard-step-tab" data-goto="4" disabled>
                <span class="wizard-step-number">4</span>
                <span class="wizard-step-label">Review</span>
              </button>
            </div>
          </div>

          <div class="wizard-count">
            <div class="wizard-count-title" id="stepTitle">
              The <em>occasion</em>
            </div>
          </div>

          {/* ---------- Step 1 ---------- */}
          <div class="wizard-step active" data-step="1">
            <div class="field full">
              <label>Which kind of event?</label>
              <div class="chips" id="chips">
                {EVENT_TYPES.map((type) => (
                  <button
                    type="button"
                    class:list={["chip", { "is-selected": type === eventType }]}
                    data-v={type}
                  >
                    {type}
                  </button>
                ))}
              </div>
              <input type="hidden" id="eventtype" value={eventType} />
              <p class="field-note" id="chipNote">
                {CHIP_NOTES[eventType]}
              </p>
            </div>

            <div class="field full">
              <label>Choose your date</label>
              <div
                class="field-input"
                id="dateNativeWrap"
                style={isWedding ? "display: none" : undefined}
              >
                <input id="dateNative" type="date" />
                <span class="field-underline"></span>
                <svg
                  class="field-date-icon"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="4" width="18" height="18" rx="2" />
                  <path d="M16 2v4M8 2v4M3 10h18" />
                </svg>
              </div>
              {datePicker === "inline" ? (
                <div
                  id="dateCalWrap"
                  class:list={{ "is-revealed": isWedding }}
                  style={isWedding ? undefined : "display: none"}
                >
                  <AvailabilityCalendar variant="compact" />
                </div>
              ) : (
                <div id="dateCalWrap" class="availability-form-row">
                  <div class="availability-foot-label" id="availFormPicked">
                    <span class="availability-foot-label-date">No date selected</span>
                    <span class="availability-picked-status"></span>
                  </div>
                  <button type="button" class="review-edit-button" id="availChangeBtn">
                    <svg
                      width="12"
                      height="12"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="3" y="5" width="18" height="16" rx="2" />
                      <path d="M8 3v4M16 3v4M3 10h18" />
                    </svg>
                    <span>Pick a date</span>
                  </button>
                </div>
              )}
              <input type="hidden" id="date" />
              <div class="error">
                {datePicker === "inline"
                  ? "Pick a date from the calendar above."
                  : "Pick a date to continue."}
              </div>
            </div>

            <div
              class="field full"
              id="backupDateField"
              style={isWedding ? undefined : "display: none"}
            >
              <label for="backupDate">Alternative date</label>
              <div class="field-input">
                <input id="backupDate" type="date" />
                <span class="field-underline"></span>
                <svg
                  class="field-date-icon"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="4" width="18" height="18" rx="2" />
                  <path d="M16 2v4M8 2v4M3 10h18" />
                </svg>
              </div>
              <div class="error" id="backupDateErr">
                Enter a valid date.
              </div>
              <p class="field-note">
                In case your first choice is already taken — for our reference only.
                <br />
                This does not hold or reserve a date.
              </p>
            </div>
          </div>

          {/* ---------- Step 2 ---------- */}
          <div class="wizard-step" data-step="2">
            <div class="field full">
              <label for="guests">Guest count</label>
              <div class="guest-count-row">
                <button
                  type="button"
                  class="guest-count-button"
                  data-step-by="-10"
                  aria-label="Fewer guests"
                >
                  −
                </button>
                <div class="field-input">
                  <input id="guests" type="number" min="1" max="500" placeholder="80" />
                  <span class="field-underline"></span>
                </div>
                <button
                  type="button"
                  class="guest-count-button"
                  data-step-by="10"
                  aria-label="More guests"
                >
                  +
                </button>
              </div>
              <div class="error" id="guestsErr">
                Enter an expected guest count.
              </div>
              <p class="guest-count-hint" id="guestHint">
                {isWedding
                  ? "A flexible estimate is perfect — final numbers come much later."
                  : "Most events here sit between 40 and 180 guests."}
              </p>
            </div>

            <div
              class="field full"
              id="spacesField"
              style={isWedding ? "display: none" : undefined}
            >
              <label>Which spaces interest you?</label>
              <div class="option-grid" id="spaces">
                <button type="button" class="option-card" data-v="Prince De Redin Hall">
                  <b>Prince De Redin Hall</b>
                  <span>Indoor, seats up to 180</span>
                </button>
                <button type="button" class="option-card" data-v="The Terrace">
                  <b>The Terrace</b>
                  <span>Open air, bastion views</span>
                </button>
                <button type="button" class="option-card" data-v="The Secret Garden">
                  <b>Secret Garden</b>
                  <span>Walled, seats up to 70</span>
                </button>
                <button type="button" class="option-card" data-v="Not sure yet">
                  <b>Not sure yet</b>
                  <span>Guide us on this</span>
                </button>
              </div>
              <p class="field-note">
                Capacity depends on layout and season — the figures shown here are
                placeholders, which we'll confirm with Bacchus before we go into
                production.
              </p>
            </div>

            <div
              class="field full"
              id="eventStyleField"
              style={isWedding ? undefined : "display: none"}
            >
              <label>Which tone suits your day?</label>
              <div class="option-grid" id="eventStyle">
                <button
                  type="button"
                  class="option-card"
                  data-v="Candlelit &amp; ceremonial"
                >
                  <b>Candlelit &amp; ceremonial</b>
                  <span>Long tables, warm light and a slow evening.</span>
                </button>
                <button
                  type="button"
                  class="option-card"
                  data-v="Garden &amp; golden hour"
                >
                  <b>Garden &amp; golden hour</b>
                  <span>Open air, relaxed drinks and sunset portraits.</span>
                </button>
                <button type="button" class="option-card" data-v="Formal &amp; refined">
                  <b>Formal &amp; refined</b>
                  <span>A seated service with considered timing.</span>
                </button>
                <button type="button" class="option-card" data-v="Still exploring">
                  <b>Still exploring</b>
                  <span>Let our events team help shape the day.</span>
                </button>
              </div>
              <input type="hidden" id="eventStyleVal" />
              <p class="field-note">
                Choose the closest feeling — this is a starting point, not a package.
              </p>
            </div>

            <div class="field full">
              <label for="msg">Anything else we should know</label>
              <p class="field-note field-note-top">
                A note for the Events Team — happy to also arrange a menu tasting if you'd
                like one first.
              </p>
              <div class="field-input message-field-input">
                <textarea
                  id="msg"
                  maxlength="500"
                  placeholder="We're imagining an outdoor ceremony followed by dinner…"
                ></textarea>
                <span class="field-underline"></span>
                <div class="character-count">
                  <span class="character-count-label">Characters</span>
                  <div class="character-ring" id="msgCharRing" aria-hidden="true">
                    <svg viewBox="0 0 34 34">
                      <circle class="character-ring-track" cx="17" cy="17" r="14" />
                      <circle class="character-ring-fill" cx="17" cy="17" r="14" />
                    </svg>
                    <span class="character-ring-number" id="msgCharNum">
                      500
                    </span>
                  </div>
                </div>
              </div>
              <p class="field-note">
                Share only what feels useful — timings, traditions, food or anything that
                matters to you.
              </p>
            </div>
          </div>

          {/* ---------- Step 3 ---------- */}
          <div class="wizard-step" data-step="3">
            <div class="field full">
              <p class="field-note">
                We'll only use these details to follow up about your enquiry.
              </p>
            </div>
            <div class="field">
              <label for="firstName">First name</label>
              <div class="field-input">
                <input id="firstName" type="text" placeholder="First name" />
                <span class="field-underline"></span>
              </div>
              <div class="error">Please enter your first name.</div>
            </div>
            <div class="field">
              <label for="lastName">Last name</label>
              <div class="field-input">
                <input id="lastName" type="text" placeholder="Last name" />
                <span class="field-underline"></span>
              </div>
              <div class="error">Please enter your last name.</div>
            </div>
            <div class="field full">
              <label for="email">Email</label>
              <div class="field-input">
                <input id="email" type="email" placeholder="you@example.com" />
                <span class="field-underline"></span>
              </div>
              <div class="error">Enter a valid email address.</div>
            </div>
            <div class="field full">
              <label for="phone">Phone</label>
              <div class="field-input">
                <input id="phone" type="tel" placeholder="e.g. +356 7912 3456" />
                <span class="field-underline"></span>
              </div>
              <div class="error">Enter a phone number.</div>
            </div>
            <div class="field full">
              <label>How should we get back to you?</label>
              <div class="chips" id="prefer">
                <button type="button" class="chip is-selected" data-v="Email">
                  <svg
                    width="15"
                    height="15"
                    viewBox="0 0 512 512"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4L236.8 313.6c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4c0-26.5-21.5-48-48-48L48 64zM0 176L0 384c0 35.3 28.7 64 64 64l384 0c35.3 0 64-28.7 64-64l0-208L294.4 339.2c-22.8 17.1-54 17.1-76.8 0L0 176z" />
                  </svg>
                  Email
                </button>
                <button type="button" class="chip" data-v="Phone">
                  <svg
                    width="15"
                    height="15"
                    viewBox="0 0 512 512"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C12.1 30.2 0 46 0 64C0 311.4 200.6 512 448 512c18 0 33.8-12.1 38.6-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6l-40.4 49.3c-70.4-33.3-127.4-90.3-160.7-160.7l49.3-40.4c13.7-11.2 18.4-30 11.6-46.3l-40-96z" />
                  </svg>
                  Phone
                </button>
                <button type="button" class="chip" data-v="WhatsApp">
                  <svg
                    width="14"
                    height="15"
                    viewBox="0 0 448 512"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222c0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222c0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2c0-101.7 82.8-184.5 184.6-184.5c49.3 0 95.6 19.2 130.4 54.1c34.8 34.9 56.2 81.2 56.1 130.5c0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18.1c-5.1-1.9-8.8-2.8-12.5 2.8c-3.7 5.6-14.3 18.1-17.6 21.8c-3.2 3.7-6.5 4.2-12 1.4c-32.6-16.3-54-29.1-75.5-66c-5.7-9.8 5.7-9.1 16.3-30.3c1.8-3.7 .9-6.9-.5-9.7c-1.4-2.8-12.5-30.1-17.1-41.2c-4.5-10.8-9.1-9.3-12.5-9.5c-3.2-.2-6.9-.2-10.6-.2c-3.7 0-9.7 1.4-14.8 6.9c-5.1 5.6-19.4 19-19.4 46.3c0 27.3 19.9 53.7 22.6 57.4c2.8 3.7 39.1 59.7 94.8 83.8c35.2 15.2 49 16.5 66.6 13.9c10.7-1.6 32.8-13.4 37.4-26.4c4.6-13 4.6-24.1 3.2-26.4c-1.3-2.5-5-3.9-10.5-6.6z" />
                  </svg>
                  WhatsApp
                </button>
              </div>
              <input type="hidden" id="preferVal" value="Email" />
            </div>
          </div>

          {/* ---------- Step 4 — Review ---------- */}
          <div class="wizard-step" data-step="4">
            <div class="review-note">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="9" />
                <path d="M12 11v5" />
                <path d="M12 8h.01" />
              </svg>
              <span>
                This is your enquiry exactly as it reaches us. Nothing has been sent yet —
                edit any section, then send when you're happy.
              </span>
            </div>

            <div class="review-list" id="review"></div>

            <label class="consent" id="consentWrap">
              <input type="checkbox" id="consent" />
              <span class="box" aria-hidden="true">
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m5 12 5 5L19 7" />
                </svg>
              </span>
              <span>
                I'm happy for the Bacchus events team to contact me about this enquiry.
                Held privately, never shared, deleted on request.
              </span>
            </label>
          </div>

          {/* ---------- Navigation ---------- */}
          <div class="wizard-nav">
            <button
              type="button"
              class="wizard-back-circle wizard-back-link wizard-back-hidden"
              aria-label="Back"
            >
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
                <path
                  d="M13 5H2m3.5-3.5L2 5l3.5 3.5"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <span class="wizard-spacer"></span>
            <button type="button" class="button button-gradient wizard-next-button">
              <span>Continue</span>
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
                <path
                  d="M1 5h11M8.5 1.5 12 5 8.5 8.5"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <button
              type="submit"
              class="button button-gradient wizard-submit-button"
              style="display: none"
            >
              <span>Submit</span>
              <svg width="14" height="10" viewBox="0 0 14 10" fill="none">
                <path
                  d="M1 5h11M8.5 1.5 12 5 8.5 8.5"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </div>
        </form>

        {/* ---------- Sent ---------- */}
        <div class="enquiry-sent-panel" id="sent" role="status">
          <div class="seal">
            <svg
              width="30"
              height="30"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m4 12 5 5L20 6" />
            </svg>
          </div>
          <h3>
            Your enquiry is <em>with us</em>
          </h3>
          <p id="sentLine">
            Thank you — we have everything we need to start putting your proposal
            together.
          </p>
          <p id="sentCopyLine"></p>
          <ul class="next-steps">
            <li>
              <span class="next-step-number">1</span>
              <div>
                <b>A confirmation email, now</b>
                <p>A copy of everything you reviewed, for your records.</p>
              </div>
            </li>
            <li>
              <span class="next-step-number">2</span>
              <div>
                <b>A personal reply within two working days</b>
                <p>Availability confirmed, with pricing for your date and party size.</p>
              </div>
            </li>
            <li>
              <span class="next-step-number">3</span>
              <div>
                <b>A viewing, whenever suits</b>
                <p>Walk the Hall, the Terrace and the Secret Garden at your own pace.</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="trust-sticky">
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="4" y="10" width="16" height="10" rx="2" />
            <path d="M8 10V7a4 4 0 0 1 8 0v3" />
          </svg>
          <span id="stickyText">
            Private &amp; without obligation · nothing is sent until you review it
          </span>
        </div>
