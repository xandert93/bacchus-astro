---
// Wizard step 4, "Review": the enquiry exactly as it will arrive, and the
// consent box. The review list itself is built by EnquiryForm.js from the
// answers, so its rows are script-made and their rules are :global().
---

<div class="review-note">
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="9" />
    <path d="M12 11v5" />
    <path d="M12 8h.01" />
  </svg>
  <span>
    This is your enquiry exactly as it reaches us. Nothing has been sent yet — edit any
    section, then send when you're happy.
  </span>
</div>

<div class="review-list" id="review"></div>

<label class="consent" id="consentWrap">
  <input type="checkbox" id="consent" />
  <span class="box" aria-hidden="true">
    <svg
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m5 12 5 5L19 7" />
    </svg>
  </span>
  <span>
    I'm happy for the Bacchus events team to contact me about this enquiry. Held
    privately, never shared, deleted on request.
  </span>
</label>

<style>
  /* Scoped to this file (moved from global.css by
       scripts/scope-styles.mjs). See FaqAccordion.astro for how scoping works.
  */
  /* ---------- Review step ---------- */
  .review-note {
    flex: 1 1 100%;
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px 16px;
    border-radius: var(--radius-card);
    background: rgba(var(--gold-rgb), 0.1);
    box-shadow: inset 0 0 0 1px rgba(var(--gold-rgb), 0.34);
    font-family: "Newsreader", Georgia, serif;
    font-size: 14.5px;
    line-height: 1.5;
  }

  .review-list {
    flex: 1 1 100%;
    display: grid;
    gap: 0;
    border: 1px solid rgba(var(--muted-ink-rgb), 0.12);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .consent {
    flex: 1 1 100%;
    display: flex;
    gap: 12px;
    align-items: flex-start;
    cursor: pointer;
    font-family: "Newsreader", Georgia, serif;
    font-size: 12px;
    color: var(--muted-ink);
    line-height: 1.5;
  }

  .consent input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .consent .box {
    flex: none;
    width: 21px;
    height: 21px;
    margin-top: 2px;
    border-radius: 5px;
    border: 1px solid rgba(var(--muted-ink-rgb), 0.28);
    display: grid;
    place-items: center;
    transition: all 0.3s var(--ease);
  }

  .consent input:checked + .box {
    background: var(--gold);
    border-color: var(--gold);

    /* Matches .button-gradient's --fg on the same --gold background (submit button
           included), rather than --paper, so the checkmark reads as the same "ink
           on gold" combination used everywhere else that pairs the two.
  */
    color: var(--ink);
  }

  .consent.bad .box {
    border-color: var(--oxblood);
    animation: shake 0.4s;
  }

  .review-note :global(svg) {
    flex: none;
    color: var(--bronze);
    margin-top: 2px;
  }

  :global(.review-group) {
    border-bottom: 1px solid rgba(var(--muted-ink-rgb), 0.1);
  }

  :global(.review-group:last-child) {
    border-bottom: 0;
  }

  :global(.review-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    background: rgba(var(--limestone-rgb), 0.42);
  }

  :global(.review-head) :global(h4) {
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bronze);
    font-family: "Inter", sans-serif;
    font-weight: 500;
  }

  :global(.review-rows) {
    padding: 0 16px;
  }

  :global(.review-row) {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 10px 16px;
    padding: 9px 0;
    border-bottom: 1px dotted rgba(var(--muted-ink-rgb), 0.16);
  }

  :global(.review-row:last-child) {
    border-bottom: 0;
  }

  :global(.review-row) :global(dt) {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-ink);
    padding-top: 2px;
  }

  :global(.review-row-full) {
    grid-template-columns: 1fr;
    gap: 6px;
  }

  :global(.review-row-full) :global(dt) {
    padding-top: 0;
  }

  :global(.review-row-full) :global(dd) {
    white-space: pre-line;
  }

  :global(.review-row) :global(dd) {
    font-family: "Newsreader", Georgia, serif;
    font-size: 15px;
    line-height: 1.45;
  }

  :global(.review-row) :global(dd.empty) {
    color: rgba(var(--muted-ink-rgb), 0.42);
    font-style: italic;
  }

  @media (--below-enquiry-review-columns) {
    :global(.review-row) {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }

  .consent .box :global(svg) {
    opacity: 0;
    transform: scale(0.6);
    transition: all 0.3s var(--ease);
  }

  .consent input:checked + .box :global(svg) {
    opacity: 1;
    transform: none;
  }
</style>
