---
// The three reassurances beside the enquiry form: a personal reply within
// two working days, privacy, and nothing sent until it's been reviewed.
// Kept in step with the wizard: the third promise describes step four.
---

<ul class="trust-rail" data-reveal style="--d: 240ms">
  <li>
    <span class="trust-item-icon" aria-hidden="true">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
      >
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3.5 2" />
      </svg>
    </span>
    <div>
      <b>A reply within two working days</b>
      <p>
        Written personally by Francois or Nicholas from our events team — Monday to
        Saturday, never an automated quote.
      </p>
    </div>
  </li>
  <li>
    <span class="trust-item-icon" aria-hidden="true">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="4" y="10" width="16" height="10" rx="2" />
        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
      </svg>
    </span>
    <div>
      <b>Private, and without obligation</b>
      <p>
        Your details stay with the events team at Bacchus. No mailing list, no third
        parties, no pressure to commit.
      </p>
    </div>
  </li>
  <li>
    <span class="trust-item-icon" aria-hidden="true">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M4 5h11l5 5v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" />
        <path d="m8.5 13 2.5 2.5 4.5-5" />
      </svg>
    </span>
    <div>
      <b>Nothing is sent until you review it</b>
      <p>
        Step four shows the enquiry exactly as we'll receive it. Edit any line from there
        — the send button waits for you.
      </p>
    </div>
  </li>
</ul>

<style>
  /* Scoped to this file (moved from global.css by
     scripts/scope-styles.mjs). See FaqSection.astro for how scoping works. */
  @media (--below-enquiry-two-column) {
    :global(.enquire) .trust-rail {
      order: 3;
    }
  }
  :global(.enquire) .trust-rail {
    /* Flat 24px, matching the sitewide convention for a list following intro
         copy (e.g. .split ul.check, .tab-panel ul, .deposit-box). */
    margin-top: 24px;
    display: grid;
    gap: clamp(8px, 2vw, 12px);
  }
  :global(.enquire) .trust-rail .trust-item-icon {
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    color: var(--bronze);
  }
  :global(.enquire) .trust-rail p {
    margin-top: clamp(8px, 2vw, 12px);
    font-family: "Newsreader", Georgia, serif;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--muted-ink);
  }
  :global(.enquire) .trust-rail > li {
    list-style: none;
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 12px;
    align-items: start;
    padding: 18px 2px;
    border-bottom: 1px solid rgba(var(--muted-ink-rgb), 0.12);
  }
  :global(.enquire) .trust-rail > li:last-child {
    border-bottom: none;
  }
  :global(.enquire) .trust-rail :global(b) {
    display: block;
    font-family: "Fraunces", Georgia, serif;
    font-weight: 400;
    font-size: 17px;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
</style>
