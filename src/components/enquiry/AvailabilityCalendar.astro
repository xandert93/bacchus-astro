---
// The wedding availability calendar: month header, weekday row, the grid of
// days, the legend, the waitlist hint and the "illustrative only" notice.
// Three instances on the site, all the same widget:
//   • "diary"   — the weddings page's showcase calendar (#avail) and the
//                 quick-pick modal's copy of it (#availModalGrid)
//   • "compact" — the enquiry form's own date picker, which always carries
//                 the ids #availForm / #availPicked its styles key off
//
// The day cells are created by AvailabilityCalendar.js, which finds every
// .availability on the page and renders into its .availability-grid — so
// the cell rules below are :global(): script-made elements never carry this
// component's scoping attribute. All its state (the picked date, the
// waitlist popover) lives in that script too.
interface Props {
  variant: "diary" | "compact"
  // Diary instances only; the compact one is always #availForm.
  id?: string
  // Makes the calendar a modal dialog with this accessible name.
  dialogLabel?: string
  // Appended to the "illustrative only" notice.
  noticeSuffix?: string
}

const { variant, id, dialogLabel, noticeSuffix } = Astro.props
const isCompact = variant === "compact"
const arrow = isCompact ? { width: 14, height: 10 } : { width: 12, height: 9 }
---

<div
  class:list={["availability", variant]}
  id={isCompact ? "availForm" : id}
  role={dialogLabel ? "dialog" : undefined}
  aria-modal={dialogLabel ? "true" : undefined}
  aria-label={dialogLabel}
>
  <div class="availability-head">
    <button type="button" class="availability-prev" aria-label="Previous month">
      <svg width={arrow.width} height={arrow.height} viewBox="0 0 14 10" fill="none">
        <path
          d="M13 5H2m3.5-3.5L2 5l3.5 3.5"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>
    <div class="availability-title">
      <div class="availability-month">Month</div>
      <div class="availability-sub">One celebration each day</div>
    </div>
    <button type="button" class="availability-next" aria-label="Next month">
      <svg width={arrow.width} height={arrow.height} viewBox="0 0 14 10" fill="none">
        <path
          d="M1 5h11M8.5 1.5 12 5 8.5 8.5"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>
  </div>
  <div class="availability-day-of-week">
    <span>Mon</span>
    <span>Tue</span>
    <span>Wed</span>
    <span>Thu</span>
    <span>Fri</span>
    <span>Sat</span>
    <span>Sun</span>
  </div>
  <div class="availability-grid"></div>
  <div class="availability-legend">
    <span class="availability-legend-open">
      <i></i>Available
    </span>
    <span class="availability-legend-interest">
      <i></i>Enquiries Received
    </span>
    <span class="availability-legend-taken">
      <i></i>Booked
    </span>
  </div>
  {/* Without this, a Booked date being clickable at all is invisible —
       cursor:pointer and a hover ring are easy to miss, and there's nothing
       to notice on a touch device until you happen to tap one. Shown
       unconditionally (not just on touch), since a mouse user hovering a
       date without knowing anything happens is the same discoverability gap,
       just solved by a different affordance. Each icon travels with its own
       text as one toggled group (display: contents), so a touch visitor
       never sees a mouse-pointer glyph next to "Tap it...". */}
  <div class="availability-note">
    <span class="wl-hint-hover">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
        <path
          d="M4 4l7.07 16.97 2.51-7.39 7.39-2.51L4 4Z"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M13.5 13.5 19 19"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
        />
      </svg>
      <span>
        Date unavailable? Click it to join the waitlist — we'll email you if it opens up.
      </span>
    </span>
    <span class="wl-hint-touch">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="2.5" stroke="currentColor" stroke-width="1.3" />
        <circle
          cx="12"
          cy="12"
          r="6"
          stroke="currentColor"
          stroke-width="1.3"
          opacity="0.6"
        />
        <circle
          cx="12"
          cy="12"
          r="9.5"
          stroke="currentColor"
          stroke-width="1.1"
          opacity="0.35"
        />
      </svg>
      <span>
        Date unavailable? Tap it to join the waitlist — we'll email you if it opens up.
      </span>
    </span>
  </div>
  {isCompact ? (
    <div class="availability-foot-label" id="availPicked">
      <span class="availability-foot-label-date"></span>
      <span class="availability-picked-status"></span>
    </div>
  ) : (
    <>
      <div class="availability-foot">
        <span class="availability-foot-label">
          <span class="availability-foot-label-date">No date selected</span>
          <span class="availability-picked-status"></span>
        </span>
        <slot name="foot-action" />
      </div>
      <p class="availability-foot-note">
        The Prince De Redin Hall, Terrace and Secret Garden are reserved together for your
        day. Your date stays unconfirmed until we reply.
      </p>
    </>
  )}
  <div class="availability-note">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
      <path
        d="M12 9v4m0 4h.01M10.3 3.9 2.5 17.5A1.5 1.5 0 0 0 3.8 20h16.4a1.5 1.5 0 0 0 1.3-2.5L13.7 3.9a1.5 1.5 0 0 0-2.6 0Z"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <span>
      Illustrative only — the dates shown are placeholder data. We'll connect this to real
      availability with Bacchus before we go live.{noticeSuffix && ` ${noticeSuffix}`}
    </span>
  </div>
</div>

<script>
  import "./AvailabilityCalendar.js"
</script>

<style>
  /* Scoped to this file (moved from global.css by
     scripts/scope-styles.mjs). See FaqSection.astro for how scoping works. */
  :global(.availability-cell) {
    user-select: none;
  }
  /* .98 below the min-width the base rule resumes at, per the .98 breakpoint
     pairing — a plain 980/981 pair leaves 980.01-980.99 matching neither.

     Both declarations here are two halves of one fact: this is the width at
     which .package-menu-groups stops being three columns, and therefore the
     width below which the dish tiles have nothing left to line up with. Above
     it the tiles take the wide text gutter so the two grids read as one column
     structure (the drifting grid gaps); below it that gutter buys nothing and only
     costs tile width — it took a 400px phone's tiles from ~113px square down to ~99px.

     Done by redefining the token on the element rather than re-declaring
     column-gap: .package-dishes-grid already resolves its gap through
     var(--package-grid-column-gap), so there stays exactly one column-gap
     declaration in the component and this just changes what it reads. */
  /* ---------- Packages: horizontal cards (mobile only, ≤620px) ----------
     Thumbnail left, everything else (title, copy, button) stacked in the text
     column beside it — the way .package-beverage-card already lays itself out
     at 621px+, borrowed down to phone widths. Replaces the old single-column
     treatment, where each format card ran image-on-top-of-content full-bleed
     and the three of them together dominated the page's scroll length.

     Markup is identical at every breakpoint — this is CSS only. 620.98 pairs
     with the 2-up tier's own `min-width: 621px` above; see the .98 breakpoint pairing
     for why the max side is fractional. Everything from 621px up (the 2-up
     tablet tier and the 980px+ triptych) is untouched by this block. */
  /* ---------- Mock availability calendar (Weddings — concept demo) ---------- */
  .availability {
    background: #fff;
    border: 1px solid rgba(var(--muted-ink-rgb), 0.1);
    border-radius: var(--radius-card);
    /* min unchanged (still 22px) so true mobile (≤620px) keeps its existing
       padding — 4vw only exceeds 22px above ~550px, so this only actually
       grows anything above that. max raised from 34px to 44px. */
    padding: clamp(22px, 4vw, 44px);
    box-shadow: 0 40px 90px -60px rgba(var(--muted-ink-rgb), 0.4);
  }
  .availability-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .availability-head .availability-month {
    font-family: "Fraunces", serif;
    font-size: 20px;
    font-weight: 400;
  }
  .availability-day-of-week {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    margin-bottom: 6px;
  }
  .availability-day-of-week span {
    text-align: center;
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bronze);
    padding-bottom: 6px;
  }
  .availability-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }
  :global(.availability-cell) {
    height: clamp(32px, 4.6vw, 46px);
    border-radius: var(--radius-card);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12.5px;
    font-variant-numeric: tabular-nums;
    position: relative;
    cursor: default;
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
  :global(.availability-cell.blank) {
    visibility: hidden;
  }
  :global(.availability-cell.open) {
    background: var(--avail-green-bg);
    color: var(--avail-green-fg);
    cursor: pointer;
  }
  @media (--hover) {
    :global(.availability-cell.open:hover) {
      box-shadow: inset 0 0 0 1px var(--avail-green-fg);
    }
  }
  :global(.availability-cell.interest) {
    background: var(--avail-amber-bg);
    color: var(--avail-amber-fg);
    cursor: pointer;
  }
  @media (--hover) {
    :global(.availability-cell.interest:hover) {
      box-shadow: inset 0 0 0 1px var(--avail-amber-fg);
    }
  }
  :global(.availability-cell.taken) {
    background: var(--avail-grey-bg);
    color: var(--avail-grey-fg);
    cursor: auto;
    text-decoration: line-through;
  }
  :global(.availability-cell.today)::before {
    content: "";
    position: absolute;
    bottom: 6px;
    left: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--oxblood);
    transform: translateX(-50%);
  }
  :global(.availability-cell.open.picked) {
    background: var(--avail-green-fg);
    color: #fff;
    font-weight: 600;
    box-shadow: none;
  }
  :global(.availability-cell.interest.picked) {
    background: var(--avail-amber-fg);
    color: #fff;
    font-weight: 600;
    box-shadow: none;
  }
  :global(.availability-cell.picked.today)::before {
    background: #fff;
  }
  /* Gold pulse on pick — every calendar on the site (the diary showcase, its
     quick-pick modal, and the wizard's own inline compact calendar) is meant
     to read as the same component, so this isn't scoped further than that. */
  .availability.diary :global(.availability-cell.picked)::after,
  .availability.compact :global(.availability-cell.picked)::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
    box-shadow: 0 0 0 0 rgba(var(--gold-rgb), 0.45);
    animation: selPulse 0.5s var(--ease);
  }
  .availability-note {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px dashed rgba(var(--muted-ink-rgb), 0.14);
    font-size: 12px;
    color: var(--muted-ink);
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-family: "Newsreader", Georgia, serif;
  }
  .availability-note :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--bronze);
  }
  .availability-legend {
    display: flex;
    flex-direction: column;
    gap: 4px;
    /* Matches the shared .availability-head's own margin-bottom and .availability-picked's
       own margin-top just below — the established rhythm around this
       widget's own sub-sections. */
    margin-top: 20px;
    font-size: 11.5px;
    color: var(--muted-ink);
  }
  .availability-legend > span {
    display: flex;
    align-items: center;
  }
  .availability-legend i {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    display: inline-block;
    margin-right: 6px;
  }
  .availability-legend-open i {
    background: var(--avail-green-bg-h);
    box-shadow: inset 0 0 0 1px var(--avail-green-fg);
  }
  .availability-legend-interest i {
    background: var(--avail-amber-bg-h);
    box-shadow: inset 0 0 0 1px var(--avail-amber-fg);
  }
  .availability-legend-taken i {
    background: var(--avail-grey-bg);
    box-shadow: inset 0 0 0 1px var(--avail-grey-fg);
  }
  .availability-picked-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .availability-picked-status:not(:empty)::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex: none;
  }
  .availability.compact .availability-head {
    margin-bottom: 14px;
  }
  .availability.compact .availability-head .availability-month {
    font-size: 17px;
  }
  .availability.compact .availability-grid {
    gap: 7px;
  }
  .availability.compact :global(.availability-cell) {
    height: auto;
    aspect-ratio: 1;
    font-size: clamp(12px, 1.5vw, 14px);
  }
  .availability.compact :global(.availability-cell.interest)::after {
    content: "";
    position: absolute;
    top: 5px;
    right: 5px;
    bottom: auto;
    left: auto;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--avail-amber-fg);
  }
  /* .availability-cell.picked::after (the gold pulse box, above) sets inset:0 on the
     same pseudo-element at equal specificity — without explicit bottom/left
     here, those leftover 0 values over-constrain this dot's box (left:0 +
     right:5px + width:5px) and the browser drops 'right', snapping the dot to
     the cell's left edge. Same lesson as the same-specificity collision: don't let
     one same- specificity rule's shorthand bleed into another's longhands. */
  .availability.compact :global(.availability-cell.interest.picked)::after {
    background: var(--paper);
  }
  /* The widget's card (form{}, above) stays capped to ~480-500px at every
       width — it never stretches to fill a wider field the way a full-bleed
       compact calendar might, so its cells stay desktop-sized down to true
       mobile, matching .availability.diary's own 480px breakpoint below rather than
       shrinking early. */
  @media (--below-tablet) {
    .availability.compact :global(.availability-cell.interest)::after {
      top: 4px;
      right: 4px;
      width: 4px;
      height: 4px;
    }
  }
  @media (--below-tablet) {
    .availability.compact :global(.availability-cell.today)::before {
      bottom: 4px;
      width: 4px;
      height: 4px;
    }
  }
  /* index/corporate/celebrations/gallery's inline wizard calendar (#availForm)
     — matches the diary showcase's own header exactly (centered title +
     subtitle, prev/next flanking on either side) so every calendar on the site
     reads as the same component; restyled directly here. */
  #availForm :global(.availability-cell) {
    font-family: "Inter", sans-serif;
  }
  #availForm .availability-head {
    justify-content: space-between;
    margin-bottom: 26px;
  }
  #availForm .availability-head .availability-month {
    font-size: clamp(21px, 2.2vw, 27px);
  }
  #availForm .availability-title {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  #availForm .availability-sub {
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-ink);
  }
  #availForm .availability-prev,
  #availForm .availability-next {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(var(--muted-ink-rgb), 0.16);
    background: transparent;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex: none;
    transition:
      background 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  @media (--hover) {
    #availForm .availability-prev:hover:not(:disabled),
    #availForm .availability-next:hover:not(:disabled) {
      background: var(--paper);
      border-color: rgba(var(--muted-ink-rgb), 0.3);
    }
  }
  @media (--no-hover) {
    #availForm .availability-prev:active:not(:disabled),
    #availForm .availability-next:active:not(:disabled) {
      background: var(--paper);
      border-color: rgba(var(--muted-ink-rgb), 0.3);
    }
  }
  #availForm .availability-prev:disabled,
  #availForm .availability-next:disabled {
    opacity: 0.3;
    cursor: auto;
  }
  /* Matches the AC showcase's own .availability-foot-label bar (styles.css, scoped
     to .availability.diary there) — same markup/format, just repeated here since
     this calendar sits inside .availability.compact instead. Unlike the showcase's
     version, this one starts hidden and only appears once a date is picked
     (.show, toggled in main.js's updatePickedPanels()) — there's no
     "No date selected" placeholder row sitting above the Continue button
     before then. */
  #availPicked {
    margin-top: 24px;
    padding-top: 22px;
    border-top: 1px solid rgba(var(--muted-ink-rgb), 0.1);
    display: none;
    flex-direction: column;
    gap: 4px;
  }
  #availPicked.show {
    display: flex;
  }
  #availPicked.status-open .availability-picked-status {
    color: var(--avail-green-fg);
  }
  #availPicked.status-interest .availability-picked-status {
    color: var(--avail-amber-fg);
  }
  /* Same markup/format as the AC showcase's own #availPicked (.availability-foot-label,
     below) — this one just sits inline in the .availability-form-row instead of below
     a divider, so no margin-top/padding-top/border-top here. */
  :global(#availFormPicked) {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .availability.diary .availability-head {
    margin-bottom: 26px;
  }
  .availability.diary .availability-title {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .availability.diary .availability-head .availability-month {
    font-size: clamp(21px, 2.2vw, 27px);
  }
  .availability.diary .availability-sub {
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-ink);
  }
  .availability.diary .availability-prev,
  .availability.diary .availability-next {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(var(--muted-ink-rgb), 0.16);
    background: transparent;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex: none;
    transition:
      background 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  @media (--hover) {
    .availability.diary .availability-prev:hover:not(:disabled),
    .availability.diary .availability-next:hover:not(:disabled) {
      background: var(--paper);
      border-color: rgba(var(--muted-ink-rgb), 0.3);
    }
  }
  @media (--no-hover) {
    .availability.diary .availability-prev:active:not(:disabled),
    .availability.diary .availability-next:active:not(:disabled) {
      background: var(--paper);
      border-color: rgba(var(--muted-ink-rgb), 0.3);
    }
  }
  .availability.diary .availability-prev:disabled,
  .availability.diary .availability-next:disabled {
    opacity: 0.3;
    cursor: auto;
  }
  .availability.diary .availability-grid {
    gap: 7px;
  }
  .availability.diary :global(.availability-cell) {
    height: auto;
    aspect-ratio: 1;
    /* Scales with cell size instead of a fixed value, since both this and
       .availability.compact's cells resize with viewport/container width (aspect-
       ratio:1 on a 7-column grid) while the old fixed 14px/13px numbers
       didn't track that — shared with .availability.compact below so both read
       as the same calendar. */
    font-size: clamp(12px, 1.5vw, 14px);
  }
  /* Matches .availability.compact's interest-dot exactly (top/right/size), including
     its 980px mobile step below — the two calendars are meant to read as
     identical, so this no longer carries its own separate phone-only value. */
  .availability.diary :global(.availability-cell.interest)::after {
    content: "";
    position: absolute;
    top: 5px;
    right: 5px;
    bottom: auto;
    left: auto;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--avail-amber-fg);
  }
  /* Same inset:0-vs-longhand collision as .availability.compact's version above —
     see the comment there. */
  .availability.diary :global(.availability-cell.interest.picked)::after {
    background: var(--paper);
  }
  @media (--below-desktop) {
    .availability.diary :global(.availability-cell.interest)::after {
      top: 4px;
      right: 4px;
      width: 4px;
      height: 4px;
    }
  }
  @media (--below-large-phone) {
    :global(.availability-cell.today)::before {
      bottom: 4px;
      width: 4px;
      height: 4px;
    }
  }
  /* Two deliberate lines (date, then status) instead of one flowing string —
     a single "Selected · 16 Sep 2026 · Enquiries received" line wraps at
     whatever point the device's actual width/font metrics happen to land on,
     which sometimes split it mid-phrase and looked broken. A fixed two-line
     layout is a controlled break every time, on every device, matching the
     desktop callout's own .availability-picked-date/.availability-picked-status stack. Reuses .availability-picked-status
     (already styled/dotted below) for the status line rather than duplicating
     that styling here. */
  .availability.diary .availability-foot-label {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .availability-foot-label-date {
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-ink);
  }
  .availability-foot-label.status-open .availability-picked-status {
    color: var(--avail-green-fg);
  }
  .availability-foot-label.status-interest .availability-picked-status {
    color: var(--avail-amber-fg);
  }
  /* Scoped to this specific instance of .availability-picked-status, not the shared class in
       general (it's also reused by .availability-picked elsewhere, where no one's
       asked for a smaller dot). */
  @media (--below-large-phone) {
    .availability-foot-label .availability-picked-status:not(:empty)::before {
      width: 4px;
      height: 4px;
    }
  }
  @media (--below-large-phone) {
    .availability-foot-label {
      align-items: center;
    }
  }
  @media (--below-large-phone) {
    .availability-foot :global(.button) {
      width: 100%;
      max-width: 300px;
      justify-content: center;
      /* Scaled up from .button-small's own size — that sizing made sense sitting
