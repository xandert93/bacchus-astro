---
// The desktop bar: brand, the Restaurant / Events dropdowns, Gallery, and the
// two CTAs. Previously pasted into every page by hand; now written once.
import NavPanelPhoto from "@components/nav/NavPanelPhoto.astro"
import Photo from "@components/ui/Photo.astro"
---

<header class="nav" id="nav">
  <div class="wrap">
    <a href="/" class="brand" aria-label="Bacchus home">
      <Photo
        src="brand/bacchus-logo"
        sizes="64px"
        maxWidth={128}
        alt="Bacchus mark — the head of Bacchus wreathed in vine leaves"
      />
      <span class="brand-text">
        <span class="name">Bacchus</span>
        <span class="sub">Mdina · Est. 1660</span>
      </span>
    </a>
    <nav>
      <ul class="nav-links" id="navlinks">
        {/* ---------- Restaurant ---------- */}
        <li class="nav-dd nav-dd-split">
          <a href="#" data-unbuilt>
            Restaurant
          </a>
          <button
            class="nav-dd-split-chevron-button"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="Open the Restaurant menu"
          >
            <svg
              class="nav-dd-chevron"
              width="12"
              height="8"
              viewBox="0 0 12 8"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M1.5 2l4.5 4 4.5-4"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          {/* Panel stays nested inside .nav-dd (not a sibling of
               .wrap) — .nav-dd-panel is position:fixed, so it anchors
               against the viewport regardless of DOM nesting, which
               lets it keep the natural ".nav-dd:hover" descendant
               hover chain. See the comment above .nav-dd-panel in
               styles.css for why a sibling was tried and reverted. */}
          <div class="nav-dd-panel">
            <div class="nav-dd-panel-card nav-dd-panel-card-dark">
              <div class="nav-dd-panel-main">
                <div class="nav-dd-panel-heading-row">
                  <div class="nav-dd-panel-heading">Dine at Bacchus</div>
                  <a class="nav-dd-hub-link" href="#" data-unbuilt>
                    The restaurant
                    <svg
                      width="13"
                      height="13"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M5 12h14m-7-7 7 7-7 7"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                </div>
                {/* Exactly three items, which is one clean row of three
                     in the grid. "Book a table" is deliberately NOT a row
                     here: the primary CTA pill carrying that exact label
                     sits a few hundred pixels away in the same bar, and a
                     fourth item would leave an orphan cell in a
                     three-column grid. */}
                <div class="nav-dd-items">
                  <a class="nav-dd-item" href="#" data-unbuilt data-target="menus">
                    <span class="nav-dd-icon">
                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                      >
                        <rect
                          x="5"
                          y="3"
                          width="14"
                          height="18"
                          rx="1.5"
                          stroke="currentColor"
                          stroke-width="1.4"
                        />
                        <path
                          d="M9 8h6M9 12h6M9 16h3"
                          stroke="currentColor"
                          stroke-width="1.4"
                          stroke-linecap="round"
                        />
                      </svg>
                    </span>
                    <span class="nav-dd-text">
                      <span class="nav-dd-label">
                        Menus<span class="nav-dd-item-proposed-badge">PROPOSED</span>
                      </span>
                      <span class="nav-dd-desc">
                        The à la carte menu, and the cellar.
                      </span>
                    </span>
                  </a>
                  <a class="nav-dd-item" href="#" data-unbuilt>
                    <span class="nav-dd-icon">
                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M3 21V11a5 5 0 0 1 10 0v10M13 21V13a4 4 0 0 1 8 0v8"
                          stroke="currentColor"
                          stroke-width="1.4"
                        />
                      </svg>
                    </span>
                    <span class="nav-dd-text">
                      <span class="nav-dd-label">
                        The Chambers
                        <span class="nav-dd-item-proposed-badge">PROPOSED</span>
                      </span>
                      <span class="nav-dd-desc">
                        Built 1657–1660 as a gunpowder magazine.
                      </span>
                    </span>
                  </a>
                  <a class="nav-dd-item" href="#" data-unbuilt>
                    <span class="nav-dd-icon">
                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                      >
                        <rect
                          x="3"
                          y="8"
                          width="18"
                          height="12"
                          rx="1.5"
                          stroke="currentColor"
                          stroke-width="1.4"
                        />
                        <path
                          d="M3 12h18M12 8v12"
                          stroke="currentColor"
                          stroke-width="1.4"
                        />
                        <path
                          d="M8.5 8a2.5 2.5 0 0 1 0-5c1.7 0 3.5 2.2 3.5 5M15.5 8a2.5 2.5 0 0 0 0-5c-1.7 0-3.5 2.2-3.5 5"
                          stroke="currentColor"
                          stroke-width="1.4"
                        />
                      </svg>
                    </span>
                    <span class="nav-dd-text">
                      <span class="nav-dd-label">
                        Gift vouchers
                        <span class="nav-dd-item-proposed-badge">PROPOSED</span>
                      </span>
                      <span class="nav-dd-desc">Dinner for two, in a card.</span>
                    </span>
                  </a>
                </div>
              </div>
              {/* aria-hidden: decorative alongside the fully accessible
                   text links, so alt="" throughout and nothing in here
                   needs its own announcement.
                   data-src rather than src on everything but the default
                   — see primeDropdownMedia() in the script. One <img> per
                   state would otherwise mean every panel photo
                   downloading in the header of every page, for a dropdown
                   most visitors never open. The default keeps a real src
                   so the column is never briefly blank, and since the
                   fade overlaps two images, a photo arriving a beat late
                   hides behind it rather than showing as a hole. An <img>
                   with no src issues no request; src="" would, resolving
                   against the page URL, which is why these carry no src
                   attribute at all. */}
              <div class="nav-dd-panel-media" aria-hidden="true">
                <NavPanelPhoto src="food-and-drink/lamb" state="default" eager />
                <NavPanelPhoto src="food-and-drink/seabass" state="menus" />
                <p class="nav-dd-panel-caption" data-state="default">
                  Dinner beneath two stone vaults.
                </p>
                <p class="nav-dd-panel-caption" data-state="menus">
                  Caught that morning, plated that night.
                </p>
              </div>
            </div>
          </div>
        </li>

        {/* ---------- Events ---------- */}
        <li class="nav-dd nav-dd-split">
          <a href="#" data-unbuilt>
            Events
          </a>
          <button
            class="nav-dd-split-chevron-button"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="Open the Events menu"
          >
            <svg
              class="nav-dd-chevron"
              width="12"
              height="8"
              viewBox="0 0 12 8"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M1.5 2l4.5 4 4.5-4"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          <div class="nav-dd-panel">
            <div class="nav-dd-panel-card nav-dd-panel-card-dark">
              <div class="nav-dd-panel-main">
                <div class="nav-dd-panel-heading-row">
                  <div class="nav-dd-panel-heading">Celebrate at Bacchus</div>
                  <a class="nav-dd-hub-link" href="#" data-unbuilt>
                    All events
                    <svg
                      width="13"
                      height="13"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M5 12h14m-7-7 7 7-7 7"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                </div>
                {/* Six items: two clean rows of three. With the hub out
                     of the grid, adding Guides is what closes the empty
                     third cell the bottom row used to have — the row we
                     wanted anyway happens to square the grid. */}
                <div class="nav-dd-items">
                  <a class="nav-dd-item" href="/weddings" data-target="weddings">
                    <span class="nav-dd-icon">
                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                      >
                        <circle
                          cx="9"
                          cy="14"
                          r="5.5"
                          stroke="currentColor"
                          stroke-width="1.4"
                        />
                        <circle
                          cx="15"
                          cy="14"
                          r="5.5"
                          stroke="currentColor"
                          stroke-width="1.4"
                        />
                      </svg>
                    </span>
                    <span class="nav-dd-text">
                      <span class="nav-dd-label">Weddings</span>
                      <span class="nav-dd-desc">
                        One wedding a day, across all three spaces.
                      </span>
                    </span>
                  </a>
                  <a class="nav-dd-item" href="/corporate" data-target="corporate">
                    <span class="nav-dd-icon">
                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                      >
                        <rect
                          x="4"
                          y="4"
                          width="16"
                          height="16"
                          rx="1.5"
                          stroke="currentColor"
                          stroke-width="1.4"
                        />
                        <path
                          d="M8 9h3M8 13h3M13 9h3M13 13h3M10 20v-3h4v3"
                          stroke="currentColor"
                          stroke-width="1.4"
                          stroke-linecap="round"
                        />
                      </svg>
                    </span>
                    <span class="nav-dd-text">
                      <span class="nav-dd-label">Corporate</span>
                      <span class="nav-dd-desc">
                        Launches and dinners in a 17th-century hall.
                      </span>
                    </span>
                  </a>
                  <a class="nav-dd-item" href="/celebrations" data-target="celebrations">
                    <span class="nav-dd-icon">
                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M7 21l4-11 6 6-10 5zM13 3v3M19 7l-2 2M21 13h-3"
                          stroke="currentColor"
                          stroke-width="1.4"
                          stroke-linecap="round"
                        />
                      </svg>
                    </span>
                    <span class="nav-dd-text">
                      <span class="nav-dd-label">Celebrations</span>
                      <span class="nav-dd-desc">
                        Birthdays, anniversaries and christenings.
                      </span>
                    </span>
                  </a>
                  <a class="nav-dd-item" href="#" data-unbuilt data-target="spaces">
                    <span class="nav-dd-icon">
                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z"
                          stroke="currentColor"
                          stroke-width="1.4"
                        />
                        <circle
                          cx="12"
                          cy="10"
                          r="2.4"
                          stroke="currentColor"
                          stroke-width="1.4"
                        />
                      </svg>
                    </span>
                    <span class="nav-dd-text">
                      <span class="nav-dd-label">
                        The spaces<span class="nav-dd-item-proposed-badge">PROPOSED</span>
                      </span>
                      <span class="nav-dd-desc">
                        Secret Garden, De Redin Hall and Terrace.
                      </span>
                    </span>
                  </a>
                  <a class="nav-dd-item" href="#" data-unbuilt>
                    <span class="nav-dd-icon">
                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                      >
                        <rect
                          x="3"
                          y="7"
                          width="18"
                          height="13"
                          rx="2"
                          stroke="currentColor"
                          stroke-width="1.4"
                        />
                        <path
                          d="M9 7l1.5-3h3L15 7"
                          stroke="currentColor"
                          stroke-width="1.4"
                        />
                        <circle
                          cx="12"
                          cy="13.5"
                          r="3.2"
                          stroke="currentColor"
                          stroke-width="1.4"
                        />
                      </svg>
                    </span>
                    <span class="nav-dd-text">
                      <span class="nav-dd-label">
                        Preferred suppliers
                        <span class="nav-dd-item-proposed-badge">PROPOSED</span>
                      </span>
                      <span class="nav-dd-desc">Photographers, florists and bands.</span>
                    </span>
                  </a>
                  {/* The guide articles' home in the nav — a row here
                       rather than under About or as a top-level Journal
                       item. Reasoning in the write-up below the fold;
                       short version, About is where you read about the
                       company, not where you find out what a wedding
                       costs. No data-target: the articles don't exist
                       yet, so there is nothing to photograph. */}
                  <a class="nav-dd-item" href="#" data-unbuilt>
                    <span class="nav-dd-icon">
                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M4 4.5h7a2 2 0 0 1 2 2V21a2 2 0 0 0-2-2H4zM20 4.5h-7a2 2 0 0 0-2 2V21a2 2 0 0 1 2-2h7z"
                          stroke="currentColor"
                          stroke-width="1.4"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                    <span class="nav-dd-text">
                      <span class="nav-dd-label">
                        Guides<span class="nav-dd-item-proposed-badge">PROPOSED</span>
                      </span>
                      <span class="nav-dd-desc">
                        What a wedding here involves, and what it costs.
                      </span>
                    </span>
                  </a>
                </div>
              </div>
              <div class="nav-dd-panel-media" aria-hidden="true">
                <NavPanelPhoto src="venue/ballroom-night" state="default" eager />
                <NavPanelPhoto src="weddings/couple-outside-2" state="weddings" />
                <NavPanelPhoto src="corporate/guests-chatting" state="corporate" />
                <NavPanelPhoto src="celebrations/guest-laughing" state="celebrations" />
                <NavPanelPhoto src="venue/secret-garden-night" state="spaces" />
                <p class="nav-dd-panel-caption" data-state="default">
                  Gather within centuries of Maltese history.
                </p>
                <p class="nav-dd-panel-caption" data-state="weddings">
                  One wedding a day, always yours alone.
                </p>
                <p class="nav-dd-panel-caption" data-state="corporate">
                  From boardroom to full seated gala.
                </p>
                <p class="nav-dd-panel-caption" data-state="celebrations">
                  Every milestone, worth marking.
                </p>
                <p class="nav-dd-panel-caption" data-state="spaces">
                  A garden older than the walls around it.
                </p>
              </div>
            </div>
          </div>
        </li>

        <li>
          <a href="/gallery">Gallery</a>
        </li>
      </ul>
    </nav>
    <div class="nav-cta">
      {/* Decision 1: Book a table takes the gradient pill, Enquire the
           outline one. Both are gold — see .nav-cta-enquire-button above
           for why the secondary is NOT the stock .button-ghost: grey
           beside gold read as unavailable rather than secondary, where
           same-hue outline-beside-filled reads as a deliberate pair. The
           hierarchy itself is unchanged; only the secondary's colour and
           mass are. */}
      <a href="#" class="button button-gradient button-small" data-unbuilt>
        <span>Book a table</span>
        <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
          <path
            d="M1 5h11M8.5 1.5L12 5l-3.5 3.5"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
      <a href="#" class="button button-small nav-cta-enquire-button" data-unbuilt>
        <span>Enquire</span>
        <svg
          width="14"
          height="10"
          viewBox="1.5 4.5 21 15"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M3 7.5A1.5 1.5 0 0 1 4.5 6h15A1.5 1.5 0 0 1 21 7.5v9A1.5 1.5 0 0 1 19.5 18h-15A1.5 1.5 0 0 1 3 16.5z"
            stroke="currentColor"
            stroke-width="1.95"
          />
          <path
            d="m3.6 7 8.4 6 8.4-6"
            stroke="currentColor"
            stroke-width="1.95"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
      {/* Inside .nav-cta, matching every other page's header — the
           @media rule that swaps the pills for the burger is scoped
           ".nav-cta .button", so the burger has to be its sibling to be
           the thing left standing at mobile widths. */}
      <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false">
        <i></i>
        <i></i>
        <i></i>
      </button>
    </div>
  </div>
  {/* Dims the page below the nav while any panel is open. Toggled
       purely by :has() off the same states that open the panel, so
       there is no second piece of JS state to keep in sync. */}
  <div class="nav-dd-scrim" aria-hidden="true"></div>
  <div class="progress" id="progress"></div>
</header>

<style>
  /* Scoped to this component (moved from global.css by
     scripts/scope-styles.mjs). See FaqSection.astro for how scoping works. */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 800;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    border-bottom: 1px solid transparent;
    transition: border-color 0.6s var(--ease);
  }
  .nav::before,
  .nav::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    transition: opacity 0.6s var(--ease);
  }
  .nav::before {
    background: linear-gradient(180deg, rgba(10, 9, 6, 0.72), transparent);
    opacity: 1;
  }
  .nav::after {
    background: rgba(var(--muted-ink-rgb), 0.86);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    opacity: 0;
  }
  .nav.stuck {
    border-bottom-color: rgba(var(--gold-rgb), 0.22);
  }
  .nav.stuck::before {
    opacity: 0;
  }
  .nav.stuck::after {
    opacity: 1;
  }
  /* While the overlay is open the bar's fade is QUICK. Its own 0.6s is tuned
     for page scroll, where the bar is pinned above content that is already
     moving past it and a gentle fade reads well. Inside the overlay the first
     row starts only 22px below the bar, so at 0.6s a fast flick put "Restaurant"
     behind the lockup before the dark had arrived — reported 2026-10-02.
     transition-duration only, not a fresh shorthand, so the property list stays
     the single source of truth for what animates (bug #2). */
  :global(body.menu-open) .nav::before,
  :global(body.menu-open) .nav::after {
    transition-duration: 0.18s;
  }
  /* No frost while the overlay is open. .stuck flips more often in here than it
     does on a page: collapsing a group shrinks .menu-scroll's scrollHeight, the
     browser clamps scrollTop, that fires the overlay's own scroll handler, and
     the bar un-sticks — so ::after crossfades from opacity 0, and a
     backdrop-filter layer initialising from nothing is a known source of a
     one-frame flash.
     Nothing is lost by dropping it: the only thing behind the bar while the
     overlay is open is the overlay itself, which is --ink with a photograph at
     0.16 over it, so there is essentially nothing for a 14px blur to pick up.
     The fill and the border stay, so the dark state still reads as dark — same
     treatment, and the same reasoning, as .package-sticky-switch under
     body.is-scrolling. */
  :global(body.menu-open) .nav::after {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    /* Fully opaque while the drawer is open (2026-10-05). The page bar's fill
       is 0.86 alpha and relies on the blur above to hide what passes behind
       it; with the blur off, the drawer's own links stayed legible through
       the bar as they scrolled under it. Same colour, no transparency. */
    background: rgb(var(--muted-ink-rgb));
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
  }
  .brand .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .brand .name {
    font-family: "Fraunces", serif;
    font-size: 19px;
    letter-spacing: 0.3em;
    color: var(--limestone);
    text-transform: uppercase;
    padding-left: 2px;
  }
  .nav-links {
    display: flex;
    align-items: center;
    /* 2px, not 6px (changed 2026-10-02). Each link already carries 16px of
       padding a side, so adjacent labels have 32px between them before the gap
       counts at all — 6px was adding a seventh of that again for no structural
       reason, and the links now sit against the CTAs where a tight cluster reads
       as one group. The compact band in the nav section at the foot of this file
       takes it to 0 between 980px and 1180px. The hover underline is unaffected:
       ::after is inset 16px from each link's own edges. */
    gap: 2px;
    list-style: none;
  }
  /* Pairs with .nav .wrap's flex-start above — this is what pushes the links and
     the CTAs to the right edge together. */
  .nav .wrap nav {
    margin-left: auto;
  }
  .nav-links > li > a {
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* 0.82, up from 0.7 (2026-10-02). 0.7 measures 8.12:1 against the dark bar,
       which is objectively fine — but uppercase Inter at 11.5px with 0.16em
       tracking covers very little of its own area, so it reads considerably
       lighter than the ratio implies. This is a sitewide change: it reaches the
       nine pages still on the flat nav as well. */
    color: rgba(var(--limestone-rgb), 0.82);
    transition: color 0.35s;
  }
  /* The link's horizontal padding lives in two custom properties, and the
     underline below reads the same two. Before 2026-10-04 they were separate
     literals set by separate rules, and they drifted: the compact band set the
     underline's left to 10px while the split trigger's own (0,2,2) padding rule
     kept the text at 16px, so between 980px and 1180px the Restaurant/Events
     underline started 6px before the first letter. Variants now change the
     VARIABLE only, never padding or left/right directly, so the two cannot
     disagree again however many variants or bands get added. */
  .nav-links > li > a {
    --nav-link-padding-start: 16px;
    --nav-link-padding-end: 16px;
    position: relative;
    display: block;
    padding: 10px var(--nav-link-padding-end) 10px var(--nav-link-padding-start);
  }
  /* right is 16px PLUS the trailing letter-space, not a flat 16px. CSS applies
     letter-spacing after every character including the last, so this element's
     inline box ends 0.16em (1.84px at 11.5px) beyond the final glyph, and an
     underline inset to the padding edge runs to the box rather than to the
     letter. Reported 2026-10-02 as the bar "extending a bit too far" past the
     last letter. left needs no equivalent, since nothing is added before the
     first character. Any future change to .nav-links' letter-spacing has to
     come with the one calc() below. */
  .nav-links > li > a::after {
    content: "";
    position: absolute;
    left: var(--nav-link-padding-start);
    right: calc(var(--nav-link-padding-end) + 0.16em);
    bottom: 4px;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease);
  }
  /* ---- split-trigger overrides, kept ADJACENT to what they override ----
     These two lived ~7,900 lines further down, in the whole-site nav section at
     the foot of this file, where they belong by topic. Moved here 2026-10-02
     because a reported "the override isn't applying" could not be reproduced
     from the file — the rule parsed, sat at brace depth 0, out-specified the
     base at (0,2,2) against (0,1,2), and the markup matched — yet devtools
     listed only the base rule as contributing. Proximity removes any dependency
     on the tail of a 350KB stylesheet being read, which was the one variable
     that could not be tested from the file alone. It is also simply better
     organisation: a rule whose entire job is to override the rule above it
     should not be eight thousand lines away from it. */
  .nav-links > li.nav-dd-split > a {
    /* The split trigger is a label plus a separate chevron <button>, so the
       pair has to read as ONE target — hence 6px here instead of the 16px
       above, closing the gap to the chevron's own 2px padding-left. Only the
       end variable changes; the start, and the underline, follow on their own. */
    --nav-link-padding-end: 6px;
  }
  .nav-links > li:hover > a {
    color: #fff;
  }
  .nav-links > li:hover > a::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  /* Nav dropdown proposal (see navbar.html) — not yet adopted sitewide. Groups
     Weddings/Corporate/Celebrations under one "Events" trigger. Inert unless
     .nav-dd markup exists on the page, so safe to keep here even undecided.
     .nav-dd-panel is "position: fixed" (see the comment above it), which
     resolves against the viewport directly rather than the nearest positioned
     ancestor, so it can be centered and sized independently of this small
     trigger <li> while still living inside it in the DOM (kept there
     deliberately — see that same comment for why moving it out was tried and
     reverted).
     The real remaining gap, found by pinning :hover in devtools and
     confirming the panel itself works perfectly once truly hovered: .nav-dd's
     own box only wraps its button as tightly as the button's own size, not
     the full nav bar — .nav-links centers its items with room above and
     below, so the trigger's rendered bottom edge sits noticeably above the
     nav bar's actual bottom edge, where .nav-dd-panel starts. That gap
     belongs to neither element, so moving the mouse straight down from the
     button crosses dead space and drops :hover before ever reaching the
     panel — no transition delay can save a gap that's never actually
     entered. Explicit "height: var(--nav-h)" + flex centering on .nav-dd
     stretches its own box down to the nav bar's real bottom edge (this
     cascades: .nav-links, then <nav>, then .wrap all auto-size to their
     tallest item in a flex row, so this one explicit height on .nav-dd pulls
     all of them up to match .nav's own height too) — .nav-dd's hit-area now
     touches .nav-dd-panel's with nothing in between, the same principle as
     the pointer-events fix and the padding-top bridge above, just applied to
     the one remaining real gap instead of an assumed one. */
  .nav-dd {
    height: var(--nav-h);
    display: flex;
    align-items: center;
  }
  /* .nav-dd-panel: previously "position: absolute" against .wrap, whose own
     computed height (an auto-sized flex box centered inside .nav's 74px bar)
     isn't something to eyeball confidently — two rounds of guessing at it got
     the vertical gap wrong both times. Then tried moving the panel out to be
     a direct sibling of .nav so "top: var(--nav-h)" could anchor to .nav's
     own explicit height instead — that fixed the gap, but broke the hover
     chain a different way: once the panel was no longer a DOM descendant of
     .nav-dd, hovering the panel itself stopped counting as hovering .nav-dd,
     so leaving the trigger started the close transition regardless of the
     mouse now resting inside the panel — exactly the bug the pointer-events
     fix above was trying to solve, just moved one level up.
     "position: fixed" gets the same pixel-exact anchor as the sibling
     approach (fixed positioning resolves against the viewport itself, not
     the nearest positioned ancestor — and .nav starts at the viewport's own
     top edge, so "top: var(--nav-h)" means exactly the same thing either
     way) WITHOUT needing to move the panel out of .nav-dd — so it stays a
     real descendant, the built-in ".nav-dd:hover .nav-dd-panel" hover chain
     works again, and hovering the panel itself legitimately keeps .nav-dd
     "hovered" the whole time your cursor is inside it. */
  .nav-dd-panel {
    position: fixed;
    top: var(--nav-h);
    /* Centered on the viewport (left:50% + translateX(-50%) against a fixed
       element resolves against the viewport, same as .nav's own center since
       .wrap centers within it) — not left/right-anchored to an edge, since
       this panel is meant to be wider than .wrap's own 1180px content column
       (a mega-menu convention, not our normal reading-width container) and
       needs to extend symmetrically past both edges without one-sided
       clipping math. */
    left: 50%;
    transform: translateX(-50%);
    width: min(1376px, calc(100vw - 32px));
    padding-top: 24px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    /* pointer-events was missing from this list originally — with no
       transition entry it flips to "none" the instant the mouse leaves the
       trigger, before the 0.3s fade-out even starts. Kept as a second line of
       defense even with the dead zone gone above (e.g. covers a mouse that
       stops moving mid-transit for a beat). */
    transition:
      opacity 0.3s var(--ease),
      visibility 0s linear 0.3s,
      pointer-events 0s linear 0.3s;
  }
  .nav-dd-panel-card {
    display: flex;
    gap: 32px;
    padding: 28px;
    background: var(--limestone-2);
    border-radius: var(--radius-card);
    box-shadow: 0 30px 60px -24px rgba(var(--muted-ink-rgb), 0.5);
    transform: translateY(8px);
    transition: transform 0.3s var(--ease);
  }
  .nav-dd-panel-main {
    flex: 1 1 auto;
    min-width: 0;
  }
  /* Fraunces stays reserved for the one genuine heading in here — lighter and
     larger than the old 20px/400 (matching the weight-300 editorial voice h2
     uses elsewhere) so it actually reads as a headline, not just a bolded
     label sitting at the same weight as the item names below it. */
  .nav-dd-panel-heading {
    font-family: "Fraunces", serif;
    font-size: 23px;
    font-weight: 300;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 20px;
  }
  /* Three columns, one row — at the panel's real width (up to 1376px) a
     two-column grid left each item too wide and the odd one out sitting alone
     on its own row; one row of three uses the space evenly for exactly the
     three items there are. */
  .nav-dd-items {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px 24px;
  }
  /* Never actually reached today — the burger takes over at 820px, well
       above this — but kept as a safety net rather than assuming that
       breakpoint never changes. */
  @media (max-width: 700px) {
    .nav-dd-items {
      grid-template-columns: 1fr;
    }
  }
  .nav-dd-panel-media {
    flex: 0 0 340px;
    border-radius: calc(var(--radius-card) - 2px);
    overflow: hidden;
  }
  /* Matches the site's own existing tablet-ish cutover (e.g. the
       copy+image sections reordering at 980px) rather than a number invented
       for this one component. Below it, .wrap is narrow enough that a fixed
       340px image column would crowd the three-column item grid. */
  @media (max-width: 980.98px) {
    .nav-dd-panel-media {
      display: none;
    }
  }
  /* Plain descendant selectors again — .nav-dd-panel is back to being a real
     child of .nav-dd (see the comment above .nav-dd-panel), so it no longer
     needs :has() to reach it. */
  .nav-dd.is-open .nav-dd-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 0.3s var(--ease),
      visibility 0s linear 0s;
  }
  .nav-dd.is-open .nav-dd-panel-card {
    transform: translateY(0);
  }
  /* .is-hovering, not a bare ":hover" — see the long comment above .nav-dd.
     CSS :hover propagation depends entirely on the literal pixel path the
     cursor takes, and a narrow trigger next to a much wider, physically
     distant panel means any diagonal drift toward the panel's visual center
     can exit the trigger's hoverable box before ever touching the panel —
     confirmed directly (pinning :hover in devtools works perfectly; the
     failure is specifically in getting from trigger to panel by moving the
     mouse there normally). No amount of widening hit-areas or bridging gaps
     fixes that in general, because it's not really a size/position problem,
     it's that CSS has no notion of "still heading toward the target." JS
     mouseenter/mouseleave with a short close-delay (see the script at the
     bottom of navbar.html) does: it tolerates a brief moment of being
     "outside" while still moving, however the cursor got there, rather than
     trying to guess the exact geometry that keeps it "inside." :focus-within
     stays as plain CSS below — tabbing directly moves focus, no physical
     path involved, so it never had this problem. */
  .nav-dd.is-hovering .nav-dd-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 0.3s var(--ease),
      visibility 0s linear 0s;
  }
  .nav-dd.is-hovering .nav-dd-panel-card {
    transform: translateY(0);
  }
  /* Not gated behind (hover: hover) — that media query separates touch from
     mouse, which has nothing to do with keyboard focus. Gating this here
     would break keyboard access on any touch+keyboard hybrid device. */
  .nav-dd:focus-within .nav-dd-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 0.3s var(--ease),
      visibility 0s linear 0s;
  }
  .nav-dd:focus-within .nav-dd-panel-card {
    transform: translateY(0);
  }
  /* Scrim: dims the page below the nav while the dropdown is open, same trick
     as the BNY reference — puts the panel's own content in relief instead of
     competing with whatever's in the hero behind it. Sits as a direct child of
     .nav (not inside .wrap), so it relies on .wrap's own explicit z-index: 2
     to paint above it without needing a z-index of its own — giving the scrim
     one risks it painting above the dropdown panel too, since both would then
     have explicit stacking levels and DOM order (scrim comes last) would
     decide, the wrong way. Toggled with :has() off the same .is-open,
     .is-hovering and :focus-within states that already open the panel
     itself, so there's no separate JS state to keep in sync. */
  .nav-dd-scrim {
    position: fixed;
    top: var(--nav-h);
    left: 0;
    right: 0;
    bottom: 0;
    /* 0.6 and blur(10px), up from 0.5 and blur(3px) (2026-10-02). The panel was
       reading differently depending on which section happened to be behind it —
       fine over a light section, muddy over a dark one. The variable that
       actually controls that is not which section it is, it is how much of the
       ground comes through at all, which is this layer's whole job and it was
       set too gently to do it.
       The blur is doing most of the work here, not the alpha: at 10px nothing
       behind the panel resolves into legible text or a hard edge, so every
       section presents the same TEXTURE regardless of its content, while the
       panel keeps its relief against a ground that is still clearly there. More
       alpha alone would have flattened that relief instead. The alternative
       considered and rejected was switching the panel's own colour per section,
       which needs every section tagged, fails silently when one is missed, and
       cannot be followed by the bar — which is always dark while a panel is
       open. */
    background: rgba(var(--muted-ink-rgb), 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.3s var(--ease),
      visibility 0s linear 0.3s;
  }
  /* Briefly excluded Events 2 here (":not(:has(.nav-dd-panel-v2))" on each
     line) while its frosted panel was reading as muddy instead of light —
     backdrop-filter samples whatever's actually painted behind it on screen,
     scrim included, even though the scrim sits correctly *below* the panel in
     stacking. Reverted: the real cause turned out to be a separate bug (a
     `transform` on .nav-dd-v2-card was isolating its backdrop-filter from
     seeing anything behind it at all, scrim or otherwise — see the comment
     above .nav-dd-v2-card), now fixed there instead. With that fixed, the
     frost genuinely blurs whatever's behind it, scrim included, same as
     Events 1 was always meant to — so both dropdowns share one unscoped rule
     again. */
  .nav:has(.nav-dd.is-open) .nav-dd-scrim,
  .nav:has(.nav-dd.is-hovering) .nav-dd-scrim,
  .nav:has(.nav-dd:focus-within) .nav-dd-scrim {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.3s var(--ease);
  }
  /* While a panel is open the BAR takes its scrolled appearance too, whatever
     the scroll position. Without this the scrim dims everything from 74px down
     and the bar keeps its near-transparent top-of-page gradient, leaving a hard
     horizontal seam where the two meet and the hero still bright behind the
     links while the panel hangs off a dimmed page.
     Reuses .nav.stuck's own two declarations rather than inventing a treatment:
     ::before's gradient out, ::after's frost in. So the bar, the panel and the
     scrim read as one surface, and when the page IS scrolled this is already
     the state, so nothing moves.
     (0,3,0) via :has()'s own argument specificity, which beats both .nav::after
     (0,1,0) and .nav.stuck::after (0,2,0) outright - it has to win over stuck
     as well as over the base, since at the top of the page stuck is absent and
     partway down it is present. The 0.6s transition on ::before/::after is
     inherited, so the bar darkens rather than snapping. */
  .nav:has(.nav-dd.is-open)::before,
  .nav:has(.nav-dd.is-hovering)::before,
  .nav:has(.nav-dd:focus-within)::before {
    opacity: 0;
  }
  .nav:has(.nav-dd.is-open)::after,
  .nav:has(.nav-dd.is-hovering)::after,
  .nav:has(.nav-dd:focus-within)::after {
    opacity: 1;
  }
  .nav-dd-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    /* 12px of left padding at EVERY state; the 2px border sits outside it and is
       always present, transparent until the row is hovered or current. Nothing
       reflows when it lands, which is the whole reason it is declared here
       rather than appearing on :hover. Ported from
       .package-stations-index-row on the Reception stations page, along with
       its asymmetric radius below. */
    padding: 11px 12px;
    border: 0;
    border-left: 2px solid transparent;
    /* Tight on the left where the marker sits, rounded on the right. A fully
       rounded left edge would leave the 2px bar as a floating curved sliver
       rather than a straight rule against the row. */
    border-radius: 3px calc(var(--radius-card) - 2px) calc(var(--radius-card) - 2px) 3px;
    text-decoration: none;
    /* 0.18s, not the 0.4s this was ported with. 0.4s suits
       .package-stations-index-row, which is a vertical index read slowly; a nav
       panel is swept across, and at 0.4s the row has not finished arriving
       before the pointer leaves — which reads as the hover being LATE rather
       than as a slow fade. Reported that way 2026-10-02. The label, description
       and icon transitions were shortened to match, or the row would arrive in
       two stages. */
    transition:
      background 0.18s var(--ease),
      border-color 0.18s var(--ease);
  }
  /* Ungated, unlike .nav-dd-trigger above — this is a real page link (like its
     .nav-links a siblings), so a lingering :hover on tap is moot (bug #19's
     documented exemption for controls that navigate away). */
  .nav-dd-item:hover {
    background: rgba(var(--gold-rgb), 0.12);
  }
  .nav-dd-item.active {
    background: rgba(var(--gold-rgb), 0.1);
  }
  .nav-dd-icon {
    flex: none;
    margin-top: 2px;
    color: var(--bronze);
  }
  /* Inter uppercase here, not Fraunces — per the design system, Fraunces is
     reserved for headings (the panel heading above already covers that role);
     this label is functionally the same thing as "WEDDINGS" in the plain nav
     bar, just relocated into a dropdown row, so it gets the same UI-chrome
     treatment every other nav label uses rather than borrowing the heading
     font a second time. */
  .nav-dd-label {
    display: block;
    font-family: "Inter", sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 5px;
  }
  .nav-dd-desc {
    display: block;
    font-family: "Newsreader", Georgia, serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.45;
    color: rgba(var(--ink-rgb), 0.62);
  }
  .nav-cta {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .burger {
    display: none;
    width: 46px;
    height: 46px;
    border: none;
    border-radius: 50%;
    background: transparent;
    position: relative;
    cursor: pointer;
    flex: none;
    transition:
      background 0.3s var(--ease),
      transform 0.2s var(--ease);
  }
  .burger::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(var(--limestone-rgb), 0.1);
    transform: scale(0.7);
    opacity: 0;
    transition:
      transform 0.3s var(--ease),
      opacity 0.3s var(--ease);
  }
  @media (hover: hover) {
    .burger:hover::before {
      transform: scale(1);
      opacity: 1;
    }
  }
  .burger:active {
    transform: scale(0.94);
  }
  @media (hover: none) {
    .burger:active::before {
      transform: scale(1);
      opacity: 1;
    }
  }
  .burger i {
    position: absolute;
    left: 14px;
    right: 14px;
    height: 1.5px;
    background: var(--limestone);
    transition:
      transform 0.45s var(--ease),
      opacity 0.3s;
  }
  .burger i:nth-child(1) {
    top: 17px;
  }
  .burger i:nth-child(2) {
    top: 22.5px;
  }
  .burger i:nth-child(3) {
    top: 28px;
  }
  :global(body.menu-open) .burger i:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  :global(body.menu-open) .burger i:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.4);
  }
  :global(body.menu-open) .burger i:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }
  .progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: linear-gradient(90deg, var(--bronze), var(--gold), var(--gold-2));
  }
  :global(html.nav-no-anim) .nav {
    transition: none !important;
    animation: none !important;
  }
  @media (max-width: 820px) {
    .nav-links {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .burger {
      display: block;
    }
  }
  @media (max-width: 620.98px) {
    .brand .name {
      font-size: 16px;
      letter-spacing: 0.24em;
    }
  }
  /* ============================================================================
     WHOLE-SITE NAV - dropdown panels, split triggers, drawer accordion
     ============================================================================
     Merged out of sandboxes/site-nav.html on 2026-10-02, live on index.html
     only for now. Every rule below was page-local in that sandbox; the sandbox
     keeps its own copy of the write-up styles and nothing else, so it still
     renders, but THIS is now the source of truth for the component.

     The sandbox's long-form reasoning comes with it deliberately - the
     measurements (why the burger moves to 980px, why the panel photo shrinks in
     the compact band), the specificity notes, and the two backdrop-filter bugs
     that come back if anyone re-adds the blur are all things that cost real time
     to find and are not re-derivable from the code.

     Two values that live in the ORIGINAL rules rather than here, so there is one
     source of truth per property: .nav .wrap's justify-content (now flex-start,
     which right-aligns the links) and .nav-links' gap (now 2px). Both are
     commented at their own definitions above.

     Inert on any page without .nav-dd markup, so the nine pages still carrying
     the old flat nav are unaffected.
     ============================================================================ */
  /* ============================================================
     Page-local only. The .nav-dd dropdown and .mobile-nav-group
     accordion components themselves live in styles.css (see the
     comment near .nav-dd there) — everything below is either this
     demo page's own layout, or one of the four additions listed in
     the comment at the top of this file.
     ============================================================ */
  /* RIGHT-ALIGNED NAV LINKS — part of the proposal, not a demo leftover.
     styles.css lays the real nav out as "justify-content: space-between",
     which puts the links in the middle of the bar; this groups them
     against the CTAs at the right edge instead, the treatment navbar.html
     has carried all along.
     Briefly removed on 2026-10-01 on the mistaken reading that it was a
     sandbox convenience rather than an intended design — it is intended,
     so it is restored and this comment exists so it does not get
     "cleaned up" a second time. Adopting this proposal means changing
     .nav .wrap in styles.css, which reaches every page's header; it is
     not a page-local tweak, and it is the one change here that alters the
     live nav's layout rather than only adding to it. */
  /* ---------- (a) .nav-dd-split: a trigger that both navigates and opens ----------
     navbar.html's .nav-dd-trigger is a single <button>, which is right
     for a pure grouping label but cannot navigate. This proposal wants
     Restaurant and Events to be real destinations (decision 2), so the
     label is a genuine <a> and the chevron is its own <button> beside
     it. Consequences handled below, in order:
       - The <a> is a DIRECT child of li.nav-dd, so it already inherits
         every ".nav-links > li > a" treatment for free, hover underline
         included. Nothing to restate.
       - The pair must read as ONE target, so the gap between them is
         closed by trimming the <a>'s right padding and the button's
         left padding rather than letting two 16px paddings sit back to
         back.
       - Keyboard order is label → chevron → panel rows, which is the
         reading order; :focus-within on .nav-dd (styles.css) opens the
         panel for either. */
  /* The two .nav-links > li.nav-dd-split > a rules that used to sit here (the
     padding that closes the gap to the chevron, and the underline inset that
     follows it) now live next to .nav-links > li > a near the top of this file,
     beside the rules they override. See the note there. */
  /* align-self: stretch, because .nav-dd is "align-items: center" on an
     explicit 74px height, so this button otherwise sits at its content
     height — 29 x 27px. That clears WCAG 2.5.8's 24px minimum but is well
     short of the comfortable 44px, and it matters more than it looks:
     between 980px and roughly 1100px there is no hover, so this chevron
     is the ONLY way a touch user can open a panel. Stretching takes it to
     29 x 74 at zero visual cost, since the button is already a centred
     flex container and the SVG stays optically where it was.
     The LABEL deliberately does not get the same treatment — it carries
     the gold underline-reveal at "bottom: 4px" of its own box, so
     stretching it would drop that underline to the bottom of the nav
     bar. */
  /* 6px (styles.css) down to 2px. The links already carry 16px of
     padding a side, so adjacent labels have 32px between them before the
     gap is counted at all — 6px was adding a seventh of that again for no
     structural reason. Reads tighter now that the links sit against the
     CTAs rather than centred: a compact link cluster is legible as ONE
     group distinct from the two buttons, where a loose one blurs into
     them. The compact band below takes it the rest of the way to 0.
     The hover underline is unaffected — .nav-links > li > a::after is
     inset 16px from the link's own edges, so the visible gap between two
     underlines is 32px + this, and 4px off that is imperceptible. */
  /* padding-left 4px -> 2px, so the chevron sits 2px nearer its word
     (the seam was the link's 6px padding-right plus this, 10px total;
     now 8px). Taken off THIS side rather than the link's padding-right
     because that value also sets where the underline stops — moving it
     would pull the gold bar in under the text. Cost worth stating: the
     button is now 27px wide rather than 29px. Still over WCAG 2.5.8's
     24px minimum, and the align-self below makes it 74px tall, so the
     target area is comfortably larger than it was before either change. */
  .nav-dd-split-chevron-button {
    display: flex;
    align-items: center;
    align-self: stretch;
    padding: 10px 14px 10px 2px;
    background: none;
    border: none;
    color: rgba(var(--limestone-rgb), 0.7);
    cursor: pointer;
    transition: color 0.35s;
  }
  @media (hover: hover) {
    .nav-dd-split-chevron-button:hover {
      color: #fff;
    }
  }
  @media (hover: none) {
    .nav-dd-split-chevron-button:active {
      color: #fff;
    }
  }
  /* Same-page toggle, not a page link, so it needs bug #19's touch
     hover-gate: a tap would otherwise leave it looking permanently
     hovered instead of clearing on release. Identical reasoning to
     .nav-dd-trigger's own gate in styles.css. */
  /* Keeps the LABEL lit while the panel is open, so the pair reads as
     one lit control rather than a lit chevron next to a dim word.
     styles.css already does this for .nav-dd-trigger; the <a> needs
     its own line. At (0,2,0) this beats ".nav-links > li > a"'s (0,1,2)
     on class count, while ".nav-links > li > a.active" at (0,2,2) still
     beats THIS — so an active page stays gold rather than going white
     whenever its own dropdown is open. */
  .nav-dd.is-open > a,
  .nav-dd.is-hovering > a,
  .nav-dd:focus-within > a {
    color: #fff;
  }
  .nav-dd.is-open .nav-dd-split-chevron-button,
  .nav-dd.is-hovering .nav-dd-split-chevron-button,
  .nav-dd:focus-within .nav-dd-split-chevron-button {
    color: #fff;
  }
  /* ============================================================
     (e) DARK CARD — .nav-dd-panel-card-dark
     ============================================================
     The light card was the one thing about this treatment that did not
     match the plan: the nav is dark, so the dropdown was always meant to
     be too. Colour is a property of the CARD, not of the layout, so this
     keeps the three-column grid (which absorbs new links sideways —
     nine items is three clean rows) and takes the Events #2 panel's
     colour instead of its single-column shape.

     Page-local, via a modifier stacked on the base class, exactly the
     way .nav-dd-v2-card does it — NOT edited into .nav-dd-panel-card
     itself, because navbar.html's Events #1 panel shares that class and
     its whole purpose is to preserve the light treatment as a record of
     what was compared.

     NO backdrop-filter HERE, and that is the whole point of this rule
     being three lines long. The Events #2 panel frosts its card the way
     .nav::after does, which is where this colour comes from — but the
     scrim behind an open panel is already rgba(--muted-ink, 0.5), and
     0.86 on top of that puts the card at roughly 93% opaque against the
     actual page. About 7% of a blur(14px) was reaching the eye, while
     paying for the one declaration CLAUDE.md records as a dominant scroll
     cost on .package-sticky-switch. Measured against that, the blur was
     buying nothing. The flat alpha alone still carries the "extension of
     the nav bar" read, because what does that work is the colour matching
     .nav::after's, not the blur.

     DROPPING IT REMOVED TWO WORKAROUNDS RATHER THAN ONE, which is why
     this is a simplification and not just a deletion. Both are real bugs,
     both were solved once on .nav-dd-v2-card, and BOTH COME BACK THE
     MOMENT ANYONE RE-ADDS backdrop-filter HERE — so they are written down
     rather than quietly discarded:

     1. backdrop-filter AND border-radius on the SAME box produces a black
        hairline seam along the rounded edge in Chromium/WebKit, worst
        while the card is mid-transition. That forced the background onto
        a ::before with inset:-1px so its antialiased boundary fell
        outside the visible corner, with the card itself doing nothing but
        clip. With no blur, background and border-radius coexist happily
        on one box, so the ::before, its overflow:hidden, and the z-index
        rules that lifted both children above it are all gone.
     2. ANY transform on an ancestor of a backdrop-filter element isolates
        it into its own compositing layer, cutting the blur off from
        sampling the page behind it — the frost reads flatly opaque.
        .nav-dd-panel-card's open/close lift is
        "transform: translateY(8px) → translateY(0)", which made that
        lift unusable and forced a margin-top re-implementation plus an
        is-open override to match. With no blur, the base class's own
        transform lift just works, so both are gone too.

     What is left is one declaration.

     ALPHA RAISED 0.86 → 0.97, then settled at 0.91 on review — enough to
     stop the page reading through, with more of the frosted character
     than 0.97 kept. Over the 0.5 scrim that is about 95.5% opaque.
     (Original note follows.) Reported: too much of the page was reading
     through the panel). Note this is the RIGHT lever for that complaint
     and re-adding the blur is not: a blur softens what comes through, it
     does not reduce how much does — that is what alpha controls, and
     alpha is free where the blur was not. 0.97 over the 0.5 scrim puts
     the card at about 98.5% opaque, so nothing legible survives behind
     it, while the last whisper of transparency keeps it from reading as
     a flat sheet pasted over the page. Going fully solid is the next
     step if even that is too much.
     The trade is worth naming: a genuinely frosted panel REQUIRES low
     alpha, because frost is literally the page showing through blurred.
     Frost and an opaque panel are mutually exclusive, so this is a choice
     between them rather than a tuning problem. */
  /* THE HAIRLINE (added 2026-10-02). Over a light section the card's own
     darkness defines its edge; over a DARK one the card and the scrimmed ground
     behind it land close enough together that the panel stops reading as a card
     at all. A border is the standard answer to "this surface has no edge", and
     gold is not an invention here: .nav.stuck already defines the bar's own
     bottom edge with rgba(--gold-rgb, 0.22) once scrolled, and this exact
     1px/0.2 pairing is already used elsewhere in this file — so the panel
     hanging off the bar picks up a line the site already speaks rather than
     introducing a second vocabulary.
     0.2 rather than something heavier on purpose: this has to define an edge,
     not frame the panel in, which is the same judgement .tab-panel li makes
     about its own dividers.
     A GRADIENT border was considered and not taken for now — it needs either
     border-image or a masked ::before, and on a surface this large it starts
     reading as decoration rather than definition. The version worth revisiting
     if a flat line proves too quiet is a TOP-WEIGHTED gradient: strongest where
     the card meets the bar and fading down the sides, which is what an actual
     light source would do. */
  .nav-dd-panel-card-dark {
    background: rgba(var(--muted-ink-rgb), 0.91);
    /* 1.5px, up from the 1px this started at. A hairline defined the card's
       edge over a dark section but only just; half a pixel more gives it enough
       presence to read as a card without becoming a frame.
       Fractional borders antialias rather than landing on a device pixel, so on
       a 1x display this renders as a soft line rather than a crisp one. If that
       reads fuzzy, the alternative that avoids subpixels entirely is going back
       to 1px and raising the alpha to around 0.28 — same perceived weight, no
       antialiasing. Worth checking on an external monitor before settling.
       A TOP-WEIGHTED GRADIENT version of this border was built and removed on
       2026-10-02: brightest where the card met the bar and fading down the
       sides, via a masked ::before. It worked, but it was more machinery than
       the job needed and read as decoration on a surface this large. The flat
       line does the actual work, which is telling you where the card ends. */
    border: 1.5px solid rgba(var(--gold-rgb), 0.2);
  }
  /* ---------- Text recoloured for the dark card ----------
     Values taken from .nav-dd-v2-* rather than invented, so the two
     panels can't drift apart on a dark background. Each is scoped under
     .nav-dd-panel-card-dark so navbar.html's light panel is untouched. */
  .nav-dd-panel-card-dark .nav-dd-panel-heading {
    color: var(--limestone-2);
  }
  /* Rows now REST DIM and the hovered one lights up, rather than every row
     sitting at full brightness with only the background moving. That is the
     half of the stations treatment worth having on its own: with the label
     already at --limestone-2 there was no headroom to brighten into, so hover
     could only add a wash. The comment on that page puts it best - the current
     row should be the LIT one, not the loud one, and most of that work is done
     by its neighbours resting lower. */
  .nav-dd-panel-card-dark .nav-dd-label {
    color: rgba(var(--limestone-rgb), 0.86);
    transition: color 0.18s var(--ease);
  }
  .nav-dd-panel-card-dark .nav-dd-desc {
    color: rgba(var(--limestone-rgb), 0.74);
    transition: color 0.18s var(--ease);
  }
  @media (hover: hover) {
    .nav-dd-panel-card-dark .nav-dd-item:hover {
      background: rgba(var(--limestone-rgb), 0.07);
      border-left-color: var(--gold);
    }
  }
  /* (0,4,0) - one more class than the [data-unbuilt] label rule below at
       (0,3,0), so an unbuilt row brightens on hover too rather than staying
       pinned at its dimmer resting value. */
  @media (hover: hover) {
    .nav-dd-panel-card-dark .nav-dd-item:hover .nav-dd-label {
      color: var(--limestone-2);
    }
  }
  @media (hover: hover) {
    .nav-dd-panel-card-dark .nav-dd-item:hover .nav-dd-desc {
      color: rgba(var(--limestone-rgb), 0.78);
    }
  }
  /* (0,4,0), so it beats BOTH resting icon rules - the plain one at (0,2,0)
       and the [data-unbuilt] one at (0,3,0). Without that, unbuilt rows would
       be the only ones whose icon stayed dark on hover. */
  @media (hover: hover) {
    .nav-dd-panel-card-dark .nav-dd-item:hover .nav-dd-icon {
      color: var(--gold-2);
    }
  }
  /* The wash is LIMESTONE, not gold, and the gold is spent entirely on the
     left border. This is the lesson the stations page already learned and
     recorded: a gold tint behind a gold border beside a gold badge is three
     golds at three strengths in one row, and the quietest of them stops
     registering. These rows carry a Proposed badge and a bronze icon, so they
     would have hit it immediately. One gold event per hover, and the surface
     says "this row" while the border says "gold".
     0.07 looks faint written down and is right rendered: it is doing far less
     work than the old 0.16 gold wash because the border and the label
     brightening now carry the state between them. */
  /* Current page. Not gated behind (hover: hover) - this is a persistent
     state, not feedback, and a touch visitor needs to see where they are as
     much as anyone.
     Until 2026-10-04 this was the hover treatment exactly, held — wash,
     border, label and icon — so on returning to a panel the current page's
     row read as a hover that never cleared. Now it keeps the gold border,
     brightened label and gold icon but NOT the limestone wash, which is left
     to mean "pointer is here", and adds a gold dot after the label as its own
     "you are here" mark.
     background is set explicitly, not just omitted: the light card's
     .nav-dd-item.active gold wash (0,2,0) would otherwise show through. That
     makes this (0,3,0) rule beat the (0,3,0) hover wash above on source
     order, so hovering the current row gets its own (0,4,0) rule below. */
  .nav-dd-panel-card-dark .nav-dd-item.active {
    background: transparent;
    border-left-color: var(--gold);
  }
  @media (hover: hover) {
    .nav-dd-panel-card-dark .nav-dd-item.active:hover {
      background: rgba(var(--limestone-rgb), 0.07);
    }
  }
  /* A flex item in the label's baseline-aligned row (see the .nav-dd-label
     override further down), so it centres itself rather than sitting on the
     baseline, which an empty box would otherwise do. */
  .nav-dd-panel-card-dark .nav-dd-item.active .nav-dd-label::after {
    content: "";
    flex: none;
    align-self: center;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold);
  }
  .nav-dd-panel-card-dark .nav-dd-item.active .nav-dd-label {
    color: var(--limestone-2);
  }
  .nav-dd-panel-card-dark .nav-dd-item.active .nav-dd-icon {
    color: var(--gold-2);
  }
  /* (0,3,0) with the attribute selector, beating the plain label rule
     above at (0,2,0) — the dim treatment for an unbuilt row has to win
     over the normal one. */
  .nav-dd-panel-card-dark .nav-dd-item[data-unbuilt] .nav-dd-label {
    color: rgba(var(--limestone-rgb), 0.74);
  }
  .nav-dd-panel-card-dark .nav-dd-item[data-unbuilt] .nav-dd-icon {
    color: rgba(var(--bronze-on-dark-rgb), 0.78);
  }
  /* The icon rests dim and lights with the label, rather than sitting at full
     strength while the text around it moves. Same reasoning as the labels: at
     full --bronze there was no headroom to brighten into, so the icon was the
     one part of a hovered row that did not respond.
     It brightens to --gold-2, not to full bronze, because bronze-to-bronze is
     too small a move to read at 18px. That does put a second gold in the row
     alongside the left border - which the stations page's own note warns
     about - but the case there was gold tint BEHIND a gold border beside a
     gold badge, three of them at three strengths with the background among
     them. Here the wash is limestone and the badge is bronze, so the only two
     gold things are the border and the icon, both of which appear together on
     the same event. One gold moment, two marks. */
  .nav-dd-panel-card-dark .nav-dd-icon {
    /* --bronze-on-dark at full strength, not --bronze at an alpha. See that
       token's note: the previous 0.72 then 0.85 passes were both trying to
       brighten a colour that is simply too dark for this surface, and alpha
       only ever moves it toward the background. */
    /* 0.85, not the 0.72 the labels rest at. Equal alpha is NOT equal
       brightness: --limestone is #f7f2e6, so 0.72 of it over a dark card is
       still clearly light, while --bronze is #8a7442 — already a dark colour —
       and 0.72 of that lands close to the card itself. Matching the numbers
       made the icon read as nearly off rather than as resting. The headroom for
       the hover is carried by the jump to --gold-2, which is a hue change as
       much as a brightness one, so it does not need the alpha gap the text
       does. */
    color: var(--bronze-on-dark);
    transition: color 0.18s var(--ease);
  }
  /* ---------- (b) Proposed-page markers ----------
     Several rows in these panels point at pages that do not exist yet.
     Rather than letting them look like working links in a pitch, each
     carries a visible badge and the local JS preventDefault()s it.
     Not oxblood: that is the sitewide "illustrative / unconfirmed data"
     warning (per CLAUDE.md), and these are not unconfirmed facts — they
     are real proposals that simply are not built. Different signal,
     different colour.
     --gold-2 rather than --bronze now that the card is dark — bronze
     against rgba(--muted-ink) is too dim to read as a badge. The mobile
     drawer's own badge below stays bronze, because that drawer's
     background is --ink and bronze reads fine there; the two are not
     meant to match, they are meant to each suit their own surface. */
  /* The badge's 8px margin-left used to follow it onto the next line
     when the label wrapped, indenting it under nothing — reported on
     "Preferred suppliers", which is the one label long enough to wrap and
     push its badge down. The facetious version of the fix ("a media query
     for whether it wrapped") is actually the right instinct: CSS has no
     selector for that, so the answer is to stop using a margin and let a
     GAP do the spacing, since a flex gap applies between items on a line
     and never at the start of one.
     So the label becomes a flex container. Its own text stays a bare text
     node, which flex wraps in an anonymous item that still line-breaks
     internally exactly as it did; the badge is the second item, and
     flex-wrap drops it to its own flex line when it does not fit — flush
     left, no phantom indent. align-items: baseline keeps the badge
     sitting on the label's baseline rather than centred against a
     two-line block, which is what inline-block was giving for free and
     what a naive switch to flex would have quietly lost.
     Scoped to the dark card rather than edited into styles.css's
     .nav-dd-label, since navbar.html shares that class and has no badges
     to need it. */
  .nav-dd-panel-card-dark .nav-dd-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
  }
  /* nowrap so "PROPOSED" can never break across two lines in a narrow
     column — it can fall to its own line after a wrapping label, which is
     fine, but splitting the word itself is not. */
  .nav-dd-item-proposed-badge {
    display: inline-block;
    white-space: nowrap;
    padding: 1px 6px;
    /* Bronze, not gold - see the note by .nav-dd-item's hover rules. Gold is
       now spent entirely on the row's left border, and a gold badge sitting
       beside a gold border is two golds doing two different jobs. Bronze pairs
       it with .nav-dd-icon instead, which is already bronze. */
    border: 1px solid rgba(var(--bronze-rgb), 0.55);
    border-radius: 999px;
    font-family: "Inter", sans-serif;
    font-size: 8.5px;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--bronze);
    vertical-align: 1px;
  }
  /* ============================================================
     (f) THE HUB MOVED OUT OF THE GRID, into the heading row
     ============================================================
     The hub ("The restaurant" / "All events") is the dropdown's own
     parent page, and it has to be reachable by tap, since on touch there
     is no hover to separate "open the menu" from "go to the page". It was
     a row spanning all three columns, with a hairline under it. That is
     what made the Restaurant panel feel bloated, and the geometry says
     exactly why:

       RESTAURANT                        EVENTS
       ┌───────────────────────────┐     ┌───────────────────────────┐
       │ The restaurant      (hub) │     │ All events          (hub) │
       ├───────────────────────────┤     ├───────────────────────────┤
       │ Menus │ Chambers │ Vouch. │     │ Weddings │ Corp. │ Celebr.│
       └───────────────────────────┘     │ Spaces   │ Suppl.│ Guides │
                                         └───────────────────────────┘
         hub = 1 of 2 rows → 50% of        hub = 1 of 3 rows → 33% of
         the height for 1 of 4 links       the height for 1 of 6 links

     Same component, different proportion — which is why one panel read
     as mostly empty and the other read fine. On Restaurant the hub was
     half the panel's height for a quarter of its content, a short label
     and one line of description sprawled across the full 948px of the
     content column.
     Moving it onto the heading's own line costs no grid row at all, and
     it stays reachable two ways on touch (this link, plus the nav label
     itself, which is a real <a> — see .nav-dd-split). Measured result:
     Restaurant drops from roughly 260px to 180px, Events from 365px to
     270px.
     Note the knock-on that makes Events tidier too: with the hub out of
     the grid, adding Guides takes it to six items — two clean rows of
     three, which also closes the empty third cell its bottom row used
     to have. */
  .nav-dd-panel-heading-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    /* Takes over .nav-dd-panel-heading's own 20px bottom margin, zeroed
       below — a margin on a flex item inside this row would push the
       row's own height around instead of setting the gap beneath it. */
    margin-bottom: 20px;
  }
  .nav-dd-panel-heading-row .nav-dd-panel-heading {
    margin-bottom: 0;
  }
  /* Inter uppercase, matching every other piece of UI chrome rather than
     borrowing Fraunces a second time — the same reasoning as
     .nav-dd-label's own comment in styles.css. */
  /* Sized and lit as a PEER of the row labels below it, not as a caption.
     It was 10.5px at 0.62 alpha with 0.14em tracking — smaller, dimmer
     AND more letter-spaced than .nav-dd-label's 12.5px/0.07em, and wide
     tracking makes uppercase read smaller still, so all three pushed the
     same way and the panel's own parent page became the easiest link in
     it to miss. Now 12px at 0.8, tracking pulled back to 0.12em.
     Deliberately NOT gold at rest: that would compete with the Fraunces
     heading it shares a baseline with, and gold is what the hover and
     current-page states use. */
  .nav-dd-hub-link {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: "Inter", sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(var(--limestone-rgb), 0.9);
    text-decoration: none;
    transition: color 0.35s;
  }
  /* Ungated :hover — a real page link, so bug #19's touch exemption
     applies: tapping navigates away and a lingering hover is moot. */
  .nav-dd-hub-link:hover {
    color: var(--gold-2);
  }
  /* Gold rather than the rows' background wash: the rows are full-width
     blocks, and a wash behind a short inline label in a heading row
     would read as a stray chip. Without this the script's own .active
     class would be a silent no-op here, since nothing else styles it. */
  .nav-dd-hub-link.active {
    color: var(--gold-2);
  }
  /* ============================================================
     (g) THE PHOTOGRAPH NOW ANSWERS THE HOVERED ROW
     ============================================================
     The best thing about the Events #2 panel was that its photo column
     changed to match whichever row you were reading — for a venue, where
     the product IS the room, that beats one static decorative image. The
     mechanism is not specific to that panel's layout: it is :has()
     keyed off each row's data-target, entirely in CSS, no JS. So it
     ports onto this grid unchanged in principle.
     It was expensive before, because one <img> per state meant every
     photo downloading on page load. The deferred loading below (see
     primeDropdownMedia in the script) makes it close to free, which is
     what made this worth doing here at all. */
  .nav-dd-panel-media {
    position: relative;
  }
  /* Darkens only where the caption sits, so the photograph itself stays
     bright — a flat overall tint would dim the image to light the text.
     Same two-stop gradient as .nav-dd-v2-media::after. */
  .nav-dd-panel-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(var(--ink-rgb), 0) 40%,
      rgba(var(--ink-rgb), 0.8) 100%
    );
  }
  /* ::after is painted as the last child regardless of source order, so
     without an explicit z-index the gradient would paint over the
     caption and darken the text along with the photo. */
  .nav-dd-panel-caption {
    position: absolute;
    z-index: 1;
    left: 18px;
    right: 18px;
    bottom: 16px;
    margin: 0;
    font-family: "Newsreader", Georgia, serif;
    font-style: italic;
    font-weight: 350;
    font-size: 15px;
    line-height: 1.375;
    /* Matches .quote blockquote — the site's existing precedent for
       italic text over a photo — rather than plain white. */
    color: var(--limestone-2);
    /* Layered: a tight dark shadow for edge definition against bright
       patches, plus a softer one for separation from the image. */
    text-shadow:
      0 1px 3px rgba(0, 0, 0, 0.9),
      0 2px 10px rgba(0, 0, 0, 0.7);
    opacity: 0;
    transition: opacity 0.28s var(--ease);
  }
  .nav-dd-panel-caption[data-state="default"] {
    opacity: 1;
    transition: opacity 0.28s var(--ease) 0.15s;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-dd-panel-card .nav-dd-panel-caption[data-state] {
      transition: none;
    }
  }
  .nav-dd-panel-card:has(.nav-dd-item[data-target]:is(:hover, :focus))
    .nav-dd-panel-caption[data-state="default"] {
    opacity: 0;
    /* The other half of the asymmetry above: no delay leaving, so landing
       on a row swaps the photo at once. Written as the full shorthand
       rather than a lone transition-delay — a bare delay here would have
       to win against a shorthand on the same element, which is bug #2's
       trap in miniature (the shorthand resets delay to 0, and whichever
       loads later takes the property wholesale). */
    transition: opacity 0.28s var(--ease) 0s;
  }
  .nav-dd-panel-card:has(.nav-dd-item[data-target="menus"]:is(:hover, :focus))
    .nav-dd-panel-caption[data-state="menus"] {
    opacity: 1;
  }
  .nav-dd-panel-card:has(.nav-dd-item[data-target="weddings"]:is(:hover, :focus))
    .nav-dd-panel-caption[data-state="weddings"] {
    opacity: 1;
  }
  .nav-dd-panel-card:has(.nav-dd-item[data-target="corporate"]:is(:hover, :focus))
    .nav-dd-panel-caption[data-state="corporate"] {
    opacity: 1;
  }
  .nav-dd-panel-card:has(.nav-dd-item[data-target="celebrations"]:is(:hover, :focus))
    .nav-dd-panel-caption[data-state="celebrations"] {
    opacity: 1;
  }
  .nav-dd-panel-card:has(.nav-dd-item[data-target="spaces"]:is(:hover, :focus))
    .nav-dd-panel-caption[data-state="spaces"] {
    opacity: 1;
  }
  /* ============================================================
     (j) COMPACT NAV BAND — 980px to 1179.98px
     ============================================================
     REAL BUG, reported from the demo 2026-10-01: the Enquire button runs
     off screen at 1015px, and the bar already looks overfull at 1092px.
     Confirmed by adding the content up from the CSS rather than
     eyeballing it, which is where an earlier estimate of ~890px went
     wrong — it forgot that each dropdown label now has a 29px chevron
     button beside it:

       brand          34px mark + 13px gap + ~154px lockup   ~201px
                      (the "MDINA · EST. 1660" sub-line is WIDER than
                      "BACCHUS" itself — 0.42em tracking over 17
                      characters — so it, not the name, sets this width)
       nav links      Restaurant 130 + chevron 29, Events 91 + 29,
                      Gallery 101, About 81, three 6px gaps      ~479px
       CTAs           Book a table 174, Enquire 129, 18px gap    ~321px
       wrap gaps      2 x 24px                                     48px
                                                               --------
                                                               ~1049px

     Against that, .wrap offers (viewport - 88px) of room, capped at
     1092px once the viewport passes 1180. So the bar needs ~1137px before
     it sits comfortably, and it has been overflowing below that — not
     only near the 980px cutover.

     A MEDIA BAND, NOT clamp(), deliberately. The house preference is
     clamp() for anything that should scale, but across a 200px-wide range
     a vw-based clamp barely moves: 1.36vw on the link padding recovers
     about 21px over the whole band, where this needs 120 or more. Getting
     there with clamp() means the calc-interpolation form on six separate
     properties, which is both less legible and harder to reason about
     than one band. This is also bug #20's situation exactly — fixed-size
     controls inside a fluid bar, where "the breakpoint floor is set by
     the control, not by the layout" — and the fix there was a media band
     swapping to existing smaller token values, which is what this does.

     Bounded on BOTH sides on purpose: above 1180px .wrap stops growing
     and there is ~43px of slack, so the designed spacing is untouched
     there; below 980px the burger takes over. The .98 pairing follows bug
     #22 so the handover to 1180px leaves no fractional gap.

     Nothing here changes a font size, the 74px bar height, or any
     colour — every line is spacing or a decorative glyph, so the bar
     compresses rather than restyling. Running total of what it recovers
     is noted per block. */
  /* -48px. 16px to 10px each side; the links keep 20px of total
       horizontal padding, which is still comfortably above their 11.5px
       type. */
  @media (min-width: 980px) and (max-width: 1179.98px) {
    .nav-links > li > a {
      --nav-link-padding-start: 10px;
      --nav-link-padding-end: 10px;
    }
  }
  /* -18px. The links' own padding already separates them; the gap was
       additional breathing room, not structure. */
  @media (min-width: 980px) and (max-width: 1179.98px) {
    .nav-links {
      gap: 0;
    }
  }
  /* -12px. Keeps the 4px seam between label and chevron so the pair
       still reads as one target. */
  @media (min-width: 980px) and (max-width: 1179.98px) {
    .nav-dd-split-chevron-button {
      padding-right: 8px;
    }
  }
  /* The underline follows these automatically (see the custom properties
       on .nav-links > li > a). Same (0,2,2) as the base split rule, so this
       wins on source order — it sits ~9,000 lines later inside the band. */
  @media (min-width: 980px) and (max-width: 1179.98px) {
    .nav-links > li.nav-dd-split > a {
      --nav-link-padding-end: 4px;
    }
  }
  @media (min-width: 980px) and (max-width: 1179.98px) {
    .nav-cta {
      gap: 10px;
    }
  }
  /* ---------- The PANEL is squashed in this band too ----------
       Reported with a screenshot: descriptions wrapping to four and five
       lines, and on "Preferred suppliers" the PROPOSED badge pushed down
       to a third line before the description even started.
       The cause is the photo column, not the grid. .nav-dd-panel-media is
       a fixed "flex: 0 0 340px" while the panel itself is
       min(1376px, 100vw - 32px) — so the photo is a constant while
       everything else shrinks, and it takes a steadily larger share. At a
       1024px viewport the panel is 992px, the card's padding takes 56 and
       the photo and its gap take 372, leaving 564px for three columns:
       about 172px each, and after the item's own padding, icon and gutter
       roughly 118px of actual text. At 14px Newsreader that is around
       seventeen characters a line, which is what produced the screenshot.
       styles.css already hides this column below 981px for exactly this
       reason ("a fixed 340px image column would crowd the three-column
       item grid") — that reasoning simply did not stop being true at
       981px, because the PANEL is wider than .wrap and keeps growing
       after the breakpoint it was judged at.
       Shrinking the photo rather than hiding it, on purpose: hiding it
       would widen the columns more, but the per-row crossfade is the best
       thing about this panel and losing it on every laptop to win a line
       of text is the wrong trade. 240px is still a real photograph. */
  @media (min-width: 980px) and (max-width: 1179.98px) {
    .nav-dd-panel-media {
      flex-basis: 240px;
    }
  }
  /* The remaining width comes from the gutters rather than the type:
       column gap 24 → 16, item padding 12 → 8 a side, icon gutter 12 →
       10. Roughly 50px back across the three columns, on top of the 100px
       the photo gives up. */
  @media (min-width: 980px) and (max-width: 1179.98px) {
    .nav-dd-items {
      column-gap: 16px;
    }
  }
  @media (min-width: 980px) and (max-width: 1179.98px) {
    .nav-dd-item {
      padding-left: 8px;
      padding-right: 8px;
      gap: 10px;
    }
  }
  /* ---------- (c) Burger cutover at 980px, not 820px ----------
     Measured, not guessed: brand lockup ~200px + four nav items ~400px
     + two compact pills ~250px + gaps lands around 890px of content,
     which overflows .wrap's available width anywhere below roughly
     940px. The real site's 820px cutover is sized for four plain text
     links and ONE pill. 979.98px is the site's own established tablet
     cutover (the copy+image reorder, .nav-dd-panel-media's own hide)
     rather than a number invented here, and the .98 follows CLAUDE.md
     bug #22's house rule so the handover to 980px leaves no fractional
     gap. */
  @media (max-width: 979.98px) {
    .nav-links {
      display: none;
    }
  }
  @media (max-width: 979.98px) {
    .burger {
      display: block;
    }
  }
  /* ============================================================
     NAV ENTRANCE (2026-10-05)
     ============================================================
     The bar used to be the one thing on the page with no entrance: fully
     formed from the first frame, and on the homepage sitting on top of the
     still-closed portcullis, ahead of the gate it's meant to arrive behind.
     It now fades down into place: with the bars lifting on the homepage,
     and alongside the hero copy everywhere else.

     Pure CSS on purpose. A script-triggered entrance would leave the nav
     invisible until the script arrived, which on a slow connection means a
     site with no navigation for seconds; a CSS animation runs from the
     first paint regardless.

     `backwards` fill, never `both`/`forwards`: the from-state applies during
     the delay, and once the animation ends the element is handed back to its
     normal styles entirely. A held end-state would keep overriding things
     the bar does later — `.nav.stuck::before` fading its gradient out, for
     one — since animations beat ordinary declarations. It also means no
     transform lingers on the bar's contents, which matters: a transform on
     an ancestor of the dropdown panels makes it their containing block and
     kills their backdrop blur (see the dark-card notes further up). During
     the brief entrance itself, no panel can be open yet.

     The contents (.wrap) and the top gradient (::before) are animated, not
     .nav itself, for the same transform reason. */
  .nav::before {
    animation: nav-backdrop-enter 0.6s var(--ease) 0.05s backwards;
  }
  :global(body:has(.portcullis)) .nav::before {
    animation-delay: 0.35s;
    animation-duration: 0.7s;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav::before {
      animation: none;
    }
  }
  /* NO unconditional darkening while the overlay is open — that was tried on
     2026-10-02 and replaced the same day. The bar should behave inside the
     overlay exactly as it does on the page: transparent at the top, darkening
     once you scroll. It is .stuck that does that, and main.js now drives .stuck
     from the OVERLAY's own scrollTop while it is open rather than from
     window.scrollY, which is frozen then anyway (body gets overflow: hidden).
     See the whole-site nav block in main.js. */
  .nav .wrap {
    display: flex;
    align-items: center;
    /* flex-start + "margin-left: auto" on the <nav> below, NOT space-between:
       the links group against the CTAs at the right edge rather than sitting
       centred. Changed 2026-10-02 with the whole-site nav merge — with two CTAs
       the right side is the heaviest thing in the bar, and a compact link
       cluster beside them reads as one group where a centred one blurs into
       the gap. This is the one part of that merge that alters the existing nav's
       layout rather than only adding to it, so it reaches the nine pages still
       on the flat nav too — which is fine, they look correct right-aligned. */
    justify-content: flex-start;
    gap: 24px;
    position: relative;
    z-index: 2;
  }
  .brand :global(img) {
    width: 34px;
    height: auto;
    filter: drop-shadow(0 1px 6px rgba(0, 0, 0, 0.5));
  }
  .brand .sub {
    font-size: 8.5px;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--gold-2);
    margin-top: 5px;
    padding-left: 3px;
  }
  /* Every <li> is the full height of the bar, not just the .nav-dd ones.
     .nav-dd has carried "height: var(--nav-h)" on its own since the dropdown was
     built, to close the dead strip between the trigger's bottom edge and the
     panel's top edge — without it, moving the cursor straight down from the
     label crossed ~22px belonging to neither element and dropped the hover.
     The side effect, reported 2026-10-02: Restaurant and Events had a 74px-tall
     hit area while Gallery had only its link's ~31px, so the two dropdowns felt
     hair-trigger next to a Gallery link you had to aim at. That reads as the bar
     being erratic rather than as one item being generous.
     Giving every <li> the same height makes the whole bar behave identically —
     anywhere in the 74px band over a label activates it, which is ordinary nav
     behaviour and better than a thin strip in the middle. The hover underline
     moves to "li:hover > a::after" to follow, since the <a> itself is no longer
     what the pointer has to be inside. */
  .nav-links > li {
    height: var(--nav-h);
    display: flex;
    align-items: center;
  }
  .nav-links > li > :global(a.active)::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav-links > li > :global(a.active) {
    color: var(--gold-2);
  }
  .nav-dd-chevron {
    flex: none;
    transition: transform 0.35s var(--ease);
  }
  .nav-dd.is-open .nav-dd-chevron,
  .nav-dd.is-hovering .nav-dd-chevron {
    transform: rotate(180deg);
  }
  .nav-dd:focus-within .nav-dd-chevron {
    transform: rotate(180deg);
  }
  .nav-dd-panel-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Suppresses every transition and animation inside the drawer, for the frame
     or two it takes to force it closed without anything visibly moving. Used on
     pagehide (so the snapshot the back/forward cache freezes has no transition
     in flight) and on a bfcache pageshow (so a snapshot taken before this
     existed still resolves instantly). See the pageshow/pagehide block in
     main.js.
     !important, and a deliberate exception rather than an oversight. The drawer
     declares transitions on roughly a dozen selectors at specificities from
     (0,1,0) to (0,3,0) — .menu, .menu-bg, the rows, the triggers, the sub-links,
     the accordion itself, the chevrons, the CTA row, the social row — and
     out-specifying every one of them would be a list to keep in sync forever,
     which is bugs #2/#14/#15 waiting to happen. A blunt one-frame kill switch
     cannot drift. It is scoped to .menu and its descendants, so nothing outside
     the drawer is affected. */
  :global(html.nav-no-anim) .nav :global(*) {
    transition: none !important;
    animation: none !important;
  }
  @media (max-width: 820px) {
    .nav-cta :global(.button) {
      display: none;
    }
  }
  /* ---------- Chevron rotation jitter, attempt 2 (2026-10-01) ----------
     Attempt 1 fixed the glyph's geometry: the viewBox is "0 0 12 8"
     (ratio 1.5) but the SVGs rendered at 11x7 and 16x11, so the path was
     letterboxed by preserveAspectRatio AND the rotation centre landed on
     half pixels — (5.5, 3.5) and (8, 5.5). Both are now exact 1:1 matches
     centred on whole pixels (12x8 and 18x12). The vibration survived
     that, so the centre was not the whole story.
     What is left is rasterisation. A 180deg rotation on a path with a
     1.4px stroke is re-rastered by the main thread on every frame unless
     the element has its own compositing layer, and a thin stroke
     antialiases differently at every intermediate angle — which reads as
     the glyph shimmering rather than turning. Promoting it means the
     browser rasterises the chevron ONCE and composites the rotation,
     so the antialiasing is computed a single time.
     will-change on a permanently-present element does cost a standing
     layer (CLAUDE.md bug #27's caution), but that applies to elements
     that are never seen; these are two small, visible, interactive
     glyphs, so the trade is the right way round. transform-origin is
     stated explicitly rather than left to its 50% 50% default, so it
     cannot drift if the box size is ever changed again.
     STILL UNCONFIRMED — if it persists, see the CLAUDE.md entry, which
     records both attempts and the two remaining suspects. */
  .nav-dd-chevron {
    will-change: transform;
    backface-visibility: hidden;
    transform-origin: 50% 50%;
  }
  .nav-dd-hub-link :global(svg) {
    flex: none;
    transition: transform 0.35s var(--ease);
  }
  .nav-dd-hub-link:hover :global(svg) {
    transform: translateX(3px);
  }
  /* Stacked, all filling the same box — a real crossfade needs two
     images overlapping in opacity. Fading one <img> out before swapping
     its src shows the card's own background through the gap where
     neither photo is visible; this never opens that gap. */
  .nav-dd-panel-media :global(img) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.28s var(--ease);
  }
  /* --- The default pair fades back IN on a delay, but OUT instantly ---
     Reported: moving quickly between rows flashes the default photo
     between them. Correctly diagnosed as the gap — :has() only matches
     while a row is actually hovered, and the grid's 4px row gap and 24px
     column gap are real dead space where no row is, so the default pair
     starts fading back in and then straight back out again.
     Fixed by making that return asymmetric rather than by closing the
     gaps (which would have meant setting gap: 0 and letting the hover
     washes touch — a layout change to fix a timing problem). A 0.15s
     delay on the default's fade-IN is longer than any realistic transit
     across a 24px gap, so a row-to-row move never gives it time to
     start; the :has() rule below cancels the delay for the fade-OUT, so
     entering a row is still immediate. Dwelling in a gap for longer than
     0.15s does bring the default back, which is correct — at that point
     you genuinely aren't on a row.
     Specificity note, since this rule now carries `transition` and so
     can collide: (0,2,1) here beats the base .nav-dd-panel-media img at
     (0,1,1), which is what makes the delay stick. */
  .nav-dd-panel-media :global(img[data-state="default"]) {
    opacity: 1;
    transition: opacity 0.28s var(--ease) 0.15s;
  }
  /* Scoped through .nav-dd-panel-card to reach (0,3,1) and (0,3,0),
       which beat the [data-state="default"] rules above at (0,2,1) and
       (0,2,0). A bare ".nav-dd-panel-media img" would be (0,1,1) and
       would silently LOSE to them — so the crossfade, and now its delay,
       would have kept animating for anyone who asked it not to. Latent in
       this block from the moment the default pair got its own rule; worth
       re-checking any reduced-motion override that sits next to a
       state-attribute rule. */
  @media (prefers-reduced-motion: reduce) {
    .nav-dd-panel-card .nav-dd-panel-media :global(img[data-state]) {
      transition: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-dd-hub-link:hover :global(svg) {
      transform: none;
    }
  }
  /* The crossfade trigger. Each row carries data-target naming one
     image/caption pair's data-state; :has() asks whether a row with that
     target is currently hovered or focused and, if so, opts that pair in
     while opting the default pair out. :is() folds hover and focus into
     one selector rather than writing every rule twice — focus matters,
     it is what makes the photo follow a keyboard user through the list.
     Rooted at .nav-dd-panel-card, not .nav-dd, so a state name can never
     match across from the other panel despite the shared ancestor.
     Rows with NO data-target deliberately leave the default photo up:
     there is no photograph of a page that does not exist, and — flagged
     to the client — none of the vaulted chambers either. */
  .nav-dd-panel-card:has(.nav-dd-item[data-target]:is(:hover, :focus))
    .nav-dd-panel-media
    :global(img[data-state="default"]) {
    opacity: 0;
    /* The other half of the asymmetry above: no delay leaving, so landing
       on a row swaps the photo at once. Written as the full shorthand
       rather than a lone transition-delay — a bare delay here would have
       to win against a shorthand on the same element, which is bug #2's
       trap in miniature (the shorthand resets delay to 0, and whichever
       loads later takes the property wholesale). */
    transition: opacity 0.28s var(--ease) 0s;
  }
  .nav-dd-panel-card:has(.nav-dd-item[data-target="menus"]:is(:hover, :focus))
    .nav-dd-panel-media
    :global(img[data-state="menus"]) {
    opacity: 1;
  }
  .nav-dd-panel-card:has(.nav-dd-item[data-target="weddings"]:is(:hover, :focus))
    .nav-dd-panel-media
    :global(img[data-state="weddings"]) {
    opacity: 1;
  }
  .nav-dd-panel-card:has(.nav-dd-item[data-target="corporate"]:is(:hover, :focus))
    .nav-dd-panel-media
    :global(img[data-state="corporate"]) {
    opacity: 1;
  }
  .nav-dd-panel-card:has(.nav-dd-item[data-target="celebrations"]:is(:hover, :focus))
    .nav-dd-panel-media
    :global(img[data-state="celebrations"]) {
    opacity: 1;
  }
  .nav-dd-panel-card:has(.nav-dd-item[data-target="spaces"]:is(:hover, :focus))
    .nav-dd-panel-media
    :global(img[data-state="spaces"]) {
    opacity: 1;
  }
  /* ============================================================
     (i) THE ENQUIRE BUTTON — .nav-cta-enquire-button
     ============================================================
     .button-ghost next to .button-gradient read as the disabled sibling
     rather than the secondary action, and three things were doing that at
     once: it was GREY where the other was gold, its border sat at 0.42
     alpha so the outline barely existed, and it had no icon so it carried
     noticeably less visual mass.

     Hue was the main one. Two buttons in the same colour, one filled and
     one outlined, read as a deliberate primary/secondary pair; a gold
     pill beside a grey pill reads as "one action and one thing that isn't
     available". So this keeps the outline — the hierarchy is still
     correct, Book a table should lead — and moves it into the same family
     by tinting the border and the label gold, then fills solid gold on
     hover, which is a more confident resolution than .button-ghost's fade
     to limestone.

     .button-ghost is DROPPED from the element rather than overridden.
     Overriding it would have meant silently redefining all five of its
     custom properties, leaving a class on the markup that no longer
     describes anything true about the button — and styles.css's own
     comment reserves it for hero secondary CTAs. Written as
     ".button.nav-cta-enquire-button" at (0,2,0) so it beats .button's own
     (0,1,0) defaults outright rather than on source order (bug #2). */
  .button.nav-cta-enquire-button {
    --bg: transparent;
    --fg: var(--gold-2);
    --bd: rgba(var(--gold-rgb), 0.55);
    --bg-h: var(--gold);
    --fg-h: var(--ink);
    /* 2px, up from .button's 1px (2026-10-04), so the outline carries
       visual mass closer to Book a table's solid fill beside it. */
    border-width: 2px;
  }
  /* The envelope is a LABEL, not a "proceed" chevron, so it must not
     inherit .button:hover svg's 4px forward nudge — that motion only
     reads correctly on a trailing arrow. Exactly the precedent
     #availChangeBtn's calendar icon already set in styles.css, and the
     reason the icon here is an envelope rather than a second copy of
     Book a table's arrow: "Enquire" is the vaguer of the two labels, so
     the icon is doing real work saying what the action is, instead of
     repeating what its neighbour already says. */
  .nav-cta-enquire-button :global(svg) {
    transition: none;
  }
  @media (hover: hover) {
    .button.nav-cta-enquire-button:hover :global(svg) {
      transform: none;
    }
  }
  @media (hover: none) {
    .button.nav-cta-enquire-button:active :global(svg) {
      transform: none;
    }
  }
  /* -20px. The sub-line is the widest part of the lockup and the mark
       plus "BACCHUS" still identify the site unambiguously. */
  @media (min-width: 980px) and (max-width: 1179.98px) {
    .brand .sub {
      display: none;
    }
  }
  /* -20px and -8px. */
  @media (min-width: 980px) and (max-width: 1179.98px) {
    .nav .wrap {
      gap: 14px;
    }
  }
  /* -24px. Reuses the existing compact token's own relationship rather
       than inventing a size: 22px to 16px each side, still a pill. */
  @media (min-width: 980px) and (max-width: 1179.98px) {
    .nav-cta :global(.button) {
      padding-left: 16px;
      padding-right: 16px;
    }
  }
  /* -44px. Both CTAs drop their icon together in this band, so the pair
       always matches: either both carry one (above 1180px, and in the
       mobile drawer) or neither does. Until 2026-10-04 only Book a table's
       arrow went, on the argument that Enquire's envelope said more than
       the arrow did — but a matched pair reads as one deliberate group,
       and one icon on one pill read as an inconsistency. The labels carry
       the meaning on their own. */
  @media (min-width: 980px) and (max-width: 1179.98px) {
    .nav-cta :global(.button) :global(svg) {
      display: none;
    }
  }
  @media (max-width: 979.98px) {
    .nav-cta :global(.button) {
      display: none;
    }
  }
  .nav > .wrap {
    animation: nav-enter 0.6s var(--ease) 0.05s backwards;
  }
  /* Homepage: in step with the portcullis, whose bars start rising at 0.1s.
     Arriving at ~0.35s lands the bar just as the gate is visibly opening. */
  :global(body:has(.portcullis)) .nav > .wrap {
    animation-delay: 0.35s;
    animation-duration: 0.7s;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav > .wrap {
      animation: none;
    }
  }
  @keyframes nav-enter {
    from {
      opacity: 0;
      transform: translateY(-14px);
    }
  }
  @keyframes nav-backdrop-enter {
    from {
      opacity: 0;
    }
  }
</style>
