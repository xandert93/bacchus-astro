---
// The desktop bar: brand, the Restaurant / Events dropdowns, Gallery, and the
// two CTAs. Previously pasted into every page by hand; now written once.
import { NAV_MENUS } from "@data/navigation"
import NavDropdown from "@components/nav/NavDropdown.astro"
import Photo from "@components/ui/Photo.astro"
---

<header class="nav" id="nav">
  <div class="wrap">
    <a href="/" class="brand" aria-label="Bacchus home">
      <Photo
        src="brand/bacchus-logo"
        sizes="64px"
        maxWidth={128}
        alt="Bacchus mark — the head of Bacchus wreathed in vine leaves"
      />
      <span class="brand-text">
        <span class="name">Bacchus</span>
        <span class="sub">Mdina · Est. 1660</span>
      </span>
    </a>
    <nav>
      <ul class="nav-links" id="navlinks">
        {NAV_MENUS.map((menu) => (
          <NavDropdown menu={menu} />
        ))}

        <li>
          <a href="/gallery">Gallery</a>
        </li>
      </ul>
    </nav>
    <div class="nav-cta">
      {/* Decision 1: Book a table takes the gradient pill, Enquire the
           outline one. Both are gold — see .nav-cta-enquire-button above
           for why the secondary is NOT the stock .button-ghost: grey
           beside gold read as unavailable rather than secondary, where
           same-hue outline-beside-filled reads as a deliberate pair. The
           hierarchy itself is unchanged; only the secondary's colour and
           mass are. */}
      <a href="#" class="button button-gradient button-small" data-unbuilt>
        <span>Book a table</span>
        <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
          <path
            d="M1 5h11M8.5 1.5L12 5l-3.5 3.5"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
      <a href="#" class="button button-small nav-cta-enquire-button" data-unbuilt>
        <span>Enquire</span>
        <svg
          width="14"
          height="10"
          viewBox="1.5 4.5 21 15"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M3 7.5A1.5 1.5 0 0 1 4.5 6h15A1.5 1.5 0 0 1 21 7.5v9A1.5 1.5 0 0 1 19.5 18h-15A1.5 1.5 0 0 1 3 16.5z"
            stroke="currentColor"
            stroke-width="1.95"
          />
          <path
            d="m3.6 7 8.4 6 8.4-6"
            stroke="currentColor"
            stroke-width="1.95"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
      {/* Inside .nav-cta, matching every other page's header — the
           @media rule that swaps the pills for the burger is scoped
           ".nav-cta .button", so the burger has to be its sibling to be
           the thing left standing at mobile widths. */}
      <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false">
        <i></i>
        <i></i>
        <i></i>
      </button>
    </div>
  </div>
  {/* Dims the page below the nav while any panel is open. Toggled
       purely by :has() off the same states that open the panel, so
       there is no second piece of JS state to keep in sync. */}
  <div class="nav-dd-scrim" aria-hidden="true"></div>
  <div class="progress" id="progress"></div>
</header>

<style>
  /* Scoped to this component (moved from global.css by
     scripts/scope-styles.mjs). See FaqSection.astro for how scoping works. */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 800;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    border-bottom: 1px solid transparent;
    transition: border-color 0.6s var(--ease);
  }
  .nav::before,
  .nav::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    transition: opacity 0.6s var(--ease);
  }
  .nav::before {
    background: linear-gradient(180deg, rgba(10, 9, 6, 0.72), transparent);
    opacity: 1;
  }
  .nav::after {
    background: rgba(var(--muted-ink-rgb), 0.86);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    opacity: 0;
  }
  .nav.stuck {
    border-bottom-color: rgba(var(--gold-rgb), 0.22);
  }
  .nav.stuck::before {
    opacity: 0;
  }
  .nav.stuck::after {
    opacity: 1;
  }
  /* While the overlay is open the bar's fade is QUICK. Its own 0.6s is tuned
     for page scroll, where the bar is pinned above content that is already
     moving past it and a gentle fade reads well. Inside the overlay the first
     row starts only 22px below the bar, so at 0.6s a fast flick put "Restaurant"
     behind the lockup before the dark had arrived — reported 2026-10-02.
     transition-duration only, not a fresh shorthand, so the property list stays
     the single source of truth for what animates (bug #2). */
  :global(body.menu-open) .nav::before,
  :global(body.menu-open) .nav::after {
    transition-duration: 0.18s;
  }
  /* No frost while the overlay is open. .stuck flips more often in here than it
     does on a page: collapsing a group shrinks .menu-scroll's scrollHeight, the
     browser clamps scrollTop, that fires the overlay's own scroll handler, and
     the bar un-sticks — so ::after crossfades from opacity 0, and a
     backdrop-filter layer initialising from nothing is a known source of a
     one-frame flash.
     Nothing is lost by dropping it: the only thing behind the bar while the
     overlay is open is the overlay itself, which is --ink with a photograph at
     0.16 over it, so there is essentially nothing for a 14px blur to pick up.
     The fill and the border stay, so the dark state still reads as dark — same
     treatment, and the same reasoning, as .package-sticky-switch under
     body.is-scrolling. */
  :global(body.menu-open) .nav::after {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    /* Fully opaque while the drawer is open (2026-10-05). The page bar's fill
       is 0.86 alpha and relies on the blur above to hide what passes behind
       it; with the blur off, the drawer's own links stayed legible through
       the bar as they scrolled under it. Same colour, no transparency. */
    background: rgb(var(--muted-ink-rgb));
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
  }
  .brand .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .brand .name {
    font-family: "Fraunces", serif;
    font-size: 19px;
    letter-spacing: 0.3em;
    color: var(--limestone);
    text-transform: uppercase;
    padding-left: 2px;
  }
  .nav-links {
    display: flex;
    align-items: center;
    /* 2px, not 6px (changed 2026-10-02). Each link already carries 16px of
       padding a side, so adjacent labels have 32px between them before the gap
       counts at all — 6px was adding a seventh of that again for no structural
       reason, and the links now sit against the CTAs where a tight cluster reads
       as one group. The compact band in the nav section at the foot of this file
       takes it to 0 between 980px and 1180px. The hover underline is unaffected:
       ::after is inset 16px from each link's own edges. */
    gap: 2px;
    list-style: none;
  }
  /* Pairs with .nav .wrap's flex-start above — this is what pushes the links and
     the CTAs to the right edge together. */
  .nav .wrap nav {
    margin-left: auto;
  }
  .nav-links > :global(li) > :global(a) {
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* 0.82, up from 0.7 (2026-10-02). 0.7 measures 8.12:1 against the dark bar,
       which is objectively fine — but uppercase Inter at 11.5px with 0.16em
       tracking covers very little of its own area, so it reads considerably
       lighter than the ratio implies. This is a sitewide change: it reaches the
       nine pages still on the flat nav as well. */
    color: rgba(var(--limestone-rgb), 0.82);
    transition: color 0.35s;
  }
  /* The link's horizontal padding lives in two custom properties, and the
     underline below reads the same two. Before 2026-10-04 they were separate
     literals set by separate rules, and they drifted: the compact band set the
     underline's left to 10px while the split trigger's own (0,2,2) padding rule
     kept the text at 16px, so between 980px and 1180px the Restaurant/Events
     underline started 6px before the first letter. Variants now change the
     VARIABLE only, never padding or left/right directly, so the two cannot
     disagree again however many variants or bands get added. */
  .nav-links > :global(li) > :global(a) {
    --nav-link-padding-start: 16px;
    --nav-link-padding-end: 16px;
    position: relative;
    display: block;
    padding: 10px var(--nav-link-padding-end) 10px var(--nav-link-padding-start);
  }
  /* right is 16px PLUS the trailing letter-space, not a flat 16px. CSS applies
     letter-spacing after every character including the last, so this element's
     inline box ends 0.16em (1.84px at 11.5px) beyond the final glyph, and an
     underline inset to the padding edge runs to the box rather than to the
     letter. Reported 2026-10-02 as the bar "extending a bit too far" past the
     last letter. left needs no equivalent, since nothing is added before the
     first character. Any future change to .nav-links' letter-spacing has to
     come with the one calc() below. */
  .nav-links > :global(li) > :global(a)::after {
    content: "";
    position: absolute;
    left: var(--nav-link-padding-start);
    right: calc(var(--nav-link-padding-end) + 0.16em);
    bottom: 4px;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease);
  }
  .nav-links > :global(li:hover) > :global(a) {
    color: #fff;
  }
  .nav-links > :global(li:hover) > :global(a)::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  /* Scrim: dims the page below the nav while the dropdown is open, same trick
     as the BNY reference — puts the panel's own content in relief instead of
     competing with whatever's in the hero behind it. Sits as a direct child of
     .nav (not inside .wrap), so it relies on .wrap's own explicit z-index: 2
     to paint above it without needing a z-index of its own — giving the scrim
     one risks it painting above the dropdown panel too, since both would then
     have explicit stacking levels and DOM order (scrim comes last) would
     decide, the wrong way. Toggled with :has() off the same .is-open,
     .is-hovering and :focus-within states that already open the panel
     itself, so there's no separate JS state to keep in sync. */
  .nav-dd-scrim {
    position: fixed;
    top: var(--nav-h);
    left: 0;
    right: 0;
    bottom: 0;
    /* 0.6 and blur(10px), up from 0.5 and blur(3px) (2026-10-02). The panel was
       reading differently depending on which section happened to be behind it —
       fine over a light section, muddy over a dark one. The variable that
       actually controls that is not which section it is, it is how much of the
       ground comes through at all, which is this layer's whole job and it was
       set too gently to do it.
       The blur is doing most of the work here, not the alpha: at 10px nothing
       behind the panel resolves into legible text or a hard edge, so every
       section presents the same TEXTURE regardless of its content, while the
       panel keeps its relief against a ground that is still clearly there. More
       alpha alone would have flattened that relief instead. The alternative
       considered and rejected was switching the panel's own colour per section,
       which needs every section tagged, fails silently when one is missed, and
       cannot be followed by the bar — which is always dark while a panel is
       open. */
    background: rgba(var(--muted-ink-rgb), 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.3s var(--ease),
      visibility 0s linear 0.3s;
  }
  /* The scrim samples into each panel's frosted backdrop like anything else
     behind it, which is intended. :global() inside :has() because the
     dropdowns are NavDropdown's elements, not this file's. */
  .nav:has(:global(.nav-dd.is-open)) .nav-dd-scrim,
  .nav:has(:global(.nav-dd.is-hovering)) .nav-dd-scrim,
  .nav:has(:global(.nav-dd:focus-within)) .nav-dd-scrim {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.3s var(--ease);
  }
  /* While a panel is open the BAR takes its scrolled appearance too, whatever
     the scroll position. Without this the scrim dims everything from 74px down
     and the bar keeps its near-transparent top-of-page gradient, leaving a hard
     horizontal seam where the two meet and the hero still bright behind the
     links while the panel hangs off a dimmed page.
     Reuses .nav.stuck's own two declarations rather than inventing a treatment:
     ::before's gradient out, ::after's frost in. So the bar, the panel and the
     scrim read as one surface, and when the page IS scrolled this is already
     the state, so nothing moves.
     (0,3,0) via :has()'s own argument specificity, which beats both .nav::after
     (0,1,0) and .nav.stuck::after (0,2,0) outright - it has to win over stuck
     as well as over the base, since at the top of the page stuck is absent and
     partway down it is present. The 0.6s transition on ::before/::after is
     inherited, so the bar darkens rather than snapping. */
  .nav:has(:global(.nav-dd.is-open))::before,
  .nav:has(:global(.nav-dd.is-hovering))::before,
  .nav:has(:global(.nav-dd:focus-within))::before {
    opacity: 0;
  }
  .nav:has(:global(.nav-dd.is-open))::after,
  .nav:has(:global(.nav-dd.is-hovering))::after,
  .nav:has(:global(.nav-dd:focus-within))::after {
    opacity: 1;
  }
  .nav-cta {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .burger {
    display: none;
    width: 46px;
    height: 46px;
    border: none;
    border-radius: 50%;
    background: transparent;
    position: relative;
    cursor: pointer;
    flex: none;
    transition:
      background 0.3s var(--ease),
      transform 0.2s var(--ease);
  }
  .burger::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(var(--limestone-rgb), 0.1);
    transform: scale(0.7);
    opacity: 0;
    transition:
      transform 0.3s var(--ease),
      opacity 0.3s var(--ease);
  }
  @media (hover: hover) {
    .burger:hover::before {
      transform: scale(1);
      opacity: 1;
    }
  }
  .burger:active {
    transform: scale(0.94);
  }
  @media (hover: none) {
    .burger:active::before {
      transform: scale(1);
      opacity: 1;
    }
  }
  .burger i {
    position: absolute;
    left: 14px;
    right: 14px;
    height: 1.5px;
    background: var(--limestone);
    transition:
      transform 0.45s var(--ease),
      opacity 0.3s;
  }
  .burger i:nth-child(1) {
    top: 17px;
  }
  .burger i:nth-child(2) {
    top: 22.5px;
  }
  .burger i:nth-child(3) {
    top: 28px;
  }
  :global(body.menu-open) .burger i:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  :global(body.menu-open) .burger i:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.4);
  }
  :global(body.menu-open) .burger i:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }
  .progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: linear-gradient(90deg, var(--bronze), var(--gold), var(--gold-2));
  }
  :global(html.nav-no-anim) .nav {
    transition: none !important;
    animation: none !important;
  }
  @media (max-width: 820px) {
    .nav-links {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .burger {
      display: block;
    }
  }
  @media (max-width: 620.98px) {
    .brand .name {
      font-size: 16px;
      letter-spacing: 0.24em;
    }
  }
  /* ============================================================
     (j) COMPACT NAV BAND — 980px to 1179.98px
     ============================================================
     REAL BUG, reported from the demo 2026-10-01: the Enquire button runs
     off screen at 1015px, and the bar already looks overfull at 1092px.
     Confirmed by adding the content up from the CSS rather than
     eyeballing it, which is where an earlier estimate of ~890px went
     wrong — it forgot that each dropdown label now has a 29px chevron
     button beside it:

       brand          34px mark + 13px gap + ~154px lockup   ~201px
                      (the "MDINA · EST. 1660" sub-line is WIDER than
                      "BACCHUS" itself — 0.42em tracking over 17
                      characters — so it, not the name, sets this width)
       nav links      Restaurant 130 + chevron 29, Events 91 + 29,
                      Gallery 101, About 81, three 6px gaps      ~479px
       CTAs           Book a table 174, Enquire 129, 18px gap    ~321px
       wrap gaps      2 x 24px                                     48px
                                                               --------
                                                               ~1049px

     Against that, .wrap offers (viewport - 88px) of room, capped at
     1092px once the viewport passes 1180. So the bar needs ~1137px before
     it sits comfortably, and it has been overflowing below that — not
     only near the 980px cutover.

     A MEDIA BAND, NOT clamp(), deliberately. The house preference is
     clamp() for anything that should scale, but across a 200px-wide range
     a vw-based clamp barely moves: 1.36vw on the link padding recovers
     about 21px over the whole band, where this needs 120 or more. Getting
     there with clamp() means the calc-interpolation form on six separate
     properties, which is both less legible and harder to reason about
     than one band. This is also bug #20's situation exactly — fixed-size
     controls inside a fluid bar, where "the breakpoint floor is set by
     the control, not by the layout" — and the fix there was a media band
     swapping to existing smaller token values, which is what this does.

     Bounded on BOTH sides on purpose: above 1180px .wrap stops growing
     and there is ~43px of slack, so the designed spacing is untouched
     there; below 980px the burger takes over. The .98 pairing follows bug
     #22 so the handover to 1180px leaves no fractional gap.

     Nothing here changes a font size, the 74px bar height, or any
     colour — every line is spacing or a decorative glyph, so the bar
     compresses rather than restyling. Running total of what it recovers
     is noted per block. */
  /* -48px. 16px to 10px each side; the links keep 20px of total
       horizontal padding, which is still comfortably above their 11.5px
       type. */
  @media (min-width: 980px) and (max-width: 1179.98px) {
    .nav-links > :global(li) > :global(a) {
      --nav-link-padding-start: 10px;
      --nav-link-padding-end: 10px;
    }
  }
  /* -18px. The links' own padding already separates them; the gap was
       additional breathing room, not structure. */
  @media (min-width: 980px) and (max-width: 1179.98px) {
    .nav-links {
      gap: 0;
    }
  }
  /* -12px. Keeps the 4px seam between label and chevron so the pair
       still reads as one target. */
  /* The underline follows these automatically (see the custom properties
       on .nav-links > li > a). Same (0,2,2) as the base split rule, so this
       wins on source order — it sits ~9,000 lines later inside the band. */
  @media (min-width: 980px) and (max-width: 1179.98px) {
    .nav-cta {
      gap: 10px;
    }
  }
  /* ---------- The PANEL is squashed in this band too ----------
       Reported with a screenshot: descriptions wrapping to four and five
       lines, and on "Preferred suppliers" the PROPOSED badge pushed down
       to a third line before the description even started.
       The cause is the photo column, not the grid. .nav-dd-panel-media is
       a fixed "flex: 0 0 340px" while the panel itself is
       min(1376px, 100vw - 32px) — so the photo is a constant while
       everything else shrinks, and it takes a steadily larger share. At a
       1024px viewport the panel is 992px, the card's padding takes 56 and
       the photo and its gap take 372, leaving 564px for three columns:
       about 172px each, and after the item's own padding, icon and gutter
       roughly 118px of actual text. At 14px Newsreader that is around
       seventeen characters a line, which is what produced the screenshot.
       styles.css already hides this column below 981px for exactly this
       reason ("a fixed 340px image column would crowd the three-column
       item grid") — that reasoning simply did not stop being true at
       981px, because the PANEL is wider than .wrap and keeps growing
       after the breakpoint it was judged at.
       Shrinking the photo rather than hiding it, on purpose: hiding it
       would widen the columns more, but the per-row crossfade is the best
       thing about this panel and losing it on every laptop to win a line
       of text is the wrong trade. 240px is still a real photograph. */
  /* The remaining width comes from the gutters rather than the type:
       column gap 24 → 16, item padding 12 → 8 a side, icon gutter 12 →
       10. Roughly 50px back across the three columns, on top of the 100px
       the photo gives up. */
  /* ---------- (c) Burger cutover at 980px, not 820px ----------
     Measured, not guessed: brand lockup ~200px + four nav items ~400px
     + two compact pills ~250px + gaps lands around 890px of content,
     which overflows .wrap's available width anywhere below roughly
     940px. The real site's 820px cutover is sized for four plain text
     links and ONE pill. 979.98px is the site's own established tablet
     cutover (the copy+image reorder, .nav-dd-panel-media's own hide)
     rather than a number invented here, and the .98 follows CLAUDE.md
     bug #22's house rule so the handover to 980px leaves no fractional
     gap. */
  @media (max-width: 979.98px) {
    .nav-links {
      display: none;
    }
  }
  @media (max-width: 979.98px) {
    .burger {
      display: block;
    }
  }
  /* ============================================================
     NAV ENTRANCE (2026-10-05)
     ============================================================
     The bar used to be the one thing on the page with no entrance: fully
     formed from the first frame, and on the homepage sitting on top of the
     still-closed portcullis, ahead of the gate it's meant to arrive behind.
     It now fades down into place: with the bars lifting on the homepage,
     and alongside the hero copy everywhere else.

     Pure CSS on purpose. A script-triggered entrance would leave the nav
     invisible until the script arrived, which on a slow connection means a
     site with no navigation for seconds; a CSS animation runs from the
     first paint regardless.

     `backwards` fill, never `both`/`forwards`: the from-state applies during
     the delay, and once the animation ends the element is handed back to its
     normal styles entirely. A held end-state would keep overriding things
     the bar does later — `.nav.stuck::before` fading its gradient out, for
     one — since animations beat ordinary declarations. It also means no
     transform lingers on the bar's contents, which matters: a transform on
     an ancestor of the dropdown panels makes it their containing block and
     kills their backdrop blur (see the dark-card notes further up). During
     the brief entrance itself, no panel can be open yet.

     The contents (.wrap) and the top gradient (::before) are animated, not
     .nav itself, for the same transform reason. */
  .nav::before {
    animation: nav-backdrop-enter 0.6s var(--ease) 0.05s backwards;
  }
  :global(body:has(.portcullis)) .nav::before {
    animation-delay: 0.35s;
    animation-duration: 0.7s;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav::before {
      animation: none;
    }
  }
  /* NO unconditional darkening while the overlay is open — that was tried on
     2026-10-02 and replaced the same day. The bar should behave inside the
     overlay exactly as it does on the page: transparent at the top, darkening
     once you scroll. It is .stuck that does that, and main.js now drives .stuck
     from the OVERLAY's own scrollTop while it is open rather than from
     window.scrollY, which is frozen then anyway (body gets overflow: hidden).
     See the whole-site nav block in main.js. */
  .nav .wrap {
    display: flex;
    align-items: center;
    /* flex-start + "margin-left: auto" on the <nav> below, NOT space-between:
       the links group against the CTAs at the right edge rather than sitting
       centred. Changed 2026-10-02 with the whole-site nav merge — with two CTAs
       the right side is the heaviest thing in the bar, and a compact link
       cluster beside them reads as one group where a centred one blurs into
       the gap. This is the one part of that merge that alters the existing nav's
       layout rather than only adding to it, so it reaches the nine pages still
