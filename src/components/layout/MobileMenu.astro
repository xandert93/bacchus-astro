---
// The <=980px fullscreen drawer opened by the burger in SiteHeader.
import { getImage } from "astro:assets"
import SocialLinks from "@components/ui/SocialLinks.astro"
import { image } from "@lib/images"

interface Props {
  // The photo behind the drawer — a key from src/lib/images.ts. Each page
  // in the prototype picked its own.
  backgroundImage?: string
}
const { backgroundImage = "venue/ballroom-night" } = Astro.props
// A CSS background can't take a srcset, so one size: wide enough for the
// drawer at tablet width on a high-density screen (the drawer only exists
// below 980px), and it sits under a dark wash at 0.16 opacity anyway.
const background = await getImage({
  src: image(backgroundImage),
  width: 1280,
  format: "webp",
  quality: 75,
})
---

<div class="menu" id="mobmenu">
  <div class="menu-bg" style={`background-image: url('${background.src}')`}></div>
  {/* The SCROLL happens here, not on .menu. .menu-bg has to sit in a box
       that never scrolls and never changes its containing block; see the
       note on .menu-scroll in styles.css. */}
  <div class="menu-scroll">
    <div class="menu-inner">
      <div class="mobile-nav-group">
        <button class="mobile-nav-group-trigger" type="button" aria-expanded="false">
          <span class="mobile-nav-number">1</span>Restaurant
          <svg
            class="nav-dd-chevron"
            width="18"
            height="12"
            viewBox="0 0 12 8"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M1.5 2l4.5 4 4.5-4"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
        <div class="mobile-nav-sub">
          {/* The grid row collapses to 0fr; this wrapper is what clips, so
             the links inside are never the thing being resized. */}
          <div class="mobile-nav-sub-items">
            <a class="mobile-nav-sub-link" href="#" data-unbuilt>
              The restaurant<span class="mobile-nav-proposed-badge">Proposed</span>
            </a>
            <a class="mobile-nav-sub-link" href="#" data-unbuilt>
              Menus<span class="mobile-nav-proposed-badge">Proposed</span>
            </a>
            <a class="mobile-nav-sub-link" href="#" data-unbuilt>
              The Chambers<span class="mobile-nav-proposed-badge">Proposed</span>
            </a>
            <a class="mobile-nav-sub-link" href="#" data-unbuilt>
              Gift vouchers<span class="mobile-nav-proposed-badge">Proposed</span>
            </a>
          </div>
        </div>
      </div>
      <div class="mobile-nav-group">
        <button class="mobile-nav-group-trigger" type="button" aria-expanded="false">
          <span class="mobile-nav-number">2</span>Events
          <svg
            class="nav-dd-chevron"
            width="18"
            height="12"
            viewBox="0 0 12 8"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M1.5 2l4.5 4 4.5-4"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
        <div class="mobile-nav-sub">
          <div class="mobile-nav-sub-items">
            <a class="mobile-nav-sub-link" href="#" data-unbuilt>
              All events<span class="mobile-nav-proposed-badge">Proposed</span>
            </a>
            <a class="mobile-nav-sub-link" href="/weddings">
              Weddings
            </a>
            <a class="mobile-nav-sub-link" href="/corporate">
              Corporate
            </a>
            <a class="mobile-nav-sub-link" href="/celebrations">
              Celebrations
            </a>
            <a class="mobile-nav-sub-link" href="#" data-unbuilt>
              The spaces<span class="mobile-nav-proposed-badge">Proposed</span>
            </a>
            <a class="mobile-nav-sub-link" href="#" data-unbuilt>
              Preferred suppliers<span class="mobile-nav-proposed-badge">Proposed</span>
            </a>
            <a class="mobile-nav-sub-link" href="#" data-unbuilt>
              Guides<span class="mobile-nav-proposed-badge">Proposed</span>
            </a>
          </div>
        </div>
      </div>
      <a href="/gallery" class="mobile-nav-link">
        <span>3</span>Gallery
      </a>
      {/* Mobile only. About is still out of the desktop bar, where it was
         the one unbuilt top-level item with no panel behind it, so a click
         produced nothing with no explanation. Here it carries the same
         Proposed badge its sibling rows use, which is the explanation the
         desktop bar had no room for. */}
      <a href="#" class="mobile-nav-link" data-unbuilt>
        <span>4</span>About<span class="mobile-nav-proposed-badge">Proposed</span>
      </a>
      <div class="mobile-nav-cta-row">
        <a href="#" class="button button-gradient button-small" data-unbuilt>
          <span>Book a table</span>
          <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
            <path
              d="M1 5h11M8.5 1.5L12 5l-3.5 3.5"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
        <a href="#" class="button button-small nav-cta-enquire-button" data-unbuilt>
          <span>Enquire</span>
          <svg
            width="14"
            height="10"
            viewBox="1.5 4.5 21 15"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 7.5A1.5 1.5 0 0 1 4.5 6h15A1.5 1.5 0 0 1 21 7.5v9A1.5 1.5 0 0 1 19.5 18h-15A1.5 1.5 0 0 1 3 16.5z"
              stroke="currentColor"
              stroke-width="1.95"
            />
            <path
              d="m3.6 7 8.4 6 8.4-6"
              stroke="currentColor"
              stroke-width="1.95"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </div>
    <SocialLinks class="menu-social" />
  </div>
</div>

<style>
  /* Scoped to this component (moved from global.css by
     scripts/scope-styles.mjs). See FaqSection.astro for how scoping works. */
  :global(html.nav-no-anim) .menu {
    transition: none !important;
    animation: none !important;
  }
  .menu {
    /* ONE value for the drawer's top-level row type, because it is set on two
       rules thousands of lines apart — .menu .mobile-nav-link here, and
       .menu .mobile-nav-group-trigger in the whole-site nav section at the foot
       of this file. Restaurant/Events are buttons and Gallery/About are links,
       so they can only read as one list while those two agree, and as two equal
       literals they had every opportunity to drift (bug #24's lesson, same fix).
       Declared on .menu rather than :root since it is this component's concern;
       custom properties inherit, so the far rule picks it up.
       Reduced twice on 2026-10-02, both on the user's call: from the original
       clamp(26px, 7.5vw, 42px) to clamp(25px, 6.8vw, 36px), then to the value
       below. Cumulatively ~16% off at phone widths and ~21% off the ceiling.
       The ceiling took more at each step because it was the most oversized
       part: 7.5vw pinned at 42px from 560px up, so the whole 560-980px tablet
       range sat at the maximum while carrying the most rows.
       The floor now engages below 381px, so unlike the first pass it IS the
       size a 360-375px phone gets rather than mere insurance — which is the
       constraint to know about before reducing again. Going lower means
       lowering the floor, and the floor is what protects the tap target.
       Tap targets were checked rather than assumed, since row height here is
       almost entirely font-derived (only 5px of padding either side): at
       line-height 1.65 the shortest row is ~52px against the 44px guideline, so
       no padding compensation was needed. If a further reduction is wanted, the
       ceiling is the knob to turn first. */
    --mobile-nav-link-size: clamp(24px, 6.3vw, 33px);
    position: fixed;
    inset: 0;
    z-index: 790;
    background: var(--ink);
    display: flex;
    flex-direction: column;
    justify-content: center;
    justify-content: safe center;
    /* .menu does NOT scroll — .menu-scroll inside it does. The padding and
       the safe-centring moved there with it.
       Why it matters: .menu carries a transform for its open/close animation,
       and a transform makes an element the containing block for fixed
       descendants. While .menu was also the scroll container, .menu-bg had no
       good option — absolute meant it scrolled away with the content (the black
       band), and fixed meant its containing block FLIPPED between .menu and the
       viewport at the two ends of the transform transition, which repaints the
       layer and produced a black flash on every open and close (reported
       2026-10-02).
       Moving the scroll one level in removes the conflict: .menu never scrolls,
       so .menu-bg can be a plain absolute child of it and simply sits still. */
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: scale(1.02);
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease),
      visibility 0s linear 0.5s;
    pointer-events: none;
  }
  :global(body.menu-open) .menu {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    pointer-events: auto;
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease),
      visibility 0s linear 0s;
  }
  /* FIXED, not absolute (changed 2026-10-02). An absolutely positioned child
     of a scroll container is placed in that container's scrollable coordinate
     space, so once .menu had more content than fits — which it does as soon as
     a group is expanded on a short phone — the photograph scrolled up with the
     content and left .menu's own --ink background as a black band at the
     bottom. Reported as the image shifting with a black bar under it.
     This only works because body.menu-open .menu sets "transform: none" rather
     than "scale(1)": ANY transform on an ancestor makes it the containing block
     for fixed descendants, and a fixed element in that position behaves like an
     absolute one — i.e. it would scroll again. The scale is still there in the
     closed state, so the open/close animation is unchanged; it is only released
     once the overlay has finished opening, which is also the only time it is
     possible to scroll. */
  /* Takes .menu's old padding, centring and scrolling. min-height: 0 is the
     part that is easy to miss — a flex child will not shrink below its content
     and so will not scroll without it. */
  .menu-scroll {
    position: relative;
    z-index: 2;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    justify-content: safe center;
    padding: 96px clamp(24px, 7vw, 60px) 32px;
    overflow-y: auto;
    /* The one real DISCONTINUITY at the moment an expanding group takes the
       content past the container height: a classic scrollbar appears and takes
       layout width, so the whole column reflows and the centred rows re-wrap in
       a single frame. Reserving the space means the crossover changes nothing.
       Desktop/laptop only — a phone's overlay scrollbar floats and has never
       taken width — so this is for the <=980px laptop view rather than the
       device. The centring itself does NOT jump, which was the other suspect
       and was wrong: free space is H - C, "safe center" offsets by half of it
       and falls back to start once it goes negative, so the offset approaches
       zero continuously and simply stays there. Same for .menu-inner's auto
       margins. */
    scrollbar-gutter: stable;
  }
  .menu-bg {
    position: absolute;
    inset: 0;
    /* Absolute against .menu, which is fixed, viewport-sized and — crucially —
       no longer scrolls. So this fills the overlay and stays put, with no
       containing-block switching and nothing to lag behind a resizing URL bar.
       The earlier fixed + 100lvh version solved the URL-bar band but caused the
       open/close flash; see the note on .menu's overflow. */
    opacity: 0.16;
    background-size: cover;
    background-position: center;
    filter: grayscale(0.3);
  }
  .menu-inner {
    position: relative;
    z-index: 2;
    margin: auto 0;
  }
  .menu .mobile-nav-link {
    display: block;
    font-family: "Fraunces", serif;
    font-size: var(--mobile-nav-link-size);
    color: var(--limestone);
    padding: 5px 0;
    letter-spacing: -0.02em;
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.6s var(--ease) var(--m-delay, 0s),
      transform 0.7s var(--ease) var(--m-delay, 0s),
      color 0.3s;
  }
  /* aria-current stays ungated — it marks which page you are on, and has
     nothing to do with a pointer. Only :hover moves behind the gate. */
  .menu .mobile-nav-link[aria-current="page"] {
    color: var(--gold-2);
  }
  @media (hover: hover) {
    .menu .mobile-nav-link:hover {
      color: var(--gold-2);
    }
  }
  @media (hover: none) {
    .menu .mobile-nav-link:active {
      color: var(--gold-2);
    }
  }
  /* GATED (2026-10-02). This rule and the sub-link one below used to carry an
     explicit bug #19 exemption, on the grounds that these are real page links
     and navigating away on tap makes a lingering hover moot. That premise is
     false here, twice over:
       • ELEVEN of the drawer's seventeen links are href="#" — every unbuilt row
         behind a Proposed badge. Nothing navigates, and main.js deliberately
         does NOT close the drawer for those (closing it while going nowhere
         would be worse), so the row simply stays latched gold until you tap
         something else. Touch has no "pointer left" event to clear it.
       • Even the four real page links are visible after the tap: closeMenu()
         fades the overlay over 0.5s while the browser waits on navigation, and
         "color 0.3s" animates the row to gold through that fade. You watch it
         turn gold on the way out.
     Gated on POINTER CAPABILITY, not viewport, which is the important half: the
     drawer only appears below 980px, but a laptop window dragged narrow still
     has a mouse, and hover is right there. A viewport gate would break hover
     during exactly the kind of desktop-at-mobile-width testing this is built
     with. (hover: hover) draws that line by itself. */
  :global(body.menu-open) .menu .mobile-nav-link {
    opacity: 1;
    transform: translateY(0);
  }
  /* grid-template-rows: 0fr -> 1fr, NOT max-height (changed 2026-10-02).
     max-height needs a magic number large enough for the tallest group, and
     every pixel of the difference between that number and the real content is
     dead time in the animation. Measured here: the cap was 520px against ~164px
     of Restaurant content and ~287px of Events. Opening therefore finished
     moving a third of the way through, and CLOSING was worse - max-height has
     to fall from 520 all the way to 164 before the Restaurant panel's bottom
     edge starts moving at all, so roughly the first 0.3s of the close produced
     no visible change. That reads as a dead tap, not a slow one.
     0fr -> 1fr animates to whatever the content actually measures, so there is
     no number to keep in sync with the row count. The cost is one wrapper
     element per group, because the clipping has to happen INSIDE the grid row
     rather than on the grid itself - hence .mobile-nav-sub-items below. */
  .mobile-nav-sub {
    display: grid;
    grid-template-rows: 0fr;
    padding-left: 34px;
    transition: grid-template-rows 0.45s var(--ease);
  }
  .mobile-nav-sub-items {
    overflow: hidden;
  }
  .mobile-nav-group.is-open .mobile-nav-sub {
    grid-template-rows: 1fr;
  }
  /* TEMPORARY, for a look at the overlay with no accordion at all. Driven by
     DRAWER_GROUPS_PINNED_OPEN in main.js - set that to false to get the
     accordion back and these rules stop matching. The label stays (it is still
     the section heading) but the chevron goes, since nothing collapses, and
     the cursor stops claiming the row is clickable. */
  .mobile-nav-group.is-pinned-open .mobile-nav-group-trigger {
    cursor: default;
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-nav-sub {
      transition: none;
    }
  }
  /* The accordion is motion like any other. It was never gated, which predates
     the whole-site nav - the max-height version had the same gap. */
  .mobile-nav-sub-link {
    display: block;
    font-family: "Newsreader", Georgia, serif;
    font-size: clamp(18px, 4.5vw, 22px);
    color: rgba(var(--limestone-rgb), 0.72);
    padding: 8px 0;
  }
  /* Sub-links were the one thing in the overlay with no entrance at all, so
     whichever group opens by default had its rows sitting there fully painted
     while everything around them animated in — which read as them having been
     left out rather than as a deliberate difference.
     They take the same treatment as the rows above them, with a shorter lift
     (18px against 28px) because they are smaller items and the same distance
     reads as further on them. main.js folds the OPEN group's sub-links into the
     same --m-delay sequence as the top-level rows, so the whole thing counts
     down the list once rather than running two staggers side by side.
     color stays out of the delay, per bug #12 — a delayed hover colour is what
     made the top-level links feel laggy once. */
  .menu .mobile-nav-sub-link {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.5s var(--ease) var(--m-delay, 0s),
      transform 0.6s var(--ease) var(--m-delay, 0s),
      color 0.3s;
  }
  :global(body.menu-open) .menu .mobile-nav-sub-link {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .menu .mobile-nav-sub-link {
      transform: none;
      transition:
        opacity 0.5s var(--ease) var(--m-delay, 0s),
        color 0.3s;
    }
  }
  .mobile-nav-sub-link[aria-current="page"] {
    color: var(--gold-2);
  }
  @media (hover: hover) {
    .mobile-nav-sub-link:hover {
      color: var(--gold-2);
    }
  }
  @media (hover: none) {
    .mobile-nav-sub-link:active {
      color: var(--gold-2);
    }
  }
  /* --bronze-on-dark, not --bronze: the overlay's background is --ink, where
     plain --bronze measures 3.85:1 — the same reason the panel icons needed the
     token. */
  .mobile-nav-proposed-badge {
    display: inline-block;
    margin-left: 10px;
    padding: 2px 8px;
    border: 1px solid rgba(var(--bronze-on-dark-rgb), 0.45);
    border-radius: 999px;
    font-family: "Inter", sans-serif;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bronze-on-dark);
    vertical-align: middle;
  }
  /* ".menu .mobile-nav-link span" is the big gold NUMBER treatment, and it
     matches ANY span inside such a link — including a badge. At (0,2,1) it
     beats the badge's own (0,1,0) class, so a badge in a top-level drawer row
     would silently render as a 0.32em gold numeral with 12px of right margin.
     Bug #14's shape exactly. Re-asserted here at (0,3,0); only the properties
     the number rule actually sets need restating. */
  .menu .mobile-nav-link .mobile-nav-proposed-badge {
    font-size: 9px;
    letter-spacing: 0.12em;
    color: var(--bronze-on-dark);
    margin-right: 0;
    vertical-align: middle;
  }
  /* ---------- (d) Mobile drawer ----------
     The accordion trigger is .mobile-nav-group-trigger, NOT
     .mobile-nav-link — see the conflict documented at the top of this
     file: main.js closes the drawer on every .mobile-nav-link click,
     first in the listener order, so a trigger carrying that class can
     never expand. These are the only properties it loses by opting
     out: the type treatment, and the drawer's staggered entrance
     (whose --m-delay this page's own script recomputes across the
     drawer's rows in DOM order, overwriting main.js's indices so the
     stagger still counts 1,2,3,4 down the list). */
  .menu .mobile-nav-group-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: "Fraunces", serif;
    /* Declared on .menu near the top of this file — it has to match
       .menu .mobile-nav-link exactly or the four rows stop reading as one
       list. See that token's note. */
    font-size: var(--mobile-nav-link-size);
    letter-spacing: -0.02em;
    color: var(--limestone);
    background: none;
    border: none;
    padding: 5px 0;
    text-align: left;
    cursor: pointer;
    opacity: 0;
    transform: translateY(28px);
    /* Delay lives on the opacity/transform entries only, via the same
       --m-delay custom property styles.css uses — never the
       transitionDelay shorthand, which would also delay the colour
       transition and make the tap feel laggy (CLAUDE.md bug #12). */
    transition:
      opacity 0.6s var(--ease) var(--m-delay, 0s),
      transform 0.7s var(--ease) var(--m-delay, 0s),
      color 0.3s;
  }
  :global(body.menu-open) .menu .mobile-nav-group-trigger {
    opacity: 1;
    transform: translateY(0);
  }
  .menu .mobile-nav-group-trigger .mobile-nav-number {
    color: var(--gold);
    /* Matches .menu .mobile-nav-link span's 0.38em — see its note. */
    font-size: 0.38em;
    vertical-align: text-top;
    letter-spacing: 0;
    font-family: "Inter", sans-serif;
  }
  /* The 520px cap for an open .mobile-nav-sub lives on the original
     .mobile-nav-group.is-open rule earlier in this file, not here. While this
     was page-local in the sandbox it had to out-specify that rule's 240px via a
     .menu ancestor; merged in, the right move is to change the source value
     rather than leave an override sitting under it. */
  /* The two CTAs as real buttons at the foot of the drawer rather than
     two more numbered Fraunces rows — keeps the list at four items and
     mirrors the role they have on desktop. Fixed delay, matching
     .menu-social's own, since these sit below every numbered row. */
  /* Stacked and equal-width, not side by side (changed 2026-10-02). Measured
     at 375px: the two pills came to ~315px against ~335px of available width,
     so they fitted by twenty pixels — and at 320px they wrapped, producing two
     LEFT-ALIGNED buttons of different widths, which reads as something that
     went wrong rather than a decision. Stacking makes it deliberate at every
     width, gives both a full-width tap target, and keeps the hierarchy legible
     with the filled pill sitting above the outline one.
     300px is the site's existing CTA cap, not a new number — the same value
     already used in four places for buttons that would otherwise run the full
     width of a narrow column. */
  .mobile-nav-cta-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s var(--ease) 0.42s,
      transform 0.6s var(--ease) 0.42s;
  }
  :global(body.menu-open) .mobile-nav-cta-row {
    opacity: 1;
    transform: none;
  }
  .nav-dd-chevron {
    flex: none;
    transition: transform 0.35s var(--ease);
  }
  /* ---------- Chevron rotation jitter, attempt 2 (2026-10-01) ----------
     Attempt 1 fixed the glyph's geometry: the viewBox is "0 0 12 8"
     (ratio 1.5) but the SVGs rendered at 11x7 and 16x11, so the path was
     letterboxed by preserveAspectRatio AND the rotation centre landed on
     half pixels — (5.5, 3.5) and (8, 5.5). Both are now exact 1:1 matches
     centred on whole pixels (12x8 and 18x12). The vibration survived
     that, so the centre was not the whole story.
     What is left is rasterisation. A 180deg rotation on a path with a
     1.4px stroke is re-rastered by the main thread on every frame unless
     the element has its own compositing layer, and a thin stroke
     antialiases differently at every intermediate angle — which reads as
     the glyph shimmering rather than turning. Promoting it means the
     browser rasterises the chevron ONCE and composites the rotation,
     so the antialiasing is computed a single time.
     will-change on a permanently-present element does cost a standing
     layer (CLAUDE.md bug #27's caution), but that applies to elements
     that are never seen; these are two small, visible, interactive
     glyphs, so the trade is the right way round. transform-origin is
     stated explicitly rather than left to its 50% 50% default, so it
     cannot drift if the box size is ever changed again.
     STILL UNCONFIRMED — if it persists, see the CLAUDE.md entry, which
     records both attempts and the two remaining suspects. */
  .nav-dd-chevron {
    will-change: transform;
    backface-visibility: hidden;
    transform-origin: 50% 50%;
  }
  /* ============================================================
     (i) THE ENQUIRE BUTTON — .nav-cta-enquire-button
     ============================================================
     .button-ghost next to .button-gradient read as the disabled sibling
     rather than the secondary action, and three things were doing that at
     once: it was GREY where the other was gold, its border sat at 0.42
     alpha so the outline barely existed, and it had no icon so it carried
     noticeably less visual mass.

     Hue was the main one. Two buttons in the same colour, one filled and
     one outlined, read as a deliberate primary/secondary pair; a gold
     pill beside a grey pill reads as "one action and one thing that isn't
     available". So this keeps the outline — the hierarchy is still
     correct, Book a table should lead — and moves it into the same family
     by tinting the border and the label gold, then fills solid gold on
     hover, which is a more confident resolution than .button-ghost's fade
     to limestone.

     .button-ghost is DROPPED from the element rather than overridden.
     Overriding it would have meant silently redefining all five of its
     custom properties, leaving a class on the markup that no longer
     describes anything true about the button — and styles.css's own
     comment reserves it for hero secondary CTAs. Written as
     ".button.nav-cta-enquire-button" at (0,2,0) so it beats .button's own
     (0,1,0) defaults outright rather than on source order (bug #2). */
  .button.nav-cta-enquire-button {
    --bg: transparent;
    --fg: var(--gold-2);
    --bd: rgba(var(--gold-rgb), 0.55);
    --bg-h: var(--gold);
    --fg-h: var(--ink);
    /* 2px, up from .button's 1px (2026-10-04), so the outline carries
       visual mass closer to Book a table's solid fill beside it. */
    border-width: 2px;
  }
  /* The envelope is a LABEL, not a "proceed" chevron, so it must not
     inherit .button:hover svg's 4px forward nudge — that motion only
     reads correctly on a trailing arrow. Exactly the precedent
     #availChangeBtn's calendar icon already set in styles.css, and the
     reason the icon here is an envelope rather than a second copy of
     Book a table's arrow: "Enquire" is the vaguer of the two labels, so
     the icon is doing real work saying what the action is, instead of
     repeating what its neighbour already says. */
  .nav-cta-enquire-button :global(svg) {
    transition: none;
  }
  @media (hover: hover) {
    .button.nav-cta-enquire-button:hover :global(svg) {
      transform: none;
    }
  }
  @media (hover: none) {
    .button.nav-cta-enquire-button:active :global(svg) {
      transform: none;
    }
  }
  :global(html.nav-no-anim) .menu :global(*) {
    transition: none !important;
    animation: none !important;
  }
  .menu .mobile-nav-link :global(span) {
    color: var(--gold);
    /* 0.38em, up from the original 0.32em across two passes: em tracks the
       label, so each reduction shrank the numeral with it. These were already
       at the small end, and below ~9px Inter numerals go thin on a dark ground,
       so the ratio is raised to hold the RENDERED size at ~9.3px rather than to
       keep the proportion. Deliberate trade: the numeral-to-label ratio is now
       noticeably tighter than it was. If the label shrinks again this should
       stop being an em and become a fixed px — it is UI chrome, not display
       type, and at some point tracking the label is the wrong behaviour.
       Mirrored on .mobile-nav-number in the whole-site nav section. */
    font-size: 0.38em;
    vertical-align: text-top;
    letter-spacing: 0;
    margin-right: 12px;
    font-family: "Inter", sans-serif;
  }
  .mobile-nav-group.is-pinned-open .mobile-nav-group-trigger .nav-dd-chevron {
    display: none;
  }
  /* Gated for the same reasons as .menu .mobile-nav-link above — see that
     rule's note. These rows are the worse case of the two: every sub-link in
     the Restaurant group currently points at "#", so on touch the latch had
     nothing at all to clear it. */
  :global(.menu-social) {
    margin-top: 28px;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s var(--ease) 0.45s;
    position: relative;
    z-index: 2;
  }
  :global(body.menu-open) :global(.menu-social) {
    opacity: 1;
    transform: none;
  }
  /* 18x12 — the drawer trigger chevron. The viewBox is "0 0 12 8" (ratio
     1.5), so 16x11 letterboxed the path and put the rotation centre on a half
     pixel, which made the glyph shimmer through its 180deg turn instead
     of rotating cleanly. Keep any replacement size on a 3:2 ratio with
     even numbers on both axes. */
  .menu .mobile-nav-group-trigger .nav-dd-chevron {
    flex: none;
    width: 18px;
    height: 12px;
    margin-left: auto;
    transition: transform 0.35s var(--ease);
  }
  .mobile-nav-group.is-open .mobile-nav-group-trigger .nav-dd-chevron {
    transform: rotate(180deg);
  }
  /* .button is inline-flex and flex-shrink: 0, so it sizes to its label
     unless told otherwise — width + max-width is what gives the two equal
     widths. justify-content matters because the label and icon would otherwise
     sit left inside a button that is now wider than its content. */
  .mobile-nav-cta-row :global(.button) {
    width: 100%;
    max-width: 300px;
    justify-content: center;
    /* Scaled up from .button-small's own size, exactly as
       .availability-foot .button already does at this same 300px width. That
       rule's note applies verbatim here: the compact size made sense sitting
       tight beside other chrome, but on a full-width stacked pill there is no
       reason to keep it cramped — at 40px tall against 300px wide it reads as
       a letterbox. Reads the same --button-* tokens .button itself does rather
       than inventing a size, so the two stay in step. */
    height: var(--button-height);
    padding: 0 var(--button-padding-x);
    font-size: var(--button-font-size);
  }
</style>
