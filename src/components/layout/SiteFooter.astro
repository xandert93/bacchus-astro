---
import SocialLinks from "@components/ui/SocialLinks.astro"

interface Props {
  // Adds an "Enquire" row scrolling to the page's own #enquire section.
  // Only the homepage had it in the prototype, though four other pages have
  // the section too; kept as-is for now (open question, not a port decision).
  showEnquireLink?: boolean
}
const { showEnquireLink = false } = Astro.props

// Rendered at build time, so the year is baked into the HTML rather than
// filled in after load (site.js still sets #yr; harmless).
const year = new Date().getFullYear()
import Photo from "@components/ui/Photo.astro"
---

<footer>
  <div class="wrap">
    <div class="footer-top footer-top-two-col">
      <div class="footer-brand">
        <div class="footer-brand-mark">
          <Photo
            src="brand/bacchus-logo"
            sizes="64px"
            maxWidth={128}
            alt="Bacchus mark"
          />
          <span class="footer-brand-text">
            <span class="footer-brand-name">Bacchus</span>
            <span class="footer-brand-sub">Mdina · Est. 1660</span>
          </span>
        </div>
        <p style="max-width: 34ch; font-size: 14px">
          Two vaulted chambers inside the walls of the Silent City, serving Mdina since
          1660.
        </p>
        <SocialLinks />
      </div>
      <div>
        <h5>Explore</h5>
        <ul>
          <li>
            <a href="/weddings">Weddings</a>
          </li>
          <li>
            <a href="/corporate">Corporate</a>
          </li>
          <li>
            <a href="/celebrations">Celebrations</a>
          </li>
          <li>
            <a href="/gallery">Gallery</a>
          </li>
          {showEnquireLink && (
            <li>
              <a href="#enquire">Enquire</a>
            </li>
          )}
          {/* Only where drafts are built (dev and preview builds), so the
               live site never links to a page it doesn't have. */}
          {import.meta.env.DRAFTS_INCLUDED && (
            <li>
              <a href="/sandboxes">🏖️ Sandboxes</a>
            </li>
          )}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div>
        © <span id="yr">{year}</span> Bacchus · Mdina, Malta
      </div>
      <div>Prototype by xandert.93. All rights reserved.</div>
    </div>
  </div>
</footer>

<style>
  /* Scoped to this component (moved from global.css by
       scripts/scope-styles.mjs). See FaqAccordion.astro for how scoping works.
  */
  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 44px;
    border-bottom: 1px solid rgba(var(--limestone-rgb), 0.12);
  }

  @media (--from-desktop) {
    .footer-top.footer-top-two-col {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .footer-brand-mark {
    display: flex;
    align-items: center;
    gap: 13px;
  }

  .footer-brand-text {
    display: flex;
    flex-direction: column;
  }

  .footer-brand-name {
    font-family: "Fraunces", serif;
    font-size: 15px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--limestone);
  }

  .footer-brand-sub {
    margin-top: 3px;
    font-family: "Inter", sans-serif;
    font-size: 9px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--gold-2);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    padding-top: 26px;
    font-size: 12px;
    font-family: "Newsreader", Georgia, serif;
  }

  @media (--below-desktop) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (--below-tablet) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
  footer {
    background: var(--ink);
    color: var(--muted);
    padding: clamp(56px, 7vw, 84px) 0 34px;
  }
  footer h5 {
    font-family: "Fraunces", serif;
    font-weight: 400;
    color: var(--limestone);
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  footer ul {
    list-style: none;
    display: grid;
    gap: 10px;
    font-size: 14px;
    font-family: "Newsreader", Georgia, serif;
  }
  footer :global(a:hover) {
    color: var(--gold-2);
  }

  .footer-brand-mark :global(img) {
    width: 40px;
  }
</style>
