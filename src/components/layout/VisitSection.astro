---
// "Come and see it for yourself" - identical on every page in the prototype.
import Photo from "@components/ui/Photo.astro"
import { ADDRESS_LINE, CONTACT } from "@data/contact"
import { below } from "@lib/media-queries.js"
---

<section class="section-padding on-dark visit">
  <div class="wrap split">
    <div class="arch" data-reveal="img">
      <Photo
        src="food-and-drink/champagne"
        sizes={`${below.desktop} 100vw, 50vw`}
        alt="A guest raising a glass of sparkling wine at a dressed table"
      />
    </div>
    <div>
      <div class="eyebrow" data-reveal>
        Visit Bacchus
      </div>
      <h2 data-reveal style="--d: 80ms">
        Come and see it <em>for yourself</em>
      </h2>
      <p class="lead" data-reveal style="--d: 160ms; margin-top: 22px">
        Private viewings are the easiest way to picture your event here — the Hall, the
        Terrace and the Secret Garden, walked through at your own pace.
      </p>
      <div class="visit-list" data-reveal style="--d: 220ms">
        <div>
          <span class="visit-label">
            <span class="visit-item-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </span>
            Where
          </span>
          <span class="visit-value">{ADDRESS_LINE}</span>
        </div>
        <div>
          <span class="visit-label">
            <span class="visit-item-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
            </span>
            Viewings
          </span>
          <span class="visit-value">
            Mon–Fri, <em>by appointment</em>
          </span>
        </div>
        <a href={CONTACT.email.href}>
          <span class="visit-label">
            <span class="visit-item-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m4 6 8 7 8-7" />
              </svg>
            </span>
            Email
          </span>
          <span class="visit-value">{CONTACT.email.display}</span>
        </a>
        <a href={CONTACT.phone.href}>
          <span class="visit-label">
            <span class="visit-item-icon">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z" />
              </svg>
            </span>
            Phone
          </span>
          <span class="visit-value">{CONTACT.phone.display}</span>
        </a>
      </div>
      <p class="visit-note" data-reveal style="--d: 280ms">
        Mention what you're planning when you write — we'll shape the viewing around it.
      </p>
    </div>
  </div>
</section>

<style>
  /* Scoped to this component (moved from global.css by
       scripts/scope-styles.mjs). See FaqAccordion.astro for how scoping works.
  */
  .visit {
    border-bottom: 1px solid rgba(var(--limestone-rgb), 0.12);
  }

  .visit-list {
    display: grid;
    gap: 1px;
    margin-top: clamp(18px, 2vw, 24px);
  }

  .visit-list a:hover {
    padding-left: 10px;
    color: var(--gold-2);
  }

  .visit-list .visit-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: "Inter", sans-serif;
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-2);
    flex: none;
  }

  .visit-list .visit-item-icon {
    flex: none;
    display: grid;
    place-items: center;
    color: var(--gold-2);
  }

  .visit-list .visit-value {
    font-family: "Newsreader", Georgia, serif;
    font-size: 16.5px;
    font-weight: 500;
    color: var(--limestone-2);
    text-align: right;
  }

  .visit-note {
    margin-top: clamp(22px, 3vw, 30px);
    font-size: 12.5px;
    color: var(--muted);
  }

  .visit .arch {
    aspect-ratio: 4/5;
  }

  .visit-list > :global(*) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid rgba(var(--limestone-rgb), 0.14);
    transition:
      padding 0.4s var(--ease),
      color 0.3s;
  }

  .visit-list > :global(*:last-child) {
    border-bottom: none;
  }

  @media (--below-desktop) {
    .visit .arch {
      order: -1;
      max-width: 440px;
    }
  }
</style>
